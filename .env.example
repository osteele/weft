# Test Server Configuration
# Copy this file to .env and fill in the values
# These are used by integration tests in internal/remote/integration_test.go

# SSH Test Server (for queue-based job testing)
SSH_TEST_HOST=user@hostname

# SLURM Test Server (for SLURM backend testing)
SLURM_TEST_HOST=user@hostname

# SSH agent socket (required for key-based authentication)
# On macOS with 1Password, find the socket with:
#   ls -la /private/tmp/com.apple.launchd.*/Listeners
# SSH_AUTH_SOCK=/path/to/agent/socket

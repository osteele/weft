-- allium: 3
-- status-sync.allium
--
-- Scope: Synchronization of job and instance status between the local database,
--        remote hosts (via SSH), and cloud instances (via R2 object storage)
-- Includes: On-prem SSH sync, cloud R2 sync, three-way merge reconciliation,
--           agent-side status reporting, provider polling, orphan cleanup
-- Excludes:
--   - Job submission and placement (see job-lifecycle.allium)
--   - Campaign/instance launch and termination (see campaign-lifecycle.allium)
--   - Output artifact collection and log caching
--   - Queue dispatch policy details (except cloud dependency readiness signals)
--
-- TUI view contracts: rendering contracts for views whose content is driven
-- by sync state (the grouped/ungrouped job list, the selected-job detail
-- footer, and related views) are documented within the rules that drive
-- them — e.g. rule TUIPeriodicSync below. Pure job-centric views that do
-- not depend on sync state (such as the per-job Attempts drill-down) are
-- specified in job-lifecycle.allium.
--
-- Unless a rule explicitly names an attempt id, `job.latest_attempt` means
-- the latest non-abandoned attempt from job-lifecycle.allium. Abandoned move
-- overlap attempts are retained for audit but do not drive sync-derived job
-- status, info, artifacts, or telemetry.

use "./job-lifecycle.allium" as jobs
use "./campaign-lifecycle.allium" as cloud

-- ==========================================================================
-- Value types
-- ==========================================================================

-- Source identifies what signal triggered a status transition.
-- Determines whether the transition is authoritative (can override terminal).
value SyncSource = ssh_sync | slurm_sync | r2_completion | r2_phase
                 | reconcile | user_action | cleanup | queue_runner | placement

-- Agent execution phase reported via R2. Format: "verb:jobID" or bare verb.
value AgentPhase = setup | running | finalizing | uploading
                 | uploading_results | disk_full | grace | destroying

-- Bootstrap progress stage reported during instance startup.
value BootstrapStage = agent_installed | sources_extracted | ready

-- Sync mode controls which portions of host sync execute.
value SyncMode = full | status_only | repair

-- The three states used in three-way merge reconciliation.
value ThreeWayState {
    base: String?       -- last_synced_status: remote state at last successful sync
    local: String?      -- pending_status: what user wants (nil = no pending change)
    remote: String      -- probed remote state
}

-- Remote file markers read from on-prem hosts via SSH.
value RemoteJobFiles {
    status_file: String?        -- {jobID}.status: exit code (plain text)
    pid_file: String?           -- {jobID}.pid: process ID
    pgid_file: String?          -- {jobID}.pgid: process group ID
    meta_file: String?          -- {jobID}.meta: key=value metadata
    heartbeat_file: String?     -- {jobID}.heartbeat: epoch timestamp
}

-- R2 markers read for cloud instance sync.
value R2InstanceState {
    phase: AgentPhase?              -- instance/<id>/phase
    bootstrap_stage: BootstrapStage?    -- bootstrap/<id>/stage
    heartbeat: HeartbeatSample?     -- instance/<id>/heartbeat
    heartbeat_age: Duration?
    termination_intent: String?     -- instance/<id>/termination-intent.json
    agent_version: String?          -- instance/<id>/agent-version (deterministic source-hash build ID)
    job_progress: Integer?          -- 0-100 or -1
}

-- Heartbeat sample written by agent to R2.
value HeartbeatSample {
    timestamp: Timestamp
    phase: AgentPhase
    gpu_util_pct: Integer?
    gpu_mem_used_mib: Integer?
    gpu_mem_total_mib: Integer?
    gpu_temp_c: Integer?
    host_rss_kb: Integer?
    host_mem_total_kb: Integer?
    disk_free_bytes: Integer?
    disk_total_bytes: Integer?
}

-- Result of probing a queue-runner job's remote state via SSH.
value QuickStatus {
    state: queue_unknown | queue_running | queue_paused | queue_queued | queue_dead
    exit_code: Integer?
    mtime: Timestamp?       -- file modification time when completed
    uncertain: Boolean      -- true if host unreachable
}

-- Outcome of a sync or reconciliation operation.
value SyncResult {
    updated: Boolean        -- job status was changed in database
    host_contacted: Boolean -- remote host was successfully reached
}

-- Cloud dependency readiness for queued jobs is derived from synced DB state:
--   - cloud_after(success): upstream status must be completed
--   - cloud_after(any): upstream status must be terminal
-- These dependencies are evaluated during queue dispatch, not by remote
-- queue-runner status files.
-- cloud_after itself is derived at placement/launch time from the consumer's
-- Job.needs list and the current state of each referenced producer job; it is
-- not a user-facing input.

-- Outcome of three-way merge reconciliation.
value ReconcileResult {
    action: none | update_db | update_remote | conflict_resolved
    old_status: String?
    new_status: String?
    conflict: Boolean
    resolution: String?
}

-- ==========================================================================
-- Entities
-- ==========================================================================

-- Tracks the live observation state for a cloud instance, persisted
-- between reconciliation passes.
entity InstanceLiveState {
    instance: cloud/Instance
    phase: AgentPhase?
    bootstrap_stage: BootstrapStage?
    heartbeat_age: Duration?
    phase_changed_at: Timestamp?
    job_progress: Integer?
    -- The job currently making progress on the instance, as reported by the
    -- agent's R2 progress writes. Null while the agent is still starting up
    -- and has not yet pulled a job from its queue.
    active_job: jobs/Job?
    termination_intent: String?
}

-- ==========================================================================
-- Configuration
-- ==========================================================================

config {
    -- SSH sync timeouts
    default_ssh_timeout: Duration = 5.seconds
    fast_ssh_timeout: Duration = 2.seconds
    fast_host_timeout: Duration = 30.seconds
    normal_sync_timeout: Duration = 30.seconds

    -- R2 fetch timeout
    r2_marker_timeout: Duration = 3.seconds

    -- Heartbeat and stall thresholds
    heartbeat_stale_threshold: Duration = 5.minutes
    heartbeat_stale_threshold_early_life: Duration = 8.minutes
    heartbeat_early_life_window: Duration = 15.minutes
    running_stall_timeout: Duration = 30.minutes

    -- Reconcile safety-net window
    recently_terminal_window: Duration = 30.minutes

    -- Provider polling dead-confirmation
    dead_confirm_time: Duration = 30.seconds

    -- Survival cache TTL (bootstrap/setup thresholds)
    survival_cache_ttl: Duration = 5.minutes

    -- TUI sync intervals
    tui_sync_interval: Duration = 60.seconds
    tui_cloud_reconcile_interval: Duration = 60.seconds
    tui_fast_cloud_sync_timeout: Duration = 10.seconds
    tui_normal_cloud_sync_timeout: Duration = 60.seconds
}

-- ==========================================================================
-- On-prem SSH sync
-- ==========================================================================

-- Every ssh and rsync invocation that weft spawns for on-prem sync, source
-- sync, output pull, or agent deploy must be non-interactive: BatchMode=yes
-- plus a bounded ConnectTimeout. Without BatchMode=yes, ssh opens /dev/tty
-- directly to prompt for host-key confirmation, passwords, or passphrases,
-- bypassing piped stdin/stdout. When the spawning process is a Bubble Tea
-- TUI in alt-screen mode, such a prompt corrupts the frame buffer and blocks
-- the process on stdin that never arrives, hanging the UI. A previously-
-- unknown host key alone is enough to trigger this, regardless of whether
-- the flow is expected to require auth.
invariant NonInteractiveSSH {
    for invocation in SSHInvocations ++ RsyncInvocations:
        invocation.options.contains("BatchMode=yes")
        invocation.options.contains_connect_timeout()

    @guidance
        -- Implementation anchor: internal/ssh/batchmode.go
        --   ssh.BatchModeArgs(connectTimeout, extraOpts...)       — exec-form args
        --   ssh.BatchModeRsyncCommand(connectTimeout, extraOpts...) — rsync -e string
        -- These are the single source of the option set.
        --
        -- Callers:
        --   internal/ssh/pool.go            — SSH session pool
        --                                      (10 s connect timeout + keepalive)
        --   internal/agentdeploy/ondemand.go — builder probe + rsync
        --                                      (3 s + ConnectionAttempts=1)
        --   internal/sync/sources.go        — source rsync (15 s)
        --   internal/sync/outputs.go        — output pull (15 s)
        --
        -- New ssh/rsync invocations added in future code must route through
        -- these helpers (or match their behaviour) rather than inlining
        -- ssh option strings.
}

-- Host-level sync: iterate all active jobs on a host and sync each one.
rule SyncHost {
    when: SyncHostRequested(host, mode)

    -- Step 1: Process deferred queue operations (pending kills, cancels, etc.)
    ensures: DeferredQueueOpsProcessed(host)

    -- Step 2: Sync each active job
    for job in jobs/Jobs where job.host.name = host and not job.is_terminal:
        ensures: SyncJobTriggered(job, mode)

    -- Step 3: Reconcile the local queue view with the runner's pending list
    -- in BOTH directions. Together these form the contract: a job ID is in
    -- the runner's pending list if and only if the DB considers it queued
    -- on this host (modulo transient/running states).
    --   - Forward (DB → runner): DB-queued jobs missing from runner state
    --     get dispatched or re-dispatched (see DispatchQueuedExplicitTargets
    --     and RedispatchMissingQueuedJobs).
    --   - Reverse (runner → DB): runner-pending entries that the DB no
    --     longer expects get cancel ops (see PruneStaleRunnerPendings).
    if mode = full:
        ensures: QueuedJobsPushedToRemote(host)
    ensures: RunnerStateReconciled(host)
}

-- Dispatch is a sync responsibility once a concrete inventory-host target
-- is already known. It is not an autopilot responsibility: autopilot chooses
-- destinations and launches new rental instances, while host sync pushes
-- queued work to an already-known host.
rule DispatchQueuedExplicitTargets {
    when: SyncHostRequested(host, full)

    for job in jobs/Jobs
        where job.host.name = host
        and job.status = queued
        and job.target_kind = inventory_host
        and (job.latest_attempt.pending_status = queued
             or job.latest_attempt.last_synced_status != queued):
            ensures: SourceSyncedToHost(job, host)
            ensures: JobAppendedToRunnerQueue(host, job)
            ensures: job.latest_attempt.pending_status = null
            ensures: job.latest_attempt.last_synced_status = queued
            ensures: job.latest_attempt.queued_at != null
            ensures: LifecycleEvent(job, "queue.dispatch.ok")

    @guidance
        -- Applies to explicit `weft sync`, daemon/background sync, and
        -- the TUI hostsync.Worker whenever it selects full mode for the
        -- host. On timeout, connection error, source-sync failure, input
        -- staging failure, or queue append failure, the target remains
        -- durable and pending_status stays queued so any later sync actor
        -- can complete dispatch.
}

-- Forward reconcile: walk DB-queued jobs whose last_synced_status is queued
-- (so the dispatcher previously believed the runner had them), and re-dispatch
-- any that the runner no longer knows about. This catches runner crashes,
-- agent restarts, and glibc-mismatch reinstalls where the runner's local
-- queue state was lost while the DB still records the dispatch as synced.
-- AppendJobToQueue / AddPending are idempotent, so re-dispatching a job the
-- runner does in fact still hold is a no-op.
rule RedispatchMissingQueuedJobs {
    when: RunnerStateReconciled(host)

    let state = FetchRemoteRunnerState(host)
    -- If state is unavailable (SSH failed, runner not started), the next
    -- sync cycle retries; we do not infer "runner has nothing".
    if state != null:
        for job in jobs/Jobs
            where job.host.name = host
            and job.status = queued
            and job.latest_attempt.last_synced_status = queued
            and not JobInRunnerState(job.id, state):
                ensures: job.latest_attempt.last_synced_status = null
                ensures: JobReDispatchedToRunner(host, job)

    @guidance
        -- Implementation anchor:
        --   internal/ops/host_sync.go syncQueueRunnerForHost
        --     - db.ListSyncedQueuedJobs(database, host) yields the
        --       candidate set (status=queued, last_synced_status=queued).
        --     - fetchRemoteRunnerState(host, timeout) reads state.json.
        --     - isJobInRunnerState(jobID, state) checks pending, current,
        --       and running maps.
        --     - db.ResetLastSyncedStatus(jobID) clears the synced marker
        --       so the dispatcher treats the job as unsynced on this pass.
}

-- Reverse reconcile: walk the runner's pending list and remove entries the
-- DB no longer expects there. Without this, the runner's pending array grows
-- unboundedly: any job that ran to a terminal state without an explicit
-- cancel op (the normal case for completed/failed jobs) leaves a stale ID
-- in pending. New arrivals then queue behind the stale entries, blocking
-- progress while the TUI (reading the DB) shows them at the head of the
-- queue. This is the symptom that drove the fix (incident wj557, 2026-06):
-- a benchmark job sat at the head of cool30's runner pending list for
-- 30+ minutes after the DB had marked it failed and processed, gating
-- ~28 other ready jobs behind its stale GPU/benchmark constraints.
rule PruneStaleRunnerPendings {
    when: RunnerStateReconciled(host)

    let state = FetchRemoteRunnerState(host)
    -- Expected = the set of job IDs the dispatcher legitimately wants the
    -- runner to hold on this pass: queued-on-host jobs (both unsynced and
    -- synced, including any just re-dispatched by RedispatchMissingQueuedJobs).
    let expected = QueuedJobsForHost(host) + ReDispatchedJobsThisPass(host)

    if state != null:
        for pending_id in state.pending where pending_id not in expected:
            let job = JobByID(pending_id)

            -- Branch (1): No DB row. The job was deleted or never tracked;
            -- the runner would fail to start it anyway (no job file on
            -- disk). Send cancel op.
            if job = null:
                ensures: RunnerCancelOpSent(host, pending_id, db_row_missing)

            -- Branch (2): DB-terminal. The dispatcher has moved past this
            -- job; the runner has no business trying to start it. Send
            -- cancel op. The reason tag carries the specific terminal
            -- status (completed | failed | dead | killed | canceled) for
            -- log traceability.
            else if job.status in {completed, failed, dead, killed, canceled}:
                ensures: RunnerCancelOpSent(host, pending_id, db_terminal)

            -- Branch (3): DB says queued, but the job is NOT
            -- inventory-targeted at this specific host. Three sub-cases:
            --   (a) Retargeted to a different inventory host.
            --   (b) Retargeted to a rental instance (target_kind becomes
            --       rental_instance, so has_inventory_host is false).
            --   (c) Moved to unplaced (target_kind becomes unplaced).
            -- In all three, this runner shouldn't hold the entry.
            -- The condition is the negation of branch (4)'s positive
            -- identification — matching the positive case keeps newly
            -- added target kinds from silently defaulting to "leave
            -- alone" and reintroducing the leak.
            else if job.status = queued and not (job.has_inventory_host and job.host = host):
                ensures: RunnerCancelOpSent(host, pending_id, db_queued_on_other_host)

            -- Branch (4): DB says queued AND inventory-targeted at this
            -- host. The runner is right to hold it. Shouldn't fire in
            -- practice (the expected set should have caught it) but is
            -- preserved defensively. Leave entry alone.
            --
            -- Branch (5): Running, starting, paused, or other transient/
            -- in-flight states. Canceling under the agent could race the
            -- job's own lifecycle. Leave entry alone.

    @guidance
        -- Implementation anchor:
        --   internal/ops/host_sync.go
        --     - pruneStaleRunnerPendings builds the expected set from the
        --       (jobs, syncedJobs) slices that syncQueueRunnerForHost
        --       already has on hand, then walks state.Pending issuing
        --       removeFromQueueFile(host, id) for each entry the
        --       shouldPruneStalePending classifier marks prunable.
        --     - shouldPruneStalePending is the classifier; its five
        --       branches (db_row_missing, db_terminal:<status>,
        --       db_queued_on_other_host, db_queued_here, db_transient:
        --       <status>) are pinned by TestShouldPruneStalePending in
        --       internal/ops/host_sync_test.go.
        --
        -- Best-effort: any single cancel-op failure logs at debug and the
        -- reverse reconcile continues; the next sync retries. A missed
        -- prune costs one extra dispatch tick of the agent skipping the
        -- stale entry. A wrong prune (cancelling a job that should still
        -- run) is more expensive, so the classifier errs on the side of
        -- leaving ambiguous entries in place.
}

-- Sync a single on-prem job by probing its remote state via SSH.
rule SyncOnPremJob {
    when: SyncJobTriggered(job, mode)
    requires: job.backend in {queue_runner, slurm}
    requires: job.host != null

    -- Different probe strategies per backend
    if job.backend = slurm:
        ensures: SlurmJobProbed(job)
    else if job.backend = queue_runner:
        ensures: QueueRunnerJobProbed(job)

    @guidance
        -- Queue-runner probe sequence:
        -- 1. Read status file ({jobID}.status) for exit code
        -- 2. Check if process is running via PID/PGID files
        -- 3. Check process pause state (ps -o stat= shows "T")
        -- 4. Read metadata, samples, resource usage files
        -- Falls back to R2 if SSH fails for inventory hosts.
}

-- Tmux-session job sync (legacy path for non-queue-runner jobs).
rule SyncTmuxJob {
    when: SyncJobTriggered(job, mode)
    requires: job.backend != slurm
    requires: not job.uses_queue_runner

    -- Probe: does the tmux session still exist?
    -- If session exists and process is paused (pgid state "T") → mark paused
    -- If session exists and job was paused → mark running (resumed)
    -- If session gone → check status file for exit code → completed/failed
    -- If session gone and no status file → mark dead

    @guidance
        -- SSH probes:
        -- 1. `tmux list-sessions` to check session existence
        -- 2. Read .pgid/.pid, then `ps -o stat=` for pause detection
        -- 3. Read {jobID}.status file for exit code
        -- 4. If running/paused and session gone with no status → dead
}

-- Status file detection: job completed on remote host.
rule RemoteJobCompleted {
    when: StatusFileFound(job, exit_code, mtime)

    if exit_code = 0:
        ensures: job.status = completed
    else:
        ensures: job.status = failed
    ensures: job.exit_code = exit_code
    ensures: job.latest_attempt.end_time = mtime
    ensures: job.latest_attempt.last_synced_status = job.status
}

-- Process vanished without status file.
rule RemoteJobVanished {
    when: SessionGoneNoStatusFile(job)
    requires: job.status in {running, paused}

    ensures: job.status = dead
}

-- Process detected as paused (SIGSTOP / "T" state).
rule RemoteJobPaused {
    when: ProcessPauseDetected(job)
    requires: job.status in {queued, starting, running}

    ensures: job.status = paused
}

-- Paused process resumed (session exists, no longer in "T" state).
rule RemoteJobResumed {
    when: ProcessResumeDetected(job)
    requires: job.status = paused

    ensures: job.status = running
}

-- ==========================================================================
-- Preflight rejection (runner → agent → coordinator)
-- ==========================================================================

-- The agent's `batch-status` subcommand, called by the coordinator over
-- SSH, detects the runner's preflight rejection sentinel
-- (<jobid>.preflight_rejected in the agent's log dir) and emits a wire
-- line distinct from COMPLETED, carrying the failure_reason text the
-- runner wrote alongside the sentinel.
--
-- Wire format:
--   JOB|<id>|PREFLIGHT_REJECTED|<ts>|<failure_reason>
--
-- Distinct from:
--   JOB|<id>|COMPLETED|<exit_code>|<mtime>[|<failure_reason>]
rule AgentBatchStatusReportsPreflightRejection {
    when: AgentBatchStatusInvoked(host, job_ids)

    for jobID in job_ids:
        if PreflightSentinelExists(jobID):
            ensures: WireLineEmitted(
                job_id: jobID,
                state: preflight_rejected,
                ts: PreflightRejectedTimestamp(jobID),
                failure_reason: PreflightFailureReason(jobID)
            )

    @guidance
        -- Implementation anchor:
        --   cmd/agent/batchstatus.go    — detects <jobid>.preflight_rejected
        --                                 and prints the PREFLIGHT_REJECTED
        --                                 line before any other classifier.
        --   internal/runner/runner.go   — writes the sentinel and
        --                                 <jobid>.failure_reason files
        --                                 (see source-data-sync.allium
        --                                 § PreflightRejected).
}

-- Coordinator handling for PREFLIGHT_REJECTED. The attempt is closed as
-- failed with exit_code = NULL and end_time = 0; the job stays queued
-- (no RecordJobCompletion call). A dedup-windowed
-- EventQueueDispatchFailed lifecycle event is inserted so `weft job
-- diagnose` surfaces the reason via LatestInventoryDispatchBlock with
-- the existing wait/replan options at high confidence.
rule PreflightRejectionReconciled {
    when: BatchStatusLineReceived(line)
    requires: line.state = preflight_rejected

    let job = JobByID(line.job_id)
    let reason = line.failure_reason

    -- Persist the reason on the open attempt FIRST (while it is still the
    -- latest open attempt; SetJobRemoteState targets the latest open),
    -- then close the attempt without exit_code / end_time.
    ensures: JobFailureReasonStored(job: job, reason: reason)
    ensures: EventQueueDispatchFailedRecorded(job: job, detail: reason)
    ensures: PreflightRejectionReported(job: job, reason: reason)

    @guidance
        -- Implementation anchor:
        --   internal/ops/queue_batch.go    — applyBatchStatuses
        --                                    (queueStatePreflightRejected
        --                                    branch); recordPreflightDispatchBlock
        --                                    inserts the lifecycle event with
        --                                    dispatchEventDedupeWindow.
        --   internal/db/attempts.go        — CloseAttempt(StatusFailed,
        --                                    nil, 0)
        -- See job-lifecycle.allium § PreflightRejectionClosesAttempt for
        -- the attempt-shape semantics this rule produces.
}

-- Both the new PREFLIGHT_REJECTED line and the existing COMPLETED-with-
-- reason path produce the same lifecycle-event side effect: a dedup-windowed
-- EventQueueDispatchFailed carrying the failure_reason. `weft job diagnose`
-- reads this via explain.LatestInventoryDispatchBlock and surfaces it as
-- "[Xs ago] <reason>" with wait / replan options at high confidence,
-- instead of falling through to the generic "job is queued / wait".
rule DispatchFailureEventDedupWindowed {
    when: BatchStatusLineReceived(line)
    requires: line.failure_reason != null and line.failure_reason != ""

    -- Same dedup window applies to PREFLIGHT_REJECTED and COMPLETED-with-
    -- reason paths. The window suppresses repeat inserts for the same
    -- (job, kind, detail) triple within the window.
    ensures: EventQueueDispatchFailedRecorded(
        job: JobByID(line.job_id),
        detail: line.failure_reason
    )

    @guidance
        -- Implementation anchor:
        --   internal/ops/queue_batch.go    — recordPreflightDispatchBlock,
        --                                    dispatchEventDedupeWindow.
        --   internal/explain/               — LatestInventoryDispatchBlock
        --                                    is the diagnose-side reader.
}

-- ==========================================================================
-- Runner restart and exit code preservation (on-prem)
-- ==========================================================================

-- When deploying a new agent binary, the queue runner is restarted
-- gracefully rather than killed, preserving running jobs' exit codes.

rule AgentDeployRestart {
    when: AgentBinaryDeployed(host)

    -- Send restart command via queue command log, not kill signal.
    -- The runner picks up the restart on its next tick and re-execs.
    ensures: RunnerRestartRequested(host)

    @guidance
        -- The runner re-execs via syscall.Exec, preserving the tmux session.
        -- Running jobs continue in their subprocesses. Exit codes survive
        -- because commands are wrapped with exit-capture shell code:
        --   cmd; EXIT_CODE=$?; echo $EXIT_CODE > {jobID}.status; exit $EXIT_CODE
        -- When the restarted runner finds a dead PID with a wrapper-written
        -- status file, it reads the real exit code instead of defaulting to 1.
        --
        -- Falls back to session kill if restart command fails.
        -- Implementation:
        --   internal/runner/process.go WrapCommandWithExitCapture()
        --   internal/runner/runner.go tick() restart handling
        --   internal/agentdeploy/deploy.go SendRestartSignal()
}

invariant ExitCodesPreservedAcrossRestart {
    -- Jobs that completed during a runner restart must have their actual
    -- exit code recorded, not a default value.
    for job in jobs/Jobs:
        if job.status in {completed, failed}:
            if job.exit_code != null:
                -- Exit code came from the wrapper-written status file
                -- or the runner's direct observation, not a default.
                job.exit_code = job.latest_attempt.exit_code
}

-- ==========================================================================
-- Three-way merge reconciliation (on-prem)
-- ==========================================================================

-- The three-way merge resolves conflicts between what the user wants
-- (pending_status), what the remote host reports, and what we last knew.
rule ThreeWayMerge {
    when: ReconcileRequested(job, remote_status)

    let base = job.latest_attempt.last_synced_status ?? job.status
    let local = job.latest_attempt.pending_status

    -- Case 1: No local intent and remote unchanged → no-op
    if local = null and base = remote_status:
        ensures: ReconcileResult(action: none)

    -- Case 2: Remote changed, no local intent → accept remote (pure sync)
    else if local = null and base != remote_status:
        ensures: job.status = remote_status
        ensures: job.latest_attempt.last_synced_status = remote_status

    -- Case 3: Local intent, remote unchanged → apply intent to remote
    else if local != null and base = remote_status:
        ensures: PendingAppliedToRemote(job, local)

    -- Case 4: Both changed to same state → convergence
    else if local != null and local = remote_status:
        ensures: job.status = remote_status
        ensures: job.latest_attempt.pending_status = null
        ensures: job.latest_attempt.last_synced_status = remote_status

    -- Case 5: Job queued locally but not on remote → push to remote queue
    else if job.status = queued and remote_status = null:
        ensures: JobPushedToRemoteQueue(job)

    -- Case 6: Conflict — both diverged from base
    else:
        ensures: ConflictResolved(job, base, local, remote_status)
}

-- Conflict resolution: local intent vs remote state.
rule ResolveConflict {
    when: ConflictResolved(job, base, local, remote)

    -- If remote is terminal, accept it (unless local wants requeue)
    if remote in {completed, failed, dead, killed, canceled}:
        if local = queued:
            -- Requeue intent overrides stale terminal state
            ensures: PendingAppliedToRemote(job, queued)
        else:
            -- Accept terminal remote state, discard local intent
            ensures: job.status = remote
            ensures: job.latest_attempt.pending_status = null
    else:
        -- Remote not terminal — keep trying local intent
        ensures: PendingAppliedToRemote(job, local)

    @guidance
        -- Connection errors during pending application leave pending_status
        -- in place for retry on the next sync pass, rather than dropping
        -- the user's intent.
}

-- Apply a pending status change to the remote host.
rule ApplyPendingToRemote {
    when: PendingAppliedToRemote(job, target_status)

    if target_status = killed:
        ensures: RemoteKillRequested(job)
    else if target_status = canceled:
        ensures: RemoteCancelRequested(job)
    else if target_status = paused:
        ensures: RemotePauseRequested(job)
    else if target_status = running:
        ensures: RemoteResumeRequested(job)
    else if target_status = draft:
        ensures: RemoteDraftRequested(job)
    else if target_status = queued:
        ensures: RemoteRequeueRequested(job)

    ensures: job.latest_attempt.pending_status = null
    ensures: job.status = target_status
    ensures: job.latest_attempt.last_synced_status = target_status
}

-- Stamp the attempt's status and last_synced_status in a single write.
-- When the new status is terminal (completed, failed, dead, killed,
-- canceled), end_time is stamped in the same statement if it was not
-- already set. This preserves the TerminalJobsHaveEndTime invariant
-- (jobs/job-lifecycle.allium) for ALL terminal transitions, including
-- the user-cancel path that goes through this writer rather than the
-- normal RemoteJobCompleted exit-code path.
rule StampAttemptStatus {
    when: AttemptStatusUpdateRequested(attempt, new_status)

    ensures: attempt.status = new_status
    ensures: attempt.last_synced_status = new_status
    if new_status in {completed, failed, dead, killed, canceled}
       and (attempt.end_time = null or attempt.end_time = 0):
        ensures: attempt.end_time = now

    @guidance
        -- Implementation: internal/db/attempts.go
        -- UpdateAttemptStatusAndLastSynced. The end_time CASE expression
        -- ("end_time = CASE WHEN end_time IS NULL OR end_time = 0 THEN ?
        -- ELSE end_time END") preserves an already-set end_time so the
        -- recorded execution boundary is not overwritten by the cancel
        -- timestamp.
        --
        -- Regression wi2317 (2026-05): prior to this writer behavior, a
        -- user-initiated cloud cancel produced status='canceled' with
        -- end_time=NULL. The reconciler's job-started predicate
        -- (campaign-lifecycle.allium § Instance.has_started_job) treated
        -- that row as "still in flight", silencing the
        -- IdleAfterReadyTimeout (5a) watchdog on the surrounding
        -- instance. The watchdog is gated on `not has_started_job`,
        -- and that gate must reflect direct execution evidence
        -- (start_time / end_time), not status.
}

-- ==========================================================================
-- Cloud R2 sync
-- ==========================================================================

-- Sync a cloud instance's state from R2 markers and provider API.
rule SyncCloudInstanceState {
    when: CloudSyncRequested(instance)
    requires: instance.status in {running, paused, grace}

    -- Read R2 markers. Data-independent markers are fetched concurrently
    -- rather than sequentially; see ParallelR2MarkerFetch below.
    let r2_state = FetchR2InstanceState(instance)

    -- Persist to live state table
    ensures: InstanceLiveState updated for instance

    -- Side effect: mark queued jobs as running if R2 phase says they are
    if r2_state.phase != null:
        let phase_job = job referenced by r2_state.phase
        if phase_job != null and phase_job.status = queued:
            ensures: phase_job.status = running

    -- Side effect: detect grace transition
    if r2_state.phase = grace and instance.status = running:
        if no active jobs on instance:
            ensures: instance.status = grace

    -- Side effect: detect grace→running (agent resumed)
    if instance.status = grace and r2_state.phase != grace:
        ensures: instance.status = running
        ensures: instance.grace_started_at = null
        ensures: instance.grace_deadline = null

    @guidance
        -- R2 keys read per instance:
        -- instance/<id>/phase — current execution phase ("verb:jobID")
        -- instance/<id>/heartbeat — JSON with GPU, memory, disk metrics
        -- bootstrap/<id>/stage — bootstrap progress during startup
        -- instance/<id>/termination-intent.json — cleanup control
        -- instance/<id>/agent-version — agent build ID (source-hash-derived)
        -- jobs/<jobID>/runs/<runID>/.complete — per-job exit code
        --
        -- The runID in R2 key paths is the job_attempts.id from the DB.
        -- Both agent (writer) and sync (reader) derive it from the same
        -- DB row, established by claimJobForLaunch before the agent
        -- payload is built. See R2RunIDFromDB invariant.
}

-- Fetch R2 markers for a single instance with bounded concurrency.
-- Data-independent markers are fetched in parallel; markers that depend
-- on the phase observation are fetched in a second wave.
rule ParallelR2MarkerFetch {
    when: FetchR2InstanceState(instance)

    -- Wave 1 (independent): termination intent, phase, agent build ID.
    -- All three are issued concurrently; each is best-effort and does not
    -- fail the others.
    ensures: R2MarkersFetched(instance, {termination_intent, phase, agent_version})

    -- Wave 2 (phase-dependent): issued after the phase is known.
    --   phase non-empty → job progress + heartbeat (concurrent)
    --   phase empty and not has_started_job → bootstrap stage
    --   has_started_job OR in_dud_window → heartbeat
    --
    -- in_dud_window = status = running and launched_at != null and
    -- agent_ready_at = null. We fetch heartbeat there too so the
    -- agent's first synchronous heartbeat — written at startup, well
    -- before any instance phase appears — is visible to DudVastDetection.
    -- Without it, an alive agent looked dead to the watchdog
    -- (incident wi3280, 2026-05-28; see lab-notebook EXP-021).
    ensures: R2PhaseDependentMarkersFetched(instance)

    -- The OnStart probe existence check (instance/<id>/onstart-probe)
    -- runs in the same wave when in_dud_window holds. On R2 error the
    -- observation is set to "presumed present" rather than "absent",
    -- so a transient hiccup cannot combine with other empty signals
    -- to false-fire DudVastDetection. The first confirmed-present
    -- observation is persisted to launches.first_onstart_probe_seen_unix
    -- as training data for a future per-provider survival fit; presumed-
    -- present-on-error observations are NOT persisted.
    -- Implementation: internal/campaign/sync_state.go SyncInstanceState.

    @guidance
        -- Fanning out these reads reduces per-instance R2 latency from
        -- ~5× RTT (serial) to ~2× RTT (two waves). The per-instance loop
        -- in ReconcilePass is already unbounded-parallel, so this
        -- compounds: whole-pass latency approaches
        --   Vast.ai ListAllInstances RTT + 2× R2 RTT
        -- Implementation: internal/campaign/sync_state.go SyncInstanceState
        -- uses two sync.WaitGroup waves over the syncFetch* hooks.
}

-- The two top-level cloudsync phases — instance reconciliation and
-- cloud-job-result syncing — access disjoint R2 key prefixes
-- (instance/<id>/* vs jobs/<id>/*) and update disjoint DB columns,
-- so they run concurrently.
rule ParallelCloudSyncPhases {
    when: CloudSyncPassStarted()

    -- Phase A: reconcile running/launching instances (provider list +
    -- per-instance R2 markers, instance state writes).
    -- Phase B: sync per-job result markers (R2 jobs/ prefix scan +
    -- per-job completion/started/timeseries/opslog reads and DB writes).
    -- A and B run concurrently; ReconcileCampaigns runs after both,
    -- because it consumes instance-level state that A produces.
    ensures: Concurrent(PhaseAReconcileLaunches, PhaseBSyncCloudJobResults)
    ensures: ReconcileCampaigns runs after both A and B complete

    @guidance
        -- Implementation: internal/cloudsync/sync.go SyncState spawns
        -- two goroutines joined by sync.WaitGroup. The serial path
        -- dominated by two sequential R2 list operations becomes
        -- max(A, B) + ReconcileCampaigns.
        -- Phase B is gated on opts.SyncResults. TUI fast cloud refreshes
        -- MUST skip it so the 10s UI budget is spent on provider/instance
        -- reconciliation rather than the heavier R2 jobs/ prefix scan.
        -- The normal/full cloud sync path MAY enable Phase B with the
        -- longer cloud timeout.
}

-- Sync individual job completions from R2 .complete markers.
rule SyncJobCompletionsFromR2 {
    when: JobCompletionSyncRequested(instance)

    for job in instance.jobs where (not job.is_terminal) or job.needs_completion_backfill:
        let run_id = job.latest_attempt.id
        let r2_complete = R2JobCompleteMarker(job, run_id) ??
                          R2JobCompleteMarkerAnyRun(job)
        if r2_complete != null:
            if r2_complete.exit_code = 0:
                ensures: job.status = completed
                ensures: job.exit_code = 0
            else:
                ensures: job.status = failed
                ensures: job.exit_code = r2_complete.exit_code

    @guidance
        -- R2 key: jobs/<jobID>/runs/<runID>/.complete
        -- Contains exit code. Written by agent synchronously before
        -- moving to next job. Read by reconciler each pass to keep
        -- DB in sync without waiting for terminal instance action.
        --
        -- Run-id resolution proceeds in two steps. Normally the run_id
        -- used to construct the R2 key comes from job.latest_attempt.id
        -- (the job_attempts row); the agent and sync agree on this id
        -- because claimJobForLaunch creates the attempt before building
        -- the agent payload. See R2RunIDFromDB invariant.
        --
        -- When the marker is absent at the latest run_id, sync may fall
        -- back to scanning the job's R2 prefix for any completed run.
        -- The fallback fires in two cases:
        --   1. Queued jobs with no launch_id (legacy orphaned markers).
        --   2. Terminal jobs that need completion backfill, i.e.
        --      latest_attempt.last_synced_status is NULL or != status.
        --      cleanupStaleAttempts can advance latest_run_id past the
        --      run that actually wrote the marker; the fallback recovers
        --      the authoritative completion JSON in that case.
        -- See AllowCompletedMarkerFallback in cmd/sync.go.
}

invariant ProcessedMarkerIsPerAttempt {
    -- The "already ingested" gate on R2 .complete markers is per-attempt,
    -- not per-job. Each .complete marker is paired with a .processed marker
    -- at the same prefix:
    --   jobs/<jobID>/runs/<runID>/.complete ↔ jobs/<jobID>/runs/<runID>/.processed
    --   jobs/<jobID>/.complete              ↔ jobs/<jobID>/.processed
    --     (inventory form; runID=0 collapses via key constructor)
    --
    -- The sync loop processes a job whenever any of its observed .complete
    -- markers lacks the matching .processed marker. A .processed marker for
    -- one attempt must NOT suppress reconciliation of a different attempt's
    -- .complete on the same job.
    for job in jobs/Jobs:
        for complete_key in R2CompletedMarkersOf(job):
            if not R2HasMarker(PairedProcessedKey(complete_key)):
                SyncLoopEnqueues(job)

    @guidance
        -- Implementation: HasUnprocessedComplete in internal/r2/client.go;
        -- gated at internal/syncorch/cloud_results.go and
        -- internal/coordinator/vastai_sweep.go. Pairing helper:
        -- r2.PairedProcessedKey(completeKey).
        --
        -- Regression: TestJobMarkers_HasUnprocessedComplete_NewAttemptAfter
        -- ProcessedOlderAttempt in internal/r2/client_test.go pins the
        -- failure mode this invariant rules out — a legacy job-scoped
        -- jobs/<jobID>/.processed marker (written by the pre-fix code path
        -- for an earlier attempt) silently stranded re-queued cloud jobs
        -- whose newer attempt had completed on a different instance.
}

-- ==========================================================================
-- Agent-side status reporting
-- ==========================================================================

-- Agent writes phase transitions to R2 as it progresses through a job.
rule AgentReportsPhase {
    when: AgentPhaseChange(instance, phase, job)

    ensures: R2PhaseWritten(instance, phase, job)

    @guidance
        -- Written to: instance/<instanceID>/phase
        -- Format: "verb:jobID" (e.g., "setup:123", "running:123")
        -- Or bare verb for non-job phases: "grace", "destroying"
        -- Phase sequence per job: setup → running → finalizing → uploading
        -- During running, agent may also perform periodic output/artifact
        -- uploads without changing the phase verb.
}

rule AgentPeriodicOutputSync {
    when: AgentJobRunning(instance, job)

    ensures: R2OutputsIncrementallyUpdated(job)

    @guidance
        -- Agent periodically uploads changed outputs/artifacts while the job
        -- is running (incremental copy), then performs a final sync at stop.
        -- Keys:
        --   jobs/<jobID>/runs/<runID>/outputs/<dir>/
        --   jobs/<jobID>/runs/<runID>/artifacts/files/
        --   jobs/<jobID>/runs/<runID>/artifacts/manifest.json
        -- This bounds lost work on interruptible instances.
}

-- Agent writes heartbeat samples continuously in the background.
rule AgentReportsHeartbeat {
    when: AgentHeartbeatTick(instance)

    ensures: R2HeartbeatWritten(instance)

    @guidance
        -- Written to: instance/<instanceID>/heartbeat
        -- JSON with: timestamp, phase, GPU utilization, GPU memory,
        -- GPU temperature, host RSS, host total memory, disk free/total.
        -- Read by coordinator to detect stale/dead agents and disk full.
        --
        -- A separate, sample-free liveness key is written before any
        -- expensive sample collection on each tick:
        --   instance/<instanceID>/last-seen — plain epoch seconds.
        -- The reconciler treats time-since-liveness as
        -- min(time-since-heartbeat, time-since-last-seen) so a hang in
        -- nvidia-smi or another metric probe does not silence the
        -- watchdog.
        --
        -- AgentHeartbeatTick fires:
        --   1. Synchronously once at agent startup, before any other
        --      observable phase begins (uv sync, model downloads,
        --      user script). This bounds the post-mortem gap when an
        --      instance dies during early bootstrap: without it, a
        --      30-second tick interval can leave no heartbeat at all on
        --      R2 and the failure classifier has nothing to work with.
        --   2. On every instance phase transition (starting → setup →
        --      running → uploading → finalizing). Phase changes are
        --      exactly when fresh disk and metric state is most useful
        --      to the post-mortem.
        --   3. On the periodic 30-second tick during the run.
}

-- Agent writes per-job completion marker.
rule AgentReportsJobComplete {
    when: AgentJobFinished(instance, job, exit_code)

    ensures: R2JobCompleteWritten(job, exit_code)

    @guidance
        -- Written to: jobs/<jobID>/runs/<runID>/.complete
        -- Contains exit code as plain text.
        -- Written synchronously before agent moves to next job.
        -- The runID is the job_attempts.id assigned by claimJobForLaunch
        -- before the agent payload is built. See R2RunIDFromDB invariant.
}

-- Agent writes completion manifest when all jobs finish.
rule AgentReportsInstanceComplete {
    when: AgentAllJobsFinished(instance)

    ensures: R2CompletionManifestWritten(instance)

    @guidance
        -- Written to: campaigns/<instanceID>/.complete
        -- JSON: {CompletedAtUnix, Jobs: [{JobID, ExitCode, UploadStatus, OutputBytes}]}
        -- Written just before agent self-destructs.
}

-- ==========================================================================
-- Provider polling
-- ==========================================================================

-- Batch-fetch provider instance states once per reconciliation pass.
rule BatchFetchProviderState {
    when: ReconcilePassStarted()

    ensures: ProviderInstancesBatchFetched()

    @guidance
        -- Calls ListAllInstances() once per provider instead of N
        -- individual ShowInstance() calls. Reduces transient errors.
        -- Falls back to individual ShowInstance() if batch fails.
        -- If the batch call succeeds but a known provider instance ID is
        -- absent from that list, reconcile treats the observation as provider
        -- status unavailable, not as provider-dead, until the normal
        -- unavailable-status timeout is exceeded.
}

-- Record provider status transitions for historical tracking.
rule RecordProviderTransition {
    when: ProviderStatusChanged(instance, new_provider_status)

    ensures: ProviderTransitionRecorded(instance, new_provider_status)

    @guidance
        -- Persisted to provider_status_history table.
        -- Used for bootstrap survival analysis and reliability tracking.
}

-- ==========================================================================
-- Cloud reconciliation pass
-- ==========================================================================

-- The reconciler runs periodically and checks all running/launching instances.
rule ReconcilePass {
    when: ReconcilePassTriggered()

    -- For each running/launching instance:
    for instance in cloud/Instances where not instance.is_terminal:
        ensures: CloudSyncRequested(instance)
        ensures: InstanceReconciled(instance)

    -- Reset jobs stranded on dead cloud instances
    ensures: OrphanedCloudJobsReset()

    -- Safety net: verify recently-terminal instances are actually destroyed
    for instance in cloud/Instances
        where instance.is_terminal
        and instance.ended_at > now - config.recently_terminal_window:
            ensures: TerminalInstanceVerified(instance)

    -- Orphan sweep: destroy weft-labeled provider instances from non-active campaigns
    ensures: OrphanSweepCompleted()
}

-- Heal stale pending_placement intents once a launch is past bootstrap.
rule NormalizePendingPlacementAfterLaunchProgress {
    when: InstanceReconciled(instance)
    requires: instance.status in {running, paused, grace, completed}

    ensures: StalePendingPlacementNormalized(instance)

    @guidance
        -- Scope: latest attempts for jobs on this instance where
        -- pending_status = pending_placement.
        -- Normalize pending_status to queued unless the latest attempt is a
        -- completed non-orphaned/non-canceled cloud outcome.
        -- This prevents jobs from being shown as "launching" forever when
        -- launch status has already advanced and coordinator updates lag.
}

-- R2 completion can authoritatively override terminal job states.
-- This corrects race conditions where SSH sync marked a job dead/failed
-- but the agent actually completed it successfully.
rule AuthoritativeR2Completion {
    when: R2CompletionFound(job, exit_code)
    requires: job.status in {failed, dead, killed, canceled, queued}

    if exit_code = 0:
        ensures: job.status = completed
        ensures: job.exit_code = 0
        ensures: job.latest_attempt.last_synced_status = completed

    @guidance
        -- R2 completion is the only non-user source that can override
        -- terminal states. The agent on the remote host has direct
        -- knowledge of actual job outcome, making it authoritative.
        -- This uses the Authoritative flag in the transition table.
        --
        -- Timestamp resolution for end_time/start_time:
        --   1. Prefer the agent's <jobID>.completion.json (authoritative).
        --   2. If JSON is missing, fall back to the .complete marker's
        --      R2 LastModified for end_time (within ~1s of true end).
        --   3. Only when no marker LastModified is available either,
        --      leave end_time NULL and clear last_synced_status so the
        --      row remains backfill-eligible.
        -- last_synced_status is set to the terminal status only when
        -- (1) succeeded — i.e. authoritative times were ingested. The
        -- marker-only path (2) and (3) MUST leave last_synced_status
        -- NULL so a later sync that finds the JSON can rewrite the row.
        -- Wall-clock sync time MUST NOT be substituted as end_time.
}

-- ==========================================================================
-- Sync triggers
-- ==========================================================================

-- Automatic sync before display commands (list, status, job show).
rule AutoSyncBeforeDisplay {
    when: DisplayCommandRequested(hosts)

    for host in hosts:
        ensures: SyncHostRequested(host, status_only)

    ensures: CloudSyncRequested()

    @guidance
        -- Uses fast timeouts (2s SSH, 30s per host) to avoid blocking
        -- the display. Falls back gracefully if hosts are unreachable.
        -- Display commands must also fall back gracefully when writable DB
        -- open/repair is unavailable (for example SQLITE_READONLY in
        -- sandboxed agents): show cached local state instead of failing.
        -- Optional pre-display sync remains best-effort; inability to write
        -- DB state during sync must not be a hard error for list/status/log/
        -- info/artifact listing.
        -- User-facing warnings should focus on potential staleness, not on
        -- startup-repair deferral itself.
        -- Read-only display commands (`weft status <id>` without --wait) must
        -- NOT trigger queue-runner startup (agent deploy, rclone config
        -- deployment, runner ensure). Those are side-effectful ssh operations
        -- that belong to progression paths (--wait, dashboard `weft status`
        -- with no args, explicit `weft sync --full`), not read-only checks.
        -- A stuck runner-ensure (e.g. 30s rclone-write timeout) must never
        -- appear as latency on a plain status query.
}

-- Explicit sync command.
rule ExplicitSync {
    when: UserSync(hosts)

    for host in hosts:
        ensures: SyncHostRequested(host, full)

    ensures: ReconcilePassTriggered()

    @guidance
        -- Default mode: SSH host sync + cloud reconcile.
        -- Uses normal timeouts (30s per host).
        -- Agent deployment and queue runner startup require --full flag
        -- to avoid slow SSH operations on unreachable hosts blocking
        -- the fast path.
}

-- TUI periodic sync via the hostsync.Worker background goroutine.
rule TUIPeriodicSync {
    when: TUISyncTickFired()

    -- On-prem: request syncs for hosts with visible jobs.
    for host in visible_job_hosts:
        if HostHasQueuedExplicitTargetNeedingDispatch(host):
            ensures: SyncHostRequested(host, full)
        else:
            ensures: SyncHostRequested(host, status_only)

    -- Cloud: reconcile runs on its own 60s ticker inside the worker
    ensures: CloudReconcileTriggered()

    -- Always reload jobs from DB to pick up changes from any source
    ensures: TUIJobsReloaded()

    @guidance
        -- The hostsync.Worker runs a select loop with multiple tickers:
        --   500ms: process host sync queue
        --   60s:   cloud reconcile (reconcileCloudJobs)
        --   120s:  repair syncs, unplaced job checks
        --
        -- Cloud reconcile calls cloudsync.SyncState → ReconcileLaunches
        -- which reads R2 markers and provider API. Side effects include
        -- marking queued jobs as running (MarkQueuedJobRunning).
        -- Fast TUI cloud refreshes use the 10s cloud timeout and run
        -- instance/provider reconciliation only. Full TUI cloud refreshes
        -- use the 60s cloud timeout and may additionally sync R2 job
        -- result markers.
        --
        -- The worker sends a result to the TUI when Updated > 0
        -- (including both instance-level reconciliation AND job status
        -- transitions like queued→running). The TUI reloads jobs from DB
        -- upon receiving any result.
        --
        -- The TUI also reloads jobs every sync tick (60s) regardless
        -- of worker results, to catch DB changes from other sources.
        --
        -- HostHasQueuedExplicitTargetNeedingDispatch is true when any
        -- queued inventory-host job has pending_status=queued or
        -- last_synced_status != queued. This promotes the worker from a
        -- status-only probe to full sync so TUI background sync can append
        -- durable explicit placements to the runner queue.
        --
        -- TUI rendering contract for grouped status list:
        --   - Status/footer block is bottom-anchored.
        --   - Keep at least one blank separator line above the footer block.
        --   - If the viewport is too short, abbreviate grouped job rows by
        --     replacing the tail of a section with "..." (only when 2+ lines
        --     are elided). If all jobs in a section are elided, render
        --     "Section (N)" (without a colon), preserving section order and
        --     omitting blank separator lines between abbreviated sections.
        --
        -- Grouped status buckets (in display order):
        --   - Running:   job.status in {running, starting}.
        --   - Paused:    job.status = paused. Paused jobs are NOT counted as
        --               running in the footer "N jobs running" summary.
        --   - Queued:    placed job.status = queued AND either (a) a sibling
        --               on the same launch is in Running/Starting, OR (b) the
        --               launch's agent has been ready at least once (i.e.
        --               Launch.agent_ready_at is set). Condition (b) keeps
        --               between-jobs phases (uploading outputs, draining
        --               background work, polling for new work) classified as
        --               Queued rather than cycling back through Launching.
        --               Sibling membership is computed from actual job
        --               statuses in the current snapshot, not from
        --               LaunchLiveState.JobProgressID (which can go stale).
        --   - Launching: placed job whose launch is Planned/Launching, OR
        --               rental-assigned job whose launch is Running but whose
        --               agent has never been ready yet (bootstrap window).
        --               Once the agent has been ready once, queued jobs on
        --               that launch belong in Queued regardless of current
        --               agent activity. The Launching row also surfaces a
        --               "terminate in <d>" countdown when the bootstrap
        --               deadline is within ~10 minutes.
        --   - Unplaced:  queued/pending jobs with no target, plus jobs whose
        --               launch has Failed/Cancelled, plus stale pending
        --               placements without a launch.
        --   - Completed / Failed / Killed/Canceled: terminal buckets.
        --   - In grouped unprocessed outcome triage, canceled rows are
        --     omitted while killed rows remain visible.
        --
        -- Blocked/waiting-reason consolidation (Queued and Unplaced sections
        -- only): within each of these sections, jobs carrying a visible
        -- reason are grouped by that reason and emitted under a subheader of
        -- the form "  blocked: <reason> (<count>)" for actionable blockers or
        -- "  waiting: <reason> (<count>)" for routine handoff/wait states,
        -- followed by their indented job rows ("  - wj<id> — …"). Reason
        -- groups appear in first-seen order (matching the section's job
        -- order). Jobs without a visible reason trail the grouped output at
        -- the normal indent, without a subheader. No per-job
        -- "    blocked: …" line is emitted — the reason is surfaced once per
        -- group, not per job.
        -- Implementation: appendBlockedGroupedJobRows in
        -- internal/ui/terminal/list_grouped_status.go.
        --
        -- Footer "N jobs running" counts rows where status in
        -- {running, starting} AND effective_target_kind != unplaced. Paused
        -- jobs are excluded so the count agrees with the Running section.
        --
        -- ETA line: the "with +1 instance" suffix is suppressed unless a
        -- concrete improved estimate is available; otherwise the hint is
        -- not actionable and clutters the footer.
        --
        -- Selected-job detail footer: when a job is under the cursor, both
        -- the grouped and ungrouped list views render up to two detail
        -- lines between the grouped error-details block and the System
        -- line (formerly the "shared-status" line). The renderer returns
        -- 0, 1, or 2 lines:
        --
        --   Job:  <always rendered when a job is selected>
        --   Host: <rendered only when the job is placed>
        --
        -- When no job is selected, neither line is rendered.
        --
        -- Job line:
        --   "Job: wj<id>" (canonical CLI job-id notation), followed by
        --   " · "-joined segments:
        --   - Status-context segments, selected by EffectiveStatus:
        --       - running/starting:         "elapsed <duration>" when
        --                                   StartTime > 0.
        --       - queued/pending_placement: "waiting <duration>".
        --       - completed:                "ran <duration>",
        --                                   "finished <duration> ago",
        --                                   "cost $<amount>", and
        --                                   "exit <code>" when the
        --                                   corresponding fields are
        --                                   available. Cost uses the
        --                                   stored job cost first and
        --                                   falls back to run duration
        --                                   multiplied by launch hourly
        --                                   rate.
        --       - failed:                   "exit <code>", then
        --                                   "<FailureReason>" or the first
        --                                   line of ErrorMessage. Failed
        --                                   jobs also show the completed
        --                                   timing/cost segments above when
        --                                   those fields are available.
        --   - Sibling-wait segment: "waiting for wj<sibling-id>" appears
        --     between the status-context segment and the ETA segment when
        --     EffectiveStatus is queued or pending_placement AND a running
        --     sibling exists on the same target.
        --       - Rental target: sibling ID comes from
        --         LaunchLiveState.JobProgressID for the job's launch.
        --         Rendered only when JobProgressID is non-zero and differs
        --         from the selected job's own ID.
        --       - Inventory target: scan the loaded job set for a sibling
        --         with the same Host whose EffectiveStatus is Running or
        --         Starting; first match wins.
        --     Helper: waitingForSiblingJobID(job, ctx) in
        --     list_selected_detail.go resolves the target ID; null → no
        --     segment rendered.
        --   - When TargetKind is unplaced, the Job line also carries
        --     "unplaced", plus "wants <gpu-class ≥NGB>" when a GPU
        --     constraint is set, plus "blocked: <reasons>"
        --     (placement_reasons joined with "; ") when non-empty. No
        --     separate Host line is rendered for unplaced jobs.
        --   - ETA suffix: "ETA <estimate-with-bounds>" when
        --     estimateRunningJobRemaining(job, live, now) yields a
        --     positive estimate — typically only for running jobs with
        --     history-backed remaining estimates.
        --
        -- Host line (rendered only for placed jobs, selected by TargetKind):
        --   - inventory host: "Host: <hostname>", optionally followed by
        --     " · last seen <dur> ago" when CachedHostInfo.LastUpdated for
        --     the host is older than 5 minutes. When the cached info is
        --     fresh (within 5 minutes) or absent, only "Host: <hostname>"
        --     is rendered. The DB does not track boot-time uptime for
        --     on-prem hosts; this "last seen" freshness indicator is the
        --     closest derivable signal.
        --   - rental instance (enriched): when the list TUI has a Launch
        --     record for the job's LaunchID, the Host line reads
        --       "Host: wi<launch-id> @ <Provider> · <state> ·
        --        <GPU brief> · $<rate>/hr · uptime <dur> · $<cost>"
        --     with segment sources:
        --       - <Provider>: cloud.Provider.DisplayName() on
        --         launch.Provider (e.g. "Vast.ai", "RunPod"). Falls back
        --         to the job's provider tag when the Launch provider is
        --         unknown. When both are empty, the "@ <Provider>"
        --         suffix is omitted and the head collapses to
        --         "Host: wi<launch-id>".
        --       - <state>: Launch.Status rendered as one of "launching",
        --         "running", "grace", "completed", "failed", "canceled",
        --         "planned". Omitted for empty or unknown statuses.
        --       - <GPU brief>: db.Launch.DisplayGPUBrief() (e.g.
        --         "RTX 3090 24GB" or "2x A100 80GB").
        --       - $<rate>/hr, uptime <dur>, $<cost>: produced by
        --         observeLaunch(ci, inst=nil, now) in
        --         cloud_instance_observability.go. Uptime is the
        --         wall-clock duration since Launch.LaunchedAt; cost is
        --         the currently accumulated dollar total.
        --     Each of these segments is omitted independently when the
        --     underlying field is absent (e.g. a just-launched record
        --     with no LaunchedAt yet).
        --   - rental instance (fallback): when the Launch record itself
        --     is missing (e.g. a race during reload), the line falls
        --     back to the bare form
        --       "Host: wi<launch-id> @ <Display>"
        --     where <Display> is cloud.Provider.DisplayName() on the
        --     job's provider tag ("Vast.ai" for vastai, "RunPod" for
        --     runpod; the "@ <Display>" suffix is omitted entirely for
        --     unknown providers). The va:/rp: prefix on wi<id> is NOT
        --     used on the Host line.
        --
        -- Per-reload plumbing for the above:
        --   - db.GetLaunchesByIDs batch-loads all Launch rows for the
        --     rental jobs on screen (parallels GetLaunchLiveStates).
        --   - db.LoadCachedHostInfo is called per distinct inventory
        --     host in the loaded job set.
        --   - Both populate maps on listJobsLoadedMsg / listTUIModel:
        --     launchByID and hostInfoByName. Rendering reads only from
        --     these maps — no per-render DB queries.
        --   - The four lookup maps (launchByID, hostInfoByName,
        --     launch-live-state map, sibling job slice) are bundled into
        --     a selectedJobContext struct in list_selected_detail.go and
        --     passed into renderSelectedJobDetail(job, ctx, now).
        --
        -- System line (formerly "shared-status"):
        --   - Always rendered, whether or not a job is selected.
        --   - Prefixed with "System: " — or "System (global): " when the
        --     visible running-job count differs from the global count —
        --     so it sits as a sibling of the Job:/Host: lines.
        --   - Content: running-job count, instance count, and the
        --     cost-rate segment.
        --   - Count nouns are singularised when the count is 1:
        --       "1 job running"  / "2 jobs running"
        --       "1 instance"     / "2 instances"
        --       "(1 up, 1 starting)" / "(2 up, 2 starting)" in the
        --         instance-breakdown sub-phrase.
        --     Helper: pluralize(n, singular, plural) in
        --     provider_credit_warning.go.
        --   - Cost-rate segment combines the current burn rate with the
        --     auto-pilot run-rate soft target:
        --       - burn > 0 and target > 0:
        --           "$<burn>/hr of $<target>/hr target"
        --       - burn > 0 and target = 0: "$<burn>/hr"
        --       - burn = 0 and target > 0: "target $<target>/hr"
        --       - burn = 0 and target = 0: segment omitted.
        --     The target comes from listTUIModel / watchModel
        --     autoRunRateTargetCents (loaded via
        --     config.AutoRunRateSoftTargetCentsPerHour). Helper:
        --     formatCostRateSegment(burn, target) in
        --     provider_credit_warning.go. The grouped-view controls row
        --     no longer carries a "$:target(...)" segment; the `$` key
        --     still opens the rate-input prompt.
        --
        -- The standalone campaign-wide "ETA: …" line is no longer
        -- rendered in the grouped view. Per-job ETA now lives on the Job
        -- line. The underlying computeGroupedETA call is still made
        -- because eta.HasQueued is consumed by groupedControlsText to
        -- label the "new instance" keybinding.
        --
        -- Excluded by design: project label (already shown in the job
        -- list row), queue name (only one queue in practical use), and
        -- the command / script tail (too long; already visible in the
        -- job row).
        --
        -- Provider prefix on rental instance labels: where the list TUI
        -- renders a rental instance reference in the list row (ungrouped
        -- HOST column) or as the grouped "launching" row suffix
        -- ("instance <pp>:wi<id> starting"), the wi<id> is prefixed with a
        -- 2-letter provider tag derived from the job's provider:<name> tag:
        --   - "va:wi<id>" for provider:vastai
        --   - "rp:wi<id>" for provider:runpod
        --   - bare "wi<id>" when the provider tag is absent or unknown.
        -- The prefix applies only to rental references in the list row;
        -- inventory host names are unchanged. The footer Host line does
        -- NOT use this prefix — it renders "Host: wi<id> @ <Display>"
        -- with the provider fused into the head via "@".
        -- Implementation: providerShortPrefix in
        -- internal/ui/terminal/list_render.go (fed by db.Job.ProviderName()
        -- / db.TagProviderPrefix), applied in formatJobListHost and
        -- groupedStatusTimingSuffix.
        --
        -- Viewport reservation: the Job/Host detail lines' count (0, 1,
        -- or 2) is subtracted from the body viewport so grouped section
        -- headers remain visible on short terminals. The body-height
        -- calculation counts ETA, status, Job/Host detail lines, System,
        -- auto-pilot, and controls as footer lines. This applies equally
        -- to the grouped-by-status and ungrouped flat-list views.
        --
        -- Implementation:
        --   internal/ui/terminal/list_selected_detail.go —
        --     renderSelectedJobDetail (returns []string of 0/1/2 lines),
        --     renderJobFooterLine, renderHostFooterLine,
        --     providerDisplayName.
        --   internal/ui/terminal/provider_credit_warning.go —
        --     "System: " / "System (global): " prefix.
        --   internal/ui/terminal/list_tui.go — View() and groupedView()
        --     integration; campaign ETA line removed from grouped view.
}

-- ==========================================================================
-- Multi-process sync coordination
-- ==========================================================================

-- Cloud sync lease: prevents redundant provider API calls when multiple
-- commands, TUIs, monitors, or coordinators run simultaneously.
rule CloudSyncLease {
    when: CloudSyncRequested()

    let lease = AcquireAutoLease("sync:cloud:reconcile", process_owner, 180.seconds)

    if lease.acquired:
        -- This process owns the cloud reconcile for the next 180s.
        ensures: ReconcilePassTriggered()
        ensures: LeaseReleased("sync:cloud:reconcile") after reconcile completes
    else:
        -- Another process owns the reconcile. Fall back to DB-only
        -- reconciliation (apply local state changes without contacting
        -- cloud providers or R2).
        ensures: DBOnlyReconcileTriggered()

    @guidance
        -- Lease table: auto_leases(scope, owner, expires_at, updated_at)
        -- Scope: "sync:cloud:reconcile"
        -- TTL: 180 seconds
        -- Owner: "{hostname}:{pid}:{nanotime}" by default, unless a caller
        --   supplies a narrower owner for a legacy coordinator path.
        -- internal/syncorch.SyncCloud applies this lease by default for
        --   normal database-backed cloud sync callers. Tests and narrow
        --   maintenance paths may opt out explicitly with DisableLease.
        -- DB-only fallback applies only local DB repairs (orphaned job
        --   resets, campaign status reconciliation) without R2 or provider
        --   API calls.
}

-- Per-host sync leases: prevent redundant SSH probes across processes.
rule HostSyncLease {
    when: SyncHostRequested(host, mode)

    let scope = "sync:host:" ++ mode ++ ":" ++ host
    let ttl = HostLeaseTTL(mode)
    let lease = AcquireAutoLease(scope, process_owner, ttl)

    if lease.acquired:
        ensures: HostSyncExecuted(host, mode)
        ensures: LeaseReleased(scope) after sync completes
    else:
        -- Another process is syncing this host. Skip.
        ensures: HostSyncSkipped(host)

    @guidance
        -- Lease TTLs by mode:
        --   fast (status_only): 30 seconds
        --   full: 15 minutes
        --   repair: 3 minutes
        -- The hostsync.Worker enforces maxParallel=3 concurrent host syncs
        -- within a single process, and uses per-host leases to coordinate
        -- across processes.
}

-- DB as shared notification bus: all processes read/write the same SQLite DB.
-- Any process that updates job or instance state makes changes visible to all
-- other processes on their next DB read. Watch-style processes subscribe to
-- the shared SQLite DB/WAL/SHM change source and debounce reloads so they
-- usually react before the periodic tick.
rule DBAsSharedBus {
    when: AnyProcessUpdatesDB()

    -- Notifications are invalidations only. Processes still re-read from DB;
    -- the watcher does not carry row-level payloads.
    ensures: AllProcessesEventuallyReadUpdatedState()

    @guidance
        -- The DB is the source of truth for all job and instance state.
        -- Multiple processes may read and write concurrently. SQLite's
        -- WAL mode allows concurrent reads with a single writer.
        --
        -- TUI reload sources:
        --   1. Periodic tick (60s) → reloadJobs() from DB
        --   2. Worker result notification → reloadJobs() from DB
        --   3. DB file watcher (inotify/kqueue) → debounced reload
        --
        -- This means a TUI that loses the cloud sync lease still gets
        -- updated data on the next DB watcher invalidation, with the 60s
        -- periodic tick as a backstop.
}

-- ==========================================================================
-- Opslog sync
-- ==========================================================================

-- Opslog sync fetches instance operation logs from R2 for local caching.
-- Uses negative caching to avoid re-fetching oplogs that don't exist or time out.
-- Gets its own context timeout, independent of the job-marker sync budget.
rule OpslogSync {
    when: OpslogSyncRequested(instances)

    -- Filter out instances with cached not-found or timed-out status
    let candidates = instances.filter(i =>
        not ((i.oplog_not_found = true or i.oplog_timeout = true)
             and i.oplog_synced_at >= i.ended_at + config.oplog_not_found_buffer))

    -- Fetch in parallel with bounded concurrency; each request has its own timeout
    for instance in candidates (parallel, max: config.oplog_max_parallel):
        let result = FetchR2Opslog(instance, timeout: config.oplog_request_timeout)
        if result = synced:
            ensures: OpslogCached(instance)
            ensures: instance.oplog_synced_at = now
        else if result = not_found:
            ensures: instance.oplog_not_found = true
            ensures: instance.oplog_synced_at = now
        else if result = timeout:
            ensures: instance.oplog_timeout = true
            ensures: instance.oplog_synced_at = now

    @guidance
        -- DB columns on launches: oplog_synced_at, oplog_not_found, oplog_timeout
        -- Safety buffer: 10 minutes after ended_at before trusting not-found/timeout
        -- Running/grace instances are always re-checked regardless of flags
        -- Bounded parallelism: 10 concurrent R2 reads (semaphore channel)
        -- Per-request timeout: 5s; overall sync timeout: 30s (fresh context)
}

config {
    -- Opslog sync
    oplog_lookback: Duration = 7.days
    oplog_not_found_buffer: Duration = 10.minutes
    oplog_max_parallel: Integer = 10
    oplog_sync_timeout: Duration = 60.seconds
    oplog_request_timeout: Duration = 10.seconds
}

-- ==========================================================================
-- Invariants
-- ==========================================================================

invariant SyncedStatusMatchesAfterSync {
    -- After a successful sync with no pending operations, the DB status
    -- should reflect the remote state.
    for job in jobs/Jobs:
        if job.latest_attempt.pending_status = null
        and job.latest_attempt.last_synced_status != null:
            job.status = job.latest_attempt.last_synced_status
}

invariant AuthoritativeOverridesAreR2Only {
    -- Only R2 completion (authoritative source) can transition
    -- from terminal states to completed.
    for job in jobs/Jobs:
        if job.status = completed and job.latest_attempt.last_synced_status in {failed, dead, killed, canceled}:
            -- This transition was made by an authoritative source
            job.latest_attempt.last_synced_status = completed
}

invariant PendingStatusClearedAfterApply {
    -- After a pending operation is successfully applied to the remote,
    -- pending_status must be cleared.
    for attempt in JobAttempts:
        if attempt.pending_status != null:
            attempt.pending_at != null
}

invariant RunnerPendingMatchesDBQueued {
    -- The agent runner's pending list and the DB's queued-on-host view
    -- must converge. After SyncHost completes for a host, every entry in
    -- the runner's pending list either corresponds to a job the DB still
    -- considers queued on that host, or is in a transient/in-flight state
    -- (running, starting, paused) where the runner is mid-execution. No
    -- terminal jobs, no DB-row-missing entries, and no jobs retargeted to
    -- another host should remain in the runner's pending list across
    -- consecutive sync passes.
    --
    -- This invariant is the contract pair of the two reconcile directions:
    --   - RedispatchMissingQueuedJobs supplies the forward direction
    --     (DB-queued ⊆ runner.pending ∪ runner.current ∪ runner.running).
    --   - PruneStaleRunnerPendings supplies the reverse direction
    --     (runner.pending ⊆ DB-queued-here ∪ transient-states).
    -- Either direction alone is insufficient: forward without reverse
    -- accumulates stale entries forever (incident wj557); reverse without
    -- forward never recovers a job the runner has lost.
    for host in Hosts:
        for pending_id in RunnerStateFor(host).pending:
            let job = JobByID(pending_id)
            exists job
            job.status not in {completed, failed, dead, killed, canceled}
            not (job.status = queued and job.has_inventory_host and job.host != host)

    @guidance
        -- Convergence, not instantaneous equality: a stale entry that
        -- appears between sync passes is expected and acceptable. The
        -- invariant holds in the limit — after each SyncHostRequested
        -- pass with mode != lease-skipped completes, the relation is
        -- restored. PruneStaleRunnerPendings is best-effort on individual
        -- cancel ops, so a single failing cancel may carry one entry
        -- forward by one tick.
}

invariant R2RunIDFromDB {
    -- The run_id used in R2 key paths (jobs/<jobID>/runs/<runID>/...)
    -- must be the job_attempts.id established in the DB before the
    -- agent payload is constructed. Both the agent (R2 writer) and
    -- sync (R2 reader) derive the run_id from the same DB row.
    --
    -- This prevents a class of bugs where the agent writes R2 markers
    -- at one path and sync looks for them at another.
    --
    -- Enforcement: claimJobForLaunch creates the job_attempts row
    -- (via SetJobLaunchID) and re-reads the job to get the fresh
    -- LatestRunID before the agent payload is built.
    -- newCloudAgentJob validates that LatestRunID is non-zero.
    for job in jobs/Jobs:
        if job.cloud_instance != null and not job.is_terminal:
            job.latest_attempt != null
            job.latest_attempt.id > 0

    @guidance
        -- Implementation: internal/campaign/launch_claim.go
        -- claimJobForLaunch(database, jobID, instanceID) performs:
        --   1. SetJobLaunchID → creates job_attempts row (the run_id)
        --   2. GetJobByID → re-reads to get fresh LatestRunID
        --   3. Validates LatestRunID > 0 and LaunchID matches
        -- This must complete before newCloudAgentJob builds the payload.
        -- If claim fails, all previously claimed jobs are rolled back
        -- to unplaced via resetClaimedJobsToUnplaced.
}

invariant GraceDetectionRequiresNoActiveJobs {
    -- Grace transition is only detected when no active jobs remain
    -- on the instance. This prevents premature grace entry while
    -- a job is still running.
    for instance in cloud/Instances:
        if instance.status = grace:
            instance.jobs.all(j => j.is_terminal)
}

invariant ReconcileResultCountsAllChanges {
    -- ReconcileResult.JobsUpdated must count all job status transitions
    -- made as side effects during cloud reconciliation (e.g. queued→running
    -- from R2 phase detection). This ensures the TUI is notified of
    -- changes that don't correspond to instance-level reconciliation.
    for reconcile_pass in ReconcilePasses:
        reconcile_pass.result.jobs_updated >= count of jobs whose status
            changed during the pass
}

-- allium: 3
-- campaign-lifecycle.allium
--
-- Scope: Cloud instance lifecycle from launch through execution to termination
-- Includes: Campaign, Instance (Launch), grace period, R2 control plane,
--           provider abstraction, reconciliation, termination
-- Excludes:
--   - Job lifecycle (separate spec: job-lifecycle.allium)
--   - The economic launch decision contract — the cost+time objective,
--     grouping/reuse/count decisions, and the models that feed them — now
--     lives in launch-objective.allium; statistical estimator internals
--     (distributions, priors, decay constants, weight values) remain
--     implementation detail
--   - TUI/dashboard rendering
--   - Source syncing and output artifact collection
--   - Offer search and selection UI

use "./job-lifecycle.allium" as jobs

-- ==========================================================================
-- External entities
-- ==========================================================================

-- Cloud GPU provider (Vast.ai, RunPod, etc.)
external entity Provider {
    name: String        -- "vastai", "runpod"
}

-- A provider-level instance — weft creates and destroys these but does not
-- control the provider's internal state machine.
external entity ProviderInstance {
    provider_id: String
    status: created | creating | loading | running | exited | stopped | error | destroyed | dead
}

-- ==========================================================================
-- Value types
-- ==========================================================================

value OfferSnapshot {
    gpu_name: String
    num_gpus: Integer
    gpu_mem_gb: Decimal
    cost_per_hour_cents: Integer       -- total recurring rate at disk_gb, not a provider default disk size
    reliability: Decimal            -- 0.0–1.0
    dl_perf: Decimal
    data_center: String
    cuda_version: Decimal
    disk_gb: Integer
    download_mbps: Decimal
    upload_mbps: Decimal
    nvlink_bandwidth: Decimal?       -- null=not reported; zero=reported absence
    machine_id: String
}

enum TerminationReason {
    completed | provider_failure | job_failure
                        | disk_full | infra_failure | bootstrap_timeout
                        | canceled | phase_stall | preempted | unknown
                        | provider_timeout | upload_stall | weft_bug
                        | account_credit_exhausted
}

-- upload_stall: agent self-destructed after persistent R2 upload failures.
--               See upload-drain.allium for the gate that triggers it.
-- provider_timeout: provider create/destroy/show command exceeded its
--                   bounded timeout (typically a Vast.ai API hang).
-- weft_bug: reserved for internal invariant violations the agent detected.
-- account_credit_exhausted: the operator's provider account ran out of
--                   credit. Excluded from the survival model — these
--                   failures say nothing about the machine, SKU, or
--                   region. Applied retroactively by `weft instance
--                   mark-credit-exhausted` because the runtime-destruction
--                   case (provider destroys a running instance for
--                   non-payment) has no programmatic signal; the
--                   CreateInstance-time case still records provider_failure
--                   + detail until the call-site survey in
--                   docs/planning/ROADMAP.md is done.
--                   The `--auto` mode of mark-credit-exhausted heuristically
--                   identifies the incident window on a single provider by
--                   finding a mass-destroy burst followed by a silent gap
--                   (no same-provider instance reached running) until a
--                   recovery launch came up. Provider-scoped by construction:
--                   silence and recovery on one provider can never satisfy a
--                   burst on another. Bursts followed by quick recovery
--                   (regional outage) or by <90s of silence (transient
--                   cluster) are rejected and surfaced to the operator
--                   rather than reclassified. See internal/credit/incident.go.

-- AttemptOutcome classifies how a single Job attempt on a Launch ended.
-- "preempted" specifically indicates the attempt was running on an
-- interruptible launch that was relaunched after a stale pause. The
-- successor attempt's predecessor_attempt_id points back to it so
-- runtime-estimation queries can sum per-attempt durations across the
-- relaunch chain.
enum AttemptOutcome { completed | failed | canceled | orphaned | superseded | preempted }

enum InstanceRole { worker | donor }

-- Planner decision categories for an unplaced job in one autopilot pass.
enum PlannerDecision { launch | blocked }

value AutoPlacementPlan {
    launch_job_ids: List<String>         -- jobs the planner approved for launch
    blocked_reasons: Map<String, String> -- job_id -> human-readable block reason
    considered_job_ids: List<String>    -- all unplaced jobs examined this pass
}

-- ==========================================================================
-- Entities
-- ==========================================================================

-- A Campaign is a batch of cloud instances launched together.
entity Campaign {
    status: planned | launching | running | completed | failed | canceled
    created_at: Timestamp
    ended_at: Timestamp?
    estimated_cost_cents: Integer

    -- Machine anti-affinity (coverage). When distinct_machines is set, this
    -- campaign is a benchmark coverage set: each member job is one datapoint
    -- and no two successful datapoints may share a physical machine. Offer
    -- selection (CoverageOfferExclusion) and infra-failure replacement
    -- (CoverageReplacementResearchesOffer) exclude already-covered and
    -- in-flight machines — but NOT failed or boot-failed machines, whose
    -- hardware is left uncovered and therefore stays eligible. Vast.ai
    -- enforces this before provider create because offers expose machine_id;
    -- RunPod enforces it after pod create/readback because offers expose only
    -- GPU type before placement. See MachineAntiAffinityProviderSupport.
    distinct_machines: Boolean

    -- Operator-supplied physical machines to avoid, resolved to machine refs
    -- from `--avoid` tokens (a raw Vast.ai machine_id, an instance id, or a
    -- job id — see ResolveAvoidTarget). Instance/job tokens resolve to
    -- provider-qualified refs such as `runpod/<machine_id>`. Unioned into the
    -- offer-exclusion set and RunPod post-create acceptance check alongside
    -- the derived covered/in-flight sets. Used to repair, resume, or extend a
    -- coverage campaign.
    avoid_machines: List<String>

    -- Operator-supplied physical machines to require, resolved to provider
    -- machine_ids from `--affinity` tokens (a raw machine_id, an instance id,
    -- or a job id — see ResolveMachineAffinityTarget). Offer selection and
    -- reusable-instance assignment are restricted to these machines.
    affinity_machines: List<String>

    -- Relationships
    instances: Instance with campaign = this

    -- Derived
    active_instances: instances where status not in {completed, failed, canceled}
    is_terminal: status in {completed, failed, canceled}

    -- Jobs that have run on any of this campaign's instances, found via
    -- their attempts. A job requeued for relaunch has its current
    -- cloud_instance cleared, but the prior JobAttempt still links it
    -- here — so requeued jobs are included and keep the campaign open.
    -- Open move-target attempts are also visible in instance-scoped
    -- membership before the MoveIntent confirms. The canonical job view
    -- remains source-authoritative until acceptance, but instance views
    -- and diagnosis must show the destination attempt once it exists so
    -- raw agent phase such as running:<job_id> cannot appear detached
    -- from the launch that is actually executing it.
    -- Implementation: internal/campaign/reconcile.go allCampaignJobsTerminal,
    -- via db.GetLaunchJobsIncludingAttempts (launch_job_membership view).
    jobs: jobs/Job with attempts.any(a => a.cloud_instance in instances)

    -- Physical machines already COVERED by a successful datapoint: instances
    -- that hosted a completed member job. Failed and boot-failed instances are
    -- excluded by construction — their hardware is still uncovered. The
    -- machine identity is offer.machine_id.
    -- Implementation: the success+in-flight generalization of
    -- db.FailedMoveTargetMachineIDs — attempt -> launch -> machine_id join,
    -- scoped to the campaign and keyed on cloud_outcome = completed.
    covered_instances: instances where jobs.any(j => j.status = completed)

    -- Physical machines currently BEING covered: non-terminal instances in
    -- this campaign that have a resolved offer.machine_id. This closes the gap
    -- between the per-pass claim (OfferClaimInPassExclusion) and a replacement
    -- launched in a later pass against a refreshed offer pool.
    inflight_instances: instances
        where status not in {completed, failed, canceled}
          and offer.machine_id != null

    transitions status {
        planned -> launching
        planned -> running
        launching -> running
        launching -> completed
        launching -> failed
        launching -> canceled
        running -> completed
        running -> failed
        running -> canceled
        terminal: completed, failed, canceled
    }
}

-- An Instance (internally "Launch") is a single cloud GPU deployment.
entity Instance {
    -- Association
    campaign: Campaign?

    -- Provider
    provider: Provider
    provider_instance: ProviderInstance?

    -- GPU specification
    gpu_spec: String                -- user-specified GPU request
    gpu_class: String               -- resolved GPU class
    gpu_mem_gb: Integer             -- actual per-GPU memory from the offer, not the job constraint
    num_gpus: Integer
    resolved_gpu_name: String?      -- actual GPU name from offer
    docker_image: String

    -- Offer metadata (captured at launch, immutable)
    offer: OfferSnapshot

    -- Rental type and pricing (captured at launch, immutable)
    instance_type: on_demand | interruptible
    max_bid_price_cents: Integer?       -- bid paid; null for on-demand
    on_demand_ref_cents: Integer?       -- cheapest concurrent on-demand $/hr
                                        -- at launch for the same GPU class,
                                        -- for interruptible-savings analysis;
                                        -- null when the counterfactual search
                                        -- was unavailable or returned nothing

    -- Budgets
    max_spend_cents: Integer
    max_time_seconds: Integer
    actual_spend_cents: Integer

    -- Timestamps
    created_at: Timestamp
    ready_at: Timestamp?                -- provider instance ready
    launched_at: Timestamp?             -- weft marked it running
    ended_at: Timestamp?
    provider_running_at: Timestamp?     -- provider first reported running

    -- Data locality
    instance_role: InstanceRole
    donor_instance: Instance?           -- donor that seeded this worker
    seed_download_secs: Integer?        -- download time on donor
    seed_copy_secs: Integer?            -- copy-from-donor time on worker
    replaced_instance: Instance?        -- failed instance this one replaces

    -- Capacity
    -- disk_gb is the container disk weft requested for this instance
    -- (max of the per-instance request and the launch group's request),
    -- NOT the host machine's total disk advertised on the offer. Disk-full
    -- retry logic and offer re-filtering compare against this requested
    -- container disk; recording the host machine total here would cause
    -- consumers to overestimate capacity and retry on equally-undersized
    -- offers.
    disk_gb: Integer
    provisioned_inputs: List<String>    -- e.g. "hf:meta-llama/Meta-Llama-3-8B"

    -- Grace period
    grace_period_seconds: Integer       -- configured duration (0 = disabled)
    grace_started_at: Timestamp?
    grace_deadline: Timestamp?

    -- Termination
    termination_reason: TerminationReason?
    termination_detail: String?
    termination_requested_at: Timestamp?

    -- Cordon (drain): when true, autopilot/reuse skips this instance. The
    -- instance keeps running and its current job continues — only new
    -- placement is suppressed. Set/cleared via `weft cordon` /
    -- `weft uncordon` (or the canonical `weft instance cordon|uncordon`,
    -- or by pressing `C` on the selected job in the jobs-list TUI).
    cordoned: Boolean
    cordon_reason: String?
    cordoned_at: Timestamp?

    -- Result verification (set by the reconciler from the R2 completion
    -- manifest when an instance terminates completed). A false verdict has
    -- two causes, distinguished by results_verify_detail: a job's upload_status
    -- was not "ok" (uploads_incomplete), or the manifest omits a job the launch
    -- ran (manifest_missing_jobs). Coverage is keyed on launch membership
    -- (written at dispatch), not on credited cloud_outcome, so verification
    -- does not race per-job completion crediting from R2.
    results_verified: Boolean?          -- nil=legacy, true=ok, false=unverified
    results_verify_detail: String?      -- reason code when results_verified=false

    -- Relationships
    jobs: jobs/Job with cloud_instance = this

    -- Derived
    is_terminal: status in {completed, failed, canceled}
    has_grace: grace_period_seconds > 0
    -- legacy: grace_remaining: if grace_deadline != null then grace_deadline - now else null
    bootstrap_origin: provider_running_at ?? launched_at
    pause_tolerant: jobs.any(j => "interruptible" in j.tags)
    -- True when at least one job on this instance has direct evidence of
    -- having executed: a non-zero start_time stamped when the agent
    -- transitions the job to running. end_time alone is NOT sufficient:
    -- cancel/supersede paths stamp end_time without ever invoking the
    -- agent, including the supersede chains generated by
    -- tryPlaceOntoExistingInstances for dep-blocked or producer-missing
    -- jobs. Treating those as "started" silently disables the no-progress
    -- watchdogs (IdleAfterReadyTimeout and the provider-status-unavailable
    -- check) and lets a wedged instance burn cost indefinitely.
    -- Status alone is NOT a reliable proxy either: a job can reach a
    -- terminal status (e.g. canceled) at the job level before any
    -- execution begins — retry budget exhausted, attempt superseded, user
    -- cancel before bootstrap completed. Incident wi2349: 360+ canceled
    -- attempts with end_time but no start_time on wj1756 suppressed the
    -- watchdogs for the life of the launch. Accepted edge case: a job
    -- that completes faster than one sync tick may never have start_time
    -- observed, costing one extra watchdog cycle for that launch.
    has_started_job: jobs.any(j =>
        j.latest_attempt.start_time != null and j.latest_attempt.start_time > 0)
    is_retryable: termination_reason in {provider_failure, infra_failure,
                                          bootstrap_timeout, phase_stall,
                                          preempted, provider_timeout,
                                          upload_stall, account_credit_exhausted,
                                          unknown}

    -- Status
    --
    -- "paused" reflects a provider-side pause while the rental is still
    -- billable for storage: per-instance preemption (outbid spot), manual
    -- stop, or account-wide credit pause. Non-terminal — the reconciler
    -- waits up to stale_pause_timeout for the provider to resume.
    status: planned | launching | running | paused | grace | completed | failed | canceled

    transitions status {
        planned -> launching
        planned -> canceled
        launching -> running
        launching -> paused
        launching -> completed
        launching -> failed
        launching -> canceled
        running -> paused             -- provider stopped (preempted / account pause)
        running -> grace
        running -> completed
        running -> failed
        running -> canceled
        paused -> running             -- provider resumed the instance
        paused -> failed              -- stale_pause_timeout exceeded
        paused -> canceled
        grace -> running              -- jobs resubmitted during grace
        grace -> paused               -- provider/account pause during grace
        grace -> completed            -- resubmitted jobs all succeed
        grace -> failed               -- grace expired or released
        grace -> canceled
        terminal: completed, failed, canceled
    }
}

-- ==========================================================================
-- R2 control plane messages
-- ==========================================================================

-- Grace period control messages exchanged via R2 object storage
-- between Weft's local control path and the agent (cloud instance).

value GraceJobsRequest {
    jobs: List<jobs/Job>
    sources: List<String>
}

value GraceCommandAck {
    request_id: String
    accepted: Boolean
}

-- ==========================================================================
-- Configuration
-- ==========================================================================

config {
    offer_min_reliability: Decimal = 0.95
    default_grace_period: Duration = 5.minutes
    grace_poll_interval: Duration = 10.seconds
    grace_shutdown_timeout: Duration = 2.minutes
    bootstrap_warn_threshold: Duration = 15.minutes
    bootstrap_timeout: Duration = 20.minutes
    -- Setup-stall fallbacks, used when the setup survival curve has not
    -- learned thresholds for the command+workdir. Raised from 15/25 minutes
    -- after slow-but-progressing setups (large uv sync, multi-GB model
    -- downloads) were being false-killed. The raise was initially inert:
    -- instance_check.go assigned the survival struct's raw fields whenever
    -- one was present, so the unlearned defaults (15m/25m) shadowed these
    -- constants in the reconcile path. Enforcement now reads only learned
    -- values (SetupSurvival.LearnedWarn / LearnedTerminate), so these apply
    -- whenever nothing was learned.
    setup_stall_warn: Duration = 25.minutes
    setup_stall_timeout: Duration = 45.minutes
    -- Steady-state heartbeat staleness threshold. Raised from 3.minutes
    -- after observing setup-phase silences (high-RSS uv-sync /
    -- multi-GB HF download work) on instances that produced
    -- continuous heartbeats once they reached steady-state GPU work.
    -- Agents observed silent past 5 minutes have not been seen to
    -- recover in our data, so further extension would just delay
    -- declaring known-dead rentals.
    heartbeat_stale_threshold: Duration = 5.minutes
    -- Lenient threshold applied within heartbeat_early_life_window of
    -- agent_ready_at, when memory pressure from initial setup is most
    -- likely to stall the sidecar's R2 PUTs.
    heartbeat_stale_threshold_early_life: Duration = 8.minutes
    heartbeat_early_life_window: Duration = 15.minutes
    -- Running-task stall terminate threshold: trigger after an instrumented
    -- job's structured progress tuple has been unchanged for this long.
    -- Matches runningStaleTerminate in internal/campaign/status.go.
    running_stall_timeout: Duration = 60.minutes

    -- Hard cap for an OnStart chain that keeps restarting while continuing
    -- to refresh its stage marker.
    -- LEGACY FALLBACK, not the operative threshold. The cap normally rides
    -- the learned setup survival terminate threshold
    -- (SetupSurvival.TerminateAfter, computed per command+workdir by
    -- db.ComputeSetupSurvival); this constant applies when that curve has
    -- not learned a threshold — too little history, so TerminateLearned is
    -- false and the struct carries defaults. See
    -- effectiveOnStartTotalActiveTimeout in
    -- internal/campaign/instance_check.go.
    onstart_total_active_timeout: Duration = 25.minutes

    -- Default infrastructure-failure threshold for the unattended runaway
    -- breaker. Configured as campaign.auto_runaway_infra_failure_limit.
    runaway_infra_failure_limit: Integer = 5

    -- Dud-Vast detection. When Vast reports the rental as `running` but
    -- no OnStart probe has appeared in R2 after this many minutes, the
    -- container never actually started. Catches host-level binary
    -- failures (zombie offer, wedged docker daemon, image-pull block)
    -- well before the adaptive bootstrap deadline (often 90 min+) would.
    -- Bimodal observed distribution: probes either land within ~60s or
    -- never; an 8-minute window covers cold-image pulls without false-
    -- killing slow-but-progressing launches.
    -- Applies when the learned per-provider bootstrap survival curve has not
    -- learned a terminate threshold (TerminateLearned false). When it has,
    -- the dud window rides that threshold clamped to
    -- dud_vast_timeout_ceiling. See effectiveDudVastTimeout in
    -- internal/campaign/instance_check.go.
    dud_vast_timeout: Duration = 8.minutes
    -- Ceiling on the learned bootstrap survival terminate threshold when it
    -- stands in for dud_vast_timeout. Bounds a long-tailed
    -- bootstrap-COMPLETION quantile from redefining a probe-ARRIVAL window
    -- whose distribution is the bimodal one described above. See
    -- DudVastDetection.
    dud_vast_timeout_ceiling: Duration = 15.minutes
    -- How long after the provider reports `running` weft waits before
    -- asking the container whether its OnStart script was installed.
    -- Providers write the start script before starting sshd, so an
    -- SSH-reachable container has already had its script decided; this is
    -- insurance against one that orders those the other way. See
    -- OnStartScriptMissing.
    onstart_verify_grace: Duration = 2.minutes
    -- Hard bound on the verification SSH round trip: one attempt, killed at
    -- the deadline. An instance that cannot answer within it stays unknown,
    -- which is the safe verdict, and the next pass asks again. It must stay
    -- well under the fast cloud-sync budget or one unreachable instance in
    -- the dud window degrades every `weft list`.
    onstart_verify_timeout: Duration = 5.seconds
    -- How long a verdict of unknown suppresses re-asking the same instance.
    -- Unknown is the verdict that pays the full timeout, and a container
    -- still bringing up sshd has nothing new to say seconds later.
    onstart_verify_unknown_cooldown: Duration = 1.minute
    -- OnStart chain stall. When the OnStart probe HAS landed (so the
    -- container ran OnStart — dud_vast_timeout does not apply) but the
    -- OnStart stage marker then freezes on an in-progress install step
    -- (apt/uv/rclone) with no handoff to bootstrap.sh, the install hung.
    -- OnStart install steps normally finish in 1-3 min; a marker unchanged
    -- past this window is a hung mirror / failed install that will never
    -- reach bootstrap. Catches the gap between dud detection (no probe) and
    -- the bootstrap `failed:` marker (written only by bootstrap.sh). See
    -- OnStartChainWatchdog.
    -- LEGACY FALLBACK, not the operative threshold. The stall window
    -- normally rides the learned setup survival terminate threshold
    -- (SetupSurvival.TerminateAfter, computed per command+workdir by
    -- db.ComputeSetupSurvival); this constant applies when that curve has
    -- not learned a threshold (TerminateLearned false). See
    -- effectiveOnStartStallTimeout in internal/campaign/instance_check.go.
    onstart_stall_timeout: Duration = 10.minutes
    -- Maximum time an instance may sit with agent_ready_at set but no job
    -- yet started and no phase reported. See IdleAfterReadyTimeout.
    idle_after_ready_timeout: Duration = 15.minutes
    -- Maximum time a launch may sit in the paused state (provider "stopped")
    -- before we give up waiting for a provider resume and relaunch the jobs
    -- on a fresh offer. Applies to per-instance preemption AND account-wide
    -- pauses (e.g. credit exhaustion). Generous so a short outbid window or
    -- a brief credit top-up does not churn launches.
    stale_pause_timeout: Duration = 6.hours
    -- Catch-all wall-clock ceiling on the `launching` status when no
    -- bootstrap_origin has been recorded yet. See LaunchingPhaseTimeout.
    -- MUST exceed any provider-internal bootstrap context timeout so the
    -- launching goroutine's own cancellation normally fires first.
    --
    -- LEGACY FALLBACK, not the operative threshold. The launching-phase
    -- ceiling normally rides the learned per-provider bootstrap survival
    -- terminate threshold (BootstrapSurvival.TerminateAfter, computed by
    -- db.ComputeBootstrapSurvival); this constant applies when that curve
    -- has not learned a threshold (TerminateLearned false). See
    -- effectiveLaunchingPhaseTimeout in
    -- internal/campaign/instance_check.go.
    --
    -- Calibration: RESTATED 2026-08-18 against n=4270. The original
    -- reading (~1500 launches; p99 <= 2 min, max 6.2 min, "zero launches
    -- ever exceeded 10 min from create to status=running") no longer
    -- holds. Current launched_at->provider_running_at: vast.ai p50 1.9
    -- min, p90 5.7 min, p99 23.0 min; RunPod p50 0.8, p90 4.7, p99 25.8.
    -- 5.0% of vast.ai launches now exceed 10 minutes and go on to run.
    -- Pre-running provisioning is therefore NOT fast-or-never, and any
    -- constant in this family tuned against the old reading is too tight.
    -- 12 min sits near p95; the learned threshold is what keeps it from
    -- false-killing, which is the reverse of the original rationale.
    -- The earlier objection — that an adaptive threshold would converge
    -- near p99 (~2 min) and false-kill the rare 3-4 min legitimate
    -- launch — does not apply to the survival threshold actually used:
    -- its terminate value is floored at 5 min and defaults to 20 min
    -- when samples are insufficient, so relative to the p99 concern the
    -- learned value can only lengthen this window, never shorten it
    -- toward ~2 min. The 12-minute constant survives as the fallback.
    launching_phase_timeout: Duration = 12.minutes

    -- Hedge configuration. When enabled, the autopilot launches `count`
    -- instances on distinct offers per group; once any of them reaches
    -- agent_ready, the others are culled. Trades a small extra spend
    -- on probe launches for far higher launch survival on flaky
    -- provider classes. The relaunch loop spawns probes alongside the
    -- primary; the cull rule (HedgeCohortCull) enforces single-survivor.
    -- See SearchTopKOffersForGroup, launchHedgeProbes, and
    -- LaunchOpts.HedgeProbe for the launch-path wiring.
    hedge_enabled: Boolean = false
    hedge_count: Integer = 3
    hedge_max_cost_per_hour: Number = 0.25

    self_destruct_linger_threshold: Duration = 2.minutes
    self_destruct_unknown_end_fallback: Duration = 3.minutes
    self_destruct_retries: Integer = 3
    self_destruct_backoff: Duration = 5.seconds
    reconcile_cleanup_window: Duration = 30.minutes

    -- Minimum age of a launch left in 'planned' status with no provider
    -- instance ID before it is reaped as abandoned. A normal LaunchInstance
    -- call transitions through planned within seconds; a row older than
    -- this threshold means the call returned before the provider instance
    -- was ever created (provider error, asset staging failure, panic, etc.)
    -- and the row was left orphaned. Generous so a legitimately slow
    -- planned -> launching transition never trips the reaper, but short
    -- enough that orphans don't block CampaignCompleted/CampaignFailed
    -- for long.
    stale_planned_launch_age: Duration = 24.hours

    -- Runaway breaker thresholds
    runaway_enabled: Boolean = true
    runaway_lookback_window: Duration = 24.hours
    runaway_chain_no_progress_limit: Integer = 3
    runaway_orphan_churn_limit: Integer = 8
    runaway_spend_no_progress_limit_cents: Integer = 500
    runaway_resume_grace_period: Duration = 15.minutes
    runaway_auto_probe_interval: Duration = 1.hour
}

-- ==========================================================================
-- Launch rules
-- ==========================================================================

-- Provider offer searches enforce config.offer_min_reliability as a hard floor
-- during candidate discovery. Setting it to 0 disables this filter.
--
-- GPU-class matching during offer search must normalise case and punctuation
-- on BOTH the provider's machine-readable gpuId and its human-readable
-- displayName, and succeed when either matches the user-supplied class
-- (e.g. "a100-sxm4-80gb" against a displayName of "A100 SXM4 80GB").
-- Implementation: internal/runpod/client.go offer discovery.

-- Vast.ai provider search must NOT constrain `gpu_frac` (the fraction of the
-- host's GPU pool included in this offer). Doing so excludes every multi-GPU
-- host family (A100, H100 SXM, etc.), since per-GPU offers on those hosts
-- report gpu_frac well below 1.0 (e.g. 0.125 on an 8x A100 machine). The
-- desired GPU count is already expressed via num_gpus; gpu_frac is a
-- host-topology artefact, not a placement constraint.
-- Implementation: internal/vastai/client.go buildSearchFilter.
-- Regression: internal/vastai/client_test.go TestBuildSearchFilter_NoGPUFrac.

-- CUDA / driver floors are hard compatibility requirements when a provider
-- reports enough metadata to evaluate them. Floors come from five sources,
-- merged via imagereq.Merge (max wins):
--   1. Project [cloud] min_driver / min_cuda in .weft.toml
--   2. PEP 723 [tool.weft] cuda-driver-min (legacy synonym: min-cuda)
--   3. CLI --cuda-driver-min on `weft run` (stored on CLIResourceOverrides)
--   4. Auto-derived from a project's torch pin via TorchMinCUDAVersion —
--      reads the cuXXX wheel tag from uv.lock or [tool.uv] index URLs
--   5. Auto-derived from inline library deps (uv run --with X and PEP 723
--      top-level `dependencies = [...]`) when a known library version pin
--      implies a stricter CUDA floor than the project lockfile would. Catches
--      the case where `--with "vllm>=0.17"` resolves a fresh stack at runtime
--      that the project's locked torch does not reflect.
-- Image metadata (NVIDIA_REQUIRE_CUDA from the Docker image) is also merged.
-- After all merges, the driver floor is back-filled from the CUDA floor via
-- the NVIDIA Linux x86_64 CUDA→driver table (12.0→525, 12.4→550, 12.6→560,
-- 12.8→570, 12.9→575, 13.0→580) whenever the CUDA floor is set but the driver
-- floor is zero. Required because auto-selected pytorch/* and nvidia/* base images
-- bypass image-label fetching (shouldFetchImageRequirements skip-list); a
-- non-zero driver floor from any other source is never overwritten.
-- A pyproject.toml range such as torch>=2.5 is NOT a torch pin, and a uv.lock
-- merely existing is NOT proof the resolved torch wheel's driver floor is
-- knowable: a lock can record torch as a CPU/macOS wheel, or in a CUDA runtime
-- family the scanner does not recognize, exposing no cuXXX variant. For cloud
-- auto-placement, submit must reject GPU-requesting torch-using projects for
-- which weft can derive no CUDA wheel variant (hence no driver floor) from any
-- source — whether uv.lock is missing OR present-but-variantless — because the
-- resolver can then pick a newer CUDA wheel on the rental than weft gated on,
-- surfacing only at the post-`uv sync` torch preflight after full rental spend.
-- The reject is scoped to jobs that request a GPU (gpu_class / gpu_mem_gb /
-- gpu_count set via CLI flag or PEP 723 [tool.weft] metadata): only those
-- consume a GPU rental where a driver floor is enforced. A no-GPU / CPU-only
-- job is CPU-placed, where the driver floor is moot (CPU hosts satisfy GPU
-- floor checks vacuously), so it is exempt — e.g. an API-only PEP 723 script
-- (openai-only, run with `uv run --no-project`) that merely lives in a torch
-- repo whose lockfile pins a CPU/macOS wheel. Users can submit a GPU job after
-- running uv lock with a CUDA-specific torch wheel, pinning torch exactly with
-- a CUDA-specific [tool.uv] index or explicit cuda-driver-min, or targeting an
-- explicit host.
-- Implementation: cmd/run.go rejectUnlockedTorchCloudRuntime;
-- internal/dataloc/torch_pin.go ScanTorchPin / ScanPyprojectTorchRequirement.
-- Vast.ai offers are filtered at search time with driver_version/cuda_vers
-- predicates. Providers that do not expose driver or CUDA compatibility for
-- search results (currently RunPod) are compatibility-unknown: they must lose
-- to any known-compatible offer, but may still be selected if no
-- known-compatible offer exists. This fallback is intentionally scored as
-- very risky, not treated as proven compatibility.
-- Implementation: internal/campaign/campaign.go ResolveJobImageSettings
-- (sources 1, 2, 4, 5 + back-fill) and SplitGroupsByImage (source 3);
-- internal/dataloc/library_cuda.go (source 5 lookup table);
-- internal/imagereq/imagereq.go (Merge, MinDriverForCUDA, BackfillDriverFromCUDA);
-- internal/campaign/offers.go provider compatibility penalty.

-- Image auto-selection (reached only when no image is pinned by the script,
-- [cloud.image-overrides], or [cloud] image) follows WHICH ENVIRONMENT will
-- import torch, not merely whether the project depends on it:
--   * The project uv env owns torch when the project declares CUDA packages
--     AND the script neither sets [tool.weft] isolated nor declares its own
--     PEP 723 torch/CUDA dependencies. A preinstalled pytorch/pytorch image
--     only helps the env that actually imports torch, so only then is one
--     selected.
--   * A PEP 723 script with inline `dependencies = [...]` resolves on the
--     worker into an isolated uv env, so the project lockfile's torch pin
--     describes an env the job never imports. Those jobs get an nvidia/cuda
--     base image at the resolved CUDA floor instead.
-- The image's CUDA version comes from the merged floor above rather than a
-- separately re-derived project pin. Deriving it twice is what allowed weft to
-- select an offer for one CUDA version and provision an image built for
-- another (a vllm==0.19.1 PEP 723 script in a torch+cu124 project: floor 12.8,
-- image pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime).
-- The GPU-constraint upgrade below is skipped only when a RESOLVED project
-- torch wheel pin governs the runtime env, because only a resolved wheel is
-- bound to a CUDA runtime and cannot be moved to a newer one. A bare version
-- range (torch>=2.6, or a lock exposing no CUDA variant) is a minimum rather
-- than a pin and does not suppress the upgrade: gating on "the project env
-- owns torch" instead would strand a Blackwell group on a CUDA 12.4 image.
-- The upgrade preserves the image family: an auto-selected torch project is
-- already on a pytorch/pytorch image, and an explicitly pinned base image
-- stays a base image rather than being swapped to pytorch/pytorch.
-- The devel/runtime variant follows the dependency floors: a library that
-- JIT-compiles kernels at run time needs nvcc and selects a -devel image
-- (vLLM/flashinfer); everything else takes -runtime.
-- Version lookup selects the smallest tabled image version >= the required
-- CUDA WITHIN the same major and refuses across majors, consistent with
-- ImageToolkitWithinDriverMajor below. An unmapped floor such as 12.7 takes
-- the 12.8 image rather than falling back to the CUDA 12.4 default.
-- Implementation: internal/campaign/imagecompat.go (torchCUDAImages,
-- nvidiaCUDAImages, lookupCUDAImage); internal/campaign/campaign.go
-- SplitGroupsByImage; internal/placement/effective_runtime.go
-- (RuntimeFloor.ProjectEnvOwnsTorch / NeedsDevel, scriptOwnsCUDAEnv);
-- internal/dataloc/library_cuda.go LibraryNeedsDevelFromDeps.
-- Regression: internal/campaign/campaign_test.go
-- TestSplitGroupsByImage_ScriptDepsOwnCUDAEnv,
-- TestSplitGroupsByImage_IsolatedScriptSkipsProjectPin,
-- TestSplitGroupsByImage_InferMinCUDAFromScriptTorchRange,
-- TestSplitGroupsByImage_UnresolvedProjectPinStillUpgrades,
-- TestSplitGroupsByImage_ResolvedProjectPinBlocksUpgrade.

-- Unknown-compatibility offers (providers that do not expose driver_version
-- or cuda_max_good at offer search, currently RunPod) are hard-excluded from
-- the candidate set whenever at least one known-compatible offer survives.
-- The 10^9 score penalty in compatibilityScorePenalty remains as a
-- tiebreaker for the fallback path when no known-compatible offer exists.
-- Implementation: internal/campaign/offers.go filterOffersByProviderCompatibility.

-- The floor-merge and back-fill prose above resolves WHERE the requirements
-- come from. This contract states the single end-to-end constraint that
-- every enforcement point checks for a placed job, so the chain cannot
-- silently break at one link while the others pass (wb23 asked for exactly
-- this reconciliation; wb30/wb32/wb35/wb36 were independent breakages of
-- individual links).
contract CUDACompatibilityChain {
    cuda_floor: (job: Job) -> String?        -- merged CUDA floor: torch wheel /
                                             -- library dependency floors, fetched
                                             -- image-label requirements
                                             -- (NVIDIA_REQUIRE_CUDA), and explicit
                                             -- cuda-driver-min overrides
    min_driver_major: (job: Job) -> Integer? -- driver-major form of the floor:
                                             -- direct min-driver / min_driver,
                                             -- or back-filled from cuda_floor
                                             -- via the toolkit table
    image_toolkit: (job: Job) -> String?     -- CUDA toolkit version of the
                                             -- resolved Docker image tag
    driver_cuda: (target) -> String?         -- max CUDA the target's NVIDIA driver
                                             -- reports (nvidia-smi header on-prem,
                                             -- cuda_max_good on cloud offers,
                                             -- recorded CUDAVersion on reusable
                                             -- instances)
    driver_major: (target) -> Integer?       -- target's NVIDIA driver major

    -- legacy annotation: @invariant FloorWithinDriverCUDA
        -- cuda_floor(job) <= driver_cuda(target) for the target a job is
        -- placed on. Violation is the wb32/wb36 failure class: torch loads,
        -- reports "NVIDIA driver too old", and silently falls back to CPU.

    -- legacy annotation: @invariant FloorWithinDriverMajor
        -- min_driver_major(job) <= driver_major(target). Integer form of
        -- the same floor. If this floor was back-filled from cuda_floor,
        -- regardless of how cuda_floor was set, a recorded driver_cuda(target)
        -- fact covers the driver axis: a satisfying driver_cuda discharges the
        -- derived driver-major floor, and a too-low driver_cuda violates
        -- FloorWithinDriverCUDA instead. Direct user driver floors
        -- (min-driver / min_driver) are never discharged this way. Where only
        -- the driver major is observable, the integer check still binds
        -- directly (agent bootstrap probe; manifest.RequiredDriverMajor).

    -- legacy annotation: @invariant ImageToolkitWithinDriverMajor
        -- major(image_toolkit(job)) <= major(driver_cuda(target)). A
        -- cross-major image (CUDA 13 image on a driver whose max CUDA is
        -- 12.x) cannot run. WITHIN one major the image toolkit is
        -- deliberately NOT compared against the driver or the floor: CUDA
        -- minor-version compatibility lets a newer same-major toolkit run
        -- on older drivers, and wheels bundle their CUDA user-space
        -- libraries, so an image tag below the dependency floor is not
        -- proof the job cannot run. Asserting image_toolkit >= cuda_floor
        -- was the wb30 over-strictness (a pinned CUDA 12.4 image rejected
        -- under a 12.5 floor that the driver satisfied).

    -- legacy annotation: @invariant OneComparatorAtEveryEnforcementPoint
        -- Every enforcement point evaluates its links of this chain through
        -- compat.ValidateCUDAChain (internal/compat/cudachain.go) — one
        -- comparison function, one semantics — rather than ad hoc pairwise
        -- version compares. Enforcement points:
        --   1. Submit/launch-time floor resolution + cloud offer filtering:
        --      campaign.ResolveJobImageSettings / SplitGroupsByImage build
        --      cuda_floor; campaign.offerCompatibilityStatus validates it
        --      (plus image_toolkit) against each offer's cuda_max_good.
        --   2. Instance reuse: campaign.matchInstanceTargetEligibility calls
        --      placement.EvaluateEligibility to validate cuda_floor and
        --      min_driver_major against recorded launch facts. A derived
        --      driver floor can be covered by the recorded CUDAVersion fact;
        --      if neither driver_version nor CUDAVersion is recorded, or if
        --      the floor is a direct driver-version floor, reuse fails closed.
        --   3. On-prem host eligibility: inventory-placement.allium
        --      EvaluateEligibility clauses 5a/5b (compat.Check on the same
        --      CUDA/driver axes with the same comparator and the same
        --      derived-driver refinement; direct driver floors and both-facts-
        --      missing targets fail closed).
        --   4. Agent bootstrap driver probe: cmd/agent checkDriverVersion
        --      validates min_driver_major against the probed driver major
        --      before accepting any job (prose below).
        --   5. Torch CUDA preflight: behavioral enforcement — it asserts
        --      the chain end-to-end by actually initializing CUDA on the
        --      assigned device before the user command (prose below). It
        --      compares no versions; it is the ground-truth check the
        --      version links approximate.
	        -- Missing-value policy stays site-specific by design: on-prem
	        -- placement and instance reuse fail closed when the required fact is
	        -- unrecorded and no recorded CUDA compatibility fact can cover a
	        -- derived driver floor, offer filtering routes unknown-compat
	        -- providers through its fallback, and the agent probes fail open
	        -- when nvidia-smi is unavailable (CPU instances).
}

-- Defense in depth: the agent runs a driver probe at instance bootstrap,
-- after the disk-cap check and before accepting any job. It queries
-- nvidia-smi --query-gpu=driver_version, parses the major version, and
-- compares against CampaignManifest.RequiredDriverMajor (populated from
-- group.MinDriverVersion at launch time). On insufficient driver, it
-- uploads a structured failure report to R2 and self-destructs the
-- instance with infra_failure rather than running the full ~3-5 minute
-- setup before vLLM/torch hits the runtime driver check. Catches the
-- fallback path where weft selected an unknown-compat (RunPod) offer
-- whose driver turned out to be too old, and is a safety net for cases
-- where the provider's advertised driver/CUDA fields don't match the
-- actual host capability. When the required major is 0 (no floor) or
-- nvidia-smi is unavailable / unparseable, the probe is a no-op (avoids
-- blocking CPU-only instances and parse-fragile drivers).
-- Implementation: cmd/agent/driver_version_probe.go checkDriverVersion;
-- cmd/agent/runinstance.go (call site after checkDiskCap);
-- internal/cloud/wrapper.go CampaignManifest.RequiredDriverMajor;
-- internal/campaign/lifecycle.go (manifest population).

-- Defense in depth after setup: when a job has been assigned CUDA devices and
-- the project uses torch, the agent must run a torch CUDA preflight before the
-- user command. The preflight is fail-closed: it must require
-- torch.cuda.is_available(), initialize CUDA, and execute a tiny CUDA operation
-- on the assigned device. If any step fails, the job fails in setup with a
-- stage-specific diagnosis instead of silently running the user script on CPU.
-- Runner-owned output markers distinguish failure before Python starts, during
-- torch import, and after torch imports when the CUDA probe runs. Only the last
-- class is infrastructure-side: dependency resolution, interpreter selection,
-- and torch import belong to the job environment and must not trigger rental
-- replacement or machine avoidance. A CUDA-stage failure terminates the
-- instance as infra_failure, resets the job to the queue, and lets autopilot
-- place it on a fresh instance.
--
-- Bounded recovery: a job may be auto-requeued for at most three distinct
-- instance launches that fail torch preflight. After the third distinct
-- instance, the job remains failed with a user-visible explanation that the
-- instance pool appears to have broken CUDA for this workload.
--
-- Machine avoidance: when provider machine identity is known, re-placement of
-- the same job excludes physical machines that already failed its torch
-- preflight. This prevents bouncing between offers on the same bad GPU.
-- Implementation: internal/runner/torch_preflight.go runTorchPreflight;
-- internal/runner/single.go (call site before user command);
-- internal/db/failure_modes.go ClassifyInfraFailure(PhaseTorchPreflightCUDA);
-- internal/db/cloud_instances.go ResetLaunchJobs cap logic;
-- internal/db/placement_transitions.go FailedTorchPreflightMachineIDs.

-- Auto-relaunch must classify per-group offer outcomes by error first,
-- not by Offer == nil first. A failed provider search returns Offer = nil
-- AND Err != nil; checking Offer == nil before Err mis-classifies provider
-- failures (CLI exit, network) as "provider search returned 0 offers" with a
-- FilterStats-derived detail that is empty/misleading. Required event kinds:
--   * relaunch.skipped.no_offers   — provider returned 0 candidates
--   * relaunch.skipped.offer_error — provider call itself failed
-- Implementation: internal/campaign/relaunch.go (Err checked before Offer).

-- A non-empty provider result that becomes empty after local filtering must
-- report the concrete rejecting constraint(s), not merely say that offers
-- passed filters or that no launch path was found. When different offers are
-- eliminated at different stages, the reason reports that no offer met all
-- requirements and summarizes every stage that rejected a candidate (for
-- example VRAM, hourly-rate cap, and survival floor). Threshold diagnostics
-- include the closest rejected value where available.
--
-- This analysis stays within the candidate set returned for the requested
-- InstanceGroup. It must not relax GPU family, provider, geography, topology,
-- or other identity constraints to cite unrelated market inventory as a near
-- miss. An L4 request therefore never cites an H100 merely because the H100
-- satisfies a rate or survival threshold.
-- Implementation: internal/campaign/offers.go OfferFilterStats.NoOffersDetail.

-- On-demand diagnosis is a separate, explicitly counterfactual surface.
-- `weft diagnose job` first repeats the exact live-market request, then may
-- relax one active non-GPU-identity constraint at a time. It reports a probe
-- only when the relaxation admits a viable offer or exposes additional
-- candidates that another requirement still rejects. This distinguishes, for
-- example, reliable offers over the rate cap from cheap offers below the
-- survival floor, and can expose excess provider/machine/CPU/RAM pinning.
-- Every probe MUST retain the original GPUClass; it does not relax geography,
-- topology, interconnect, or GPU count. Counterfactual probes are read-only and
-- never alter the job or placement policy. The TUI and Weft Status invoke this
-- same CLI surface on demand rather than duplicating placement logic.
-- Implementation: internal/campaign/placement_diagnosis.go;
-- cmd/job_placement_diagnose.go; internal/ui/terminal/list_tui_keybindings.go.

-- R2 source-tarball upload failures must be isolated per-group, not
-- bubbled as a single error that fails the whole relaunch pass. Each
-- InstanceGroup has its own source directory; one project exceeding the
-- MaxSourceTarballBytes limit (or any other per-dir upload error) must
-- record a blocked reason against only that group's jobs (via
-- recordGroupReasons → JobReasons), not against unrelated jobs sharing
-- the same pass. The agent binary upload remains a fatal outer error —
-- without an agent no group can launch.
-- Implementation: PrepareR2AssetsPerDir / R2AssetStager.AwaitAllPerDir
-- in internal/campaign/lifecycle.go; per-group filtering in
-- internal/campaign/relaunch.go before the launch loop.

-- --------------------------------------------------------------------------
-- Dependency-gated launch selection
-- --------------------------------------------------------------------------

-- A job's `dep_spec` (set by `--after` / `--after-any` at submission) acts as
-- a placement gate for rental launches. The gate is NOT a co-location
-- constraint — dependent jobs may land on different instances with different
-- GPU specs. It is a "not yet" signal: the downstream job is invisible to
-- the launch selector until its upstream terminates.
--
-- Separately, a job's `needs` (set by `--needs` at submission, see
-- job-lifecycle.allium) is a data dependency, not a placement gate. At
-- launch time the placement classifier inspects each referenced producer's
-- current state: if the producer is live on a reusable rental instance the
-- consumer is co-located there (and the agent gates the consumer on
-- producer success via cloud_after). The consumer should be assigned to the
-- producer's rental queue so it starts automatically after the producer
-- completes, without another autopilot pass. If no live reusable producer
-- rental exists, the classifier emits cloud_needs so the producer's outputs
-- are staged from R2 onto the consumer's fresh instance. Users who require
-- the producer to finish before the consumer can run must combine `--needs`
-- with `--after`.
--
-- Semantics by dependency mode:
--   --after (strict):    upstream must be Completed with exit_code = 0
--   --after-any:         upstream must be terminal (any status)
--
-- Rationale: lets a cheap prep job gate an expensive GPU job without forcing
-- both onto one instance, and prevents silent ordering violations when
-- chained `--after` jobs would otherwise fan out to parallel rentals.

rule DependencyGatesRentalLaunch {
    when: RentalLaunchSelection(unplaced_jobs) or AutoPilotTick(unplaced_jobs)

    for job in unplaced_jobs where job.dep_spec != null:
      for dep in ParseDepSpec(job.dep_spec):
        let upstream = Job(dep.job_id)
        if dep.allow_failure:
          -- --after-any: gate clears on any terminal status
          requires: upstream.is_terminal
                    -- legacy: else job is excluded from this launch pass
        else:
          -- --after (strict): gate clears only on success
          requires: upstream.status = completed and upstream.exit_code = 0
                    -- legacy: else job is excluded from this launch pass

    -- legacy annotation: @guidance
        -- Implementation: internal/queueblock/job_dependency.go
        -- parses and evaluates jobs.dep_spec. Enforcement points are:
        -- manual rental launch in cmd/instance_launch.go; relaunch
        -- fresh-instance eligibility in internal/campaign/relaunch.go;
        -- the relaunch reuse pass in internal/campaign/relaunch.go;
        -- autopilot reuse-fill in internal/orchestration/autopilot.go;
        -- and the pre-claim rental submission backstop in
        -- internal/campaign/reuse.go.
        -- The per-host queue on on-prem instances honors dep_spec on its
        -- own; this rule is specifically about keeping unsatisfied
        -- dependencies out of the rental-launch selection set so they do
        -- not get scheduled onto independent cloud instances that cannot
        -- coordinate queue ordering with each other.
        -- Deferred jobs are re-evaluated on the next launch pass.
}

rule StaleCloudAfterPinsAreReconciled {
    when: EvaluateStaleCloudAfterPinsAreReconciled()

    -- Legacy body retained as migration guidance:
    -- when: AutoPilotTick(database)

    -- for consumer in jobs:
    -- requires: consumer.status = queued
    -- and consumer.start_time = null
    -- and consumer.launch_id != null
    -- and consumer.metadata.dependencies.resolved_cloud_after != null
    -- for pin in consumer.metadata.dependencies.resolved_cloud_after:
    -- let producer = Job(pin.job_id)
    -- legacy: if producer is readable
    -- and (
    -- legacy: producer.latest_run_id != null
    -- legacy: and producer.latest_run_id != pin.run_id
    -- legacy: or producer.launch_id != consumer.launch_id
    -- legacy: ):
    -- ensures: ResetJobToUnplaced(consumer)
    -- legacy: ensures: next AutoPilotTick does not select the same consumer row

    -- legacy annotation: @guidance
    -- wb59 recorded repeated cases where a same-instance `--needs`
    -- consumer was classified into a CloudAfter ref with the producer's
    -- then-current LatestRunID, then the producer attempt changed before
    -- the consumer started. The agent probes exactly
    -- r2keys.JobAttemptComplete(producer_job_id, pinned_run_id); when
    -- the producer runs under a newer attempt, that old marker never
    -- appears and the consumer skip-fails as cloud_after_incomplete.
    --
    -- Event-driven resets are still useful latency optimizations. The
    -- move acceptance paths call ResetStrandedCloudAfterConsumers as soon
    -- as a producer leaves the source instance. They are not sufficient
    -- as the only correctness mechanism because they require every
    -- producer run/placement churn site to remember the hook; wb59's
    -- partial fix covered successful move churn but missed same-launch
    -- orphan/retry churn.
    --
    -- Launch assembly must persist the resolved attempt pin separately
    -- from submit-time dependency semantics:
    --   * metadata.dependencies.cloud_after / cloud_needs describe the
    --     user's logical dependency and are carried forward by
    --     carryForwardDependencyMetadata so host sync and later attempts
    --     still know the submission semantics.
    --   * metadata.dependencies.resolved_cloud_after describes the
    --     concrete producer attempt shipped to one agent manifest and is
    --     not carried forward to a later attempt.
    --
    -- Be careful with the overloaded name "CloudAfter":
    -- metadata.dependencies.cloud_after is the submit-time --after /
    -- --after-any ordering gate, including AllowFailure for --after-any.
    -- cloud.CloudAfterRef is the agent-manifest same-instance --needs
    -- attempt pin. Current --needs syntax has no failure-tolerant variant,
    -- so same-instance classification does not propagate the metadata
    -- AllowFailure field.
    --
    -- The reconciler may reset only on positive mismatch evidence. A
    -- missing resolved pin, unreadable producer row, or producer with an
    -- unknown current attempt is an unknown state, not evidence that the
    -- consumer should be disrupted. A producer still running under the
    -- pinned run on the same launch is current and must not be selected.
    --
    -- Convergence is mandatory: after ResetJobToUnplaced the consumer no
    -- longer has the same launch-bound queued attempt, so the same
    -- predicate is false on the next tick. The next placement pass
    -- reclassifies against the producer's current run if co-location
    -- still applies.
    --
    -- Implementation: internal/campaign/needs_classify.go builds
    -- cloud.CloudAfterRef; internal/campaign/lifecycle.go and
    -- internal/campaign/reuse.go persist resolved_cloud_after during
    -- manifest assembly; internal/campaign/stranded_cloud_after.go
    -- ReconcileStaleCloudAfterPins performs the autopilot backstop.
}

rule SameInstanceCloudAfterConstrainsManifestOrder {
    when: EvaluateSameInstanceCloudAfterConstrainsManifestOrder(consumer, job, jobs, manifest, ref) -- legacy: a rental manifest or grace jobs request contains multiple jobs

    for consumer in manifest.jobs:
      for ref in consumer.cloud_after:
        let producer = manifest.jobs.find(job.id = ref.job_id)
        -- legacy: if producer exists and producer.id != consumer.id:
          ensures: manifest.index(producer) < manifest.index(consumer)
          -- legacy: ensures: priority ordering does not place consumer before producer

    -- legacy: ensures: manifest order begins from the path's preferred scheduling order
    -- legacy: ensures: only same-payload CloudAfter producer traversal can move one
             -- legacy: payload job ahead of another payload job

    -- legacy annotation: @guidance
        -- Same-instance `--needs` edges are shipped to the agent as
        -- CloudAfter refs. The rental agent dispatches manifest jobs
        -- sequentially in manifest order; cmd/agent/jobloop.go
        -- checkCloudAfter probes the producer's R2 completion marker before
        -- the consumer starts. A consumer that appears earlier than its
        -- same-payload producer deterministically skip-fails with
        -- cloud_after_incomplete even when the dependency would succeed if
        -- the producer ran first.
        --
        -- Manifest assembly first applies the path's scheduling preference,
        -- then applies a stable topological adjustment over only
        -- same-payload CloudAfter refs. Reuse and move submission therefore
        -- preserve db.SchedulingLess priority-descending order except where
        -- a producer-before-consumer edge is present. Fresh launch preserves
        -- its ID-ascending submission order, with the same adjustment making
        -- the dependency invariant explicit.
        --
        -- Degenerate refs cannot repair dependency semantics by ordering:
        -- refs to jobs outside this payload and self-refs impose no manifest
        -- order; duplicate refs collapse to one edge. If same-payload refs
        -- contain a cycle, there is no satisfying order. The dependency walk
        -- emits each job once as traversal completes, so the manifest never
        -- hangs or silently drops jobs.
        --
        -- Implementation: internal/campaign/manifest_order.go
        -- orderAgentJobsForManifest performs the stable adjustment.
        -- internal/campaign/reuse.go calls it before writing
        -- controlplane.GraceJobsRequest. internal/campaign/lifecycle.go calls
        -- it after the fresh-launch ID sort and before GPU slot assignment.
}

-- --------------------------------------------------------------------------
-- Provider credit gate
-- --------------------------------------------------------------------------

-- A provider's create-instance endpoint is unreachable in a structural sense
-- when the authenticated account is out of credit. Vast.ai surfaces this
-- specifically as an empty HTTP body (not a structured error), which the
-- raw provider client wraps as ErrProviderRejected — but retrying against
-- another offer of the same provider will not help. Without a gate, every
-- autopilot pass mints a fresh failed-instance row per rental-scope job,
-- pollutes the failure list, and seeds the survival model with non-signal
-- noise that has to be filtered out retrospectively. The survival query
-- in internal/bidding/build.go excludes outcomes via two layers: the
-- structured TerminationReason value account_credit_exhausted (preferred,
-- written retroactively by `weft instance mark-credit-exhausted`), and a
-- termination_detail substring filter
-- ("%provider returned empty response%" / "%insufficient balance%" /
-- "%account credit%") that remains as a safety net for legacy rows where
-- CreateInstance failures recorded provider_failure + detail. Both layers
-- stay in place until the call-site survey described in
-- docs/planning/ROADMAP.md routes CreateInstance-time failures through
-- the structured reason.
--
-- The gate is a pre-launch guard: before calling RelaunchOrphanedJobs the
-- autopilot probes each enabled provider's account balance and, when every
-- enabled provider is exhausted, short-circuits with a blocked reason that
-- names the cause and prompts the operator to top up.

rule ProviderCreditGate {
    when: EvaluateProviderCreditGate() -- legacy: AutoPilotTick(unplaced_jobs) with rental_scope nonempty

    let statuses = CheckProviderCreditHealth(enabled_providers)
    -- legacy: if every status in statuses has status.exhausted = true:
        -- legacy: ensures: rental launch is skipped this pass
        -- legacy: ensures: each job in rental_scope receives blocked_reason of the form
                 -- legacy: "<provider> credit exhausted ($<balance>) — top up before
                 -- legacy: instances can launch"

    -- legacy annotation: @guidance
        -- Threshold: balance <= $0 is treated as exhausted. The wider
        -- "credits low" UI warning ($10 default) is a soft operator signal
        -- and is intentionally NOT applied as a hard gate — credit between
        -- $0 and the warning threshold is still spendable.
        --
        -- Probe failures (network errors, transient provider API hiccups)
        -- are treated as "unknown, attempt anyway" so a momentary outage
        -- of the user endpoint does not block the queue.
        --
        -- The provider client must also translate empty-response and
        -- "account lacks credit" failures from CreateInstance to the
        -- ErrAccountCreditExhausted sentinel, so the truthful cause
        -- surfaces from any caller — manual instance launches, direct
        -- campaign launches, future schedulers — not only the autopilot.
}

rule PriceAuthorizationGate {
    when: EvaluatePriceAuthorizationGate() -- legacy: LaunchInstance(group) evaluates a candidate cloud Offer
          -- legacy: (initial offer or any replacement returned by the
          -- legacy: replacement-offer search)

    let ceiling = AuthorizedSpendCeiling(group)
    if Offer.cost_per_hour > ceiling:
        -- legacy: ensures: the candidate Offer is rejected, added to the search
                 -- legacy: exclude set, and the next replacement is requested
        -- legacy: ensures: if every candidate within the replacement-offer search
                 -- legacy: budget is rejected, the launch fails with a
                 -- legacy: PriceAuthorizationRequiredError carrying the offered,
                 -- legacy: anchor, ceiling, and (informational) current market
                 -- legacy: median prices, and the job's placement_blocked column
                 -- legacy: is written with a structured "requires_price_authorization"
                 -- legacy: reason

    -- legacy annotation: @guidance
        -- The ceiling resolution order is, highest priority first:
        --   1. The maximum jobs.price_authorized_up_to_cents across the
        --      jobs in the group (per-job sticky override set by
        --      `weft job authorize-price`).
        --   2. price_authorizations(gpu_class, gpu_mem_gb).up_to_cents
        --      (class-level sticky override set by
        --      `weft job authorize-price --for-class`).
        --   3. The price anchor's auto-approve ceiling:
        --      PriceAnchorForClass(gpu_class, gpu_mem_gb).P75Cents
        --      multiplied by PriceAnchorAutoApproveMultiplier (1.5).
        --      The anchor is the p75 of cost_per_hour_cents from
        --      `launches` rows in the same bucket that reached
        --      launched_at IS NOT NULL within a rolling window. The
        --      window backs off 30d → 90d → 365d → unbounded, picking
        --      the smallest window with at least PriceAnchorMinSamples
        --      (3) samples. Sparse classes — e.g., a job that runs
        --      every two months — still get an anchor.
        --   4. None (sparse history, no overrides). The gate fails
        --      closed; the job needs an explicit
        --      `weft job authorize-price` before it can launch.
        --
        -- Market data is INTENTIONALLY NOT a ceiling-raising input.
        -- Rental markets are thin and can spike 10× on supply-
        -- constrained days; if the current market median fed into the
        -- ceiling, a price spike would silently re-authorize spend the
        -- user has never agreed to. The market median is computed
        -- separately for display only and shown alongside the anchor
        -- in the placement_blocked message.
        --
        -- The gate applies uniformly across same-provider and cross-
        -- provider replacements. There is no special case for an offer
        -- that comes from a different provider than the originating
        -- search; the user authorizes a spend ceiling, not a provider
        -- boundary.
        --
        -- The previous fixed cap (replacementOfferMaxPriceMultiplier =
        -- 1.25 anchored on the original offer's price) was removed
        -- because anchoring on a single promotional or scarcity-
        -- discounted original could produce a ceiling no real-market
        -- replacement could clear, dead-ending the launch instead of
        -- pivoting. The history-derived anchor was chosen as the
        -- replacement because it reflects what the user has implicitly
        -- accepted paying for this bucket, not what one search
        -- iteration's first-ranked offer happens to cost.
        --
        -- Implementation: internal/campaign/price_gate.go
        -- (evaluatePriceGate, searchAuthorizedReplacementOffer),
        -- internal/campaign/price_anchor.go (PriceAnchorForClass),
        -- internal/db/price_authorizations.go (per-job and class-level
        -- storage).
}

rule PerJobRentalPolicy {
    when: EvaluatePerJobRentalPolicy()

    -- Legacy body retained as migration guidance:
    -- when: RankGroupOffers(raw_offers) or LaunchInstance(group)

    -- let hourly_ceiling = min(job.cli_overrides.max_hourly_rate_cents
    -- for job in group.jobs
    -- legacy: where the field is present)
    -- legacy: let spend_ceiling = min(job.cli_overrides.max_spend_cents
    -- legacy: for job in group.jobs
    -- legacy: where the field is present)
    -- legacy: let time_ceiling = min(job.cli_overrides.max_time_seconds
    -- legacy: for job in group.jobs
    -- legacy: where the field is present)
    -- legacy: let survival_floor = max(job.cli_overrides.min_survival
    -- legacy: for job in group.jobs
    -- legacy: where the field is present)

    -- legacy: ensures:
    -- legacy: every selected offer.cost_per_hour_cents <= hourly_ceiling
    -- legacy: when hourly_ceiling is present
    -- legacy: ensures:
    -- legacy: every selected offer.cost_per_hour_cents includes the provider's
    -- legacy: recurring storage charge for group.disk_gb
    -- legacy: ensures:
    -- legacy: no hourly-rate-compatible offer implies every job in group remains queued
    -- legacy: and each job's placement diagnosis identifies the hourly-rate cap
    -- legacy: ensures:
    -- legacy: instance.max_spend_cents <= spend_ceiling when spend_ceiling is present
    -- legacy: and instance.max_time_seconds <= time_ceiling when time_ceiling is present
    -- legacy: ensures:
    -- legacy: every EstimatedOfferSurvival(offer, survival_model) >= survival_floor
    -- legacy: when survival_floor is present and survival_floor > 0
    -- legacy: ensures:
    -- legacy: instance.grace_period_seconds = group.jobs.first.cli_overrides.grace_period_seconds
    -- legacy: when that field is present

    -- legacy annotation: @guidance
    -- The hourly-rate filter runs after hardware compatibility and before
    -- the survival filter and offer ranking. LaunchInstance checks the
    -- selected offer again before provider create, including replacement
    -- offers. A replacement that bypasses normal ranking fails closed
    -- before its metadata is accepted or the provider create begins.
    -- Vast computes dph_total from the storage amount supplied to its
    -- search command. SearchOffers must pass `--storage group.disk_gb`;
    -- Vast's 5 GiB CLI default is not an admissible price for a job that
    -- requests more disk. The storage-inclusive rate feeds ranking, the
    -- per-job cap, persisted launch cost, and RateCapAuthorized.
    --
    -- Jobs with different rental policy values or different field
    -- presence never share or merge into one fresh launch group. This
    -- preserves exact grace semantics and prevents one job's absent cap
    -- from weakening another job's explicit authorization.
    --
    -- Launch-time application uses the stricter positive value when a
    -- manual launch also supplies max-spend or max-time. An explicit job
    -- grace period overrides the launch default, including zero. The
    -- resulting values are persisted on the launch and passed through the
    -- existing manifest and agent enforcement paths.
    --
    -- min_survival is the learned end-to-end probability produced by
    -- SurvivalModel / MachinePenalty, not the provider-advertised
    -- offer.reliability value. Provider reliability is a separate
    -- offer-search constraint from config.campaign.reliability (default
    -- 0.95). Strict learned floors should be calibrated against `weft
    -- provider offers` or `weft campaign survival` rather than copied
    -- from Vast reliability2.
    --
    -- Implementation: internal/campaign/rental_policy.go,
    -- internal/campaign/offers.go, internal/campaign/campaign.go,
    -- internal/campaign/lifecycle.go, and
    -- internal/campaign/strategy_plan.go.
}

rule ReclassifyConfirmedWeftBugOutcome {
    when: EvaluateReclassifyConfirmedWeftBugOutcome(instance) -- legacy: Operator runs `weft instance mark-weft-bug instance_id --detail evidence`
    requires: instance.status in {failed, canceled}
    requires: instance.termination_reason in {provider_failure, infra_failure, unknown, empty}

    ensures: instance.termination_reason = weft_bug
    -- legacy: ensures: evidence is prepended to instance.termination_detail
    -- legacy: ensures: lifecycle, cost, attempt, and teardown evidence is preserved
    -- legacy: ensures: instance is excluded from provider, GPU, region, country, and
             -- legacy: machine survival training
}

invariant PriceAuthorizationDoesNotTripCircuitBreaker {
    -- The autopilot circuit breaker counts repeated infrastructure
    -- failures to detect runaway loops. A price-authorization block is
    -- categorically different: the system is correctly refusing to
    -- spend money the user has not authorized. Treating it as an infra
    -- failure would trip the breaker on a perfectly healthy autopilot
    -- as soon as a single bucket exhausted its authorized history.
    --
    -- For every autopilot pass, BlockedByPriceAuthorization counts the
    -- jobs whose latest pass result was rejected by
    -- PriceAuthorizationGate. These jobs MUST NOT contribute to the
    -- "repeated infrastructure failures without progress" tally that
    -- pauses the autopilot.
    --
    -- Implementation: internal/orchestration/autopilot.go
    -- (failure-streak accounting); the price-gate block reason carries
    -- a distinct tag that the breaker filters out.
}

-- --------------------------------------------------------------------------
-- Interruptible placement
-- --------------------------------------------------------------------------

-- A job opts into interruptible placement by either:
--   * tagging the job with "interruptible", or
--   * setting `interruptible = true` in its PEP 723 [tool.weft] block.
--
-- Synonyms (input-only, normalized on intake):
--   * The tag "preemptible" is accepted and canonicalized to "interruptible"
--     by CanonicalizeTag at submission. After canonicalization the persisted
--     tag set contains "interruptible"; "preemptible" never appears in
--     stored Job.tags or in any downstream rule. Spec rules that reference
--     `"interruptible" in job.tags` apply uniformly to jobs submitted with
--     either spelling.
--   * The PEP 723 key `preemptible = true` is accepted and is equivalent to
--     `interruptible = true`. If both keys are set, `interruptible` wins.
--
-- These synonyms exist solely for backwards compatibility; new code, docs,
-- and CLI output use "interruptible".
--
-- Both paths set Job.interruptible; InstanceGroup.interruptible is the OR of
-- its member jobs. An entire group runs as either all-interruptible or all-
-- on-demand — interruptible and non-interruptible jobs never share an
-- instance.
--
-- For interruptible groups:
--   * Offer search is restricted to provider interruptible offers.
--   * The initial bid price is the offer's asking `cost_per_hour`
--     (max_bid = ask). A separate user bid knob is not exposed.
--   * If provider polling observes a stopped/offline interruptible instance
--     and the launch recorded `on_demand_ref_cents`, weft may raise the bid
--     up to that on-demand reference cap and records the new
--     `max_bid_price_cents`.
--   * Provider "stopped" transitions are not immediate failures (see
--     ProviderInstancePaused) — for any rental, not just interruptible.
--     pause_tolerant only affects the termination_reason chosen if
--     stale_pause_timeout is exceeded.
--   * If the pause does not clear within config.stale_pause_timeout the
--     instance is failed (termination_reason = preempted for interruptible,
--     provider_failure otherwise) and jobs relaunch on a fresh offer (see
--     PausedInstanceStale and RelaunchAfterInfraFailure).
--
-- This is the entire policy. No per-job retry cap or premium ceiling is
-- maintained at this layer — the runaway breaker (see §Runaway prevention)
-- is the backstop.
--
-- Benchmark jobs are incompatible with interruptible placement: preemption
-- pauses the container mid-run, invalidating timing measurements (cold GPU
-- and state on resume), and a stale-pause relaunch puts the job on a
-- different physical machine, breaking the "same hardware" control that
-- benchmark analyses rely on. The submission path rejects the combined
-- {"benchmark-isolation", "interruptible"} tag set.
--
-- For provenance of historical launches, three columns on `launches`
-- capture the rental decision at create time:
--   * instance_type          ("on-demand" or "interruptible")
--   * max_bid_price_cents    (bid paid; nil for on-demand)
--   * on_demand_ref_cents    (cheapest concurrent on-demand ask at launch
--                             time for the same GPU class; best-effort,
--                             nil when the counterfactual search fails)
-- This makes "what did we actually save vs on-demand?" answerable as a
-- per-launch query rather than inferred from tag joins that can drift as
-- tags are edited after the fact.
--
-- Implementation: internal/db/db.go TagInterruptible (TagPreemptible alias,
-- TagPreemptibleLegacy for canonicalization),
-- internal/dataloc/scriptmeta.go (PEP 723; accepts both keys),
-- internal/campaign/campaign.go InstanceGroup.Preemptible +
-- HasPreemptibleJob, internal/campaign/offers.go offerConstraintsForGroup,
-- internal/campaign/lifecycle.go (MaxBidPrice default = offer cost).

rule OfferClaimInPassExclusion {
    when: RankGroupOffers(raw_offers_per_group)

    ensures:
        -- legacy: for groups (g_i, g_j) in raw_offers_per_group where i < j:
            -- legacy: ranked[i].offer != null implies
                -- legacy: ranked[j].offer.machine_id != ranked[i].offer.machine_id
                  -- legacy: OR ranked[j].offer.machine_id = null
                  -- legacy: OR ranked[j].offer.provider != ranked[i].offer.provider

    -- legacy annotation: @guidance
        -- The offer picker must NOT select the same (provider, machine_id)
        -- for two groups in the same ranking pass. Vast.ai serializes
        -- create-instance per machine — concurrent CreateInstance calls
        -- against the same machine_id race, with vastai accepting the
        -- first and returning success=false for the rest. A single
        -- ranking pass producing duplicate machine_ids fans out into
        -- parallel creates that lose the race against weft itself,
        -- burning the losers' attempt budgets on a self-inflicted
        -- failure.
        --
        -- Each group's ranking sees an offer pool with previously-
        -- claimed (provider, machine_id) and (provider, provider_id)
        -- entries excluded. machine_id is the primary granularity;
        -- provider_id is the fallback for providers (e.g. runpod) that
        -- don't populate machine_id. The next-cheapest available offer
        -- wins, falling through to the global filterStats reason when
        -- no offer survives.
        --
        -- This is per-pass only — global cross-pass ordering is the
        -- autopilot's responsibility (the next pass refreshes the offer
        -- pool from a fresh provider search).
        --
        -- Implementation: rankGroupOffersFromPredictions and
        -- RankGroupOffersWithProfile in internal/campaign/strategy_plan.go
        -- and internal/campaign/offers.go thread a claimedMachines /
        -- claimedOffers pair through the per-group loop;
        -- filterOffersByClaim and recordOfferClaim are the helpers.
}

-- ==========================================================================
-- Machine anti-affinity (coverage campaigns)
-- ==========================================================================
--
-- A coverage campaign (Campaign.distinct_machines) collects one benchmark
-- datapoint per distinct physical machine. The anti-affinity is keyed on
-- COVERAGE, not failure: a machine is excluded once it has produced a
-- successful datapoint (covered_instances) or is currently producing one
-- (inflight_instances), plus any operator avoid_machines. A machine whose
-- run FAILED or FAILED TO BOOT is left uncovered and therefore stays
-- eligible — even a re-attempt on that same machine is correct, because no
-- datapoint has been collected from it.
--
-- This is the persistent / cross-pass generalization of the per-pass
-- OfferClaimInPassExclusion: that rule prevents two groups in ONE ranking
-- pass from claiming the same machine; these rules additionally exclude
-- machines covered or in-flight from PRIOR passes and replacements, and the
-- operator-supplied avoid set.

-- A token passed to `weft ... --avoid <token>` identifying a physical machine
-- to exclude. Raw unqualified ids are treated as Vast.ai machine ids for
-- backwards compatibility; provider-qualified raw ids such as
-- `runpod/<machine_id>` and instance/job tokens resolve to provider-qualified
-- machine refs so RunPod and Vast.ai machine-id namespaces cannot collide.
enum AvoidTargetKind { machine_id | instance | job }

rule ResolveAvoidTarget {
    when: ResolveAvoidTarget(token)

    ensures:
        token.kind = machine_id implies result = token.value
    ensures:
        token.kind = instance implies
            result = Instance(token.value).provider + "/" +
                      Instance(token.value).offer.machine_id
    ensures:
        token.kind = job implies
            result = Job(token.value).latest_attempt.cloud_instance.provider + "/" +
                      Job(token.value).latest_attempt.cloud_instance.offer.machine_id

    -- legacy annotation: @guidance
        -- `--avoid` accepts a raw provider machine_id, an instance id (wiNN),
        -- or a job id (wjNN); repeatable and/or comma-separated. An instance
        -- resolves to provider/machine_id; a job resolves to provider/machine_id
        -- of its LATEST attempt's launch (deliberately the latest attempt,
        -- distinct from the all-successful coverage set — `--avoid wjNN`
        -- means "not where wjNN most recently ran"). Raw unqualified ids
        -- remain Vast.ai-compatible and are normalized to vastai/<machine_id>
        -- inside campaign offer filtering. Provider-qualified raw refs such
        -- as runpod/<machine_id> are preserved.
        --
        -- A token that never landed on a machine (job never started, or an
        -- instance/job whose offer.machine_id is empty) resolves to nothing
        -- and MUST be reported as a warning, not silently dropped, so the
        -- operator knows the exclusion had no effect.
        --
-- Resolved machine refs are unioned into Campaign.avoid_machines.
}

-- A token passed to `weft ... --affinity <token>` identifying a physical
-- machine that eligible placements must match. All three kinds resolve to a
-- single provider machine_id, using the same target resolution rules as
-- `--avoid`.
enum MachineAffinityTargetKind { machine_id | instance | job }

rule ResolveMachineAffinityTarget {
    when: ResolveMachineAffinityTarget(token)

    ensures:
        token.kind = machine_id implies result = token.value
    ensures:
        token.kind = instance implies result = Instance(token.value).offer.machine_id
    ensures:
        token.kind = job implies
            result = Job(token.value).latest_attempt.cloud_instance.offer.machine_id

    -- legacy annotation: @guidance
        -- `--affinity` accepts a raw provider machine_id, an instance id
        -- (wiNN), or a job id (wjNN); repeatable and/or comma-separated. An
        -- instance resolves to its own offer.machine_id; a job resolves to
        -- the machine_id of its LATEST attempt's launch (`--affinity wjNN`
        -- means "run where wjNN most recently ran").
        --
        -- A token that never landed on a machine (job never started, or an
        -- instance/job whose offer.machine_id is empty) resolves to nothing
        -- and MUST be reported as a warning. If no affinity token resolves,
        -- the launch fails before offer search because the constraint would
        -- otherwise be silently ignored.
        --
        -- Resolved machine_ids are unioned into Campaign.affinity_machines.
}

rule MachineAffinityOfferFilter {
    when: EvaluateMachineAffinityOfferFilter()

    -- Legacy body retained as migration guidance:
    -- when: RankGroupOffers(raw_offers_per_group) for campaign
    -- legacy: requires: campaign.affinity_machines not empty

    -- legacy: ensures:
    -- legacy: for each offer o selected for a group in campaign:
    -- legacy: o.machine_id in campaign.affinity_machines

    -- legacy annotation: @guidance
    -- Implementation: filter raw offers through an allow-list keyed by
    -- provider/machine_id before scoring. Reusable rental instances are
    -- filtered with the same key before reuse planning, so reuse cannot
    -- satisfy the job on a different physical machine. Providers without
    -- pre-launch machine_id support are rejected up front; v1 supports
    -- Vast.ai.
    --
    -- An offer or instance reporting no machine_id is not confirmed to be a
    -- pinned machine, so it is excluded: this is a placement/eligibility
    -- decision and fails closed on unknown. The invariant is additionally
    -- enforced at every claim write that binds a job to a destination —
    -- setJobLaunchIDOnce (ordinary and transfer claims),
    -- CreateMoveTargetAttempt (move-target claims, cloud and host
    -- destinations), and AssignJobHost (on-prem jobs.host) — so it holds
    -- even if an upstream filter is missing. Attach writes that record an
    -- already-observed binding are not claims and do not re-assert.
}

-- The coverage exclusion that offer selection enforces before create when a
-- provider exposes per-offer machine_id. Extends the per-pass claim by
-- pre-seeding the claimed-machine set with the campaign's covered, in-flight,
-- and avoid machines BEFORE ranking. RunPod has no per-offer machine_id, so
-- RunPod uses RunPodPostCreateMachineAcceptance instead.
rule CoverageOfferExclusion {
    when: EvaluateCoverageOfferExclusion()

    -- Legacy body retained as migration guidance:
    -- when: RankGroupOffers(raw_offers_per_group) for campaign
    -- legacy: requires: campaign.distinct_machines

    -- legacy: ensures:
    -- legacy: for each offer o selected for a group in campaign:
    -- legacy: o.machine_id not in campaign.covered_instances.offer.machine_id
    -- legacy: and o.machine_id not in campaign.inflight_instances.offer.machine_id
    -- legacy: and o.machine_id not in campaign.avoid_machines

    -- legacy annotation: @guidance
    -- Implementation: thread an initial exclusion set into
    -- filterOffersByClaim's claimedMachines map (keyed
    -- provider/machine_id, matching recordOfferClaim) before the
    -- per-group loop in rankGroupOffersFromPredictions /
    -- RankGroupOffersWithProfile. The covered + in-flight machine_ids
    -- come from the success+in-flight generalization of
    -- db.FailedMoveTargetMachineIDs scoped to the campaign; the avoid set
    -- comes from ResolveAvoidTarget. No new offer-filter stage is needed
    -- for Vast.ai — the existing claim machinery already excludes claimed
    -- machines. For RunPod, the planner intentionally allows repeated GPU
    -- type ProviderID selections in distinct-machine mode, then performs
    -- acceptance after pod readback when machine_id is known.
}

rule RunPodPostCreateMachineAcceptance {
    when: EvaluateRunPodPostCreateMachineAcceptance()

    -- Legacy body retained as migration guidance:
    -- when: EvaluateRunPodPostCreateMachineAcceptance(campaign, covered_instances, offer, pod) -- legacy: RunPod pod is created for campaign.distinct_machines

    -- ensures:
    -- if pod.machine_id in campaign.covered_instances.offer.machine_id
    -- legacy: OR pod.machine_id in campaign.inflight_instances.offer.machine_id
    -- legacy: OR pod.machine_id in campaign.avoid_machines:
    -- legacy: pod is not bootstrapped with jobs
    -- legacy: pod is cordoned and held while a replacement is sampled
    -- legacy: pod is destroyed after replacement acceptance or retry exhaustion

    -- legacy annotation: @guidance
    -- Implementation: LaunchInstance records provider_instance_id and
    -- machine_id immediately after CreateInstance/ShowInstance. Under a
    -- per-campaign mutex, runpodDistinctMachineConflict checks the
    -- provider-qualified key runpod/<machine_id> against covered rows,
    -- active accepted pods, and avoid_machines. A conflict returns a
    -- retryable distinctMachinePostCreateConflictError that unwraps to
    -- cloud.ErrOfferUnavailable, so existing create/replan retry caps
    -- bound RunPod sampling.
}

-- The defining property: failures never exclude their machine.
invariant FailedMachinesRemainEligible {
    -- legacy: for campaign where campaign.distinct_machines:
        -- legacy: for instance in campaign.instances
            -- legacy: where instance.termination_reason in {provider_failure, infra_failure,
                                                   -- legacy: bootstrap_timeout, phase_stall,
                                                   -- legacy: preempted, job_failure, disk_full}
              -- legacy: and not campaign.covered_instances.contains(instance):
            -- legacy: instance.offer.machine_id not in campaign.avoid_machines implies
                -- legacy: instance.offer.machine_id may be reselected

    -- legacy annotation: @guidance
        -- A failed or boot-failed machine produced no datapoint, so coverage
        -- anti-affinity must NOT exclude it. The only ways a once-failed
        -- machine becomes excluded are (a) a later attempt SUCCEEDS on it
        -- (now covered) or (b) the operator names it via `--avoid`. This is
        -- the inverse of the move-repair path (FailedMoveTargetMachineIDs),
        -- which excludes failed machines; the coverage query selects success.
}

-- For a coverage campaign, an infra-failure replacement must RE-SEARCH offers
-- with the coverage exclusion rather than reuse the failed instance's offer.
rule CoverageReplacementResearchesOffer {
    when: instance: Instance.status transitions_to failed
    requires: instance.is_retryable
          and instance.campaign.distinct_machines

    -- legacy: ensures: the replacement instance's offer is chosen by a fresh offer search
             -- legacy: subject to CoverageOfferExclusion (NOT copied from instance.offer)
    ensures: instance.offer.machine_id not in instance.campaign.avoid_machines
             -- legacy: implies the replacement MAY reselect instance.offer.machine_id
             -- legacy: (the failed machine is uncovered)

    -- legacy annotation: @guidance
        -- This overrides RelaunchAfterInfraFailure for distinct_machines
        -- campaigns. The base rule reuses offer: instance.offer, which pins
        -- the replacement to the same physical machine — correct for a plain
        -- infra retry, wrong for coverage, where the campaign must keep making
        -- progress across machines and must not get stuck re-creating a dead
        -- box. The replacement re-runs offer search + CoverageOfferExclusion.
        -- Note the just-failed machine is still eligible (it is uncovered);
        -- excluding the covered + in-flight set is what spreads coverage.
}

-- When the exclusion empties the eligible offer pool, say so explicitly.
rule CoverageExhaustion {
    when: EvaluateCoverageExhaustion()

    -- Legacy body retained as migration guidance:
    -- when: RankGroupOffers(raw_offers_per_group) for campaign
    -- legacy: requires: campaign.distinct_machines
    -- legacy: requires: no offer survives CoverageOfferExclusion for a group

    -- legacy: ensures: the group is reported as "all distinct machines covered or in-flight"
    -- legacy: rather than repeating a covered machine or stalling silently

    -- legacy annotation: @guidance
    -- For an interactive launch this is an error; for repair/resume/extend
    -- of an existing campaign it is the natural completion signal (the
    -- matrix is full). Surface it through the existing filterStats /
    -- unplaced-reason path, distinguished from ordinary "no offers" so the
    -- operator can tell saturation apart from a market/constraint miss.
}

-- Provider capability gate: coverage anti-affinity needs a real physical
-- machine id. Providers may expose it before create (Vast.ai) or only after
-- create/readback (RunPod).
invariant MachineAntiAffinityProviderSupport {
    -- legacy: for campaign where campaign.distinct_machines:
        -- legacy: campaign.instances.all(i => i.provider.name in {"vastai", "runpod"})

    -- legacy annotation: @guidance
        -- Vast.ai populates per-offer machine_id at search time
        -- (OfferSnapshot.machine_id), so offer selection excludes covered,
        -- in-flight, and avoided machines before provider create.
        --
        -- RunPod offers carry NO machine identity: offer search returns GPU
        -- TYPES, and ProviderID is the GPU-type id, not a machine — the
        -- machine_id only exists after a pod is created/read back.
        -- (Implementation: internal/runpod/client.go buildOffersFromGraphQL
        -- sets ProviderID = gt.ID and never sets MachineID.)
        --
        -- For RunPod distinct-machine launches, Weft creates the pod, records
        -- provider id and machine_id, then checks the machine against
        -- campaign coverage, in-flight accepted pods, and avoid_machines
        -- BEFORE uploading/running the job bootstrap. If the sampled machine
        -- is covered/avoided/in-flight, Weft cordons and holds that pod while
        -- sampling a replacement under the normal bounded retry budget, then
        -- destroys the held blocker after a distinct replacement is accepted
        -- or the group gives up. A RunPod pod that never reports machine_id is
        -- destroyed immediately and treated as a retryable provider sample.
        --
        -- Providers other than Vast.ai and RunPod MUST fail loudly at request
        -- time for distinct_machines rather than silently downgrading to no
        -- anti-affinity.
}

rule GPUMemoryHardwareCeilingResolution {
    when: BuildOfferSearchFilter(job_or_group, gpu_class, requested_mem_gb)
       -- legacy: OR MatchJobToInstance(job, instance_capacity)

    ensures:
        -- legacy: for any (gpu_class, mem_gb) where KnownHardwareMemoryGB(gpu_class, mem_gb):
            -- search filter and reuse check MUST treat requested_mem_gb as
            -- the literal hardware ceiling — no +2GB safety headroom may
            -- be added when the request names the exact hardware.
            -- legacy: effective_filter_mem_gb = mem_gb
            -- legacy: intended_job_mem_gb     = mem_gb

        -- legacy: for any (gpu_class, mem_gb) where KnownHardwareMemoryGB(gpu_class, mem_gb - defaultHeadroomGB):
            -- back-compat: jobs persisted before headroom moved to filter
            -- time stored (ceiling + 2GB) in the gpu_mem_gb column. The
            -- search filter and reuse check both roll those values back to
            -- the underlying ceiling so the job picks up automatically on
            -- the next autopilot tick — no manual `weft restart` required.
            -- legacy: effective_filter_mem_gb = mem_gb - defaultHeadroomGB
            -- legacy: intended_job_mem_gb     = mem_gb - defaultHeadroomGB

    -- legacy annotation: @guidance
        -- Vast.ai's `gpu_ram>=N` filter is in GB (despite the response field
        -- being in MB). A100 80GB hardware reports gpu_ram=80GB exactly, so
        -- emitting `gpu_ram>=82` (the literal request +2GB safety headroom)
        -- excludes every A100 80GB offer and the job sits unplaceable. The
        -- same arithmetic breaks H100 80GB, H200 141GB, RTX 4090 24GB, and
        -- every other model where the user names the exact hardware
        -- capacity.
        --
        -- The +2GB safety headroom (defaultHeadroomGB) is still applied
        -- when the request is a user-supplied minimum that doesn't match a
        -- known hardware ceiling. EffectiveMemGB
        -- (internal/vastai/hardware_memory.go) is the search-filter
        -- transform; it returns:
        --   1. requested      when (class, requested) is a known ceiling
        --   2. ceiling        when (class, requested - 2) is a known ceiling
        --   3. requested + 2  otherwise
        --
        -- IntendedMemGB is the consumer-side transform (reuse capacity
        -- check). It applies rules 1 and 2 but NOT rule 3 — when comparing
        -- against a real instance capacity, adding a +2GB cushion would
        -- falsely reject a rental that exactly satisfies the request.
        --
        -- Submit-time applyGPUMemHeadroom (cmd/gpu_estimator.go) consults
        -- the same KnownHardwareMemoryGB table, so new jobs persist the
        -- user's intent (e.g. 80 for "A100 80GB") rather than the
        -- post-headroom value (82). Historical jobs persisted with the
        -- old +2GB-baked-in behaviour are resolved at filter and reuse
        -- time by the rollback path.
        --
        -- Implementation: hardwareMemoryByClass (the GPU model → memory
        -- sizes table), EffectiveMemGB, IntendedMemGB, KnownHardwareMemoryGB
        -- in internal/vastai/hardware_memory.go. Consumed by
        -- internal/vastai/client.go buildSearchFilter and
        -- internal/campaign/reuse.go matchJobToInstance.
}

rule FreshRentalDiskEstimate {
    when: BuildOfferSearchFilter(group)
       -- legacy: OR LaunchInstance(group, options)

    -- estimate_gb is the size the estimator computes before the user's
    -- ceiling is considered. Every input below can only RAISE it.
    let estimate_gb = UncappedDiskEstimateGB(group)

    -- ExplicitDiskCeilingGB is the ONLY input that can lower the request. It
    -- is 0 unless the user declared one (--disk-max / [tool.weft] disk-max);
    -- nothing infers a ceiling. A group's ceiling is the MINIMUM of the
    -- ceilings its own jobs declare: honouring one job's ceiling means the
    -- shared instance cannot exceed it. Jobs declaring none do not
    -- contribute, so one capped job constrains its whole group.
    let ceiling_gb =
        if not group.jobs.any(j => ExplicitDiskCeilingGB(j) > 0): 0
        else: min ExplicitDiskCeilingGB(j)
                  over each j in group.jobs where ExplicitDiskCeilingGB(j) > 0

    ensures:
        estimate_gb >= DefaultMinDiskGB
        estimate_gb >= ExplicitDiskFloorGB(group)
        estimate_gb >= EstimatedDeclaredAndObservedInputsGB(group)
            + EstimatedUVSyncGB(group)
            + ImageAndSetupOverheadGB(group)
            + ExplicitRuntimeDiskGB(group)
        HistoricalDiskPeakUsable(group) implies
            estimate_gb >= EmpiricalDiskRequirementGB(group)

    -- The ceiling is applied LAST, after every floor above including
    -- DefaultMinDiskGB and an explicit --disk floor. A ceiling at or above
    -- estimate_gb is a no-op: it is a ceiling, not a request.
    ensures:
        if ceiling_gb > 0 and ceiling_gb < estimate_gb:
            group.requested_disk_gb = ceiling_gb
            DiskEstimateCappedByCeiling(
                group: group,
                estimated_gb: estimate_gb,
                ceiling_gb: ceiling_gb,
                jobs: group.jobs
            )
        else:
            group.requested_disk_gb = estimate_gb

    -- legacy annotation: @guidance
        -- Fresh rental disk sizing combines declared inputs, observed
        -- post-mortem inputs, cached uv-lock manifests (or a package-count
        -- fallback), Docker/workspace overhead, CUDA setup overhead, explicit
        -- runtime scratch, empirical history, and user disk floors. PyTorch
        -- images use reduced CUDA setup overhead for launch sizing; reuse
        -- admission is stricter because it checks remaining free disk on a
        -- mutable live instance.
        --
        -- Historical disk telemetry above the plausibility bound is rejected
        -- and surfaced as an anomaly instead of silently clamped.
        -- Implementation: internal/campaign/disk.go EstimateGroupDisk.
        --
        -- Why a ceiling exists at all: disk is the only estimated quantity
        -- that acts as a HARD PLACEMENT FILTER. requested_disk_gb becomes a
        -- server-side `disk_space>=N` predicate in the provider offer search,
        -- so a conservative over-estimate does not merely cost money — it
        -- shrinks the offer pool before scoring and can empty it. The common
        -- overshoot source is `--input hf:<model>`, which prices the whole
        -- repository from HuggingFace `usedStorage`, including serialization
        -- formats (.bin, .h5, flax .msgpack, ONNX) the loader never fetches.
        -- A user who knows their real footprint needs a way to say so.
        --
        -- Declaring both a floor and a ceiling is contradictory and the
        -- ceiling wins, because letting the floor win would make the ceiling
        -- unusable on exactly the jobs that declare both.
        --
        -- Capping is an explicit acceptance of risk, so it must be
        -- attributable: DiskEstimateCappedByCeiling records the estimated
        -- size, the ceiling, and the affected job IDs whenever the ceiling
        -- binds, so a later disk_full on that instance is attributable to the
        -- ceiling rather than to the estimator.
        --
        -- Implementation: the ceiling is applied at the end of
        -- internal/campaign/disk.go EstimateGroupDisk; the per-group minimum
        -- is internal/campaign/runtime_disk.go groupDiskCapGB, which reads
        -- CLIResourceOverrides.DiskMaxGB, then JobDiskMetadata.DiskMaxGB, then
        -- PEP 723 [tool.weft] disk-max, in that order.
        --
        -- Two later paths also raise the request and so must re-apply the
        -- ceiling, or it would bind the offer filter but not the instance the
        -- user actually pays for. First, the provider create request starts
        -- from CreateOpts.DiskGB (a 50GB provider default, not a user
        -- request) and takes the max with the estimate, so a ceiling below
        -- 50GB is re-applied in internal/campaign/lifecycle.go after that
        -- max. Second, the automatic disk_full relaunch bump multiplies the
        -- prior allocation by 1.5x; internal/campaign/relaunch.go clamps that
        -- bump to the ceiling, which means a capped group stops being bumped
        -- once it reaches its ceiling. That is the declared behaviour, not a
        -- stalled repair loop: the user accepted disk_full risk when they
        -- declared the ceiling, and the clamp is logged so the arrested bump
        -- is attributable.
        --
        -- These floors bind every group whose shape reaches an offer search,
        -- including planner-derived candidate groupings: a parallel (one job
        -- per instance) candidate uses that job's own floor (per-job floors
        -- are captured at preparation time — internal/campaign/disk.go
        -- EstimateGroupDisks fills InstanceGroup.JobDiskGB), and a merged
        -- candidate that absorbed another group re-estimates over its
        -- combined job set rather than taking the max of the source
        -- estimates (max under-counts disjoint inputs). This keeps the offer
        -- filter and the eventual create request on the same floor for the
        -- same shape. The ceiling travels with the job set the same way: a
        -- merged candidate takes the minimum ceiling over its combined jobs,
        -- so absorbing a capped job caps the merged candidate.
        -- Implementation: internal/campaign/campaign.go
        -- SplitToParallel / MergeCompatibleGroupsWithDisk.
}

rule BidLossEscalation {
    -- After enough consecutive lost bid instances for a job, the next launch
    -- for its group searches on-demand offers instead of placing another bid.
    when: SearchOffersForGroup(group)
            -- legacy: and exists job in group.jobs:
                -- legacy: job.preemptible
                -- legacy: and ConsecutiveInterruptibleOrphans(job) >= config.bid_loss_escalation_threshold

    ensures: group.escalate_to_on_demand = true
    ensures: OfferConstraints(group).instance_type != interruptible

    -- legacy annotation: @guidance
        -- ConsecutiveInterruptibleOrphans counts, from the job's most recent
        -- attempt backwards, attempts whose launch was interruptible and
        -- whose outcome was orphaned or preempted — the instance was lost
        -- out from under the job rather than the job itself failing.
        -- Counting stops at the first attempt that doesn't match, so a
        -- successful (or on-demand) run breaks the chain; superseded
        -- attempts are bookkeeping rows and are skipped without breaking it.
        --
        -- config.bid_loss_escalation_threshold = 3
        -- (bidLossEscalationThreshold in internal/campaign/prepare.go).
        --
        -- Escalation is per-launch-attempt with no persistent state: it
        -- only suppresses the interruptible opt-in for the next launch —
        -- it never forces a bid, and a completed on-demand run naturally
        -- resets the count so later launches may bid again. Groups without
        -- preemptible jobs are never touched.
        --
        -- Motivating incident: wj3741 was orphaned 16 consecutive times on
        -- bid instances that kept getting outbid (compounded by status-poll
        -- timeouts — see ProviderStatusUnknownDefersTermination); without
        -- an escape hatch the job re-bid into the same losing market
        -- indefinitely.
        --
        -- Implementation: db.ConsecutiveInterruptibleOrphans,
        -- ApplyBidLossEscalation in internal/campaign/prepare.go (applied at
        -- every group-build site: PrepareGroups, the auto-relaunch planner,
        -- and BuildAutoPlacementPlan), and the interruptible opt-in gate in
        -- offerConstraintsForGroup (internal/campaign/offers.go).
}

rule LaunchInstance {
    when: LaunchInstance(campaign, jobs, gpu_spec, options)

    ensures: Instance.created(
        campaign: campaign,
        provider: options.provider,
        gpu_spec: gpu_spec,
        gpu_class: options.gpu_class,
        gpu_mem_gb: options.offer.gpu_mem_gb,
        num_gpus: options.num_gpus,
        docker_image: options.docker_image,
        offer: options.offer,
        max_spend_cents: options.max_spend_cents,
        max_time_seconds: options.max_time_seconds,
        actual_spend_cents: 0,
        instance_role: options.role,
        donor_instance: options.donor,
        disk_gb: options.requested_disk_gb,   -- requested container disk, not offer.disk_gb
        provisioned_inputs: options.inputs,
        grace_period_seconds: options.grace_period_seconds,
        status: planned,
        created_at: now
    )
    ensures:
        for job in jobs:
            job.cloud_instance = instance
            job.target_kind = rental_instance

    -- legacy annotation: @guidance
        -- Provider routing is strict. Every operation against an Instance
        -- (launch, status query, destroy, reconcile) MUST use the cloud
        -- client whose provider.name matches instance.provider.name. If no
        -- matching client is registered, the operation MUST fail explicitly
        -- rather than silently falling back to a differently-named client —
        -- such fallback routes instances through the wrong provider API
        -- and makes them invisible to reconcile.
        -- Implementation: internal/runpod/client.go, provider-keyed client
        -- registry consumed by internal/campaign/lifecycle.go.
        -- Provider adapters must preserve transport failure evidence: a
        -- non-success HTTP response or malformed provider payload is an
        -- observation error, not an empty successful offer/instance result.
        -- In particular, RunPod GraphQL HTTP errors must be checked before
        -- decoding the response body so authentication/server failures never
        -- become an ordinary no-offers result.
}

rule BeginLaunching {
    when: instance: Instance.status becomes planned

    -- Create provider instance, upload bootstrap script and job manifest
    ensures: instance.status = launching

    -- legacy annotation: @guidance
        -- The launch sequence:
        -- 1. Create provider instance via API
        -- 2. Record provider instance ID
        -- 3. Ensure agent binary exists in R2 for the computed agent version:
        --    a) use local cache if present
        --    b) otherwise try builders in configured order
        --    c) ssh builders must fail fast on basic connectivity failures
        --       (short connect timeout / single attempt) so fallback builders
        --       (for example Fly) can be tried immediately
        --    d) if every builder fails AND no exact-version object is in R2,
        --       fail asset staging and do not launch the instance. An agent
        --       artifact is executable code whose version must match the
        --       requested version recorded for diagnostics; a stale cached
        --       artifact must never be substituted under that identity.
        --       The staging error preserves the requested version and the
        --       builder failure so the operator can repair agent deployment.
        --       Implementation: internal/agentdeploy/r2.go.
        -- 4. Upload bootstrap shell script to R2
        -- 5. Write agent startup manifest to R2 with job list and environment
        -- The provider's onstart handler fetches and executes the bootstrap script.

        -- Container image defaults are provider-specific. Each Provider
        -- declares its own default image; when LaunchInstance.options
        -- does not specify docker_image, the provider's default applies
        -- (e.g. RunPod defaults to a runpod/* base image published by the
        -- provider itself; Vast.ai has a separate default). User-supplied
        -- overrides MUST be compatible with the provider family — for
        -- RunPod specifically, custom images MUST match the runpod/*
        -- pattern, which the provider itself requires.
        -- Implementation: internal/runpod/cli.go (RunPod image defaults
        -- and override validation).

        -- Provider startup / SSH bootstrap commands are provider-determined.
        -- Some providers (e.g. RunPod) require a specific container start
        -- command so that sshd comes up ready for the agent handshake.
        -- That command is sourced from provider config, not from user
        -- input, and when non-empty MUST be surfaced in diagnosis and
        -- debug output so failed-bootstrap investigations can see what
        -- was actually requested of the provider.
        -- Implementation: RunPod CLI adapter (internal/runpod/cli.go).
        --
        -- RunPod cloud type defaults to "community" to preserve existing
        -- Weft behavior. `[runpod] cloud_type = "secure"` changes the
        -- default; `weft start instance --runpod-cloud-type secure` changes
        -- one manual launch; and job-level intent from `weft run/edit
        -- --runpod-cloud-type secure` or PEP 723 [tool.weft]
        -- runpod-cloud-type changes only those jobs. Job-level intent MUST
        -- stay attached to the group through image splitting/merging and
        -- overrides the provider/config default for offer search and create.
        -- Offer pricing/search and `runpodctl pod create` MUST use the same
        -- cloud type (`secureCloud: true/false` in the price query;
        -- `--cloud-type SECURE|COMMUNITY` at create time), so dry-run cost
        -- estimates match the requested pod class.
        -- Implementation: internal/config/config.go CloudCreateOpts and
        -- internal/runpod/{graphql.go,client.go}.
        --
        -- RunPod SSH bootstrap MUST execute the ssh command returned by
        -- `runpodctl ssh info` with non-interactive options and
        -- IdentitiesOnly=yes. The returned command may include a generated
        -- `-i` identity file; local ssh-agent keys MUST NOT be enumerated
        -- ahead of that identity, because servers can disconnect with
        -- "Too many authentication failures" before the RunPod key is tried.
        -- Implementation: internal/runpod/client.go
        -- (injectNonInteractiveSSHOptions).

        -- Provider credentials fall back to the provider's standard
        -- config file. Agent launchers (autopilot sync loop,
        -- interactive CLI, or another execution path) MUST load provider credentials
        -- from the provider's conventional config path when the
        -- corresponding environment variable is absent — e.g. RunPod
        -- loads RUNPOD_API_KEY from ~/.runpod/config.toml if not in
        -- the environment. This keeps non-interactive flows working
        -- without explicit env plumbing.
        -- Implementation: RunPod CLI adapter credential loader.
}

rule InstanceBecomesReady {
    when: instance: Instance.provider_instance.status becomes running
    requires: instance.status = launching

    ensures: instance.provider_running_at = now
}

rule InstanceStartsRunning {
    when: AgentRegistered(instance)
    requires: instance.status = launching

    ensures: instance.status = running
    ensures: instance.launched_at = now
}

-- ==========================================================================
-- Agent startup probes
-- ==========================================================================
--
-- Before the agent picks up any job from the manifest, it runs two
-- pre-flight probes against the container's local environment. Both
-- probes operate on data shipped in the agent startup manifest written
-- at LaunchInstance step 5 (see BeginLaunching guidance).
--
-- The manifest carries:
--   * requested_disk_gb: the container disk weft asked the provider for
--     (matches Instance.disk_gb). Zero means "skip the disk-cap probe" —
--     used by older Weft versions and the local backend that don't
--     populate this field.
--   * for each job, an `inputs` list of declared asset refs (the union
--     across all jobs in the manifest is the instance's allowed asset
--     set).
--
-- The probes run in this order on every agent boot, including reuse
-- bookings on a recycled rental:
--
--   1. HFCacheHygiene  — frees disk left by prior tenants.
--   2. DiskCapProbe    — verifies the provider didn't silently undersize
--                        the container disk.
--
-- Hygiene runs first so its freed space is reflected in the disk-cap
-- measurement.

rule HFCacheHygiene {
    when: AgentBoots(instance)

    -- The agent walks ~/.cache/huggingface/hub/ and removes any
    -- models--* / datasets--* directory whose corresponding asset ref
    -- (hf:<id> or hf-dataset:<id>) is not present in the union of
    -- declared inputs across all jobs in the current startup manifest.
    -- Directories left over from a previous tenant on a reused
    -- instance are reclaimed; declared inputs (including assets that
    -- were pre-staged onto the instance) are preserved.

    ensures: for dir in hf_hub_dirs(instance):
        asset_ref_for(dir) not in manifest_declared_inputs(instance)
            implies dir.deleted

    -- legacy annotation: @guidance
        -- Runs unconditionally at agent startup, before any job dispatch
        -- and before DiskCapProbe. The deletion is best-effort: a
        -- failure to remove a directory is logged but does not fail the
        -- agent or the instance. Asset-ref derivation reverses the
        -- ScanHFCache mapping in inventory-placement.allium
        -- (models--ns--name -> hf:ns/name, datasets--ns--name ->
        -- hf-dataset:ns/name). Implementation: cmd/agent (HF cache
        -- hygiene at boot).
}

rule DiskCapProbe {
    when: AgentBoots(instance, manifest)
    requires: manifest.requested_disk_gb > 0   -- skipped on older launchers

    -- The agent runs `df` on the container disk and compares the total
    -- capacity to the manifest's requested_disk_gb. If actual total is
    -- less than 85% of requested, the provider has silently capped the
    -- disk (observed on Vast.ai). The agent records the failure and
    -- self-destructs before running any job.

    let actual_gb = container_disk_total_gb(instance)
    let cap_threshold = manifest.requested_disk_gb * 0.85

    if actual_gb < cap_threshold:
        ensures: R2DiskCapFailureUploaded(instance)
            -- written to R2 at instance/<id>/disk-cap-failure.json,
            -- carrying requested_disk_gb, actual_gb, mount, and a
            -- short diagnostic trail
        ensures: instance.status = failed
        ensures: instance.termination_reason = infra_failure
        ensures: instance.termination_detail = "infra-failure:disk-cap"
        ensures: instance.ended_at = now
        ensures: AgentSelfDestructs(instance)

    -- legacy annotation: @guidance
        -- Reason is infra_failure (retryable) so RelaunchAfterInfraFailure
        -- picks the jobs up on a fresh offer. The disk-cap-failure.json
        -- payload at instance/<id>/disk-cap-failure.json is the source
        -- for `weft instance disk-report <id>`. The 85% threshold
        -- tolerates filesystem overhead and reserved blocks while
        -- catching the "asked for 200GB, got 50GB" class of provider
        -- bug. Implementation: cmd/agent disk-cap probe;
        -- internal/cloud/manifest.go CampaignManifest.RequestedDiskGB
        -- and AgentJob.Inputs are the manifest fields consumed here.
}

rule GPUShapePreflightBeforeSpend {
    when: AgentJobSequenceStarts(instance, jobs)

    -- GPU shape (device count + basic visibility) MUST be verified before
    -- any billable setup or HF-prewarm work runs on the instance. Placement
    -- filters offers by GPU count and the runner re-checks availability
    -- just before the user command, but a provider that allocated fewer
    -- devices than the offer advertised was previously only discovered
    -- AFTER the prewarm spend: wb41's 2xA100 jobs completed a full HF
    -- prewarm before gpu_count_preflight failed with one visible A100.

    -- legacy: let required = max(job.gpu_count for job in jobs, default 0)

    if required > 1 and nvidia_smi_enumerable(instance):
        requires: visible_gpu_count(instance) >= required
    if required > 1 and visible_gpu_count(instance) < required:
        ensures: R2GPUCountFailureUploaded(instance)
            -- written to R2 at instance/<id>/gpu-count-failure.json,
            -- carrying requested_gpus, visible_gpus, and the raw
            -- nvidia-smi query output
        ensures: instance.termination_reason = infra_failure
        ensures: AgentSelfDestructs(instance)
            -- before any setup/prewarm begins, so the reconciler requeues
            -- the jobs onto a correctly shaped instance with no wasted
            -- setup spend

    -- legacy annotation: @guidance
        -- Implementation: cmd/agent/gpu_count_probe.go checkGPUCount,
        -- called at the top of runJobSequence (cmd/agent/jobloop.go)
        -- before the setup-prewarm manager can start any work; phase
        -- string "infra-failure:gpu-count-insufficient". Covers both the
        -- manifest path and jobs migrated onto hedge probes. Fail-open
        -- when nvidia-smi is unavailable or unparseable, mirroring the
        -- bootstrap driver probe — failing closed on broken probe tooling
        -- would strand CPU-only instances. Single-GPU jobs (gpu_count
        -- 0/1) never trip it. The runner's gpu_count_preflight
        -- (internal/runner runner.go / single.go) remains the final
        -- AVAILABILITY guard before the user command: this rule checks
        -- physical shape, not concurrent free devices.
}

-- ==========================================================================
-- Completion rules
-- ==========================================================================

rule AllJobsCompleted {
    when: EvaluateAllJobsCompleted(instance, j, jobs)
    requires: instance.status in {running, grace}

    ensures: instance.status = completed
    ensures: instance.termination_reason = completed
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Agent self-destructs after writing completion manifest to R2.
}

-- ==========================================================================
-- Donor lifecycle (data locality)
-- ==========================================================================

-- A donor instance downloads data (HF models, datasets) and signals readiness
-- via an R2 marker. The worker instance then copies from the donor.
rule DonorCompletes {
    when: DonorReadyMarkerFound(instance)
    requires: instance.instance_role = donor
    requires: instance.status = running

    ensures: instance.status = completed
    ensures: instance.termination_reason = completed
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Detected by reconciler checking R2 for donor-ready marker.
        -- Provider instance is destroyed after marker is found.
        -- Worker instances reference donor_instance for data seeding.
}

-- ==========================================================================
-- Reconciler recovery actions
-- ==========================================================================

-- Bootstrap stalled but R2 shows the instance actually completed — accept it.
rule BootstrapCompleteOverride {
    when: BootstrapStalledButCompleted(instance)
    requires: instance.status = launching

    ensures: instance.status = completed
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Checked when bootstrap stall is detected past the warn threshold.
        -- If R2 has a completion manifest, the agent finished despite the
        -- stall appearance. Accept completion rather than terminating.
}

-- All jobs reached terminal state but the agent failed to self-destruct.
rule SelfDestructFailed {
    when: AllJobsTerminalButInstanceLingering(instance)
    requires: instance.status = running
    requires: instance.has_started_job

    -- A superseded attempt (the job migrated to a newer attempt — e.g. a
    -- `weft edit --retry` requeue) is terminal-and-neutral for this launch:
    -- its outcome belongs to the new attempt elsewhere, so it satisfies
    -- termination here and is excluded from the launch verdict.
    -- Without this, a launch whose only job was requeued away is believed to
    -- hold an active job forever and is never reaped (the idle rental runs to
    -- its own time/spend cap).
    requires: instance.jobs.all(j =>
        j.is_terminal
        or j.attempt_outcome in {completed, failed, canceled, orphaned, superseded})

    let deciding = instance.jobs.filter(j => j.attempt_outcome != superseded)
    let all_completed = deciding.all(j =>
        j.attempt_outcome = completed
        or (j.attempt_outcome = null and j.status = completed))
    let all_canceled = deciding.all(j =>
        j.attempt_outcome = canceled
        or (j.attempt_outcome = null and j.status = canceled))
    let any_failed = deciding.any(j =>
        j.attempt_outcome = failed
        or (j.attempt_outcome = null and j.status in {failed, dead, killed}))
    let any_orphaned = deciding.any(j => j.attempt_outcome = orphaned)
    if all_completed:
        ensures: instance.status = completed
        ensures: instance.termination_reason = completed
    else if all_canceled:
        ensures: instance.status = canceled
        ensures: instance.termination_reason = canceled
    else if any_orphaned:
        ensures: instance.status = failed
        ensures: instance.termination_reason = infra_failure
    else:
        -- Includes explicit job failures and any mixed terminal outcome.
        ensures: instance.status = failed
        ensures: instance.termination_reason = job_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Triggered when all jobs reached terminal state but the instance
        -- is still running. Waits self_destruct_linger_threshold (2 min)
        -- after the latest job end_time before forcing cleanup. If no job
        -- end_time is known (end_time was 0/unset), uses
        -- self_destruct_unknown_end_fallback (3 min) as a conservative
        -- synthetic duration that exceeds the threshold, triggering
        -- immediate cleanup.
        -- Requires has_started_job so terminal launch ownership is partitioned:
        -- launches with no started job remain owned by the no-progress
        -- watchdogs (idle-after-ready, bootstrap stall, and provider-status
        -- unavailable) and get their accurate bootstrap_timeout, phase_stall,
        -- or infra_failure reason instead of being reaped here. This also
        -- preserves the vacuous completed case for launches that have actual
        -- execution evidence before all deciding attempts disappear.
        -- Outcome precedence matches TerminalLaunchStatus: all completed,
        -- all canceled, any failed, any orphaned, then generic job_failure.
        -- Canceled launches stay out of failure accounting and the runaway
        -- breaker; orphan-only launches use infra_failure so retryability is
        -- retained. A mixed failed+orphaned launch reports job_failure because
        -- the job-failure branch wins first.
        -- Superseded attempts are dropped from `deciding`, so a launch whose
        -- started jobs all migrated off reaps as completed (empty deciding set
        -- -> vacuously all-completed) rather than failed. Implementation:
        -- campaign.ComputeJobState / hasActiveLaunchJobs skip superseded
        -- attempts; TerminalLaunchStatus then yields completed.
}

-- ==========================================================================
-- Grace period rules
-- ==========================================================================

rule EnterGracePeriod {
    when: job: jobs/Job.status transitions_to failed
    requires: job.cloud_instance != null
    requires: job.cloud_instance.has_grace
    requires: job.cloud_instance.status = running

    let instance = job.cloud_instance

    ensures: instance.status = grace
    ensures: instance.grace_started_at = now
    ensures: instance.grace_deadline = now + instance.grace_period_seconds.seconds

    -- legacy annotation: @guidance
        -- Agent transitions to grace-wait mode, polling R2 every
        -- config.grace_poll_interval for control messages:
        -- jobs (resubmit), extend (add time), release (terminate).
}

rule SubmitJobDuringGrace {
    when: SubmitGraceJob(instance, job)
    requires: instance.status = grace
    requires: instance.grace_deadline > now

    ensures: job.cloud_instance = instance
    ensures: instance.status = running

    -- legacy annotation: @guidance
        -- Submission sequence (DB first, then R2):
        -- 1. claimJobForLaunch: creates job_attempts row, associates
        --    job with instance, assigns run_id (the attempt ID)
        -- 2. Upload sources to R2 (content-addressed, deduped)
        -- 3. Build agent payload using claimed job's LatestRunID
        -- 4. Write GraceJobsRequest to R2 at
        --    grace/<instanceID>/jobs/<requestID>.json
        -- 5. Agent reads, processes, writes ack to
        --    grace/<instanceID>/acks/
        --
        -- If any step after claim fails, claimed jobs are rolled back
        -- to unplaced via resetClaimedJobsToUnplaced.
        --
        -- This ordering guarantees the run_id in the agent payload
        -- matches the DB. See R2RunIDFromDB invariant in status-sync.
}

rule ExtendGracePeriod {
    when: ExtendGrace(instance, additional_duration)
    requires: instance.status = grace

    ensures: instance.grace_deadline = now + additional_duration

    -- legacy annotation: @guidance
        -- Absolute semantics: the new deadline is measured from the
        -- moment the extension is applied (now + additional_duration),
        -- NOT added to the existing deadline. Both the CLI
        -- (cmd/instance.go) and agent (cmd/agent/grace_requests.go) set
        -- the deadline to time.Now().Add(duration). This is what makes
        -- the ResubmittedJobRuntimeDoesNotConsumeGrace invariant cohere:
        -- a fresh idle window starts from the extension point regardless
        -- of how much grace time had already elapsed.
        --
        -- Weft writes duration string to R2 at
        -- grace/<instanceID>/extend/<requestID>.txt.
        -- Agent reads and updates its local deadline.
        -- Default extension: 15 minutes.
}

rule ReleaseGraceInstance {
    when: ReleaseGrace(instance)
    requires: instance.status = grace

    ensures: instance.status = failed
    ensures: instance.termination_reason = job_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Weft writes to grace/<instanceID>/release/<requestID>.txt.
        -- Agent self-destructs cleanly.
}

rule GracePeriodExpires {
    when: instance: Instance.grace_deadline <= now
    requires: instance.status = grace

    -- Wait for agent graceful shutdown before force-destroying.
    -- The agent may still be uploading logs or writing termination intent.
    if instance.grace_deadline + config.grace_shutdown_timeout > now:
        -- Within shutdown window: display-only, do not destroy yet
        ensures: WaitingForAgentShutdown(instance)
    else:
        -- Shutdown window exceeded: force-destroy
        ensures: instance.status = failed
        ensures: instance.termination_reason = job_failure
        ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- After grace deadline passes, Weft waits up to
        -- grace_shutdown_timeout (2 min) for the agent to write its
        -- termination intent and upload final logs. Only force-destroys
        -- the provider instance if no agent response after the window.
        -- If the agent's termination intent is already present, the
        -- reconciler handles it via the normal termination path instead.
}

-- ==========================================================================
-- Failure and termination rules
-- ==========================================================================

rule BootstrapTimeout {
    when: instance: Instance.bootstrap_origin + config.bootstrap_timeout <= now
    requires: instance.status = launching

    ensures: instance.status = failed
    ensures: instance.termination_reason = bootstrap_timeout
    ensures: instance.ended_at = now
}

rule LaunchingPhaseTimeout {
    when: instance: Instance.created_at + EffectiveLaunchingPhaseTimeout(instance) <= now
    requires: instance.status = launching
    requires: instance.bootstrap_origin = null

    ensures: instance.status = failed
    ensures: instance.termination_reason = infra_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Closes the gap where BootstrapTimeout cannot fire because
        -- bootstrap_origin is still null (provider-specific pre-running
        -- step has not recorded launched_at or provider_running_at yet).
        -- Reason is infra_failure (retryable) so RelaunchAfterInfraFailure
        -- applies. The launching goroutine's own context timeout is the
        -- primary bound; this rule is the safety net for a wedged goroutine.
        --
        -- EffectiveLaunchingPhaseTimeout prefers the learned per-provider
        -- bootstrap survival terminate threshold
        -- (BootstrapSurvival.TerminateAfter) and falls back to
        -- config.launching_phase_timeout when the provider's curve has
        -- not learned one. A struct with TerminateLearned false carries
        -- defaults, not evidence, and must not displace the constant.
        -- The survival curve is computed by db.ComputeBootstrapSurvival
        -- (>= 20 samples, terminate cutoff at P(success) < 0.03, floored
        -- at 5 min; defaults to 20 min unlearned), cached on the
        -- reconciler and recomputed every 5 min (survivalCacheTTL in
        -- internal/campaign/reconcile.go).
        -- Implementation: effectiveLaunchingPhaseTimeout in
        -- internal/campaign/instance_check.go.
}

rule SetupStall {
    when: SetupPhaseStalled(instance)
    requires: instance.status = running
    requires: SetupPhaseStartedAt(instance) != null

    ensures: instance.status = failed
    ensures: instance.termination_reason = phase_stall
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
		-- Triggered when setup phase exceeds the effective terminate
		-- threshold with no progress: the learned setup survival value when
		-- one exists for the command+workdir, otherwise
		-- config.setup_stall_timeout. A survival struct carrying unlearned
		-- defaults does not qualify — it is a configured fallback, not a
		-- measurement, and its 25-minute default is tighter than the
		-- 45-minute constant this rule falls back to.
		-- The phase-specific start timestamp is required: launch time and
		-- provider-ready time are not evidence of setup age, so a legacy row
		-- with unknown phase timing cannot be terminated by this rule.
}

rule HedgeCohortCull {
    when: EvaluateHedgeCohortCull(instance)
    requires: instance.agent_ready_at = null
    requires: instance.status in {launching, running}
            -- legacy: and exists sibling: Instance where
                -- legacy: sibling.hedge_cohort_id = instance.hedge_cohort_id
                -- legacy: and sibling.id != instance.id
                -- legacy: and sibling.agent_ready_at != null

    ensures: instance.status = canceled
    ensures: instance.termination_reason = canceled
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Hedge cohort: when the autopilot launches `config.hedge_count`
        -- instances in parallel for a single group, the first to reach
        -- agent_ready is the survivor and the rest are culled. Cull is
        -- strictly preferable to letting losers run to their bootstrap
        -- deadline because:
        --   - Probe instances have no claimed jobs, so culling reclaims
        --     no work.
        --   - Each minute a loser stays alive burns cost without
        --     contributing to throughput.
        --   - Survivor has already proven the hardware class works for
        --     this campaign; we don't need redundant evidence.
        --
        -- The rule is gated on agent_ready_at = null so the survivor
        -- (which by definition has agent_ready_at != null) is never
        -- the one culled. Status is set to canceled rather than failed
        -- because losing a hedged race is not an infrastructure failure.
        -- Implementation: internal/campaign/instance_check.go §1a
        -- (ActionHedgeCull). The pre-computed
        -- HedgeCohortHasReadySibling field on CheckInstanceParams
        -- avoids a per-rule DB query inside the pure-decision
        -- CheckInstance.
}

rule IdleAfterReadyTimeout {
    when: instance: Instance.agent_ready_at + config.idle_after_ready_timeout <= now
    requires: instance.status = running
    requires: instance.agent_ready_at != null
    requires: not instance.has_started_job
    requires: instance.phase = empty

    ensures: instance.status = failed
    ensures: instance.termination_reason = infra_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Closes a watchdog dead-zone introduced once an agent reports
        -- ready: BootstrapTimeout's guard `bootstrap_stage != ready` goes
        -- false, the heartbeat sidecar keeps the heartbeat fresh
        -- independent of agent goroutine progress, and no job-phase
        -- watchdog applies because no phase ever started. Without this
        -- rule, an agent that reaches ready but cannot drain the queue
        -- (R2 read failure, internal hang, supervisor deadlock) burns
        -- cost indefinitely while looking healthy from the outside.
        -- The agent's only post-ready job is to start picking up queued
        -- work, so this window is short (config.idle_after_ready_timeout,
        -- default 15m).
        -- Reason is infra_failure (retryable) so jobs reset to unplaced
        -- and RelaunchAfterInfraFailure picks them up on a fresh offer.
        -- Implementation: internal/campaign/instance_check.go §5a
        -- (ActionIdleAfterReadyTimeout); threshold in
        -- internal/campaign/reconcile.go idleAfterReadyTimeout.
}

rule OnStartScriptMissing {
    when: EvaluateOnStartScriptMissing(instance)
    requires: instance.agent_ready_at = null
    requires: not HasStartedJob(instance)
    requires: OnStartScriptVerification(instance) = confirmed_missing

    ensures: instance.status = failed
    ensures: instance.termination_reason = infra_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Weft read the container and found a start script without its
        -- sentinel: the provider accepted the launch, took the OnStart
        -- command, and never installed it. Nothing can follow from that —
        -- no probe, stage, heartbeat or phase will ever be written — so
        -- the instance is terminated on the evidence, with no window.
        --
        -- This is the only pre-bootstrap rule that fires on a positive
        -- observation rather than an absence conjunction, and the reason
        -- is the failure it catches. Every signal DudVastDetection weighs
        -- is an R2 read of a push mechanism the OnStart script itself
        -- drives, so when the script is what went missing, all six are
        -- absent and absence proves nothing: the container may equally
        -- have no outbound network, or R2 may be unreachable, or the
        -- observer's own network may be down. That is why that rule must
        -- wait out a window. Reading the container is an independent,
        -- pull-based channel that settles the question directly, so this
        -- rule needs no window at all.
        --
        -- OnStartScriptVerification is a three-state observation and only
        -- confirmed_missing is actionable. No SSH details, an unreachable
        -- host, a timeout, and an unreadable file are all unknown, and
        -- unknown falls through to DudVastDetection's timeout — an
        -- instance weft cannot reach is never one whose script is missing.
        -- The check runs only inside the dud window, only once the probe
        -- has been confirmed absent, only before any job has started, and
        -- only after config.onstart_verify_grace. A settled
        -- confirmed_installed verdict is never re-asked and an unknown one
        -- no sooner than config.onstart_verify_unknown_cooldown, so an
        -- instance is reached at over SSH a handful of times at most.
        --
        -- The check applies to vast.ai only, because the premise "sentinel
        -- absent from /root/onstart.sh implies weft's script was not
        -- installed" is provider-specific. RunPod refuses per-pod startup
        -- commands and bootstraps through its template's dockerStartCmd, so
        -- a base-image start script there would read as confirmed_missing
        -- on a healthy pod. Other providers return unknown.
        --
        -- The sentinel is matched by its absence from the script weft
        -- sent, not against any provider's placeholder text: providers
        -- write their own stub when no start script is installed (vast.ai
        -- writes an 82-byte shebang-and-comment file) and that text is
        -- theirs to change. cloud.OnStartSentinel MUST remain a substring
        -- of DefaultOnStartCmd; a rename that breaks the coupling would
        -- confirm-missing every healthy container in the fleet.
        --
        -- Incident wi7309 (2026-08-18): vast.ai stored weft's
        -- --onstart-cmd in its instance record and injected extra_env into
        -- the container, but never materialised the script onto the
        -- filesystem. 86 min, $3.80, zero bootstrap activity. A sibling
        -- rental created in the same second with the same payload probed
        -- at +189s and completed normally.
}

rule DudVastDetection {
    when: EvaluateDudVastDetection(instance)
    requires: not ProviderObservedNotRunning(instance)
    requires: instance.launched_at != null
    requires: instance.agent_ready_at = null
    requires: not OnStartProbeWritten(instance)
    requires: not BootstrapActivitySeen(instance)
    requires: not HeartbeatObserved(instance)
    requires: InstancePhase(instance) = ""
    requires: BootstrapStage(instance) = ""
    requires: now - instance.launched_at >= EffectiveDudVastTimeout(instance)

    ensures: instance.status = failed
    ensures: instance.termination_reason = infra_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Dud-Vast: the provider reports the rental as running but the
        -- container never started. Without this rule we wait the full
        -- adaptive bootstrap deadline (often 90 min+) on launches that
        -- were structurally never going to start.
        --
        -- The OnStart script's first line writes a presigned-URL probe
        -- to instance/<id>/onstart-probe. If that probe never lands,
        -- OnStart never executed, which means either the host docker
        -- daemon failed to actually start the container, the image
        -- pull was blocked, or the offer was a zombie. The bimodal
        -- distribution of probe arrival times (within ~60s OR never)
        -- means a window of this order catches dud rentals without
        -- false-killing slow-but-progressing legitimate ones.
        --
        -- EffectiveDudVastTimeout prefers the learned per-provider
        -- bootstrap survival terminate threshold
        -- (BootstrapSurvival.TerminateAfter) and falls back to
        -- config.dud_vast_timeout when the provider's curve has not
        -- learned one (TerminateLearned false). The curve comes from
        -- db.ComputeBootstrapSurvival (>= 20 samples, terminate cutoff at
        -- P(success) < 0.03, floored at 5 min; defaults to 20 min
        -- unlearned), cached on the reconciler and recomputed
        -- every 5 min (survivalCacheTTL in
        -- internal/campaign/reconcile.go).
        --
        -- The learned value is clamped to config.dud_vast_timeout_ceiling.
        -- This rule reasons about probe ARRIVAL, whose distribution is the
        -- bimodal one described above; BootstrapSurvival measures bootstrap
        -- COMPLETION, a different random variable whose long tail puts its
        -- terminate cutoff beyond an hour on mature providers. Learned data
        -- may extend this window for a provider whose probes genuinely
        -- arrive late, but must not define it, because a quantile of the
        -- wrong distribution silently replaces a constant calibrated to the
        -- right one. Incident wi7309 (2026-08-18): a learned 1h50m bootstrap
        -- threshold was adopted unclamped, so an instance whose container
        -- never received its OnStart script sat 86 min ($3.80) inside an
        -- 8-minute detector that matched it on every other clause.
        --
        -- ProviderObservedNotRunning stands the rule down when the provider
        -- positively reports a non-running, non-empty status (created,
        -- loading). instance.status becomes running when the launch call
        -- returns — "instance is now self-starting" — not when the provider
        -- reaches running, so weft can hold status=running over an instance
        -- the provider has not started yet. That instance has not failed to
        -- bootstrap; it has not been given the chance. Ownership passes by
        -- status: StaleNonRunningStatus takes the pre-running ones, and
        -- ProviderDead takes any the provider reports as terminal. The
        -- guard is scoped to a positive
        -- reading: an unknown provider status is deliberately left to the
        -- unknown-streak bound, which is a designed escape hatch for
        -- interruptible instances whose polling is failing. This mattered
        -- only once dud_vast_timeout_ceiling brought the dud window below
        -- the pre-running p99 — at the old unclamped ~110 min the two never
        -- collided.
        --
        -- Defense-in-depth absence signals. The rule conjoins six
        -- absence signals rather than the single OnStart probe because
        -- each individual R2 read can return an indistinguishable
        -- "empty" for *confirmed-empty* and *couldn't-ask* (R2 5xx,
        -- transient timeout, stale list). Requiring all six to be empty
        -- raises the bar for false-firing on a single flaky read. Every
        -- predicate carries the same correctness obligation: it MUST
        -- distinguish a confirmed-absent observation from a failed
        -- check, and on failure return the safe value (present/seen)
        -- so the conjunction cannot fire on the back of missed reads.
        -- Specifically:
        --   - OnStartProbeWritten: R2 ObjectExists; on R2 error,
        --     returns true (presumed present).
        --   - BootstrapActivitySeen: live_state || R2 stage || DB
        --     transitions; on DB error, returns true.
        --   - HeartbeatObserved: heartbeat key fetched in the dud
        --     window (status=running, pre-ready); on fetch error, the
        --     synced state retains no heartbeat-absent claim.
        --   - InstancePhase, BootstrapStage: same R2 fetch path.
        -- Incident 2026-05-28 (wi3273, wi3280): a transient R2 5xx
        -- during the OnStart probe existence check caused a healthy
        -- instance to be classified as dud and terminated at the 9
        -- minute mark. The defensive policy above is the response.
        --
        -- Reason is infra_failure (retryable): the orphaned jobs reset
        -- to unplaced and RelaunchAfterInfraFailure picks them up on a
        -- fresh offer (preferably on a different host, since the
        -- survival model now records the failed machine_id).
        --
        -- Implementation: internal/campaign/instance_check.go §4d
        -- (ActionEmptyStatusTimeout with "dud Vast" stall message);
        -- threshold via effectiveDudVastTimeout in the same file.
        -- SyncInstanceState populates the absence signals for both the
        -- watch and reconcile paths via internal/campaign/sync_state.go,
        -- where the on-error defaults above are enforced. The dud
        -- window (LaunchedAt != nil and AgentReadyAtUnix == nil) gates
        -- the OnStart probe and heartbeat fetches to keep healthy-
        -- fleet reconcile passes cheap.
        --
        -- Open: the dud window now rides the survival framework, but
        -- only at provider granularity and only on a borrowed curve.
        -- Two gaps remain. (1) Stratification: bootstrap survival is
        -- computed per provider, not per (provider, data_center), so a
        -- single bad data center is averaged into its provider's
        -- threshold. (2) Curve fit: dud detection reuses the bootstrap
        -- curve, which models time-to-bootstrap, not time-to-probe-
        -- arrival — the events have different shapes (probe arrival is
        -- ~60s-or-never; bootstrap completion is a long tail), so a
        -- dud-specific survival curve would fit better than the
        -- borrowed one. Gap (2) is now bounded rather than open: the
        -- borrowed threshold is clamped to dud_vast_timeout_ceiling, so
        -- a long-tail bootstrap quantile can no longer redefine the
        -- probe-arrival window (docs/decisions/0008). The clamp is a
        -- bound, not a fit; a dedicated curve is still the right fix.
        -- RQ-E2 covers tuning the bootstrap/first-registration survival
        -- cutoffs; these two remain tracked separately.
}

rule OnStartChainWatchdog {
    when: EvaluateOnStartChainWatchdog(instance)
    requires: instance.agent_ready_at = null
    requires: not HasStartedJob(instance)
    requires: InstancePhase(instance) = ""
    requires: BootstrapStage(instance) = ""
    requires: (OnStartStage(instance) != ""
               and (IsOnStartFailureStage(OnStartStage(instance))
                    or now - OnStartStageChangedAt(instance) >= EffectiveOnStartStallTimeout(instance)))
              or (FirstOnStartProbeSeen(instance) != null
                  and now - FirstOnStartProbeSeen(instance) >= EffectiveOnStartTotalActiveTimeout(instance))

    ensures: instance.status = failed
    ensures: instance.termination_reason = infra_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Closes the gap DudVastDetection deliberately leaves. Dud
        -- detection fires only when NO OnStart probe landed — "the
        -- container never started." But the OnStart shell can run far
        -- enough to write its probe and then DIE during the apt/uv/rclone
        -- install, before bootstrap.sh ever runs. In that window:
        --   - DudVastDetection is suppressed (probe present is a sign of
        --     life; the rule defers to "a downstream adjudicator"), and
        --   - the bootstrap `failed:` marker (BootstrapStalled rule) never
        --     appears, because that marker is written by bootstrap.sh,
        --     which never started, and
        --   - no job phase or heartbeat exists yet,
        -- so the ONLY adjudicator left was the adaptive bootstrap deadline
        -- (often 1h+). Incident wi4102 (2026-06-25): apt-get hung inside
        -- the OnStart install loop; the instance billed ~95 min before the
        -- deadline would have reaped it, blocking its job (wj3392) the
        -- whole time.
        --
        -- The OnStart shell overwrites instance/<id>/onstart-stage at each
        -- step (last-write-wins), so the marker's value is the last step
        -- reached and its R2 last-modified time is when the step advanced.
        -- Two sub-cases:
        --   - IsOnStartFailureStage: the marker is a definitive failure
        --     token (apt-failed, uv-failed, rclone-failed,
        --     rclone-missing-exit) — terminate immediately. This set MUST
        --     stay in sync with DefaultOnStartCmd in internal/cloud/types.go.
        --   - Stall: an in-progress token (apt-installing, etc.) unchanged
        --     for EffectiveOnStartStallTimeout — the chain hung (e.g. an
        --     unresponsive apt mirror) and will not recover.
        --   - Total-active cap: the marker's R2 last-modified anchors the
        --     stall sub-case, so a provider that re-runs a failed OnStart
        --     from the top (RunPod restarts the container on OnStart exit)
        --     rewrites the marker every loop — it looks perpetually fresh
        --     while the chain never progresses to bootstrap.sh, so the stall
        --     sub-case never trips and the instance bleeds to the adaptive
        --     deadline. FirstOnStartProbeSeen is set once (first probe
        --     observation, never overwritten), so now - FirstOnStartProbeSeen
        --     >= EffectiveOnStartTotalActiveTimeout reaps the looping
        --     instance. Incident wi5105 (2026-07-12): a RunPod OnStart
        --     looped started↔deps-ready for ~90 min ($1.02) because the
        --     churning marker defeated the stall sub-case.
        --
        -- The stage requirement is scoped to the two sub-cases that read a
        -- stage. The total-active cap needs only FirstOnStartProbeSeen, and
        -- requiring a stage for it too left a hole: the probe can land and
        -- NO stage ever follow, when the OnStart shell dies between its
        -- first line and its first stage write, or when the provider injects
        -- the env carrying the probe URL but never materialises the script
        -- itself. In that window DudVastDetection is suppressed (the probe
        -- is a sign of life), the failure-token and stall sub-cases have no
        -- stage to read, and a stage-gated cap cannot fire either — so no
        -- rule adjudicates and the instance bleeds to the adaptive deadline.
        -- Incident wi7306 (2026-08-18): probe landed, no stage ever written,
        -- 117 min billed.
        --
        -- Both duration sub-cases prefer the learned setup survival
        -- terminate threshold (SetupSurvival.TerminateAfter, computed by
        -- db.ComputeSetupSurvival per command+workdir, falling back to
        -- workdir-only, then all jobs; >= 20 samples, terminate cutoff at
        -- P(success) < 0.03, floored at 10 min). On insufficient data the
        -- curve reports defaults with TerminateLearned false, and the
        -- constants above govern instead. Cached on the reconciler and recomputed
        -- every 5 min (survivalCacheTTL in
        -- internal/campaign/reconcile.go). Note this is SETUP survival,
        -- not the per-provider bootstrap survival used by
        -- LaunchingPhaseTimeout and DudVastDetection.
        --
        -- When a learned setup threshold is present, the sub-cases collapse
        -- to the SAME duration: EffectiveOnStartStallTimeout and
        -- EffectiveOnStartTotalActiveTimeout both resolve to
        -- SetupSurvival.TerminateAfter. The legacy relationship between
        -- the constants — total-active set generously above the stall
        -- window so a slow but genuinely progressing OnStart is not
        -- clipped — therefore holds only in the fallback case
        -- (config.onstart_stall_timeout 10 min vs
        -- config.onstart_total_active_timeout 25 min). With learned data
        -- the sub-cases differ only in anchor: the stall window is
        -- measured from the last stage-marker change, the total-active cap
        -- from the first probe sighting. The looping-provider case is
        -- still caught, because the churn refreshes the stall anchor but
        -- never the total-active one — but the reap deadline can be
        -- learned as high as ~60 min (setup survival MaxTimeSecs),
        -- versus the old hard 25-minute cap. That weakening is an
        -- accepted trade-off; see
        -- docs/decisions/0005-let-learned-setup-survival-govern-onstart-watchdogs.md.
        --
        -- Gated pre-bootstrap (BootstrapStage = ""), pre-ready, pre-job: once
        -- bootstrap.sh writes a stage, or the agent reaches ready, or a job
        -- phase appears, the bootstrap-deadline / idle-after-ready / heartbeat
        -- watchdogs own the adjudication and OnStartStage is no longer fetched.
        --
        -- Reason is infra_failure (retryable): orphaned jobs reset to
        -- unplaced and relaunch on a fresh offer, same as DudVastDetection.
        --
        -- Implementation: internal/campaign/instance_check.go §4e/4f/4g
        -- (ActionBootstrapStalled); thresholds via
        -- effectiveOnStartStallTimeout and
        -- effectiveOnStartTotalActiveTimeout in the same file.
        -- SyncInstanceState fetches the OnStart stage marker
        -- (body + R2 last-modified) in the same pre-job window
        -- as the bootstrap stage, via internal/campaign/sync_state.go, and
        -- persists FirstOnStartProbeSeenUnix set-once on first probe sighting.
}

rule StructuredJobProgressStalls {
    when: EvaluateStructuredJobProgressStalls(instance, job, live_state)
    requires: instance.phase = running(job)
    requires: instance.live_state.active_job = job
    requires: instance.live_state.job_progress != null
    requires: instance.live_state.job_progress_changed_at != null
    requires: now - instance.live_state.job_progress_changed_at >= config.running_stall_timeout

    ensures: instance.status = failed
    ensures: instance.termination_reason = phase_stall
    ensures: instance.ended_at = now
    ensures: job.status = queued

    -- legacy annotation: @guidance
        -- The progress timestamp changes only when the structured
        -- (job, phase, percent) tuple changes. Repeated Progress lines with
        -- the same value, log growth, CPU/GPU activity, and agent heartbeats
        -- do not reset it. A fresh heartbeat therefore does not suppress a
        -- confirmed task stall.
        --
        -- The rule is opt-in through instrumentation: no Progress report
        -- means unknown task progress, not confirmed absence. Such jobs stay
        -- bounded by their explicit max-time and max-spend controls.
        -- Implementation: launch_live_state.job_progress_changed_at and
        -- internal/campaign/instance_check.go rule 5c.
}

rule HeartbeatStaleWarningAfterReady {
    when: EvaluateHeartbeatStaleWarningAfterReady(instance, provider_instance)
    requires: instance.agent_ready_at != null
    requires: HeartbeatAge(instance) > config.heartbeat_stale_threshold
    requires: not (instance.provider_instance != null
                   and instance.provider_instance.status in {stopped, offline})

    ensures: StaleHeartbeatWarningShown(instance)
    ensures: AgentLivenessProbeScheduled(instance)

    -- legacy annotation: @guidance
        -- Heartbeat is a control-plane liveness signal, not proof that the
        -- user's task is advancing. Age alone is display-only and schedules
        -- the reconciler's SSH probe; it never authorizes teardown.
        --
        -- Yields to ProviderInstancePaused when the provider reports
        -- stopped/offline: a paused container stops writing heartbeats,
        -- so without this carve-out the stale-agent watchdog would
        -- always fire first and we'd destroy paused-but-recoverable
        -- instances. on-demand instances can be paused too (credit low,
        -- host maintenance, abuse review), so the gate is not limited
        -- to interruptible types.
        --
        -- Provider list absence is NOT a kill signal. Vast.ai's list
        -- endpoint exhibits both false negatives (omitting live
        -- instances during transient API gaps) and stale positives
        -- (continuing to report destroyed instances briefly). Treating
        -- "missing from list" as evidence of death produced 25-minute
        -- false-kill windows on healthy instances and corrupted survival
        -- statistics. Heartbeat presence in R2 — written directly by
        -- the agent — is a strictly stronger signal.
        --
        -- ShowInstance fallback: when the bulk list omits an instance,
        -- the reconciler issues a per-instance ShowInstance lookup
        -- before treating the instance as missing. Only an explicit
        -- per-ID terminal status (see ProviderInstanceDied) is treated
        -- as provider-confirmed death.
        --
        -- Cases not covered by this rule:
        --   - Bootstrap never completes (agent_ready_at never set):
        --     handled by the bootstrap-deadline watchdog.
        --   - Provider explicitly reports terminal status: handled by
        --     ProviderInstanceDied with hysteresis.
        --
        -- Implementation: internal/campaign/instance_check.go §4a
        -- (ActionEmptyStatusTimeout).
}

rule ProviderStatusUnknownDefersTermination {
    -- Provider status unknown ≠ dead for interruptible instances: when
    -- status polling itself is failing, a watchdog cannot distinguish
    -- "outbid, recoverable" from "dead" and must defer termination.
    when: EvaluateProviderStatusUnknownDefersTermination(instance)
                                             -- stall, bootstrap/launching timeout
    requires: instance.instance_type = interruptible
    requires: ProviderStatusUnknown(instance)
    requires: ProviderStatusUnknownFor(instance) < config.stale_pause_timeout

    ensures: instance.status not in {failed, completed, cancelled}
    -- legacy: ensures: no provider destroy is issued

    -- legacy annotation: @guidance
        -- ProviderStatusUnknown means the most recent provider poll for
        -- this launch yielded no instance data and a non-nil error (e.g.
        -- `vastai show instances` timing out on a slow network). It is
        -- distinct from a poll that succeeded and reported a non-running
        -- status (handled by ProviderInstancePaused / ProviderInstanceDied)
        -- and from "never polled".
        --
        -- An outbid interruptible instance stops heartbeating and making
        -- phase progress while it waits for resume or a bid raise. When
        -- status polls are also failing, the stale-heartbeat, running-stall,
        -- and bootstrap/launching timeout watchdogs would otherwise
        -- terminate it — conflating a network problem with instance death.
        -- Motivating incident: wj3741 was orphaned 16 consecutive times
        -- while the daemon logged 129 consecutive "vastai show instances
        -- timed out" errors and provider_status_transitions recording
        -- stopped entirely.
        --
        -- The deferral is bounded by config.stale_pause_timeout (the same
        -- bound the pause-wait path uses): once provider status has been
        -- continuously unknown that long, the watchdogs terminate as usual.
        -- The unknown window is tracked per launch across reconcile passes
        -- and resets on any poll that returns instance data.
        --
        -- Non-interruptible launches are never deferred, and nothing
        -- changes when polls succeed. Provider-dead detection
        -- (ProviderInstanceDied) remains gated on a successful poll.
        --
        -- Implementation: deferTerminationForUnknownStatus and
        -- CheckInstanceParams.ProviderStatusUnknownFor in
        -- internal/campaign/instance_check.go;
        -- Reconciler.noteProviderStatusPoll in
        -- internal/campaign/reconcile.go.
}

rule HeartbeatStale {
    when: HeartbeatStale(instance)
    requires: instance.status = running

    ensures: instance.status = failed
    ensures: instance.termination_reason = infra_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Triggered when heartbeat age exceeds config.heartbeat_stale_threshold
        -- and agent is unreachable. This proves agent loss only; it is
        -- independent of structured task-progress stall detection.
        --
        -- Probe evidence: an SSH probe that reaches the host and reports
        -- the agent process gone is positive evidence and terminates
        -- immediately. A probe ERROR (host unreachable) is unknown, and
        -- termination on unknown requires BOTH hysteresis minimums:
        -- at least min_probe_failure_attempts consecutive failed probes
        -- AND at least min_probe_failure_window of elapsed time since
        -- the first failure. Either minimum alone is insufficient — two
        -- SSH blips one reconcile tick apart (an observer-side network
        -- flap) satisfy the window but not the count, and rapid retries
        -- satisfy the count but not the window. Any successful probe or
        -- fresh heartbeat clears the accumulated failure state.
        -- CheckInstance may surface stale heartbeat as display-only, but it
        -- must not return a destructive action from heartbeat age alone. The
        -- reconciler-specific probe path is the sole authority to initiate
        -- stale-heartbeat teardown. The wi6900 report exposed that direct
        -- decision branch, but neither a successful probe nor an advancing
        -- log would have established semantic task progress.
        --
        -- Ordering: the provider destroy MUST succeed before the launch
        -- is marked failed and its jobs are requeued. A failed destroy
        -- (provider API unreachable) leaves the instance possibly still
        -- running its job; requeueing then risks a double run against
        -- the abandoned attempt. On destroy failure the terminal
        -- transition is deferred to a later reconcile pass, keeping the
        -- accumulated probe-failure hysteresis so the retry does not
        -- restart the confirmation window.
        -- The termination executes through the same side-effect pipeline
        -- as every other reconcile watchdog (ActionStaleHeartbeat via
        -- executeReconcileAction): R2 job-completion sync before the jobs
        -- are reset, ExecuteAction's destroy-before-mark, the oplog
        -- entry, and disk-failure report processing when the reason
        -- refines to disk_full.
        -- Implementation: internal/campaign/reconcile.go
        -- checkStaleHeartbeat / executeReconcileAction;
        -- internal/campaign/instance_check.go ExecuteAction.
}

rule ProviderInstanceDied {
    when: instance: Instance.provider_instance.status becomes exited
    requires: instance.status in {launching, running, paused}

    ensures: instance.status = failed
    ensures: instance.termination_reason = provider_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Grace-period instances are deliberately excluded from this
        -- rule (instance_check.go skips the provider-dead path when
        -- status = grace): a transient provider-API failure must not
        -- kill an active grace session. Grace instances reach terminal
        -- status via GracePeriodExpires / ReleaseGraceInstance instead.
        --
        -- A concrete terminal provider status (exited, destroyed, error,
        -- dead) reported for a specific instance is terminal. A missing
        -- row from a provider-wide batch list is NOT a terminal signal:
        -- the bulk list endpoint may transiently omit live instances.
        -- When the batch lookup misses an instance, reconcile falls back
        -- to a per-instance ShowInstance call to confirm; only an
        -- explicit per-ID terminal status — a non-nil instance in a
        -- terminal state — is treated as provider-confirmed death.
        -- Per-ID not-found is NOT sufficient to initiate termination:
        -- the per-instance lookup transiently reports not-found for
        -- still-booting instances, so confirmed-absence reaping falls to
        -- the heartbeat/bootstrap watchdogs, which not-found does not
        -- defer (contrast ProviderStatusUnknownDefersTermination).
        -- Not-found does confirm an *expected* destroy: for a launch
        -- carrying a termination intent, per-ID not-found marks the
        -- destroy succeeded (providerConfirmedTerminal in
        -- internal/campaign/reconcile.go); for a launch that is already
        -- terminal, the safety-net sweep does the same (see
        -- ReconcileOrphanedProviderInstance).
        -- A launch that was never polled this pass — no provider ID
        -- recorded yet because the create call is still in flight, or
        -- no client configured for its provider in this session — is
        -- unknown, never dead. Treating never-polled as dead reaped
        -- launches mid-create (2026-05-15: 16 launches failed with
        -- "provider returned no instance", no provider ID recorded).
        -- Agent liveness is otherwise checked by HeartbeatStale, not by list
        -- absence. Task progress is evaluated separately.
        -- Implementation: internal/campaign/reconcile.go
        -- (providerConfirmedTerminal) and
        -- internal/campaign/instance_check.go rule 7.
}

rule ProviderInstancePaused {
    when: instance: Instance.provider_instance.status becomes stopped
    requires: instance.status in {launching, running, grace}

    ensures: instance.status = paused
    if instance.instance_type = interruptible
       and instance.on_demand_ref_cents != null:
        ensures: instance.max_bid_price_cents <= instance.on_demand_ref_cents

    -- Provider stopped the instance: per-instance preemption (outbid spot),
    -- manual stop, or account-wide credit pause. The launch flips to the
    -- non-terminal `paused` state and waits for the provider to resume it.
    -- For interruptible launches, weft first attempts to raise the provider
    -- bid up to the launch's recorded on-demand reference cap.
    -- Applies regardless of the pause_tolerant flag, so account-wide pauses
    -- are caught even on on-demand rentals.
    -- legacy annotation: @guidance
    -- Implementation: internal/campaign/instance_check.go §4a-pause
    -- (ActionPause) plus internal/campaign/reconcile.go
    -- maybeRaiseInterruptibleBid. No DestroyProvider, no ResetJobs —
    -- jobs stay attached to the rental so they pick up where they left
    -- off when the provider resumes.
}

rule ProviderInstanceResumes {
    -- A previously paused launch is observed in provider "running" state
    -- again. Move back to running so jobs resume normally.
    when: instance: Instance.provider_instance.status becomes running
    requires: instance.status = paused

    ensures: instance.status = running

    -- legacy annotation: @guidance
        -- Implementation: internal/campaign/instance_check.go §4a-resume
        -- (ActionResume). UpdateLaunchStatus uses COALESCE on launched_at
        -- so bootstrap-survival metrics stay anchored to the original
        -- launch, not the resume time.
}

rule StalePlannedLaunchReap {
    -- A launch left in 'planned' status with no provider instance ID
    -- past the configured threshold is an abandoned LaunchInstance call
    -- (provider error or panic before CreateInstance returned). Reap it
    -- so CampaignCompleted/CampaignFailed can settle. The reaper never
    -- touches a provider — by definition these rows have no provider
    -- instance to destroy.
    when: instance: Instance.status = planned
    requires: instance.provider_instance_id = ""
    requires: (now - instance.created_at) > config.stale_planned_launch_age

    ensures: instance.status = canceled
    ensures: instance.termination_reason = canceled
    -- legacy: ensures: instance.termination_detail contains "reaped"
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Implementation: internal/campaign/orphan_sweep.go
        -- (SweepStalePlannedLaunches), invoked alongside the orphan sweep
        -- in the reconcile loop. Counterpart to SweepOrphanedInstances:
        -- orphan sweep covers the case where a provider instance exists
        -- but weft's DB row is gone or terminal (deferring the mid-create
        -- state where both exist but the launch has not yet recorded its
        -- provider ID — see status-sync.allium ReconcilePass); this
        -- reaper covers the opposite case where weft has a DB row but no
        -- provider instance was ever created. Surfaced as a dashboard alert ("X planned
        -- cloud launches stuck") via stalePlannedLaunches() in
        -- internal/ui/dashtabs/view_alerts.go.
}

rule PausedInstanceStale {
    -- A launch that has been paused since before
    -- now - config.stale_pause_timeout has almost certainly lost its bid
    -- (interruptible) or will not be resumed by the provider (account pause).
    -- Fail it so RelaunchAfterInfraFailure picks a fresh offer.
    when: instance: Instance.provider_instance.status = stopped
    requires: instance.status in {launching, running, paused, grace}
    requires: (now - instance.last_provider_status_change_at) > config.stale_pause_timeout

    ensures: instance.status = failed
    -- legacy: ensures: instance.termination_reason = preempted if instance.pause_tolerant else provider_failure
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Implementation: internal/campaign/instance_check.go §4a-pause
        -- (stalePauseTimeout branch). Jobs not in a terminal state are
        -- reset to unplaced so the standard relaunch path carries them
        -- onto a fresh instance.
}

rule DiskFullDetected {
    when: DiskFull(instance)
    requires: instance.status in {running, grace}

    ensures: instance.status = failed
    ensures: instance.termination_reason = disk_full
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- Detected via heartbeat reporting < 5% disk free.
}

-- ==========================================================================
-- User-initiated termination
-- ==========================================================================

rule UserTerminatesInstance {
    when: UserTerminate(instance)
    requires: instance.status in {launching, running, paused, grace}

    ensures: instance.status = canceled
    ensures: instance.termination_reason = canceled
    ensures: instance.termination_requested_at = now
    ensures: instance.ended_at = now

    -- legacy annotation: @guidance
        -- User-initiated termination calls the matching provider directly.
        -- Before the external call, Weft durably records a non-terminal
        -- destroy intent. The provider destroy must succeed before the launch
        -- is marked canceled or its jobs are reset; an API error leaves those
        -- execution states unchanged so the still-running attempt cannot race
        -- a replacement attempt. The intent lets a restart treat provider
        -- not-found as confirmation of this expected destroy and finish the
        -- local transition instead of leaving a running DB row indefinitely.
        -- After destroy succeeds, termination_requested_at is stamped, the
        -- launch becomes canceled, and its non-terminal jobs become unplaced.
        -- Implementation: internal/orchestration/instance_lifecycle.go.
}

rule UserTerminatesCampaign {
    when: UserTerminateCampaign(campaign)
    requires: campaign.status in {launching, running}

    ensures:
        for instance in campaign.active_instances:
            UserTerminate(instance)
    ensures: campaign.status = canceled
    ensures: campaign.ended_at = now
}

-- ==========================================================================
-- Relaunch (retry on infrastructure failure)
-- ==========================================================================

rule RelaunchAfterInfraFailure {
    when: instance: Instance.status transitions_to failed
    requires: instance.is_retryable

    ensures: Instance.created(
        campaign: instance.campaign,
        replaced_instance: instance,
        gpu_spec: instance.gpu_spec,
        gpu_class: instance.gpu_class,
        gpu_mem_gb: instance.gpu_mem_gb,
        num_gpus: instance.num_gpus,
        docker_image: instance.docker_image,
        offer: instance.offer,
        provisioned_inputs: instance.provisioned_inputs,
        grace_period_seconds: instance.grace_period_seconds,
        status: planned,
        created_at: now
    )
    ensures:
        for job in instance.jobs where job.status not in {completed, canceled, killed}:
            job.cloud_instance = new_instance

    -- legacy annotation: @guidance
        -- Infrastructure failures (provider_failure, infra_failure,
        -- bootstrap_timeout, phase_stall, preempted) are automatically
        -- relaunched on a different provider instance. Job-level failures
        -- (job_failure, disk_full) are not retried automatically.
        -- Torch CUDA preflight failures are infra_failure because the
        -- preflight runs before user code; they are auto-retried up to
        -- three distinct failed instances, with known failed machine_ids
        -- excluded from subsequent offer selection for that job.
        --
        -- Canceled and killed jobs are excluded: a user-issued cancel/kill
        -- is a durable retraction intent. Carrying those jobs onto the
        -- replacement instance would silently re-provision capacity the
        -- user already declined. See CancelSurvivesInstanceTermination
        -- in specs/job-lifecycle.allium.
        --
        -- Retry limiters apply to EVERY automatic placement path. The
        -- relaunch pass first tries to place orphaned jobs onto already
        -- running instances (reuse) before creating fresh ones; the
        -- per-job attempt cap and retry backoff gate both paths
        -- identically, because a submit that succeeds is not evidence
        -- the job will stick — an instance that keeps bouncing a job
        -- would otherwise re-accept it every pass without bound (a
        -- non-convergent repair loop). The runaway breaker is the ONE
        -- limiter the reuse pass is exempt from: the breaker gates new
        -- instance creation, and a tripped breaker must not strand a
        -- consumer whose --needs producer is already running on a
        -- paid-up instance.
        -- Implementation: internal/campaign/relaunch.go
        -- ReuseRetryBlocked (shared cap + backoff gate), used by
        -- tryPlaceOntoExistingInstances and by the autopilot
        -- reuse-assignment path
        -- (internal/orchestration/autopilot.go
        -- submitAutoPilotReuseAssignments); the eligibility loop in
        -- RelaunchOrphanedJobs re-evaluates the same limits and records
        -- the skip events.
}

-- ==========================================================================
-- Campaign status derivation
-- ==========================================================================

rule CampaignCreated {
    when: CampaignLaunchRequested(groups)
    ensures: Campaign.created(status: planned)
}

rule CampaignLaunching {
    when: instance: Instance.status transitions_to launching
    requires: instance.campaign != null
    let campaign = instance.campaign
    requires: campaign.status = planned

    ensures: campaign.status = launching
}

rule CampaignRunning {
    when: instance: Instance.status transitions_to running
    requires: instance.campaign != null
    let campaign = instance.campaign
    requires: campaign.status = planned or campaign.status = launching

    ensures: campaign.status = running
}

-- A terminal instance can leave a job requeued for relaunch. Both rules
-- below hold the campaign open until every job that ran on it is terminal,
-- so the autopilot's relaunch lands on a still-running campaign instead of
-- being stranded on one that has already ended.

rule CampaignCompleted {
    when: EvaluateCampaignCompleted(campaign, i, instances, j, jobs)
    requires: campaign.status = launching or campaign.status = running
    requires: campaign.instances.all(i => i.status = completed)
    requires: campaign.jobs.all(j => j.is_terminal)

    ensures: campaign.status = completed
    ensures: campaign.ended_at = now
}

rule CampaignFailed {
    when: EvaluateCampaignFailed(campaign, i, instances, j, jobs)
    requires: campaign.status = launching or campaign.status = running
    requires: campaign.instances.any(i => i.status != completed)
    requires: campaign.jobs.all(j => j.is_terminal)

    ensures: campaign.status = failed
    ensures: campaign.ended_at = now

    -- legacy annotation: @guidance
        -- The jobs.all(j => j.is_terminal) condition is evaluated against
        -- the canonical per-job effective status, NOT the per-attempt status
        -- echoed by historical launch_job_membership rows. A job whose
        -- latest attempt completed elsewhere is terminal even if a
        -- historical attempt on one of this campaign's launches was
        -- closed with status='queued' (e.g. the orphaned/superseded
        -- attempt-status rewrite paths). Implementation:
        -- allCampaignJobsTerminal in internal/campaign/reconcile.go
        -- queries the job_status view by job ID rather than reading
        -- attempt-level status off the membership row.
        --
        -- LaunchInstance failure paths that stamp campaign.status=failed
        -- directly (no-instance-launched, first-worker-registration
        -- timeout) MUST first cancel any non-terminal launches in the
        -- campaign, or the instances.all(i => i.is_terminal) when-clause
        -- is violated. Implementation:
        -- cancelNonTerminalCampaignInstances in
        -- internal/campaign/lifecycle.go.
}

-- ==========================================================================
-- Runaway prevention (defense in depth)
-- ==========================================================================

-- Every Instance reaches terminal status within a bounded wall-clock
-- window of creation, regardless of provider responsiveness. Four layers,
-- outermost-in:
--
--   1. Offer-time filters — config.offer_min_reliability plus the
--      SurvivalModel / MachinePenalty score used by FilterOffersBySurvival.
--   2. Per-instance kill rules (see §Failure and termination rules) —
--      LaunchingPhaseTimeout, BootstrapTimeout, IdleAfterReadyTimeout,
--      SetupStall, HeartbeatStale, ProviderInstanceDied, DiskFullDetected,
--      GraceExpired.
--   3. Adaptive phase thresholds — BootstrapSurvival / SetupSurvival
--      override the static bootstrap_/setup_ defaults when sample size is
--      sufficient; refreshed every config.survival_cache_ttl.
--   4. Per-scope churn breaker — RunawayBreakerTrips / RunawayBreakerClears
--      pause auto-relaunch when a campaign+project churns without progress.
--
-- The top-level bound is formalised by invariant InstanceEventuallyTerminal.

-- --------------------------------------------------------------------------
-- Runaway breaker (per-scope churn limiter)
-- --------------------------------------------------------------------------

-- The runaway breaker pauses automatic relaunches when repeated failures
-- indicate a systemic problem (bad GPU class, broken setup, etc.).
-- Tracked via lifecycle_events: relaunch.runaway_tripped / _resumed.

rule RunawayBreakerTrips {
    when: RelaunchEvaluated(instance)
    requires: config.runaway_enabled

    -- Trips when BOTH conditions hold within the lookback window:
    -- 1. Zero job completions (no progress)
    -- 2. At least one of:
    --    - Max trailing orphaned chain >= chain_no_progress_limit
    --    - Total orphaned attempts >= orphan_churn_limit
    --    - Distinct infrastructure-failed launches >= infra_failure_limit
    --    - Total spend >= spend_no_progress_limit_cents
    --
    -- Orphan and chain tallies EXCLUDE attempts whose launch ended for an
    -- infrastructure-side reason (provider_failure, infra_failure,
    -- bootstrap_timeout, phase_stall, preempted). These infra-side failures
    -- are counted separately by DISTINCT launch, not by affected job attempt:
    -- one failed rental carrying nine queued jobs contributes one
    -- infrastructure-weather sample. Spend is NOT filtered (infra failures
    -- still cost money) and remains the cost backstop. An infra-side orphan
    -- in the middle of a chain is neutral: it doesn't extend the chain but
    -- doesn't break it either, so two real orphans bracketing infra noise
    -- still count as a chain of two. Unknown / empty termination_reason is
    -- NOT treated as infra — unattributed failures still count, otherwise
    -- the breaker has a hole.

    -- legacy: let scope = instance.campaign.id ++ ":" ++ instance.project
    let window = config.runaway_lookback_window
    -- legacy: let resume_floor = latest RunawayBreakerResumed(scope)
                       -- legacy: + config.runaway_resume_grace_period
    let accounting_window = max(now - window, resume_floor)
    -- legacy: let completions = count completed jobs in scope after accounting_window
    -- legacy: let chain = max trailing non-infra orphaned attempt chain in scope after accounting_window
    -- legacy: let orphans = count non-infra orphaned attempts in scope after accounting_window
    -- legacy: let infra_failures = count distinct infra-failed launches in scope after accounting_window
    -- legacy: let spend = sum actual_spend_cents in scope after accounting_window

    if completions = 0
       and (chain >= config.runaway_chain_no_progress_limit
            or orphans >= config.runaway_orphan_churn_limit
            or infra_failures >= config.runaway_infra_failure_limit
            or spend >= config.runaway_spend_no_progress_limit_cents):
        ensures: RunawayBreakerTripped(scope)
        ensures: RelaunchBlocked(instance)

    -- legacy annotation: @guidance
        -- Scoped per campaign+project. The breaker prevents new instance
        -- launches but does not terminate running instances. It also does
        -- NOT block placement of unplaced jobs onto already-running
        -- instances via cloud-reuse: that path bypasses provider offer
        -- search and so cannot contribute to the churn the breaker exists
        -- to stop. RelaunchAfterInfraFailure performs a reuse pass before
        -- evaluating the breaker so consumers of running producers can
        -- still co-locate while the breaker is tripped.
        -- Failures during the manual-reset grace period are ignored for the
        -- next accounting window, so a reset gives fresh launches a real
        -- chance before the breaker can trip again.
        -- Recorded as lifecycle_event kind=relaunch.runaway_tripped.
        -- Event volume: a blocked pass records relaunch.runaway_blocked
        -- at most once per (trip, scope) per relaunch process (the dedup
        -- registry is process-local), not once per pass — the breaker
        -- blocks every autopilot pass while tripped, and per-pass rows
        -- record no state change. Likewise the relaunch pass-summary
        -- event is written only for passes with activity (eligible,
        -- launched, skipped, or errored jobs), never for no-op passes.
        -- Implementation: internal/campaign/relaunch.go evaluateRunawayBreaker(),
        -- queryRunawayMetrics(), tryPlaceOntoExistingInstances(); infra-reason
        -- set in internal/db/cloud_instances.go IsInfrastructureTermination /
        -- InfrastructureTerminationReasons.
}

rule RunawayBreakerClears {
    when: UserRetry(job) or AutoProbeCompleted(instance)
    requires: RunawayBreakerIsTripped(scope)

    ensures: RunawayBreakerResumed(scope)

    -- legacy annotation: @guidance
        -- Auto-clears when user retries a job in the affected scope, or
        -- when an auto-probe instance reaches status=completed. While the
        -- breaker is tripped and config.runaway_auto_probe_interval > 0,
        -- the autopilot launches one probe instance per interval (default
        -- 1 hour): a single cheap eligible unplaced job, scoped to one
        -- launch, bypassing the breaker check. Probe success resets the
        -- breaker and emits relaunch.auto_probe_resumed alongside the
        -- usual relaunch.runaway_resumed event. Probe failure or an
        -- in-flight probe leaves the breaker tripped; the next probe
        -- cannot fire until the interval has elapsed since the last
        -- relaunch.auto_probe_launched event, bounding probe spend during
        -- sustained outages.
        -- Auto-clears when user retries a job in the affected scope.
        -- Manual clear paths:
        --   - Per-campaign scope: `weft campaign safety resume --campaign N`
        --   - Global scope (campaign_id=NULL, project=<all>):
        --     `weft autopilot budget reset` or, in the TUI budget prompt
        --     ($-key), Ctrl-R while on the daily-cap step.
        -- The global path is required when the breaker trips on jobs that
        -- aren't yet attached to any campaign — `weft campaign safety
        -- resume` rejects --campaign 0 and cannot reach that scope.
        -- Recorded as lifecycle_event kind=relaunch.runaway_resumed
        -- (plus relaunch.auto_probe_resumed when triggered by a probe;
        -- probe launches emit relaunch.auto_probe_launched).
        -- TUI reset paths MUST also clear in-memory blocked-reason caches
        -- immediately, so rows no longer render stale
        -- "paused: repeated launch failures without progress" blockers
        -- while waiting for the next autopilot pass.
        -- Implementation: internal/campaign/relaunch.go
        -- ResumeRunawayBreakerForJob() (auto), ResetGlobalRunawayBreaker()
        -- (manual global), MaybeLaunchAutoProbe() and
        -- maybeAutoResumeFromProbe() (auto probe), cmd/campaign_safety.go
        -- (manual per-campaign), internal/ui/terminal/list_tui.go (TUI
        -- cache clearing).
}

-- --------------------------------------------------------------------------
-- Attempt outcomes per launch (display contract)
-- --------------------------------------------------------------------------

-- When multiple job_attempts rows exist for the same (job, launch) pair, the
-- attempt outcome reported to UI surfaces (diagnose, watch, campaign watch)
-- must reflect the LATEST attempt only. An older closed attempt with
-- cloud_outcome set (e.g. "superseded") must not shadow a newer open attempt
-- on the same launch — the job is still actively engaged with that launch.
--
-- Concretely: the same job may have multiple attempts on the same launch,
-- where each prior closed attempt is marked cloud_outcome=superseded when
-- SetJobLaunchID reattaches. GetAttemptOutcomesByLaunch (internal/db/
-- cloud_instances.go) returns the latest attempt's cloud_outcome per job
-- on the queried launch; jobs whose latest attempt on that launch is still
-- open are omitted from the result.
--
-- Callers that rely on this: cmd/instance_diagnose.go, cmd/campaign_diagnose.go,
-- cmd/campaign_report.go, internal/campaign/reconcile.go,
-- internal/campaign/status.go, internal/ui/terminal/watch_*.go.
--
-- Display: when a job's overall status differs from the per-launch attempt
-- outcome, diagnose renders "<status> (attempt <outcome>)" rather than
-- replacing the status — the per-launch outcome is a historical fact
-- about one attempt, not the job's global state.

-- ==========================================================================
-- Autopilot placement pass
-- ==========================================================================

-- On each scheduling tick or database invalidation, the autopilot asks
-- the planner for an AutoPlacementPlan over the current unplaced jobs,
-- then launches the jobs the planner approved. Jobs the planner explicitly
-- blocked MUST NOT be launched in the same pass — their block reasons are
-- surfaced to the user and re-evaluated on the next pass.
--
-- The unplaced_jobs input is defined by jobs.is_unplaced_awaiting_placement
-- (target_kind = unplaced AND status = queued AND no open MoveIntent or
-- PlacementIntent — see specs/job-move.allium). The autopilot consumes only
-- this unplaced set. Jobs already targeted at an inventory host or an
-- already-live rental instance are sync-dispatched, not auto-placed.
--
-- Inventory-tagged jobs are partitioned off before the planner runs (see
-- InventoryTaggedJobsBypassCloudPlanner). The cloud planner sees only
-- cloud-eligible jobs; inventory-tagged jobs get an authoritative
-- "waiting for on-prem host" blocked reason merged into the pass result.

rule AutoPilotPass {
    when: AutoPilotTick(unplaced_jobs, job, plan)
    requires: for job in unplaced_jobs: job.is_unplaced_awaiting_placement

    -- Partition: inventory-tagged jobs are handled by on-prem dispatch
    -- (internal/app/hostsync/worker.go), not by the cloud planner.
    let cloud_candidates = unplaced_jobs where not ("inventory" in job.tags)
    let inventory_awaiting = unplaced_jobs where "inventory" in job.tags

    -- legacy: let plan: AutoPlacementPlan = BuildAutoPlacementPlan(cloud_candidates)
    let planner_made_decisions = plan.launch_job_ids.any()
                                 or plan.blocked_reasons.any()

    -- legacy: for job in cloud_candidates where job.tags contains "cpu-intensive"
                          -- legacy: and not job.tags contains "rental"
                          -- legacy: and job.provider = null:
        if OnPremPlacement(job) != null
           and not RentalEstimate(job).completion_time
                   <= OnPremPlacement(job).completion_time - 30.minutes:
            ensures: AssignJobHost(job, OnPremPlacement(job).host)
            ensures: job.id not in plan.launch_job_ids

    ensures:
        for job in cloud_candidates where job.id in plan.launch_job_ids:
            LaunchInstance(job.campaign, [job], job.gpu_spec, job.launch_options)

    -- Inventory-tagged jobs do not flow through the cloud planner. They
    -- receive the inventory-awaiting reason and are merged into the
    -- pass's BlockedReasons via a deferred merge so every return path
    -- (early-exit, planner error, normal completion) surfaces them.
    ensures:
        for job in inventory_awaiting:
            AppendPlacementReason(job,
                "inventory-tagged: waiting for on-prem host")

    -- Fallback: only when the planner returned nothing at all do we
    -- launch the remaining cloud-eligible jobs individually. Inventory-
    -- tagged jobs are never picked up by this fallback.
    if not planner_made_decisions:
        ensures:
            for job in cloud_candidates:
                LaunchInstance(job.campaign, [job], job.gpu_spec, job.launch_options)

    -- legacy annotation: @guidance
        -- Planner: internal/campaign/auto_planner.go BuildAutoPlacementPlan.
        -- Pass driver: internal/orchestration/autopilot.go RunGroupedAutoPilotPass.
        -- The inventory partition is implemented in RunGroupedAutoPilotPass
        -- itself (the per-job check on db.TagInventory before the planner
        -- call) plus persistInventoryAwaitingReasons and the deferred
        -- mergeInventoryReasons that runs on every return path.
        -- When the run-rate soft target would be exceeded, autopilot now keeps a
        -- subset of launch groups that fit remaining headroom instead of blocking
        -- the entire launch plan.
        -- Compute-intensive jobs prefer on-prem placement unless a rental
        -- estimate is at least 30 minutes faster. Explicit rental/provider
        -- jobs still skip this on-prem preference.
        -- A job appearing in blocked_reasons is surfaced to the user
        -- (e.g. "waiting for donor", "no matching offers") and retried
        -- after a later DB change or max-interval fallback, not this one.
        -- Every runner (headless `weft autopilot run`, the daemon, and the
        -- TUI) shares one dispatch policy in
        -- internal/orchestration/dispatch.go, which decides whether a
        -- cooldown expiring is by itself a reason to replan. See
        -- AutoPilotDispatchPolicy below.
}

-- --------------------------------------------------------------------------
-- Autopilot dispatch policy
-- --------------------------------------------------------------------------

-- Between passes, a runner waits for evidence that replanning would produce a
-- different answer. Replanning unchanged state costs provider API calls and
-- returns the same plan, so the wait ends on one of three things: an observed
-- change to state the pass reads, a cooldown for a blocker no local write will
-- announce, or a bounded backstop.
--
-- The wake snapshot is the filter on "observed change". A database write that
-- leaves the snapshot equal is discarded: the file changed, but not in a way
-- that changes what a pass would decide.

rule AutoPilotDispatchPolicy {
    when: AutoPilotPassCompleted(outcome, blocked_reasons)

    -- An idle pass had nothing to act on. Whatever would make work actionable
    -- is a database write the runner already wakes on, so the cooldown
    -- expiring is not by itself a reason to replan.
    if outcome = idle:
        ensures: not TimerRunsPass()

    -- A blocked pass re-runs on its cooldown only when at least one blocker
    -- needs a timer to be re-evaluated. Recheck need is three-way: none (a
    -- local write announces it), deadline (a retry backoff must elapse; no row
    -- is written when it does), or market (only a fresh provider query
    -- resolves it). Suppressing the timer for the latter two strands the job.
    if outcome = blocked:
        let need = Max(blocked_reasons.map(Recheck))
        ensures: TimerRunsPass() = (need != recheck_none)

        -- The cooldown follows the need. A deadline blocker is waiting out a
        -- local clock, so rechecking it at the market's cadence only burns
        -- offer fetches on an answer that cannot have changed yet.
        if need = recheck_deadline:
            ensures: Cooldown() = AutopilotCooldownBackoff
        if need = recheck_market:
            ensures: Cooldown() = AutopilotCooldownBlocked

        -- The backoff recheck interval must not exceed the longest retry
        -- backoff, or every backoff would expire into a further wait.
        ensures: AutopilotCooldownBackoff <= LongestRetryBackoff()

    -- Classification is one-sided: a reason counts as database-observable only
    -- when it is recognized as such. An unrecognized reason keeps the timer.
    ensures:
        for reason in blocked_reasons where not Recognized(reason):
            Recheck(reason) = recheck_market

    -- The backstop covers more than missed wake-ups. Parts of a pass advance
    -- on a clock rather than on a change — source-sync auto-cordons whose
    -- retest window elapsed, deferred checkpoint publishes past their
    -- cooldown — and host definitions live in YAML outside the database. No
    -- runner may wait longer than the backstop without running a pass.
    ensures: WaitDuration() <= AutopilotQuietBackstop

    -- legacy annotation: @guidance
        -- Policy: internal/orchestration/dispatch.go — ClassifyPass,
        -- TimerRunsPass, WakeSnapshot/ReadWakeSnapshot, WaitForInvalidation.
        -- Reason classification: internal/blockreason/market.go — Recheck /
        -- RecheckFor, returning RecheckNone, RecheckDeadline, or
        -- RecheckMarket. Database-observable reasons are the run-rate budget
        -- verdicts, "no rental headroom" (the budget gate's launch-side
        -- verdict), and reuse rejections.
        -- Retry-backoff countdowns are checked across the whole reason
        -- rather than per part, because they arrive nested inside otherwise
        -- database-observable reuse summaries.
        -- Polling deadline blockers is an interim: see
        -- docs/planning/ROADMAP.md "Deadline-aware autopilot wake-ups" for
        -- the structural fix, where a pass reports its earliest deadline and
        -- the dispatcher sleeps until it.
        -- The change source (internal/app/dbwatch) watches the weft config
        -- file alongside the database, because the run-rate target and daily
        -- cap are decision inputs that produce no database write.
        -- The daemon additionally owns host and cloud freshness, so it wakes
        -- on a sync cadence (InvalidationOptions.QuietWait) independent of
        -- whether that wake runs a pass. It drops to daemonQuietSyncInterval
        -- only when the snapshot is quiet AND the last sync completed: an
        -- unreachable host is unknown state, not idle state.
}

rule ExistingInstanceCPUFloor {
    when: ReuseExistingInstance(job, instance)
       or QueueRebalanceTarget(job, instance)
       or AutoPilotReuseAssignment(job, instance)
    -- legacy: requires: job.tags contains "cpu-intensive"

    let floor = EnvInt("WEFT_COMPUTE_CPU_CORES", 16)

    -- legacy: requires: instance.cpu_cores_effective is known
    requires: instance.cpu_cores_effective >= floor

    -- legacy annotation: @guidance
        -- This mirrors cloud offer search's cpu_cores_effective floor.
        -- Existing rentals with unknown CPU metadata are not eligible for
        -- cpu-intensive reuse or rebalance destinations. The legacy alias
        -- `compute-intensive` is accepted on input and canonicalized to
        -- `cpu-intensive` via db.CanonicalizeTag.
        -- Implementation: internal/campaign/reuse.go MatchJobToInstance,
        -- plus the direct reuse guard in internal/orchestration/autopilot.go.
}

rule AssetOverlapLaunchGrouping {
    when: EvaluateAssetOverlapLaunchGrouping()

    -- Legacy body retained as migration guidance:
    -- when: RentalLaunchSelection(unplaced_jobs)
    -- or AutoPilotTick(unplaced_jobs)
    -- or MoveToNewLaunchSelection(jobs)

    -- Candidate launch groupings are still constrained first by hard
    -- compatibility: GPU constraint/supremum, provider, VRAM tier,
    -- preemptibility, image compatibility, disk, compute-cap bounds, and
    -- known CUDA/driver compatibility. Jobs must also have identical
    -- per-job rental policies, including whether each field is absent.
    -- Provider-unknown CUDA/driver
    -- compatibility is allowed only as a high-penalty fallback when no
    -- known-compatible offer is available.
    -- Among compatible candidates, the planner applies an additional
    -- setup-time benefit for groups whose jobs share declared or observed
    -- HF model/dataset inputs.

    -- let compatible_candidates = CandidateLaunchGroupings(unplaced_jobs)
    -- for candidate in compatible_candidates:
    -- let overlap_bytes =
    -- legacy: sum over each group in candidate.groups:
    -- legacy: sum over each unordered pair of jobs in group:
    -- legacy: sum Weight(asset)
    -- legacy: where asset in HFInputs(job_a) intersect HFInputs(job_b)
    -- let overlap_saved_hours = overlap_bytes / config.asset_overlap_lan_bytes_per_second / 1.hour
    -- let candidate_score =
    -- ScoreCandidate(candidate)
    -- - ScoreProfile(candidate.profile).time_weight * overlap_saved_hours

    -- ensures: SelectedLaunchGrouping =
    -- legacy: argmin candidate_score over compatible_candidates

    -- legacy annotation: @guidance
    -- Implementation: internal/campaign/campaign.go computes pairwise
    -- asset overlap for hf:* and hf-dataset:* refs from jobs.inputs and
    -- jobs.observed_inputs. HF model weights use cached model size when
    -- available; otherwise each shared ref uses a fixed 10 GB fallback.
    -- The score term is applied in internal/campaign/strategy_plan.go.
    -- This is only a scoring benefit; it must not merge incompatible
    -- GPU/image/provider/preemptibility/VRAM groups. It must NOT be
    -- promoted to a hard merge gate (such as requiring a non-zero
    -- overlap before two otherwise-compatible jobs may share a group);
    -- such a gate diverges from this rule and over-splits launches.

    -- Move-to-new (MoveToNewLaunchSelection): bulk `weft move --to new`
    -- selects a launch grouping for queued jobs but forces fresh
    -- instances (no reuse path). The same candidate-grouping evaluation
    -- runs as for RentalLaunchSelection / AutoPilotTick; reuse decisions
    -- are simply skipped. Implementation:
    -- internal/orchestration/move.go MoveQueuedJobsToNewInstances calls
    -- internal/campaign/launch_execution.go
    -- PrepareNewInstanceLaunchPlan, which passes an empty reusable set
    -- to BuildProfilePlansWithProgress.
}

-- Two jobs with DIFFERENT GPU class constraints may share an instance when
-- one constraint subsumes the other. The merged group carries the NARROWER
-- constraint — the supremum in the specificity order — so `h100` and
-- `h100-nvl` merge to `h100-nvl`, and `ampere+` and `a100` merge to `a100`.
-- Unconstrained (empty) is the bottom of the order and merges with
-- anything. Incomparable constraints (`h100-pcie` and `h100-nvl`) do not
-- merge; the grouping candidate is rejected as incompatible.
--
-- Taking the narrower constraint is what makes co-location safe: the group
-- is offer-filtered against the supremum, so every instance it can land on
-- satisfies the supremum, and the supremum implies each member's own
-- constraint. Taking the BROADER constraint would be the defect — the
-- `h100-nvl` job could then be served an H100 PCIe it never asked for.
rule GroupGPUConstraintIsSupremum {
    when: CandidateGroupingEvaluated(group)

    let constraints = group.jobs.map(j => j.gpu_class)
    let supremum = MostSpecific(constraints)

    -- Every member constraint must be at least as broad as the supremum,
    -- i.e. the supremum sits at or above all of them in the specificity
    -- order. When no member constraint is comparable to all the others,
    -- no supremum exists and the group is not a candidate.
    requires: constraints.all(c => Subsumes(c, supremum))

    ensures: group.gpu_class = supremum

    -- legacy annotation: @guidance
        -- Implementation: internal/campaign/gpucompat.go gpuClassSupremum
        -- folds two constraints via placement.GPUConstraint.Subsumes and
        -- returns ok=false when neither subsumes the other, which rejects
        -- the merge. Specificity order (broadest first): unconstrained,
        -- family ("nvidia"), min_generation ("ampere+"), exact_generation
        -- ("ampere"), exact_model ("a100"), variant ("a100-sxm4").
}

invariant MergedGroupNeverViolatesMemberConstraint {
    -- Co-location must not weaken any member's request. Every instance a
    -- merged group can be placed on satisfies the group constraint, and
    -- the group constraint is at least as specific as each member's, so no
    -- member can be served hardware outside its own request.
    for group in LaunchGroups:
        for job in group.jobs:
            for target in group.eligible_targets:
                MatchesConstraint(target, job.gpu_class)

    -- legacy annotation: @guidance
        -- This covers the VARIANT axis only, which is the axis a GPU class
        -- binds (see inventory-placement.allium ParseGPUConstraint). The
        -- memory axis rides on the group's gpu_mem_gb floor, not on the
        -- class string. The arch-cap axis rides on the group's
        -- max_compute_cap / min_compute_cap; see GroupArchCapIsMemberMin.
}

-- The arch-cap counterpart of GroupGPUConstraintIsSupremum: a group's
-- max_compute_cap is the minimum over member caps that exist, because every
-- member runs on the shared instance and the lowest cap binds it. A member
-- whose cap is "any" (explicitly, or backfilled from a project without a
-- torch pin) contributes no cap; "any" is scoped to the job that declared
-- it and must not strip a cap a sibling still needs — an unbounded group
-- can be served a card the capped sibling's torch wheel has no kernels
-- for, which fails at runtime with "no kernel image". The same reduction
-- applies when two groups merge: an empty side yields the other side, not
-- an unbounded result. min_compute_cap reduces dually (maximum of member
-- floors).
rule GroupArchCapIsMemberMin {
    when: CandidateGroupingEvaluated(group)

    let caps = group.jobs.map(j => j.max_compute_cap).filter(c => c != null and c != "any")

    -- legacy: ensures: caps empty implies group.max_compute_cap = null
    -- legacy: ensures: caps not empty implies group.max_compute_cap = caps.min()

    -- legacy annotation: @guidance
        -- Implementation: internal/campaign/campaign.go groupMaxComputeCap
        -- (reduction over jobs; "any" is skipped, unresolved caps warn and
        -- are skipped) and mergeMaxComputeCap / mergeMinComputeCap
        -- (pairwise group merge in MergeCompatibleGroupsWithDisk; empty
        -- side yields the other side).
}

-- ==========================================================================
-- Job explanation and inventory dispatch auto-replan
-- ==========================================================================
--
-- Explanation is the shared source for user-facing "why is this job stuck?"
-- surfaces: `weft job diagnose`, `weft job status`, `weft job info`, TUI
-- project views, and narrative snapshots. It does not create state by itself;
-- it interprets queue blockers, placement reasons, lifecycle events, and job
-- failure metadata into a primary reason plus a suggested action.

value JobExplanation {
    job: jobs/Job
    state: String
    primary_reason: String
    confidence: String              -- low | medium | high
    suggested_action: String
    auto_replan_allowed: Boolean
}

rule ExplainInventoryDispatchBlock {
    when: ExplainJob(job, block_event)
    requires: job.status = queued
    requires: job.target_kind = inventory_host
    requires: LatestLifecycleEvent(job, ["queue.dispatch.failed",
                                         "queue.dispatch.deferred",
                                         "queue.dispatch.ok"])
              -- legacy: is block_event
    requires: block_event.kind in {"queue.dispatch.failed",
                                   "queue.dispatch.deferred"}
    -- legacy: requires: not exists fresher_ok:
              -- legacy: LifecycleEvent(job, "queue.dispatch.ok") after block_event

    let first_block = FirstConsecutiveDispatchBlock(job, block_event)
    let blocked_for = now - first_block.occurred_at

    ensures:
        JobExplanation {
            -- legacy: job = job
            -- legacy: state = "blocked"
            -- legacy: primary_reason = DispatchBlockReason(block_event)
            -- legacy: confidence = "high"
            -- legacy: suggested_action =
                -- legacy: if blocked_for >= config.inventory_dispatch_auto_replan_after
                -- legacy: then "replan: dispatch has been blocked for " + DurationText(blocked_for)
                -- legacy: else "wait: auto-replan threshold is " + DurationText(config.inventory_dispatch_auto_replan_after)
            -- legacy: auto_replan_allowed =
                -- legacy: blocked_for >= config.inventory_dispatch_auto_replan_after
        }

    -- legacy annotation: @guidance
        -- Implementation: internal/explain/explain.go. The consecutive
        -- window starts at the first failed/deferred dispatch event after
        -- the job's queued floor (QueuedAt, or CreatedAt when QueuedAt is
        -- absent), and is cleared by a fresher queue.dispatch.ok event.
}

rule AutoReplanStuckInventoryDispatch {
    when: AutoPilotTick(_)
    requires: config.auto_replan_stuck_inventory_dispatch = true

    for job in Jobs:
      requires: job.status = queued
      requires: job.target_kind = inventory_host
      -- legacy: requires: not exists(MoveIntent { job = job, state = open })
      -- legacy: requires: not exists(PlacementIntent { job = job, state = open })
      -- legacy: requires: ExplainJob(job).auto_replan_allowed

      -- legacy: let old_target = job.target
      -- legacy: ensures: UnplaceJob(job)
      -- legacy: ensures: AppendPlacementReason(job,
          -- legacy: "auto-replanned from " + old_target +
          -- legacy: " after sustained dispatch block: " +
          -- legacy: ExplainJob(job).primary_reason)
      -- legacy: ensures: LifecycleEvent(job, "queue.dispatch.auto_replanned")

    -- legacy annotation: @guidance
        -- Opt-in by design. The intervention unplaces the job and adds the
        -- `rental` tag, converting an on-prem inventory job into a
        -- rental-eligible job — a placement change without explicit user
        -- consent. When the inventory host's problem is transient (slow HF
        -- download, transient SSH issue, host reboot), an automatic flip to
        -- cloud rental is rarely what the user wants. With the gate off
        -- (the default), blocked inventory jobs stay blocked until the user
        -- intervenes; the user-visible "blocked for Nm" explanation in
        -- ExplainStuckInventoryDispatch is unaffected. Set
        -- `[autopilot] auto_replan_stuck_inventory_dispatch = true` in
        -- config.toml to restore the previous automatic behavior.
        --
        -- Implementation: internal/orchestration/autopilot.go
        -- RunGroupedAutoPilotPass consults autoReplanConfigEnabled() (which
        -- reads Config.AutoReplanStuckInventoryDispatchEnabled()) before
        -- invoking autoReplanStuckInventoryJobs. Scoped autopilot runs only
        -- replan jobs inside their scope. Jobs with open move/placement
        -- intents remain protected by job-move.allium's
        -- AutopilotIgnoresMovingJobs invariant.
}

rule AutoPublishCheckpointForRentalPlacement {
    when: AutoPilotTick(_, autopilot_state)
    requires: config.auto_publish_checkpoints = true
    requires: not autopilot_state.paused

    for job in Jobs:
      requires: job.status = queued
      requires: job.target_kind = unplaced
      requires: RentalEligible(job)

      for input in job.inputs where input.kind = checkpoint:
        let record = HostAssetRecordFor(input.asset)
        requires: record.content_hash != null
        requires: record.size_bytes > 0

        let key = "assets/" + record.content_hash
        let r2_state = ProbeR2Object(key)
        let holder_state = ProbeHolderPath(record.host, record.path)

        ensures:
          if r2_state = on_host_only and holder_state = confirmed_present:
              R2PutFromHost(
                  source_host: record.host,
                  source_path: record.path,
                  key: key,
                  content_type: record.content_type
              )
          if r2_state = unknown or holder_state = unknown:
              DeferAutoPublish(job, reason: "checkpoint publish status unknown")
          if record.size_bytes > config.auto_publish_checkpoint_max_bytes:
              DeferAutoPublish(job, reason: "checkpoint above autopilot cap")

    -- legacy annotation: @guidance
        -- Opt-in by design. Publishing a checkpoint can move many GiB from an
        -- inventory host to paid object storage without direct user action, so
        -- the policy is disabled by default and additionally capped by
        -- `[autopilot] auto_publish_checkpoint_max_gb`.
        --
        -- Three-state discipline is mandatory. A failed R2 HEAD, SSH timeout,
        -- unreachable holder host, missing path, digest mismatch, or missing
        -- content metadata is not a confirmed absence and must not fail the job
        -- or mark the checkpoint published. The autopilot records a bounded
        -- deferred reason and tries again only after its retry cooldown. A
        -- confirmed upload failure (the holder was reachable and the host-side
        -- upload started, then failed) is recorded as a per-job reason and
        -- logged, but must NOT abort the pass: the remaining unplaced jobs are
        -- still processed, and the cooldown-gated next pass retries. A single
        -- bad upload never blocks placement of every other queued job.
        --
        -- The holder confirmation recomputes the same DigestPath metadata on
        -- the holder host before upload. This prevents stale host_data from
        -- causing autopilot to publish a different checkpoint under the old
        -- content hash.
        --
        -- Implementation: internal/orchestration/autopilot.go
        -- autoPublishMissingCheckpoints and
        -- internal/campaign/checkpoint_transport.go PublishCheckpointToR2.
}

config {
    inventory_dispatch_auto_replan_after: Duration = 10.minutes

    -- Gate for AutoReplanStuckInventoryDispatch. Off by default because the
    -- intervention changes a job's placement (adds the `rental` tag and
    -- unplaces) without explicit user consent. TOML key:
    -- [autopilot] auto_replan_stuck_inventory_dispatch.
    auto_replan_stuck_inventory_dispatch: Boolean = false

    -- Gate for AutoPublishCheckpointForRentalPlacement. Off by default.
    -- TOML keys:
    -- [autopilot] auto_publish_checkpoints
    -- [autopilot] auto_publish_checkpoint_max_gb
    auto_publish_checkpoints: Boolean = false
    auto_publish_checkpoint_max_bytes: Bytes = 10.GiB
}

-- ==========================================================================
-- Scheduling telemetry and launch recommendations
-- ==========================================================================
--
-- Scheduling telemetry is durable instrumentation for retrospective
-- analysis. It must not change placement outcomes when a write fails; failures
-- are logged and the scheduler continues.

entity PlacementDecision {
    job: jobs/Job?
    attempt: jobs/JobAttempt?
    campaign: Campaign?
    decision_kind: String          -- "acted", "blocked", etc.
    operation: String
    objective: String
    placement_policy_version: String
    selected_kind: String?
    selected_target: String?
    selected_score: Decimal?
    sample_candidates: Boolean
    created_at: Timestamp
}

entity PlacementCandidate {
    decision: PlacementDecision
    rank: Integer
    candidate_kind: String
    target: String?
    provider: String?
    offer_id: String?
    gpu_name: String?
    score: Decimal?
    est_time_s: Decimal?
    est_cost: Decimal?
    survival: Decimal?
    selected: Boolean
}

entity PredictionHistory {
    job: jobs/Job
    attempt: jobs/JobAttempt?
    target: String                 -- e.g. "duration"
    host: String?
    gpu_class: String?
    model_fingerprint: String?
    prediction: String
    created_at: Timestamp
}


rule NewsvendorLaunchRecommendation {
    when: UserRequestsLaunchEstimate(plan, score_profile)
       or LaunchPlanRendered(plan, score_profile)
    requires: plan.cost_estimates.any()

    let critical_fractile =
        clamp(score_profile.time_weight /
              (score_profile.time_weight
               + score_profile.cost_weight * AverageOfferRate(plan)),
              0.05, 0.95)
    let demand_hours =
        PiecewiseQuantile(
            sum(plan.cost_estimates.total_time.lower.hours),
            sum(plan.cost_estimates.total_time.mean.hours),
            sum(plan.cost_estimates.total_time.upper.hours),
            critical_fractile)
    let instance_hours =
        max(plan.cost_estimates.total_time.mean.hours)
    let recommended_count =
        clamp(ceil(demand_hours / instance_hours),
              1, count(plan.cost_estimates))

    ensures: ShowRecommendation(
        "launch " + recommended_count + " instance(s) now")

    -- legacy annotation: @guidance
        -- Implementation: internal/campaign/newsvendor.go. This exposes
        -- the count implied by uncertain demand and the active cost/time
        -- score profile; launch planning still constrains the feasible
        -- candidate set before this recommendation is computed.
        --
        -- Advisory display ONLY: the recommendation is not a planner input.
        -- Its call sites are the `weft start instance` output paths
        -- (cmd/instance_launch.go, via campaign.FormatNewsvendorRecommendation
        -- over campaign.RecommendInstanceCount). The autopilot planner does
        -- not consume it. See the non-goals section of
        -- specs/launch-objective.allium.
}

-- ==========================================================================
-- Queue re-balance across existing instances
-- ==========================================================================
--
-- Queue re-balance moves queued (never running) jobs between already-running
-- instances to minimize an objective over the predicted queue-drain plan.
-- This objective is LEXICOGRAPHIC (see below), which is a different objective
-- from launch planning: launch planning ranks candidates by the weighted-sum
-- cost+time objective in specs/launch-objective.allium (LaunchObjective). The
-- two share only the ScoreProfile dollar/hour weights
-- (internal/bidding/model.go ScoreProfile), and only inside this objective's
-- scalar-score component (item 4 below) — not the ordering as a whole.
--
-- A move is accepted iff it lowers
--
--     Objective(plan) =
--       1. priority_completion_sum(hours)
--       2. total_completion_sum(hours)
--       3. TotalRentalCost($)
--       4. scalar Score(plan)
--       5. GlobalMakespan(hours)
--
-- The objective is lexicographic. Priority jobs are jobs whose durable priority
-- is greater than zero. A move that improves non-priority throughput must not
-- compensate for delaying priority jobs.
--
-- A candidate move must improve the lexicographic objective by at least ε in
-- the first component it changes, or improve the scalar score by ε as a
-- fallback. It must also pass hard cost-effectiveness, capacity, disk, data,
-- image, and CPU guards.
--
-- Cost-effectiveness is deliberately stricter than "is there a compatible
-- destination": a job may not consume a much more expensive/scarce instance
-- merely because it exists. The first hard guard is destination $/hr <=
-- rebalance_cost_ceiling * source $/hr. Future versions may replace or augment
-- this with an opportunity-cost model that compares the destination against the
-- cheapest adequate compatible capacity and reserves high-end GPUs for jobs that
-- require them.
--
-- TotalRentalCost is the sum across all instances of (instance.$/hr ·
-- instance.queue_drain_hours). GlobalMakespan is the maximum across all
-- instances of instance.queue_drain_hours. Per-instance queue-drain hours
-- are estimated using mean runtime predictions from
-- predictor.ResolvePredictBatch (DefaultJobDuration fallback when absent),
-- accounting for slot count = launch.NumGPUs. Completion sums are computed by
-- simulating the same per-instance slots. Running jobs contribute their
-- remaining predicted time (clamped to a small positive minimum).
--
-- Logistics included in the initial implementation:
--   - InstanceSatisfiesJob includes GPU class, VRAM, CPU floor, grace-window,
--     disk feasibility, declared HF input disk, and cold uv-sync disk estimates.
--   - Reuse scoring already gives a positive signal to instances whose
--     provisioned_inputs overlap declared job inputs, which captures some HF
--     asset amortization.
--
-- Logistics intentionally deferred:
--   - Explicit same-disk affinity for --produces / --needs pairs.
--   - Runtime/cost amortization for downloaded HF models/datasets beyond the
--     current provisioned-input heuristic.
--   - Artifact staging amortization from R2 or local stores.
--   - uv package cache amortization as a scoring benefit. The current code
--     accounts for uv disk feasibility, not setup-time reuse.

config {
    asset_overlap_lan_bytes_per_second: Decimal = 500000000

    -- Dollars per hour; zero disables launch-rate gating.
    auto_run_rate_soft_target: Decimal = 0

    rebalance_cost_ceiling: Decimal = 1.10    -- upper bound on dst/src $/hr
    rebalance_enabled: Boolean = true
    rebalance_strategy: String = "fast"       -- "cheap" | "balanced" | "fast"
    rebalance_score_epsilon: Decimal = 0.01   -- relative improvement threshold
}

rule QueueRebalanceJob {
    when: EvaluateQueueRebalanceJob()

    -- Legacy body retained as migration guidance:
    -- when: AutoPilotTick(_) or UserRequestsRebalance()
    -- requires: config.rebalance_enabled

    -- let profile = ScoreProfileForStrategy(config.rebalance_strategy)
    -- let plan = CurrentQueuePlan()    -- per-instance running + queued

    -- for job in jobs where job.status = queued
    -- legacy: ordered by queue_position:
    -- legacy: let src = job.assigned_instance
    -- legacy: requires: src is not None

    -- legacy: let dst = BestRebalanceTarget(job, plan, profile, exclude=src)
    -- legacy: requires: dst is not None
    -- legacy: requires: InstanceSatisfiesJob(dst, job)
    -- legacy: requires: job.tags contains "cpu-intensive" implies
    -- legacy: dst.cpu_cores_effective >= EnvInt("WEFT_COMPUTE_CPU_CORES", 16)
    -- legacy: requires: ImagesCompatible(JobImage(job), dst.image)
    -- legacy: requires: dst.cost_per_hour <= config.rebalance_cost_ceiling
    -- legacy: * src.cost_per_hour

    -- legacy: let plan_after = ApplyMove(plan, job, src, dst)
    -- legacy: requires: LexicographicObjective(plan_after, profile)
    -- legacy: improves_over LexicographicObjective(plan, profile)
    -- legacy: by config.rebalance_score_epsilon
    -- legacy: or ScoreUnder(plan_after, profile)
    -- legacy: < ScoreUnder(plan, profile)
    -- legacy: * (1 - config.rebalance_score_epsilon)

    -- legacy: ensures: ReassignJobToInstance(job, dst)
    -- legacy: ensures: AppendPlacementReason(job,
    -- legacy: "rebalanced from " + src.id + " → " + dst.id
    -- legacy: + " (Δscore " + (ScoreUnder(plan_after, profile)
    -- legacy: - ScoreUnder(plan, profile))
    -- legacy: + " under " + profile.id + ")")
    -- legacy: ensures: LogRebalanceDecision(job, src, dst, profile,
    -- legacy: mean_delta=ScoreDelta(plan, plan_after, profile, mean=true),
    -- legacy: lower_delta=ScoreDelta(plan, plan_after, profile, point=lower),
    -- legacy: upper_delta=ScoreDelta(plan, plan_after, profile, point=upper))
    -- legacy: then: plan := plan_after
}

invariant RebalanceRespectsCostCeiling {
    for move in QueueRebalanceMoves:
        move.dst.cost_per_hour
            <= config.rebalance_cost_ceiling * move.src.cost_per_hour
}

invariant RebalanceNeverPreemptsRunning {
    -- Running jobs are not candidates for moving. (The earlier "dst slot must
    -- be idle at decision time" half is removed: rebalance now extends the
    -- destination's queue when doing so improves the global score.)
    for move in QueueRebalanceMoves:
        move.job.status = queued
}

invariant RebalanceImprovesScore {
    -- Every accepted move strictly improves priority throughput, total
    -- throughput, or the scalarized score under the chosen profile, by at
    -- least the configured relative epsilon.
    for move in QueueRebalanceMoves:
        LexicographicObjective(move.plan_after, move.profile)
            improves_over LexicographicObjective(move.plan_before, move.profile)
            by config.rebalance_score_epsilon
        or ScoreUnder(move.plan_after, move.profile)
           < ScoreUnder(move.plan_before, move.profile)
             * (1 - config.rebalance_score_epsilon)
}

rule QuickLaunchChoosesUsefulCapacity {
    when: UserPressesTUIKey("n")

    let candidates = LaunchableNewInstanceGroups(current_view.jobs)
    -- legacy: for group in candidates ordered by
        -- legacy: group.priority descending,
        -- legacy: group.job_count descending,
        -- legacy: group.cost_per_hour ascending:
      let candidate_instance = NewInstanceOffer(group)
      let plan_after_launch =
          RebalancePlan(current_running_instances + candidate_instance,
                        current_view.queued_jobs)

      -- legacy: requires: plan_after_launch improves priority throughput before
                -- legacy: non-priority throughput
      -- legacy: requires: candidate_instance is cost-effective under the same guards as
                -- legacy: QueueRebalanceJob

      ensures: LaunchInstance(candidate_instance)
      ensures: ApplyCostEffectiveRebalance(plan_after_launch)

    -- Groups with no compatible/currently available offers, stale provider
    -- data, or other blocked placement reasons are skipped and reported. A
    -- stale queued job must not veto quick launch for the rest of the current
    -- view.
}

invariant RebalanceLogsDeltaBounds {
    -- Empirical trigger for promoting MC-variance rebalance from the roadmap:
    -- every decision logs lower/upper Δscore bounds alongside the mean. If
    -- the bounds straddle zero on a material fraction of decisions, mean-only
    -- is making coin-flip calls and variance-aware rebalance moves up.
    for move in QueueRebalanceMoves:
        move.log_record contains {mean_delta, lower_delta, upper_delta}
}

rule InstanceReuseSkipsCordoned {
    when: BuildAutoPlacementPlan(unplaced_jobs)

    ensures:
        for instance in reusable_instances_considered:
            instance.cordoned implies
                instance.id not in plan.reuse_assignments.map(a => a.instance.id)

    -- legacy annotation: @guidance
        -- Operators may cordon a running or grace-period instance to drain it
        -- (for example, when its agent is on a stale build). A cordon does not
        -- terminate the instance or interrupt its current job — it only marks
        -- the instance as ineligible for new job assignment by the autopilot
        -- and explicit reuse paths. The cordon flag is cleared via
        -- `weft instance uncordon`. See instanceAcceptsReuse in
        -- internal/campaign/reuse.go.
}

rule InstanceReuseGPUMemoryCheck {
    when: MatchJobToInstance(job, instance)
    requires: job.gpu_mem_gb != null
    requires: instance.gpu_mem_gb > 0

    ensures: job.gpu_mem_gb <= instance.gpu_mem_gb

    -- legacy annotation: @guidance
        -- The reuse matcher compares the job's required GPU memory against
        -- the instance's actual per-GPU memory (recorded from the offer at
        -- launch). An instance with gpu_mem_gb = 0 is treated as "unknown":
        -- see MatchJobToInstance in internal/campaign/reuse.go for the
        -- conservative behavior. Recording the offer's actual memory at
        -- launch time (see LaunchInstance) is required so that running
        -- rentals are eligible for reuse by new jobs with memory constraints.
}

rule InstanceReuseDiskCheck {
    when: MatchJobToInstance(job, instance)

    ensures:
        ExplicitDiskFloorGB(job) > 0 implies
            instance.disk_gb >= ExplicitDiskFloorGB(job)
        instance.disk_free_gb >= EstimatedReuseIncrementalDiskGB(job, instance)

    -- legacy annotation: @guidance
        -- Reuse admission checks remaining disk, not just the original
        -- requested disk. The incremental estimate includes inputs not
        -- already provisioned on the instance, cached uv-sync manifest bytes
        -- when present, explicit runtime scratch, and image-aware setup
        -- fallback. CUDA projects on CUDA-only images require full CUDA setup
        -- headroom because those images do not provide the project's torch
        -- wheel. PyTorch images may use reduced setup headroom only when the
        -- system-torch shortcut is plausibly compatible; uncertain cases are
        -- treated as full CUDA setup.
        --
        -- A reuse rejection is preferable to accepting a job that can make a
        -- shared rental terminate with disk_full. Implementation:
        -- internal/campaign/reuse.go MatchJobToInstance and
        -- estimateReuseJobDiskNeedGB.
        --
        -- The check applies against REMAINING capacity wherever multiple jobs
        -- are assigned in one pass: every assignment site (direct autopilot
        -- assignment, relaunch reuse passes, and SubmitJobsToInstance
        -- validation) consumes each accepted job's estimated need via
        -- consumeReuseJob before judging the next job, so N jobs cannot each
        -- match the same free disk.
        --
        -- A user-declared disk ceiling (see FreshRentalDiskEstimate) does NOT
        -- participate here: it bounds the fresh-launch request only, and
        -- EstimatedReuseIncrementalDiskGB is unaffected by it. See the open
        -- question on ceiling scope.
}

-- Reuse must not be a hole in constraint enforcement: an axis the offer
-- chain enforces at launch and the matcher ignores is silently unmet
-- whenever a reusable instance happens to be available. Interconnect, host
-- RAM, and the explicit CPU-cores floor shipped that way.
rule InterconnectSatisfied {
    when: EvaluateInterconnect(requirement, gpu_naming_signals,
                               nvlink_bandwidth, num_gpus)

    -- Provider measurements distinguish three states. A positive numeric
    -- value confirms NVLink; a reported zero confirms no measured NVLink;
    -- null means the provider supplied no measurement. Only the unknown case
    -- falls back to naming signals.
    if nvlink_bandwidth != null:
        ensures:
            requirement = nvlink implies result = (nvlink_bandwidth > 0)
        ensures:
            requirement = pcie implies result = (nvlink_bandwidth = 0)

    if nvlink_bandwidth = null:
        ensures:
            requirement = nvlink implies
                result = gpu_naming_signals contains_any [nvlink, sxm, nvl]
        ensures:
            requirement = pcie implies
                result = not gpu_naming_signals contains_any [nvlink, sxm, nvl]

    ensures:
        requirement in {null, "", any} implies result = true

    -- nvlink asks that NVLink be present. nvlink_uniform asks that every
    -- participating GPU pair be NVLink connected, which is what a collective
    -- benchmark needs for its timings to be comparable across hosts. The two
    -- differ only above a pair, because one NVLink connection already spans
    -- two GPUs.
    if requirement = nvlink_uniform and num_gpus <= 2:
        ensures:
            result = EvaluateInterconnect(nvlink, gpu_naming_signals,
                                          nvlink_bandwidth, num_gpus)

    -- Above a pair, uniformity is judged on the part class and the provider
    -- measurement must NOT be consulted. A host of bridged pairs reports
    -- positive bandwidth for those pairs, so bandwidth cannot separate two
    -- NVLink islands from one NVLink domain. Naming that does not state the
    -- fabric is unknown, not permissive: an unverifiable topology fails
    -- closed, because placing on it yields results that are wrong rather
    -- than merely slow.
    if requirement = nvlink_uniform and num_gpus > 2:
        ensures:
            result = gpu_naming_signals contains_any [sxm, nvswitch]
        ensures:
            gpu_naming_signals contains_any [nvl] and
            not gpu_naming_signals contains_any [sxm, nvswitch]
                implies result = false
}

invariant LaunchPreservesInterconnectEvidence {
    -- Reuse must evaluate the same evidence that admitted the selected offer.
    -- Replacement offers overwrite the prior value, including with null, so
    -- facts from a failed physical machine never stand in for its replacement.
    -- legacy: invariant_holds:
        -- legacy: LaunchCreatedFromOffer(launch, offer) implies
            -- legacy: launch.offer.nvlink_bandwidth = offer.nvlink_bandwidth
    -- legacy: invariant_holds:
        -- legacy: LaunchOfferReplaced(launch, replacement) implies
            -- legacy: launch.offer.nvlink_bandwidth = replacement.nvlink_bandwidth
}

rule InstanceReuseHostAxes {
    when: EvaluateInstanceReuseHostAxes()

    -- Legacy body retained as migration guidance:
    -- when: MatchJobToInstance(job, instance)

    -- CPU cores: the cpu-intensive tag floor and an explicit --cpu-cores
    -- compose to the higher bound, mirroring the launch-time group
    -- constraint. Unknown instance cores fail closed.
    -- let cores_floor = max(job.cpu_cores,
    -- legacy: job.has_tag(cpu_intensive) ? ComputeCPUCoresFloor() : 0)
    -- ensures:
    -- cores_floor > 0 implies
    -- instance.cpu_cores > 0 and instance.cpu_cores >= cores_floor

    -- Host RAM (--cpu-mem, effective): known-insufficient fails; unknown
    -- (instance.ram_gb == 0, every RunPod launch) passes, matching the
    -- launch-time filter — reuse must not be stricter than a fresh launch
    -- on the same axis, or a job buys a new pod identical to the reusable
    -- one.
    -- ensures:
    -- job.cpu_mem_gb > 0 and instance.ram_gb > 0 implies
    -- instance.ram_gb >= job.cpu_mem_gb

    -- Interconnect: judged by the same measurement-first predicate the offer
    -- filter uses. With no measurement, nvlink/sxm/nvl naming tokens read as
    -- NVLink and their absence reads as PCIe. "nvl" covers the NVLink-bridged
    -- H100 NVL, whose bridge links card pairs only.
    -- ensures:
    -- InterconnectSatisfied(job.interconnect,
    -- instance.gpu_naming_signals,
    -- instance.offer.nvlink_bandwidth,
    -- job.num_gpus)

    -- legacy annotation: @guidance
    -- Implementation: internal/campaign/reuse.go matchJobToInstance,
    -- through helpers in internal/campaign/offers.go shared with the
    -- launch-time path: effectiveCPUCoresFloor (also offerConstraintsForGroup),
    -- hostCPUCoresSatisfied, hostRAMSatisfied (also filterOffersByHostRAM), and
    -- InterconnectSatisfied (also filterOffersByInterconnect). The reuse
    -- evidence is the persisted provider bandwidth plus the launch
    -- record's resolved GPU name (GPU class when unresolved) and
    -- datacenter, mirroring the offer filter's evidence.
    --
    -- The quickReuseCompatible prefilter (strategy_plan.go) applies the
    -- same three floors through the same helpers: candidate slots are
    -- capped, so an instance the full matcher would reject must not
    -- hold a slot a usable instance could take.
    --
    -- The NVIDIA driver-major floor is re-checked through
    -- matchInstanceTargetEligibility / placement.EvaluateEligibility. A
    -- recorded launches.driver_version binds directly: below-floor driver
    -- majors reject even when launches.cuda_version is high enough. When the
    -- driver floor was derived from the CUDA floor, regardless of whether that
    -- CUDA floor came from torch, metadata, config, or CLI --cuda-driver-min, a
    -- recorded launches.cuda_version fact covers the same driver capability
    -- axis; a satisfying value admits the instance, and a below-floor value
    -- rejects on the CUDA axis. A launch with neither recorded driver_version
    -- nor recorded cuda_version — RunPod without a probe, rows predating both
    -- facts — still fails closed. Direct user driver floors (min-driver /
    -- min_driver) never use the CUDA fact as substitute evidence; a missing
    -- driver remains a missing driver for those jobs. Jobs with no driver
    -- floor remain unaffected.
    --
    -- A replacement offer overwrites launches.driver_version
    -- unconditionally, including with "" when the replacement provider
    -- reports no driver: a launch created by create-retry must never carry
    -- the failed original offer's driver, which describes a different
    -- physical machine. Preserving the old value on an empty replacement
    -- would let an unknown masquerade as a known fact and bind the floor
    -- against hardware that was never rented (UpdateLaunchOfferMetadata).
    -- }

    -- rule InstanceReuseQueueDepthIsObjectiveSignal {
    -- when: MatchJobToInstance(job, instance)

    -- ensures:
    -- EstimatedCompletionTime(job, instance)
    -- includes QueueWaitEstimate(instance.running_job_count
    -- + PlannedReuseAssignments(instance))
    -- and MatchJobToInstance does_not_reject because queue_depth alone

    -- legacy annotation: @guidance
    -- Cloud agents run the assigned sequence on one rental, so extra
    -- reuse assignments wait behind active work. That wait is an
    -- objective penalty, not a hard eligibility cap: the planner should
    -- prefer lower expected average completion time across the job set
    -- rather than reject a reusable rental only because its queue is long.
    -- A same-rental --needs edge can legitimately choose a longer queue
    -- because placement onto the producer's rental lets the cloud agent
    -- advance the consumer after the producer writes the artifact, with
    -- no later autopilot intervention.
    -- PlanReuse increments InstanceCapacity.RunningJobCount after each
    -- planned assignment, so later objective estimates see already-running
    -- jobs and assignments made earlier in the current plan.
}

rule AutoPilotRunRateSubset {
    when: EvaluateAutoPilotRunRateSubset()

    -- Legacy body retained as migration guidance:
    -- when: AutoPilotTick(unplaced_jobs)
    -- requires: plan.projected_launch_rate > config.auto_run_rate_soft_target

    -- let explicitly_rate_capped_groups = plan.launch_groups where
    -- group.jobs.all(job => job.cli_overrides.max_hourly_rate_cents is present)
    -- and group.offer.cost_per_hour_cents <=
    -- legacy: min(job.cli_overrides.max_hourly_rate_cents for job in group.jobs)
    -- legacy: let ordinary_groups = plan.launch_groups except explicitly_rate_capped_groups

    -- legacy: ensures:
    -- legacy: plan.reuse_assignments.any() implies
    -- legacy: plan.reuse_assignments.all(a => a.job.id not in plan.blocked_reasons.keys())
    -- legacy: plan.launch_groups = explicitly_rate_capped_groups
    -- legacy: union GreedyFitByJobsPerCost(ordinary_groups, plan.headroom)
    -- legacy: plan.blocked_reasons.keys().all(job_id => job_id not in plan.launch_job_ids)

    -- legacy annotation: @guidance
    -- Reuse assignments are zero-launch-cost and are never run-rate gated.
    -- A fully and explicitly rate-capped group is already authorized by
    -- its jobs. It is retained even when headroom is zero and consumes no
    -- global soft-target headroom. Its selected offer must still satisfy
    -- every job cap. Mixed capped/uncapped groups receive no exemption.
    -- Launch groups are sorted by jobs-per-cost (tie: lower cost), then
    -- ordinary groups are accepted greedily while their cumulative launch
    -- cost stays within headroom. Rejected ordinary groups are blocked
    -- with per-group headroom reasons. Actual run rate, the daily cap, and
    -- runaway-breaker accounting still include exempt launches.
    -- Implementation: internal/orchestration/autopilot.go
    -- selectLaunchGroupsWithinHeadroom and
    -- internal/campaign/auto_planner.go LaunchGroup.RateCapAuthorized.
}

rule AutoPilotReusePreferredFallback {
    when: AutoPilotTick(unplaced_jobs, plan, retry_plan)
    requires: plan.projected_launch_rate > config.auto_run_rate_soft_target
    -- legacy: requires: no launch_group in plan.launch_groups where launch_group.cost <= plan.headroom
    requires: reusable_instances.any()

    ensures:
        retry_plan = BuildAutoPlacementPlan(unplaced_jobs, prefer_reuse=true)
        retry_plan.reuse_assignments.any() implies
            ApplyReuseAssignments(retry_plan.reuse_assignments)

    -- legacy annotation: @guidance
        -- If no new-launch subset fits headroom, autopilot retries planning with
        -- PreferReuse=true (busy-instance penalty disabled) so running instances
        -- can win when compatible.
        -- Jobs still unplaced after that retry are blocked with
        -- "no rental headroom; running instances couldn't accept this job",
        -- plus the first available MatchJobToInstance diagnostic.
}

rule AutoPilotBlockedReasonIsAuthoritative {
    when: AutoPilotTick(unplaced_jobs)

    ensures:
        -- legacy: for job in unplaced_jobs where job still unplaced after the pass:
            -- legacy: job.blocked_reason != null and job.blocked_reason != ""
        -- The primary (leading) blocked reason is always an authoritative
        -- launch-path reason: no compatible offers, launch error, retry
        -- cooldown, or run-rate headroom exhaustion. An opportunistic
        -- reuse-rejection diagnostic is never the primary reason.

    -- legacy annotation: @guidance
        -- Reuse-rejection diagnostics ("could not reuse running instances:
        -- ...") report why a job could not opportunistically piggyback on an
        -- existing rental. Reuse is opportunistic, so a reuse failure is
        -- expected and is not on its own a reason a job is unplaced.
        --
        -- fillReusableInstances and submitAutoPilotReuseAssignments collect
        -- these diagnostics into a separate map (reuse_diagnostics), never the
        -- blocked_reasons map directly. Were they written into blocked_reasons
        -- ahead of the launch path, the launch path's "set reason only if
        -- absent" guards would skip — masking the real reason.
        --
        -- BuildAutoPlacementPlan must classify every candidate as reuse,
        -- launch, or blocked with a concrete offer/capacity reason. Missing
        -- classification is an internal invariant failure, not a user-facing
        -- blocked reason.
        --
        -- After reuse assignments execute, every selected job that remains
        -- unplaced and has no concrete blocker enters rental_scope. This is
        -- true even in a mixed pass where other jobs received launch or block
        -- decisions: a failed opportunistic reuse must devolve to the fresh
        -- rental path rather than disappear from launch consideration.
        -- RelaunchOrphanedJobs must then either assign the job or return a
        -- per-job reason (offer filter, provider failure, retry cooldown,
        -- dependency, budget, or another concrete gate). A still-unplaced job
        -- with neither outcome is an orchestration invariant failure.
        --
        -- finalizeUnplacedBlockedReasons only persists these concrete reasons
        -- and appends reuse diagnostics as trailing detail; it never invents
        -- a launch-side explanation.
        -- Jobs that become unplaced after the planner snapshot wait for the
        -- next pass instead of inheriting this pass's reason.
        -- Reuse diagnostics are also recorded
        -- to the oplog (auto_pilot.reuse_fill_blocked / reuse_skipped /
        -- reuse_failed). Implementation: internal/orchestration/autopilot.go
        -- RunGroupedAutoPilotPass, finalizeUnplacedBlockedReasons.
        --
        -- "no rental headroom" remains valid only in the run-rate gate path
        -- (AutoPilotReusePreferredFallback), where it names the literal
        -- budget verdict. It is not a general safety-net placeholder.
        --
        -- Structured form: a job blocked because no placement avenue is
        -- available (no new instance could be launched AND no running
        -- instance could be reused) also carries a blockreason.Structured
        -- value. It splits the one-line reason into its primary launch
        -- blocker and a secondary per-instance list of reuse rejections, so
        -- a display surface can show every avenue rather than the truncated
        -- head of a joined string. When the planner observed a multi-line
        -- underlying reason (e.g. wrapped vastai stderr), the full
        -- untruncated text is persisted on Structured.LaunchDetail (and
        -- ReuseRejection.Detail) so the TUI disclosure expand view and the
        -- `weft job info` CLI can show the underlying provider message
        -- instead of a clipped one-liner.
        --
        -- Structured.Fingerprint carries a stable error-class coalescing key
        -- (shape "<provider>/<op>/<class>[:<key>]" — see
        -- cloud.ProviderError) when the upstream provider error was
        -- classifiable. Display surfaces SHOULD group blocked jobs sharing
        -- the same Fingerprint into a single incident row instead of
        -- bucketing per cosmetic filter-prefix variation. Empty Fingerprint
        -- means "no upstream classification available" and the row keeps
        -- per-message bucketing. Populated by applyGroupOffer via
        -- cloud.FingerprintOf(offer.Err) or, for empty-after-filter cases,
        -- filterStatsFingerprint over the post-filter OfferFilterStats. The
        -- autopilot lifts plan.BlockedReasonFingerprints into
        -- Structured.Fingerprint independently of LaunchDetail so jobs
        -- with a structured upstream error but short single-line detail
        -- still participate in incident coalescing. It is carried on the pass result
        -- (GroupedAutoPilotResult.StructuredBlocked) and also persisted to
        -- the jobs.placement_blocked column by finalizeUnplacedBlockedReasons
        -- so consumers that did not run the pass (watch TUIs, weft job info)
        -- can read it via blockreason.ForJob. The flat BlockedReasons string
        -- remains the authoritative, back-compat reason and equals
        -- Structured.Flat(). Single-cause blockers (preconditions,
        -- cooldowns) have no structured entry — their flat reason is already
        -- the whole story, and their placement_blocked column is cleared.
        -- Built by placementFailureStructured.
        --
        -- The run-rate (budget) gate verdict ("run-rate target exceeded",
        -- optionally with "(no subset fits)" when multiple launch jobs are
        -- under consideration, or "run-rate headroom exhausted") is itself
        -- an authoritative launch blocker, so finalizeUnplacedBlockedReasons
        -- reattaches a structured breakdown to it the same way: the budget
        -- string is the primary launch reason and the running instances are
        -- probed for secondary reuse rejections. The breakdown is attached
        -- only when probing yields at least one rejection — an instance that
        -- could accept the job (compatible, merely busy) means budget is the
        -- whole story and the row stays a single-cause blocker with an empty
        -- placement_blocked column. The flat budget string remains the
        -- compact, leading reason unchanged. Predicate: isRunRateBudgetReason.
}

rule RunRateBlockedReasonDedup {
    when: AppendPlacementReason(job, new_reason)

    -- Run-rate-exhausted reasons are snapshots of headroom at one moment:
    -- each pass with different active launches produces a different
    -- "$X/hr free, this group needs $Y/hr" string, so naive equality
    -- dedup lets them accumulate indefinitely on a long-blocked job.
    -- When the new reason is a run-rate-exhausted reason, evict every
    -- existing run-rate-exhausted reason on the job before appending;
    -- the new snapshot supersedes older ones. Non-run-rate appends
    -- preserve any existing run-rate entry untouched.
    --
    -- A reason is "run-rate-exhausted" iff it parses as one via
    -- ParseRunRateBlockedNeedCents (the canonical recognizer for the
    -- "run-rate headroom exhausted (... free, this group needs ...)"
    -- shape emitted by the planner).

    let new_is_run_rate = ParseRunRateBlockedNeedCents(new_reason).ok

    if new_is_run_rate:
        ensures:
            job.placement_reasons =
                job.placement_reasons.filter(r =>
                    not ParseRunRateBlockedNeedCents(r).ok)
                + [new_reason]
    else:
        ensures:
            new_reason in job.placement_reasons
                or job.placement_reasons = job.placement_reasons + [new_reason]

    -- legacy annotation: @guidance
        -- Implementation: internal/orchestration/rebalance.go
        -- appendPlacementReason. At most one run-rate reason per job is
        -- kept; the newest snapshot wins. Non-run-rate appends use the
        -- prior equality-dedup behaviour and never displace a run-rate
        -- entry.
}

-- ==========================================================================
-- Reconciliation (safety-net cleanup)
-- ==========================================================================

rule ReconcileOrphanedProviderInstance {
    when: ReconcilePass(instance)
    requires: instance.is_terminal
    requires: instance.ended_at > now - config.reconcile_cleanup_window
    requires: instance.provider_instance.status = running

    ensures: ProviderDestroyRequested(instance)

    -- legacy annotation: @guidance
        -- Safety-net: if a provider instance is still running after the
        -- weft instance reached terminal state, destroy it again.
        -- Checked during periodic reconciliation passes.
        --
        -- A provider's bulk "list all instances" API may be eventually
        -- consistent and return an empty or null result even when instances
        -- genuinely exist. Reconcile and instance-status readers MUST treat
        -- an empty bulk response as "no signal" and fall back to per-instance
        -- ShowInstance lookup before concluding that tracked instances were
        -- destroyed. For this safety-net path — the launch is already
        -- terminal, so the destroy is expected — an explicit per-ID
        -- not-found confirms the provider resource is gone. For LIVE
        -- launches, per-ID not-found never initiates termination (see
        -- ProviderInstanceDied).
        -- Implementation: internal/campaign/reconcile.go
        -- (ReconcileLaunches recently-terminal safety-net sweep);
        -- internal/runpod/client.go ListInstances / ShowInstance.
}

-- ==========================================================================
-- Invariants
-- ==========================================================================

-- ==========================================================================
-- Job runtime accounting (analytics)
-- ==========================================================================
--
-- For runtime estimation of preempted/relaunched jobs we record:
--   * provider_status_transitions — every observed status change on a
--     ProviderInstance, with timestamp. Total paused duration on a
--     Launch is derived as the sum of intervals where status = stopped
--     (the open interval at the right edge is extended to "now"). This
--     gives the wall-clock-vs-runtime split without an additional
--     materialized column. Implementation: db.LaunchPausedSeconds.
--   * job_attempts.predecessor_attempt_id — points the new attempt
--     created when a job is reattached to a fresh Launch back to the
--     attempt that ran on the prior, terminated Launch. Lets queries
--     follow the relaunch chain across instances.
--   * job_attempts.cloud_outcome = preempted — the prior attempt's
--     outcome when its Launch failed with termination_reason = preempted.
--     Distinct from "orphaned" so analytics can separate bid-loss
--     relaunches from generic infra-failure relaunches.

invariant ClosedCloudAttemptHasOutcome {
    -- A closed cloud attempt with cloud_outcome=null is wedged: the
    -- job_status view derives it as 'dead' and the orphan-recovery
    -- exclusion filter then skips it, so the job can never re-enter
    -- placement.
    --
    -- ENFORCEMENT (00006, 2026-05-26): the invariant is enforced by DB
    -- triggers
    --   cloud_attempts_auto_derive_outcome_insert
    --   cloud_attempts_auto_derive_outcome_update
    -- which auto-derive cloud_outcome from status (+ exit_code for
    -- completed) when an attempt closes (end_time set on a
    -- launch_id-NOT-NULL row) without one. Explicit cloud_outcome
    -- values that aren't derivable from status — 'orphaned',
    -- 'superseded', 'preempted' — are preserved by the trigger's
    -- WHEN cloud_outcome IS NULL gate. A prod scan before the
    -- migration found 837 wedged rows that the backfill resolved.
    -- Per-call-site "closing paths MUST stamp cloud_outcome" discipline
    -- remains correct (visible at the call site) but is no longer
    -- load-bearing. See internal/db/terminal_attempt_triggers_test.go.
    for ja in JobAttempts where ja.launch_id != null and ja.end_time != null:
        ja.cloud_outcome != null
}

invariant AttemptChainPointsBackwards {
    -- A new attempt's predecessor_attempt_id, when set, refers to an
    -- earlier attempt of the same job. Together with cloud_outcome on
    -- the predecessor it reconstructs the full relaunch chain.
    for ja in JobAttempts where ja.predecessor_attempt_id != null:
        let pred = JobAttempt(ja.predecessor_attempt_id)
        pred.job_id = ja.job_id
        pred.attempt_number < ja.attempt_number
}

invariant BenchmarkIncompatibleWithInterruptible {
    -- Benchmark and interruptible are semantically incompatible: a
    -- preemption mid-measurement invalidates the benchmark (cold GPU
    -- on resume, broken timing), and a stale-pause relaunch moves the
    -- job to a different physical machine. Enforced at job submission
    -- by validateReservedPlacementTags (internal/db/db.go). Tags are
    -- canonicalized first, so the legacy "preemptible" alias is also
    -- caught.
    for job in Jobs:
        not ("benchmark-isolation" in job.tags and "interruptible" in job.tags)
}

invariant TerminalInstancesHaveEndTime {
    -- ENFORCEMENT (00007, 2026-05-26): DB triggers
    --   launches_terminal_auto_stamp_ended_at
    --   launches_terminal_auto_stamp_ended_at_insert
    -- auto-stamp ended_at = strftime('%s','now') when a launch
    -- transitions (or is inserted) into {failed, canceled, completed}
    -- with ended_at NULL. A prod scan before the migration found 5
    -- such rows; backfill resolved them using the latest available
    -- wall-clock anchor on the row (provider_running_at >
    -- launched_at > ready_at > created_at).
    for instance in Instances:
        if instance.is_terminal:
            instance.ended_at != null
}

invariant SucceededTerminationIntentBoundsEndTime {
    -- The destroy-success timestamp is the lifecycle event, not the time a
    -- later CLI/TUI reconcile pass happened to observe the persisted intent.
    -- Reconcile can lag by hours because there is no always-on placement service;
    -- using reconcile time inflates uptime and derived cost by that idle gap.
    -- Migration 00041 repairs historical rows where the recorded ended_at is
    -- later than a succeeded termination intent's destroy timestamp.
    for instance in Instances:
        if instance.is_terminal
           and instance.termination_intent.effective_state = succeeded
           and instance.termination_intent.destroy_succeeded_at != null:
            instance.ended_at <= instance.termination_intent.destroy_succeeded_at
}

invariant TerminalInstancesHaveReason {
    -- ENFORCEMENT (00007, 2026-05-26): DB triggers
    --   launches_terminal_auto_derive_reason
    --   launches_terminal_auto_derive_reason_insert
    -- auto-derive termination_reason from status when missing:
    -- canceled → 'canceled', completed → 'completed', failed →
    -- 'unknown' (the sentinel already in
    -- launches_termination_reason_check). Writers that DO know the
    -- specific reason are preserved by the WHEN
    -- termination_reason IS NULL gate. The leaker was the fallback
    -- branch of internal/db/cloud_instances.go:999 that updated
    -- status + ended_at without a reason; a prod scan found 49
    -- such rows, backfilled by the same migration. The companion
    -- UpdateLaunchStatus guard now treats 'unknown' as overridable
    -- so a writer that learns the specific reason later can still
    -- record it over the trigger-set placeholder.
    for instance in Instances:
        if instance.status in {failed, canceled}:
            instance.termination_reason != null
}

invariant InstanceEventuallyTerminal {
    -- Every Instance reaches a terminal status within a bounded wall-clock
    -- window of creation. The window is the maximum of the per-status
    -- ceilings enforced by the kill-candidate rules enumerated in
    -- §Runaway prevention layer 2. Adaptive thresholds (layer 3) may
    -- shorten but MUST NOT extend this bound beyond
    --     config.launching_phase_timeout + config.setup_stall_timeout
    --     + config.running_stall_timeout + config.grace_shutdown_timeout.
    -- Any new pre-running bootstrap phase added to the Instance lifecycle
    -- MUST be covered by a rule that fires within this bound; otherwise
    -- this invariant is violated.
    for instance in Instances:
        instance.is_terminal
        or (now - instance.created_at)
           < config.launching_phase_timeout
             + config.setup_stall_timeout
             + config.running_stall_timeout
             + config.grace_shutdown_timeout
}

invariant GraceRequiresDeadline {
    -- ENFORCEMENT (00007, 2026-05-26): DB triggers
    --   launches_grace_requires_deadline_update
    --   launches_grace_requires_deadline_insert
    -- RAISE (BEFORE INSERT / BEFORE UPDATE OF status) when a launch
    -- transitions to grace status without both grace_started_at and
    -- grace_deadline. RAISE rather than auto-derive because the
    -- deadline is operationally load-bearing — the agent's R2
    -- grace-poll loop uses it to decide self-destruct — and no sane
    -- auto-derived value exists at the table layer (the default
    -- grace period is a config value, not a schema fact). Forces
    -- writers to pass them explicitly. CreateLaunch defaults to
    -- (now, now + 5min) when a Launch struct is constructed in
    -- grace status without them, so the common test-setup pattern
    -- works without ceremony; the trigger still catches all UPDATE
    -- leaks.
    for instance in Instances:
        if instance.status = grace:
            instance.grace_deadline != null
            instance.grace_started_at != null
}

invariant ResubmittedJobRuntimeDoesNotConsumeGrace {
    -- grace_deadline represents idle wait time after a failure, not a
    -- total wall-clock budget. When a resubmitted job runs and then
    -- fails (instance re-enters grace), the deadline must remain at
    -- or after grace_started_at so the post-failure idle window
    -- matches the pre-submission one, regardless of how many resubmit
    -- cycles preceded it.
    --
    -- Implementation: agent at cmd/agent/gracewait.go captures
    -- jobStart before runJobSequence and calls
    -- extendGraceDeadlineForJobs(deadline, jobStart, now) after.
    -- The refreshed deadline is written to R2 BEFORE phase=grace
    -- so sync never reads phase=grace alongside a
    -- stale deadline.
    --
    -- Violating this invariant produces the wj2297 failure mode
    -- (2026-05-31): a 21-min resubmitted job inside a 15-min
    -- grace window caused the agent to self-destruct the instant
    -- the job finished, and left grace_deadline < grace_started_at
    -- on the sync side after the next reconcile refresh.
    for instance in Instances:
        if instance.status = grace:
            instance.grace_deadline >= instance.grace_started_at
}

invariant TerminalCampaignsHaveEndTime {
    for campaign in Campaigns:
        if campaign.is_terminal:
            campaign.ended_at != null
}

invariant CompletedCampaignsHaveAllCompleted {
    for campaign in Campaigns:
        if campaign.status = completed:
            campaign.instances.all(i => i.status = completed)
}

invariant BlockedJobsNotRelaunchedInSamePass {
    -- When the planner returns a non-empty blocked_reasons map for a job,
    -- the autopilot pass MUST NOT issue a launch for that job in the
    -- same pass. Blocked jobs remain unplaced until re-evaluated.
    for plan in AutoPlacementPlans:
        for job_id in plan.blocked_reasons.keys():
            job_id not in plan.launch_job_ids

    -- legacy annotation: @guidance
        -- Planner output contract: internal/campaign/auto_planner.go.
        -- Enforced by caller: internal/orchestration/autopilot.go
        -- RunGroupedAutoPilotPass, which iterates LaunchJobIDs
        -- only and does not fall through to the blanket fallback when
        -- blocked_reasons is non-empty.
}

invariant InventoryTaggedJobsBypassCloudPlanner {
    -- Inventory-tagged unplaced jobs must never be visible to
    -- BuildAutoPlacementPlan. They belong on on-prem hosts (placement
    -- happens in internal/app/hostsync/worker.go); routing them through
    -- the cloud planner builds phantom launch groups that:
    --   * inflate the projected launch rate, producing spurious
    --     "run-rate headroom exhausted" reasons on cloud-eligible jobs,
    --     and
    --   * never execute, because rentalScope (relaunch.go:1756/2041)
    --     correctly rejects inventory jobs at launch time.
    -- Instead, each inventory-tagged unplaced job receives the reason
    -- "inventory-tagged: waiting for on-prem host" and that reason is
    -- merged into the pass's BlockedReasons.
    for plan in AutoPlacementPlans:
        plan.considered_job_ids.all(job_id =>
            not ("inventory" in Job(job_id).tags))

    -- legacy annotation: @guidance
        -- Implementation: internal/orchestration/autopilot.go
        -- RunGroupedAutoPilotPass — the per-job check on db.TagInventory
        -- partitions inventoryAwaiting before the planner call;
        -- persistInventoryAwaitingReasons writes the structured reason;
        -- mergeInventoryReasons is deferred so it runs on every return
        -- path (early exit, planner error, normal completion).
}

invariant AutoPilotFallbackRequiresNoDecisions {
    -- The "launch all remaining unplaced jobs" fallback path in the
    -- autopilot pass may fire only when the planner returned no
    -- decisions at all — both LaunchJobIDs and BlockedReasons empty.
    -- If the planner blocked anything, blocked jobs must wait for the
    -- next pass; we do not bypass the planner.
    for plan in AutoPlacementPlans:
        AutoPilotFallbackFired(plan) implies
            (not plan.launch_job_ids.any()
             and not plan.blocked_reasons.any())

    -- legacy annotation: @guidance
        -- See internal/orchestration/autopilot.go RunGroupedAutoPilotPass.
        -- The fallback exists to preserve behavior when a planner is
        -- unavailable or returns an empty plan; it is not a bypass for
        -- blocked jobs.
}

invariant AtMostOneRunRateReasonPerJob {
    -- A job's placement_reasons must contain at most one run-rate-
    -- exhausted reason at any time. Without this guard, every pass
    -- through AppendPlacementReason for a still-blocked job would
    -- accumulate another headroom snapshot and the list would grow
    -- unbounded across passes. See RunRateBlockedReasonDedup for the
    -- eviction rule that maintains this property.
    for job in Jobs:
        job.placement_reasons.filter(r =>
            ParseRunRateBlockedNeedCents(r).ok).count <= 1
}

-- ==========================================================================
-- Autopilot pass cadence
-- ==========================================================================

-- After a pass completes, the next pass is deferred by an outcome-dependent
-- cooldown so that transient failures do not produce a tight retry loop.
-- Manual user actions (toggling autopilot, refresh, changing the run-rate
-- target) clear the cooldown to force immediate re-evaluation.

rule AutoPilotPassCooldown {
    when: AutoPilotPassCompleted(outcome)

    ensures:
        -- legacy: match outcome:
            -- legacy: Error               -> DeferNextPass(60.seconds)
            -- legacy: LeaseContention     -> DeferNextPass(15.seconds)
            -- legacy: Progress            -> DeferNextPass(5.seconds)
            -- legacy: Blocked             -> DeferNextPass(30.seconds)
            -- legacy: Idle                -> DeferNextPass(30.seconds)

    -- legacy annotation: @guidance
        -- TUI driver: internal/ui/terminal/list_tui.go listAutoPilotDoneMsg
        -- handler + runAutoPilot guard on autoNextPassAt.
        -- Progress = at least one job placed or launched.
        -- Blocked  = planner returned block reasons, no progress.
        -- Idle     = plan empty, no progress, no blocks.
        -- LeaseContention = another TUI holds the autopilot lease.
}

rule AutoPilotManualResume {
    when: UserActionRequestsImmediatePass(action)

    ensures: ClearCooldown()

    -- legacy annotation: @guidance
        -- Manual actions that clear autoNextPassAt:
        -- * enabling the autopilot ('A' key, or `weft autopilot resume`)
        -- * manual refresh ('r')
        -- * saving a new run-rate target
        -- Implemented via resumeAutoPilotNow() in list_tui.go.
}

-- ==========================================================================
-- Autopilot singleton state (cross-process gate)
-- ==========================================================================
--
-- A single row in the `autopilot_state` table provides a coarse,
-- externally-observable, externally-controllable layer above the
-- per-scope auto_leases. Two functions:
--
--   1. Contention: only one autopilot pass may execute at a time across
--      all weft processes that share the database. A pass holder
--      heartbeats every few seconds; an aged-out claim is reclaimed.
--   2. Pause: a sticky `paused` flag halts every autopilot runner
--      (list TUI, watch TUI, autopilot, sync loop) without
--      requiring any process to exit. This is the single, global
--      autopilot enabled/disabled state — there is no per-TUI toggle.
--
-- The CLI (`weft autopilot status|pause|resume`) and the `A` key in any
-- TUI read and mutate this row. External agents that intend to launch
-- instances or restart orphaned jobs by hand SHOULD pause the autopilot
-- first to avoid
-- racing it.

rule AutoPilotPassRespectsSingletonGate {
    when: AutoPilotTick(_, autopilot_state)

    requires:
        not autopilot_state.paused
        -- legacy: and (autopilot_state.pass_started_at is None
             -- legacy: or now - autopilot_state.last_heartbeat
                -- legacy: >= AutopilotPassStaleAfter)

    ensures:
        ClaimAutopilotPassSlot(runner_pid, runner_label)
        and HeartbeatWhileRunning(runner_pid, AutopilotHeartbeatInterval)
        and ReleaseSlotOnCompletion(runner_pid)

    -- legacy annotation: @guidance
        -- Schema: internal/db/autopilot_state.go (singleton, id=1).
        -- Runner: internal/orchestration/autopilot_runner.go
        --   AutopilotRunner.TryAcquire / Release.
        -- Stale threshold: AutopilotPassStaleAfter (30s).
        -- Heartbeat interval: 5s (must be << stale threshold).
        -- list_tui calls RunGroupedAutoPilotPassGated which wraps the
        -- existing per-scope auto_lease with this gate.
        -- watch_tui short-circuits on autopilot_state.paused at the top
        -- of runAutoPilot (it does not take the slot because its
        -- auto-place / auto-launch fan out across multiple commands).
}

rule AutoPilotBinaryUpgradeHandsOffAtPassBoundary {
    when: AutopilotControllerObservesInstalledBinaryChanged(controller)

    ensures:
        if controller.holds_pass_slot:
            FinishCurrentPass(controller)
            and ReleaseSlotOnCompletion(controller.pid)
        else:
            not ClaimAutopilotPassSlot(controller.pid, controller.label)
            and YieldFuturePassesToCurrentBinary()

    -- legacy annotation: @guidance
        -- Binary freshness is checked by AutopilotRunner.TryAcquire before
        -- it mutates autopilot_state. A binary replacement does not interrupt
        -- a pass that already owns the slot; that pass reaches its normal
        -- deferred Release. On its next acquisition attempt the old process
        -- receives processguard.ErrBinaryChanged and cannot reclaim the slot.
        -- The list TUI treats this as a durable upgrade handoff, not a pass
        -- failure, so it neither displays a stale blocker nor retries.
        -- Implementation: internal/orchestration/autopilot_runner.go and
        -- internal/ui/terminal/list_tui.go.
}

invariant AutoPilotProviderOfferSearchRunsOutsideSingleton {
    -- Slow provider offer searches are not part of the DB-backed placement
    -- critical section. The singleton protects the fast DB placement decision
    -- and launch-intent mutation, not a remote provider round trip.
    -- legacy: invariant_holds:
        -- legacy: AutoPilotTick(_)
            -- legacy: implies SearchOffersForGroup(_) happens_before ClaimAutopilotPassSlot(_, _)
                    -- legacy: or UsesCachedOfferSnapshot(_)

    -- legacy annotation: @guidance
        -- Vast.ai / provider SearchOffers can take tens of seconds during
        -- network trouble. Holding the singleton during that call blocks
        -- foreground placement and status/preview operations behind network
        -- I/O that does not mutate local state. Autopilot therefore builds a
        -- short-lived in-memory raw-offer snapshot before TryAcquire and
        -- enters the claimed pass with cached-offer-only planner options.
        -- If the planner later needs a group missing from the snapshot, that
        -- miss is an unknown offer-fetch state, not permission to call the
        -- provider under the slot.
        --
        -- Implementation: internal/orchestration/autoplanner.go
        -- fetchAutoPilotOfferSnapshot; internal/campaign/offers.go
        -- offerSearchSession CachedOffersOnly / ErrOfferSnapshotUnavailable.
}

invariant OfferFetchFailureIsUnknownNotEmpty {
    -- A provider timeout or transport/API error means Weft could not observe
    -- the market. It is not evidence that the market has zero compatible
    -- offers.
    -- legacy: invariant_holds:
        -- legacy: SearchOffersForGroup(group) returns error
            -- legacy: implies OfferAvailability(group) = unknown
                -- legacy: and not OfferAvailability(group) = confirmed_empty
                -- legacy: and not BlockedReason(group.jobs, "no offers")

    -- legacy annotation: @guidance
        -- On an offer-fetch error, autopilot may reuse a last-good snapshot
        -- for the same normalized constraints. Without a last-good snapshot
        -- it skips new cloud launch for that group this pass and records an
        -- "offer fetch unavailable" reason. It must not conclude rentals are
        -- unavailable, mark a terminal/destructive outcome, or overwrite the
        -- job with a no-offers diagnosis.
        --
        -- Confirmed empty remains a distinct state: a successful provider
        -- search that returns zero offers can still produce a no-offers
        -- blocked reason with normal filter diagnostics.
        --
        -- Display/reporting corollary: if offer diagnostics carry provider
        -- errors with zero observed offers, render the blocker as provider
        -- offer fetch unavailable / market unknown / retrying, not as "no
        -- offers from providers". OfferFilterStats must also report every
        -- local filter stage that can empty a nonzero offer set, including
        -- host RAM and interconnect/topology filters, so the empty-market
        -- diagnosis is not reused for local post-filter failures.
}

invariant PausedAutopilotTakesNoActions {
    -- While paused, no process may issue auto-placements, auto-launches,
    -- automatic relaunches of orphaned jobs, or automatic data publication.
    -- legacy: invariant_holds:
        -- legacy: autopilot_state.paused implies
            -- legacy: not AutoPlacementApplied(_)
            -- legacy: and not AutoLaunchInstanceFromUnplaced(_, _)
            -- legacy: and not RelaunchOrphanedJobsAutomatically(_)
            -- legacy: and not R2PutFromHost(_, _, _)

    -- legacy annotation: @guidance
        -- Manual user-driven launches and `weft instance submit` are
        -- still permitted while the autopilot is paused — pause is
        -- specifically about the *automated* policy loop.
        -- Sync is also still permitted: explicit `weft sync`, daemon sync,
        -- and TUI hostsync.Worker may dispatch queued jobs whose concrete
        -- host/live-instance target is already known. Pause disables new
        -- placement decisions and new instance creation, not queue
        -- dispatch to known destinations.
}


}

rule MoveSelectorResolution {
    when: UserInvokesMove(selector, target)

    requires:
        count([selector.job_ids.any(),
               selector.project_name != null,
               selector.from != null] where value = true) = 1

    if selector.job_ids.any():
        ensures: MoveCandidateJobs = JobsByID(selector.job_ids)

    if selector.project_name != null:
        ensures: MoveCandidateJobs =
            Jobs where job.project = selector.project_name
                 and job.status in {queued, pending_placement}

    if selector.from != null:
        -- legacy: if selector.from parses as CloudInstanceID:
            ensures: MoveCandidateJobs =
                Jobs where job.cloud_instance.id = selector.from
                     and job.status in {queued, pending_placement}
        -- legacy: else if exists Jobs where job.host = selector.from:
            ensures: MoveCandidateJobs =
                Jobs where job.host = selector.from
                     and job.status in {queued, pending_placement}
        else:
            ensures: MoveCandidateJobs =
                Jobs where job.project = selector.from
                     and job.status in {queued, pending_placement}

    ensures:
        if MoveCandidateJobs.empty():
            ShowError("no eligible queued jobs")
        else:
            for job in MoveCandidateJobs:
                -- legacy: for prior in MoveIntent { job = job, state = open }:
                    -- legacy: if prior.target_attempt != null:
                        -- legacy: AbandonAttempt(prior.target_attempt,
                                       -- legacy: reason = "move_destination_rejected",
                                       -- legacy: by_intent = prior)
                    -- legacy: ResolveMoveIntent(prior, canceled, "superseded by explicit move")
                -- legacy: for prior in PlacementIntent { job = job, state = open }:
                    -- legacy: ResolvePlacementIntent(prior, canceled, "superseded by explicit move")
                -- legacy: ExecuteMoveOption(job, target, MoveIntentFor(job, target))

    -- legacy annotation: @guidance
        -- CLI selector precedence for `weft job move --from X` is:
        -- instance id, then host name, then project name. The project
        -- fallback is only used when there are no jobs at all for X as a
        -- host, not merely when there are no currently queued host jobs.
        -- Implementation: internal/orchestration/job_move.go
        -- ResolveEligibleJobs.
}

rule MoveToNewLaunchAttachesIntent {
    -- Once the cloud launch has produced an instance, link it to the
    -- intent so the autopilot exclusion (which is keyed on JobID) is
    -- joined by an instance reference for diagnostics and sync can confirm
    -- the intent when the target agent reports ready.
    when: EvaluateMoveToNewLaunchAttachesIntent() -- legacy: LaunchCampaign(group, ...) returns instance_id
          -- legacy: and exists(MoveIntent { job in group.jobs, state = open,
                                  -- legacy: target_kind = new, target_launch = null })

    -- legacy: for intent in MoveIntent { state = open, target_kind = new,
                               -- legacy: target_launch = null,
                               -- legacy: job in group.jobs }:
      ensures:
          -- legacy: UpdateMoveIntentTargetLaunch(intent, instance_id)
}

rule MoveToNewRetryLoop {
    -- A move-to-new intent can survive failed target launches. The failed
    -- target attempt remains linked until the next retry opens a replacement
    -- attempt; this lets later terminal resolution stamp the loser attempt
    -- abandoned and keeps hidden-target view exclusion intact.
    when: AutopilotPassStart()
          -- legacy: and exists(MoveIntent { state = open, target_kind = new })
          -- legacy: and TargetFailedBeforeJobStarted(intent)
          -- legacy: and intent.source_launch != null
          -- legacy: and intent.source_launch.status in {launching, running, paused, grace}

    -- legacy: if intent.attempt_count < intent.max_attempts
       -- legacy: and now - intent.created_at <= 2h:
      ensures:
          -- legacy: RestoreJobToLaunch(intent.job, intent.source_launch)
          -- legacy: let replacement = LaunchReplacementTarget(intent)
          -- legacy: intent.state = open
          -- legacy: intent.attempt_count = intent.attempt_count + 1
          -- legacy: intent.target_launch = replacement
          -- legacy: intent.target_attempt = ReplacementAttemptFor(replacement)

    -- legacy: if intent.attempt_count >= intent.max_attempts
       -- legacy: or now - intent.created_at > 2h:
      ensures:
          -- legacy: ResolveMoveIntent(intent, canceled, "move-to-new retry exhausted")

    -- legacy annotation: @guidance
        -- Implementation:
        --   internal/orchestration/autopilot.go
        --   fulfillOpenMoveToNewIntents / moveIntentRetryAction /
        --   launchMoveIntentRetry. The two-hour bound is
        --   db.MoveIntentRetryPruneAgeLimit: five attempts at roughly
        --   15-20 minutes each can consume 75-100 minutes, so two hours
        --   covers the intended budget while guaranteeing repair convergence
        --   if the autopilot never runs.
}

rule ExistingRunningRentalMoveWaitsForTargetAck {
    -- The R2 grace request is a durable request, not acceptance. The
    -- coordinator records the request id and leaves the move open until
    -- sync observes the corresponding ack. Running rental agents drain
    -- jobs requests on a background interval WHILE a job executes (the
    -- accepted jobs still run after the current job), so the ack — and
    -- with it move confirmation and the source stop — arrives within a
    -- drain interval rather than after the current job finishes.
    when: EvaluateExistingRunningRentalMoveWaitsForTargetAck(intent) -- legacy: ExecuteMoveOption(job, target, intent) writes GraceJobsRequest
          -- legacy: and target.kind = existing
          -- legacy: and target.launch.status = running
    requires: intent.state = open

    ensures:
        intent.target_request_id = GraceJobsRequest.request_id
        intent.target_request_kind = jobs
        intent.state = open
        JobAuthority(job) = intent.source_attempt
        StopSourceAttempt(intent) is not_started
}

rule ExistingRunningRentalTargetAckRejected {
    -- If the later ack rejects the jobs request, the hidden destination
    -- attempt is abandoned and the move is canceled. The source remains
    -- authoritative because it was never stopped.
    when: EvaluateExistingRunningRentalTargetAckRejected(intent, target_launch)
    requires: GraceAck.kind = jobs
    requires: GraceAck.accepted = false
    requires: intent.state = open
              and intent.target_kind = existing
              and intent.target_launch.status = running

    ensures:
        if intent.target_attempt != null:
            AbandonAttempt(intent.target_attempt,
                           reason = "move_destination_rejected",
                           by_intent = intent)
        ResolveMoveIntent(intent, canceled, "target rejected jobs request")
        JobAuthority(intent.job) = intent.source_attempt
        StopSourceAttempt(intent) is not_started
}

rule ConfirmMoveOnTargetAcceptance {
    -- The destination has accepted the job. For `existing` targets the
    -- destination's R2 grace ack constitutes acceptance; for grace-status
    -- rentals the submission path waits for this ack synchronously, while
    -- running rentals record the request id and sync consumes the ack
    -- later. For on-prem hosts, the queue protocol acceptance is the ack.
    -- For `new` targets, acceptance is the target agent_ready signal, or
    -- the target attempt reaching a job-owned terminal result first.
    --
    -- ENFORCEMENT NOTE: hidden target attempts are not confirmed by
    -- generic attempt-insert triggers. Confirmation goes through
    -- ConfirmMoveTargetAccepted (or ConfirmOpenMoveIntentsForTargetLaunch
    -- on target agent_ready), which both resolves the intent and abandons
    -- the source attempt in one DB transaction.
    when: DestinationAcceptanceObserved(job, target, intent)
    requires: intent.state = open

    ensures:
        ConfirmMoveTargetAccepted(intent, "moved to " + describe(target))
}

rule CancelMoveOnFailure {
    when: EvaluateCancelMoveOnFailure()

    -- Legacy body retained as migration guidance:
    -- The move's intermediate steps (unplace, claim, R2 write, launch) all
    -- failed. The source's authority must be restored if the source is
    -- still alive; otherwise the job becomes legitimately unplaced and the
    -- autopilot may pick it up on its next pass (the only state where it
    -- is allowed to). Move-to-new has one retryable subcase: when the target
    -- launch or bootstrap fails before the job starts, the source launch is
    -- still live, and attempt_count < max_attempts, the move remains open
    -- for the autopilot retry loop instead of resolving canceled.
    -- when: EvaluateCancelMoveOnFailure(intent, source_launch) -- legacy: ExecuteMoveOption(job, target, intent) fails
    -- requires: intent.state = open

    -- ensures:
    -- if intent.target_kind = new
    -- and TargetFailedBeforeJobStarted(intent)
    -- and intent.source_launch != null
    -- and intent.source_launch.status in {launching, running, paused, grace}
    -- and intent.attempt_count < intent.max_attempts
    -- legacy: then
    -- legacy: if intent.target_attempt != null:
    -- legacy: MarkAttemptCanceled(intent.target_attempt,
    -- legacy: outcome = infrastructure_failure)
    -- legacy: RestoreJobToLaunch(job, intent.source_launch)
    -- legacy: KeepMoveIntentOpen(intent)
    -- legacy: else
    -- legacy: if intent.target_attempt != null:
    -- legacy: AbandonAttempt(intent.target_attempt,
    -- legacy: reason = "move_destination_rejected",
    -- legacy: by_intent = intent)
    -- legacy: if intent.source_launch != null
    -- legacy: and intent.source_launch.status in {launching, running, paused, grace}
    -- legacy: then
    -- legacy: RestoreJobToLaunch(job, intent.source_launch)
    -- legacy: ResolveMoveIntent(intent, canceled, "move failed; restored to source")
    -- legacy: else
    -- Source is gone (or the job had no source). Job is left
    -- unplaced; AutopilotIgnoresMovingJobs no longer applies once
    -- the intent is canceled.
    -- legacy: ResolveMoveIntent(intent, canceled, "move failed")

    -- legacy annotation: @guidance
    -- Implementation:
    --   internal/db/placement_transitions.go
    --   HandleMoveTargetFailedBeforeStart closes the failed target
    --   attempt, restores an open source attempt, and leaves the intent
    --   open until attempt_count reaches max_attempts.
    --   internal/orchestration/move.go executeWithIntent preserves that
    --   open state for IsNew options so the autopilot retry path can
    --   advance the intent to a replacement target.
}

rule RequeueAbandonsOpenMoveIntent {
    -- A full requeue (launch reset, user restart/requeue/unplace/replan,
    -- stale-host repair, startup attempt cleanup) closes every attempt of the
    -- job — including a hidden move-target attempt on a DIFFERENT launch —
    -- and returns the job to the queue. An intent left open after that
    -- describes no executable move, and via AutopilotIgnoresMovingJobs it
    -- would hide the requeued job from placement forever (wj4620). Each
    -- requeue primitive therefore resolves the intent alongside closing the
    -- attempts, so no requeue path can reintroduce the wedge.
    -- The move-to-new restore path (MoveTargetFailedBeforeStart) takes
    -- precedence when the reset launch is the intent's target: that path
    -- skips the requeue primitive and manages the intent's retry lifecycle
    -- itself.
    when: CloseAttemptsAndRequeue(job)
    -- legacy: requires: exists(MoveIntent { job = job, state = open })

    -- legacy: ensures:
        -- legacy: let intent = MoveIntent { job = job, state = open }
        -- legacy: if intent.target_attempt != null:
            -- legacy: AbandonAttempt(intent.target_attempt,
                           -- legacy: reason = "move_destination_rejected",
                           -- legacy: by_intent = intent)
        -- legacy: ResolveMoveIntent(intent, canceled, "job requeued; move abandoned")
}

rule SyncCancelsAbandonedMoveTargetAttempts {
    -- Resolving an intent does not by itself retract the durable R2 jobs
    -- request already parked at the target. Without retraction the target
    -- agent would eventually drain the request and start an attempt the DB
    -- has already canceled — the running-canceled-attempt stall that
    -- terminates instances. Per-instance sync re-sends cancel-attempts
    -- markers for recently abandoned move targets; the marker is idempotent
    -- (the agent unions attempt ids and checks them before each job start),
    -- and a recency window bounds the re-sends.
    when: SyncInstanceState(target_launch)
    -- legacy: requires: exists(MoveIntent { target_launch = target_launch,
                                  -- legacy: state in {canceled, obsoleted},
                                  -- legacy: target_attempt != null,
                                  -- legacy: target_attempt.start_time = null,
                                  -- legacy: resolved_at >= now - recency_window })

    ensures:
        -- legacy: SendGraceCancelAttempts(target_launch,
            -- legacy: [intent.target_attempt for each such MoveIntent])
}

rule ObsoleteMoveOnSourceCompletion {
    -- If the source attempt reaches a job-owned terminal result before the move is
    -- confirmed, the move is obsoleted: the destination submission
    -- (already written to R2 for `existing`, or in-flight for `new`)
    -- should be canceled. Best-effort: if the destination has already
    -- started running, accept the duplicate run and discard whichever
    -- finishes second.
    --
    -- ENFORCEMENT NOTE: As of 00005, this rule is enforced by a DB trigger
    -- on job_attempts (UPDATE OF end_time / UPDATE OF status). The trigger
    -- gates on the source attempt's status reaching a job-owned terminal
    -- value ({completed, failed}) in addition to end_time being set. This
    -- distinguishes natural job termination from infrastructure/orphan
    -- closure and from closeOpenAttempts-driven re-routing of an in-flight
    -- move.
    when: EvaluateObsoleteMoveOnSourceCompletion(intent, source_attempt)
    requires: intent.source_attempt.status in {completed, failed}
    requires: intent.state = open

    ensures:
        TryCancelDestinationSubmission(intent)
        if intent.target_attempt != null:
            AbandonAttempt(intent.target_attempt, reason = "move_source_won",
                           by_intent = intent)
        ResolveMoveIntent(intent, obsoleted, "source completed before confirmation")
}

-- ==========================================================================
-- DB-backed auto-resolution and authority
-- ==========================================================================
--
-- The move protocol is DB-backed in two different ways:
--
--   * Authority is view-enforced. While a MoveIntent is open, its
--     target_attempt is excluded from authoritative_job_attempts and
--     therefore from job_status/job-info/artifact default lookup. When
--     a loser is abandoned, it remains excluded permanently.
--
--   * Completion markers for abandoned attempts are inert. A move-overlap
--     loser may keep executing until it is stopped and leave its own
--     jobs/<jobID>/runs/<runID>/.complete marker on R2. Ingesting that
--     orphaned marker must never revive the abandoned attempt, flip the job
--     terminal, emit a completion oplog entry, or fire a terminal-status
--     notification: it is marked processed on first observation and the
--     audit row is left untouched. See status-sync.allium §
--     SyncRecordsCloudCompletion (incident wb60: a move-source loser's
--     marker produced 19 duplicate "completed" notifications while the job
--     was still running on the target).
--
--   * Race resolution is trigger-backed for job-owned terminal results.
--     If the source attempt finishes completed/failed while the intent is
--     open, the target attempt is abandoned and the intent is obsoleted.
--     If the target attempt finishes completed/failed while the intent is
--     open, the source attempt is abandoned and the intent is confirmed.
--
-- Generic placement triggers still exist for non-move placement paths:
-- attempts with move_intent_id = NULL may auto-confirm open intents that
-- predate the hidden-attempt protocol. Hidden target attempts use
-- move_intent_id and are deliberately excluded from those generic
-- insertion/update triggers.
--
-- The pre-trigger periodic reconciler
-- (internal/db/placement_reconciler.go::ReconcilePlacementRows) is removed
-- in the same change. Its remaining responsibility (requeueing jobs
-- stranded on dead cloud-instance host references) lives on as
-- ReconcileStaleCloudHostJobs.
--
-- Behavioural test coverage:
--   internal/db/attempts_test.go (hidden target attempt authority)
--   internal/db/move_intents_test.go (intent resolution helpers)
--   internal/db/intent_triggers_test.go (legacy/generic trigger invariants)
--   internal/db/cloud_instances_test.go (ResetLaunchJobs + intent flow)
--   internal/orchestration/move_test.go (end-to-end move flows)

-- ==========================================================================
-- Invariants
-- ==========================================================================

invariant AtMostOneOpenIntentPerJob {
    -- The mutex property. Enforced at intent creation time.
    for job in jobs:
        -- legacy: count(MoveIntent { job = job, state = open }) <= 1
}

invariant AutopilotIgnoresMovingJobs {
    -- The central correctness property. Without this, the autopilot races
    -- in-flight placement / move work and double-handles the same job.
    -- The exclusion is over the union of MoveIntent and PlacementIntent:
    -- both kinds claim "this job is being handled — do not touch it"
    -- from the autopilot's perspective. Implemented by filtering
    -- autopilot.unplaced_jobs and rebalance candidates by
    -- `not exists(MoveIntent { job = j, state = open })
    --      and not exists(PlacementIntent { job = j, state = open })`.
    for j in autopilot.candidate_jobs:
        -- legacy: not exists(MoveIntent { job = j, state = open })
        -- legacy: and not exists(PlacementIntent { job = j, state = open })
}

invariant QueueRebalanceCandidatesAreSubmitEligible {
    -- Queue rebalancing may only propose moves that the destination submit
    -- path could accept from DB-visible state. This is planner/validator
    -- parity: target capacity is built with the same reusable-instance gates
    -- as SubmitJobsToInstance (live heartbeat, disk-failure exclusion, and
    -- DB-accounted reusable disk), and consumer jobs whose job-output
    -- `--needs` producers have not completed are not rebalance candidates.
    --
    -- Named asset needs are not producer-job edges and remain eligible.
    -- Completed producers pass this cheap gate; the submit path remains the
    -- authority for R2 artifact existence and transport.
    --
    -- The gates apply to DESTINATIONS only. Instances failing them (stale
    -- heartbeat, disk-failure history) remain visible as move sources — a
    -- wedged or disk-troubled instance is exactly one whose queued jobs
    -- should be movable away.
    --
    -- The submit-path guard behind the needs gate mirrors
    -- ClassifyNeedsForLaunch: on-prem producers (host-pinned at submission)
    -- and producers co-located on the same live target instance (CloudAfter)
    -- are exempt from the completed-producer requirement, so submitting a
    -- consumer to the instance its producer runs on stays valid. Rebalance
    -- candidacy has no chosen destination yet, so it applies the strict
    -- cross-instance rule.
    for move in QueueRebalancePlan.moves:
        ReusableInstanceAccepts(move.target)
        and ReusableDiskAccounted(move.target)
        -- legacy: and forall need in move.job.needs:
            need.kind = asset
            or ProducerJob(need).status = completed
}

invariant QueueRebalanceFailureCooldownConverges {
    true

    -- Legacy body retained as migration guidance:
    -- A rejected rebalance move must change future candidate membership long
    -- enough for the repair loop to converge. Rebalance excludes any job with
    -- at least three recently canceled MoveIntents in a thirty-minute window.
    --
    -- Failure detection is intentionally inverted: all canceled move intents
    -- count except a small benign set. This prevents new rejection paths from
    -- bypassing the cooldown merely because their resolution string was not
    -- added to an allowlist.
    -- for j in QueueRebalanceCandidates:
    -- count(MoveIntent {
    -- legacy: job = j,
    -- legacy: state = canceled,
    -- legacy: resolved_at >= now - 30m,
    -- legacy: resolution not in {
    -- legacy: MoveIntentResolutionStale,
    -- legacy: MoveIntentResolutionSuperseded
    -- }
    -- legacy: }) < 3
}

-- ==========================================================================
-- PlacementIntent (sibling of MoveIntent)
-- ==========================================================================

-- Records that a programmatic placement attempt is in flight: the
-- LaunchCampaign-driven initial placement, RelaunchOrphanedJobs after
-- an instance failure, or a bulk move-to-new. Distinct from MoveIntent
-- only in provenance — both serve the same "autopilot, hands off"
-- function.
--
-- Replaces a prior pattern that flipped Job.pending_status to
-- pending_placement at the start of an operation and restored it on
-- defer; that pattern relied on a special-case in the autopilot
-- ("rescue" pending_placement+unplaced jobs that got stranded by a
-- crash). With explicit intents, the rescue branch is no longer needed
-- to ensure progress: stranded intents are pruned at the start of each
-- autopilot pass via PruneStalePlacementIntentsAtPassStart, which
-- combines a launch-state predicate with a protection window.
entity PlacementIntent {
    job: jobs/Job
    operation: String           -- "auto_relaunch", "bulk_move", etc.
    state: PlacementIntentState
    created_at: Timestamp
    resolved_at: Timestamp?
    resolution: String?
}

enum PlacementIntentState { open | confirmed | canceled }

config {
    placement_intent_protection_window: Duration = 5.minutes
}

invariant AtMostOnePlacementIntentOpenPerJob {
    for job in jobs:
        -- legacy: count(PlacementIntent { job = job, state = open }) <= 1
}

rule PruneStalePlacementIntentsAtPassStart {
    -- At the start of every grouped autopilot pass — before reading the
    -- open-intent set used to skip jobs from the planner — the autopilot
    -- sweeps stranded PlacementIntent rows. An intent is pruned only when
    -- BOTH predicates hold:
    --
    --   (1) Protection window: the intent is older than
    --       config.placement_intent_protection_window. This is generously
    --       above the legitimate offer-search → instance-create gap so an
    --       in-flight relaunch is not canceled out from under itself if
    --       the launch-state predicate is briefly wrong, or if a manual
    --       `weft place` is racing without holding the autopilot lease.
    --
    --   (2) No non-terminal launch backing the job: the job's most recent
    --       JobAttempt either has no launch_id, or points at a Launch
    --       whose status is in {failed, canceled, completed}. This is the
    --       primary correctness predicate; the window is defense in depth.
    --
    -- Each pruned intent emits a placement_intent.pruned lifecycle event
    -- (intent id, originating operation, age) and the pass emits a single
    -- auto_pilot.intents_pruned oplog summary event.
    when: AutopilotPassStart(intent)
    -- legacy: for intent in PlacementIntent { state = open }:
      requires: now - intent.created_at > config.placement_intent_protection_window
                -- legacy: and (intent.job.latest_attempt.launch_id = null
                     -- legacy: or intent.job.latest_attempt.launch.status in {failed, canceled, completed})
      ensures:
          -- legacy: ResolvePlacementIntent(intent, canceled,
              -- legacy: "stale: no non-terminal launch (auto-pruned)")
          -- legacy: EmitLifecycleEvent("placement_intent.pruned", intent)
}

-- ==========================================================================
-- TerminationIntent (sibling of Move/PlacementIntent, scoped to instances)
-- ==========================================================================

-- Records that a deliberate shutdown is in flight for a CloudInstance.
-- Created when the orchestrator decides to terminate (cost cap reached,
-- bootstrap timeout, user `weft instance terminate`, ballast/disk-full
-- self-destruct, etc.); resolved when the provider confirms the
-- instance is gone (or fails terminally after retries).
--
-- Implementation note: persisted as a JSON marker on
-- launches.termination_intent (not a separate table), but with an
-- explicit `state` field that is authoritative for the lifecycle phase.
-- Older markers without `state` fall back to deriving phase from the
-- destroy timestamps (see Marker.EffectiveState in
-- internal/instanceintent).
entity TerminationIntent {
    instance: cloud/Instance
    terminal_status: String        -- where the launch should land
                                   -- (failed | completed | canceled)
    termination_reason: String?    -- short tag (cost_cap, disk_full, ...)
    provider_instance_id: String?  -- recovery identity when provider create
                                   -- succeeded but the launch column write failed
    state: TerminationIntentState
    requested_at: Timestamp
    destroy_started_at: Timestamp?
    destroy_succeeded_at: Timestamp?
    destroy_attempts: Integer
    last_error: String?
}

enum TerminationIntentState { open | destroying | succeeded | failed }

-- ==========================================================================
-- InstanceReadiness (CloudInstance lifecycle)
-- ==========================================================================

-- A CloudInstance progresses through readiness phases between creation
-- and the start of useful job execution. The phases are observable via
-- two timestamps on the launch row: BootstrapDeadlineUnix (set once at
-- LaunchInstance time) and AgentReadyAtUnix (set the first time the
-- live-state sync sees bootstrap_stage = "ready" or any job has started
-- running). Together they replace a previous reconciler that
-- recomputed elapsed time from launched_at + adaptive timeout on every
-- tick.
--
-- Reconciler use:
--   - bootstrap stall fires when now > BootstrapDeadlineUnix and the
--     instance is still in launching/running with no job progress.
--   - the warn-only display fires inside the last bootstrapWarnTimeout
--     window before the deadline.
--
-- Move-to-new consumes agent_ready_at as the destination-acceptance
-- signal: the sync path confirms open target attempts for that launch and
-- then stops their sources.

-- legacy: extend entity CloudInstance {
    -- legacy: bootstrap_deadline: Timestamp?  -- set at LaunchInstance time
    -- legacy: agent_ready_at: Timestamp?      -- first transition wins
-- legacy: }

invariant BootstrapDeadlineSetAtLaunch {
    -- Every newly-created CloudInstance has its bootstrap deadline
    -- stamped before the launching transition. (Backfilled for pre-#4
    -- rows by a one-time migration.)
    for inst in CloudInstance:
        inst.created_at >= time(post_migration_baseline)
        implies inst.bootstrap_deadline != null
}

invariant AgentReadyMonotonic {
    -- AgentReadyAt is set at most once; it never moves once set.
    for inst in CloudInstance:
        inst.agent_ready_at != null
        implies stable(inst.agent_ready_at)
}

invariant InstanceWithActiveTerminationIntentRejectsReuse {
    -- The orchestrator must not place new jobs onto an instance whose
    -- termination is in flight. Implemented at instanceAcceptsReuse via
    -- Launch.HasActiveTerminationIntent (which delegates to
    -- Marker.IsActive: state in {open, destroying}).
    for inst in CloudInstance:
        -- legacy: exists(TerminationIntent { instance = inst, state in {open, destroying} })
        -- legacy: implies not InstanceAcceptsReuse(inst)
}

invariant SourceLaunchUnchangedWhileIntentOpen {
    -- Both target kinds now satisfy this property:
    --   - Move-to-existing opens a hidden target attempt, submits it to
    --     the destination, and confirms only after destination acceptance.
    --   - Move-to-new opens a hidden target attempt on the placeholder
    --     launch. If the cloud launch fails before the instance is created,
    --     the source is untouched. If the launch succeeds but the agent
    --     never comes up, the bootstrap-timeout path terminates the target
    --     and the intent remains available for retry until exhausted.
    --
    -- Job.cloud_instance still transitions through "no instance" briefly
    -- only in the rollback path (resetClaimedJobsToUnplaced after a
    -- submit/launch failure), where the outer cancel-intent restore-to-
    -- source path re-attaches the job to its prior home. The autopilot
    -- exclusion via open intent covers that window.
    --
    -- @guidance: Treat new mutations to Job.cloud_instance during an
    -- open intent as a code smell; restrict them to the confirm path or
    -- to the existing rollback paths.
    -- legacy: aspirational: false
}

invariant MoveTargetExistingHasConcreteDestination {
    for intent in MoveIntent:
        intent.target_kind = existing
        implies (
            (intent.target_launch != null and intent.target_host = null)
            or (intent.target_launch = null and intent.target_host != null)
        )
}

invariant ResolvedIntentHasResolutionTime {
    for intent in MoveIntent:
        intent.state != open implies intent.resolved_at != null
}

invariant OpenMoveTargetAttemptHidden {
    for intent in MoveIntent:
        intent.state = open
        and intent.target_attempt != null
        implies intent.target_attempt not in authoritative_job_attempts
}

invariant ResolvedMoveHasSingleAuthoritativeAttempt {
    for intent in MoveIntent:
        intent.state = confirmed
        and intent.target_attempt != null
        implies intent.target_attempt in authoritative_job_attempts
                and (intent.source_attempt = null
                     or intent.source_attempt not in authoritative_job_attempts)

    for intent in MoveIntent:
        intent.state in {canceled, obsoleted}
        and intent.target_attempt != null
        implies intent.target_attempt not in authoritative_job_attempts
}

invariant ResolvedMoveLoserHasStopWork {
    -- Stopping a process is outside SQLite, so this cannot be purely
    -- transactional. The DB transition must leave enough source/target
    -- identity for sync/reconcile to perform the side effect idempotently.
    for intent in MoveIntent:
        intent.state = confirmed
        and intent.source_attempt != null
        implies StopSourceAttempt(intent) is pending_or_complete

    for intent in MoveIntent:
        intent.state = obsoleted
        and intent.target_attempt != null
        implies StopDestinationAttempt(intent) is pending_or_complete

    -- legacy: aspirational: true
}

invariant StaleMoveIntentRepairConverges {
    -- Stale-intent repair paths are lifecycle transitions, not display
    -- cleanups. They must use the same resolution semantics as explicit
    -- cancel/confirm flows so loser attempts are abandoned and terminal
    -- intent state is stable.
    --
    -- StaleMoveIntentRepairApplies(intent) holds when the periodic sweep
    -- (PruneMoveIntents: run at DB open and each autopilot pass) can
    -- determine the intent's outcome from existing evidence:
    --   * no non-terminal target launch after the protection window
    --     -> canceled (MoveIntentResolutionStale), except retryable
    --     move-to-new intents younger than MoveIntentRetryPruneAgeLimit
    --   * the target attempt reached a job-owned terminal status
    --     (completed/failed) -> confirmed (mirrors the auto-confirm trigger)
    --   * the target attempt was canceled -> canceled, never confirmed: a
    --     canceled destination did not win. Retryable move-to-new target
    --     failures are the exception: HandleMoveTargetFailedBeforeStart
    --     closes the target attempt from inside the move and keeps the
    --     intent open until attempt_count reaches max_attempts or the intent
    --     exceeds MoveIntentRetryPruneAgeLimit.
    --   * the source attempt reached a job-owned terminal status
    --     -> obsoleted (mirrors the auto-obsolete triggers); for legacy
    --     intents predating the constructor snapshot (source_attempt null,
    --     source_launch set), the source is identified as the latest
    --     terminal non-target attempt on the source launch
    -- When both source-won and target-canceled evidence exist, source-won
    -- (obsoleted) takes precedence.
    --
    -- Retryable(intent) for repair purposes means:
    --     intent.state = open
    --     and intent.target_kind = new
    --     and intent.attempt_count < intent.max_attempts
    --     and now - intent.created_at <= MoveIntentRetryPruneAgeLimit
    -- The age bound is part of convergence, not a display timeout. It is two
    -- hours in the implementation: long enough for five real launch/bootstrap
    -- attempts, but finite so an unattended CLI-only environment cannot leave
    -- a hidden moving job open forever.
    --
    -- A repair pass over an open intent may resolve it only through
    -- ResolveMoveIntent / ConfirmMoveTargetAccepted / ObsoleteMove. It
    -- must not raw-update MoveIntent.state in a way that skips
    -- target/source loser cleanup.
    for intent in MoveIntent:
        intent.state = open
        and StaleMoveIntentRepairApplies(intent)
        -- legacy: ensures:
            -- legacy: intent.state in {confirmed, canceled, obsoleted}
            -- legacy: and intent.resolved_at != null
            -- legacy: and (
                -- legacy: intent.target_attempt = null
                -- legacy: or intent.state = confirmed
                -- legacy: or intent.target_attempt not in authoritative_job_attempts
            -- legacy: )

    -- Re-running the same repair after it resolves an intent is a no-op:
    -- terminal states never reopen, change terminal category, or produce a
    -- second authoritative attempt.
    for intent in MoveIntent:
        intent.state in {confirmed, canceled, obsoleted}
        and StaleMoveIntentRepairApplies(intent)
        ensures stable(intent.state)
                and stable(intent.resolved_at)
                and stable(intent.resolution)
}

-- ==========================================================================
-- Cross-spec interactions
-- ==========================================================================

-- job-lifecycle.allium: AutoPilotPass MUST exclude jobs with open intents
--   from its candidate set (already implemented at autopilot.go's unplaced
--   filter and in the rentalScope construction).
-- campaign-lifecycle.allium: QueueRebalanceJob MUST exclude jobs with open
--   intents and with recent failed move-intent cooldowns (implemented at
--   rebalance.go's candidates filter) AND now opens its own MoveIntent {
--   target_kind = existing } per planned move, with the R2 submission
--   performed asynchronously by a background goroutine.
-- status-sync.allium: TUI views that display "moving..." status SHOULD
--   read from MoveIntent.state, not infer move-in-progress from
--   pending_placement (which is also used by initial placement).
-- jobview/status-sync.allium: Open move display is deliberately separate
--   from job_status authority. While MoveIntent.state = open, grouped status
--   views SHOULD render the source and target positions described by the
--   intent when those endpoints are known. Attempts are supporting evidence
--   for labels, timing, and attempt-specific status; their presence is not the
--   condition for showing the move. In particular:
--     * the source endpoint is a dim, non-authoritative context row driven by
--       MoveIntent.source_launch_id / source_attempt_id / source label data.
--       If the source launch is still live (running, launching, paused,
--       grace, or otherwise not failed/canceled), the source context remains
--       visible in its real bucket; for a queued source, that means a dim row
--       in Queued. If the current logical job row has been reset to
--       queued/pending with no target, the source context still belongs in
--       Queued, not Unplaced; it is move context, not auto-placement work.
--       If the source launch has failed or been canceled, the source context
--       row is suppressed and the open move is represented only by the active
--       target row.
--     * the target endpoint is the full-contrast active move row driven by
--       MoveIntent.target_attempt_id / target_launch_id / target_host /
--       target_kind. Its bucket is driven by the open move intent ("Placing"
--       while destination acceptance is pending), not by a terminal status
--       copied from a hidden target attempt row.
--   The target row remains visible even though OpenMoveTargetAttemptHidden
--   excludes hidden target attempts from job_status authority.
--
--   Likewise, a source attempt that was closed by infrastructure cleanup
--   (cloud_outcome in {orphaned, canceled, superseded, preempted}) MUST NOT
--   be shown as the logical job being Killed/Canceled. It may contribute to a
--   dim source-context row, but its display status must be normalized so
--   terminal buckets remain reserved for user-visible logical job outcomes.

-- ==========================================================================
-- Future work
-- ==========================================================================
--
-- Remaining refinements for the unified protocol:
--
--   - Reconciler: the DB triggers now apply source-wins / target-wins for
--     job-owned terminal results. A background reconciler should still scan
--     open MoveIntents for infrastructure failures and adapter-specific
--     stale states.

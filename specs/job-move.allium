rule MoveTargetSameAsSourceRejected {
    when: UserPressesMoveAndSelectsTarget(job, target)
    requires: target.kind = existing
              and (
                  target.instance = job.cloud_instance
                  or target.host = job.host
              )

    ensures:
        ShowError("Target is the current placement")
        -- UI SHOULD not offer this option; rule is defense in depth.
}


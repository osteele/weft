-- allium: 3
-- job-lifecycle.allium
--
-- Scope: Job lifecycle from submission through execution to completion
-- Includes: Job, JobAttempt, placement, execution, failure detection, retry
-- Excludes:
--   - Cloud instance management (separate spec: campaign lifecycle)
--   - Source/data syncing implementation
--   - Telemetry sampling and timeseries collection
--   - Output artifact sync
--
-- TUI view contracts: specifications for what job-related TUI views show
-- and how they are formatted live at the end of this file under "TUI
-- views". Rendering details that depend on sync state (job status list,
-- selected-job detail footer) live in status-sync.allium alongside the
-- sync rules that drive them.
--
-- Naming convention: Allium enum literals use underscores (e.g. queue_runner).
-- The implementation uses hyphens in serialized string values (e.g. "queue-runner").
-- Spec underscores map to implementation hyphens.

-- A Host is an external entity — weft discovers capabilities but does not
-- manage the host itself.
external entity Host {
    name: String
    gpu_specs: List<GPUSpec>
}

value GPUSpec {
    class: String           -- e.g. "A100", "RTX 3090"
    memory_gb: Integer
    count: Integer
}

-- A CloudInstance is managed by the campaign lifecycle spec.
-- Jobs reference it for placement but don't control its lifecycle.
external entity CloudInstance {
    host: Host
    gpu_spec: GPUSpec
    status: String
    live_state: status_sync/InstanceLiveState?
}

-- Canonical placement identity owned by inventory-placement.allium.
external entity ExecutionTarget {
    kind: TargetKind
}

entity Job {
    -- Immutable spec (set at submission)
    command: String
    working_dir: String
    project: String
    description: String?
    inputs: List<String>        -- data dependencies (e.g. "hf:meta-llama/Meta-Llama-3-8B")
    outputs: List<String>       -- declared output assets
    output_dirs: List<String>   -- convention-based output directories
    produces: List<String>      -- artifact specs this job produces
    needs: List<String>         -- artifact specs this job requires (e.g. "output/model.pt:42");
                                -- classified at placement/launch time as either same-instance
                                -- co-location (cloud_after on the consumer's agent manifest) or
                                -- cross-instance R2 staging (cloud_needs on the manifest).
    tags: Set<Tag>
    env_vars: List<String>
    dep_spec: String?           -- host-local dependency on another job (e.g. "42" or "42:any")
    -- Launch-time derived manifest fields (not persisted on the job row):
    --   agent_job.cloud_after   -- populated when a producer of a --needs spec
    --                              shares the consumer's rental LaunchID and
    --                              that launch is not terminal / self-destructing.
    --                              Covers both same-batch co-location (producer
    --                              and consumer placed on one instance in the
    --                              same instance launch, launch still
    --                              planned/launching) and reuse of an existing
    --                              running/grace instance.
    --   agent_job.cloud_needs   -- populated when a producer is no longer reachable by
    --                              co-location and its outputs must be staged from R2

    -- GPU requirements
    gpu_class: String?          -- required GPU class (e.g. "A100", "nvidia>=24GB")
                                -- matching is normalization-based:
                                -- case/punctuation ignored, bare model aliases
                                -- are accepted (e.g. "3090", "a5000"), and
                                -- model+ means "this generation or newer"
    gpu_mem_gb: Integer?        -- minimum GPU memory per device
    gpu_mem_max_gb: Integer?    -- legacy field; ignored by placement
    gpu_devices: String?        -- CUDA_VISIBLE_DEVICES allocation

    -- CPU allotment (percent of host CPU) requested by the user. null
    -- means "unset" — the runner applies config.default_cpu_allotment
    -- at dispatch. Value 0 is not used; use null to indicate unset.
    -- Edited via the TUI in edit mode on queued jobs; not exposed on
    -- the CLI.
    cpu_allotment: Integer?

    -- Placement
    host: Host?
    target_kind: TargetKind
    -- Why the job is unplaced. Each string is one reason, e.g. "no local
    -- host matched <constraints>", per-host non-eligibility ("2 hosts: no
    -- A100 GPU"), or rental-side reasons ("provider search returned 0 offers ...",
    -- "offer query failed: ..."). UI surfaces are responsible for
    -- distinguishing actionable blockers from routine handoff state — when
    -- any cloud provider is configured, the on-prem rejection reasons
    -- (HasPrefix "no local host matched " / matches `^\d+ hosts?: `) are
    -- expected hand-offs to autopilot, not blockers, and SHOULD be hidden
    -- from at-a-glance "blocked:" labels. The persisted "placement pending"
    -- value is a scheduler handoff sentinel, not user-facing text; UI
    -- surfaces SHOULD render it as the current wait state, e.g. "autopilot",
    -- "autopilot placing jobs", "autopilot paused", or "autopilot not
    -- running".
    placement_reasons: List<String>
    cloud_instance: CloudInstance?

    -- Execution backend
    backend: Backend

    -- Mutable state
    status: Status
    created_at: Timestamp
    retry_count: Integer

    -- Original submission intent: the resource-related CLI flags the user
    -- passed at `weft run` time. Replayed on retry so that edits to the
    -- script's PEP 723 [tool.weft] block are reflected without losing
    -- explicit user overrides. Fields absent here were not set on the CLI.
    -- Rental policy fields are max_hourly_rate_cents, max_spend_cents,
    -- max_time_seconds, min_survival, and grace_period_seconds. A zero grace
    -- period is an explicit request to disable grace; absent means use the
    -- launch default.
    cli_overrides: CLIResourceOverrides?

    -- Post-execution
    exit_code: Integer?
    failure_reason: FailureReason?
    error_message: String?
    observed_inputs: List<String>   -- data inputs discovered post-mortem
    cost: Decimal?                  -- actual cost for cloud jobs

    -- Relationships
    attempts: JobAttempt with job = this

    -- Derived
    -- User-visible job status/info/artifacts use the latest non-abandoned
    -- attempt. Attempts marked abandoned are retained for forensics and
    -- explicit attempt-level queries, but no longer own the logical job.
    latest_attempt: attempts
        .where(a => a.abandoned_at = null)
        .max_by(a => a.attempt_number)
    -- Physical history still uses the maximum attempt number. Retry and
    -- attempt-number allocation use this so a user-requested retry can
    -- supersede an abandoned move attempt.
    physical_latest_attempt: attempts.max_by(a => a.attempt_number)
    is_placed: host != null
    is_terminal: status in {completed, failed, dead, killed, canceled, draft}
    -- User-visible derived status (see value DisplayStatus). Reports
    -- `orphaned` when this job's latest attempt closed terminally but the
    -- backing instance/launch failed or was canceled; otherwise mirrors the
    -- stored status. Display/query only — never written back to `status`.
    display_status: DisplayStatus
    -- queued+unplaced means no prospective assignment yet.
    is_unplaced_queue: status = queued and target_kind = unplaced
    -- Alias for UI counter use. The "in-flight placement" signal
    -- distinct from "queued and idle" lives on PlacementIntent
    -- (specs/job-move.allium § PlacementIntent), not on this predicate.
    is_unplaced_awaiting_placement:
        target_kind = unplaced and status = queued
    -- A job is "launching" when the instance or placement backing it is still
    -- provisioning, or when the instance is up but the agent has not yet
    -- dispatched this job. Paths reaching this state:
    --   (a) queued+unplaced with an open PlacementIntent (on-prem path,
    --       or cloud before a launch row is attached).
    --   (b) queued + rental_instance target whose CloudInstance status is
    --       still planned or launching.
    --   (c) queued + rental_instance whose CloudInstance has reached running,
    --       but the agent has not yet dispatched any job (or the active job
    --       on the instance is this job). This covers the agent-startup
    --       window after a fresh `weft move --to new` or initial campaign
    --       launch, where the VM is up but the agent has not pulled the
    --       job from its queue. The "active job" comes from
    --       status-sync/InstanceLiveState.active_job, populated by the
    --       agent's R2 progress writes.
    is_launching:
        (status = queued and exists(PlacementIntent { job = this, state = open }))
        or (status = queued
            and target_kind = rental_instance
            and cloud_instance != null
            and (cloud_instance.status in {planned, launching}
                 or (cloud_instance.status = running
                     and (cloud_instance.live_state.active_job = null
                          or cloud_instance.live_state.active_job = this))))
    is_blocked: dep_spec != null and dependency_job.is_terminal = false

    -- Status
    status: draft | pending_placement | queued | starting | running
          | paused | completed | failed | dead | killed | canceled

    transitions status {
        -- Normal forward flow
        draft -> queued
        pending_placement -> queued
        pending_placement -> canceled
        queued -> starting
        queued -> running
        queued -> paused
        queued -> canceled
        queued -> killed
        queued -> dead
        queued -> failed
        queued -> draft
        starting -> running
        starting -> completed
        starting -> dead
        starting -> failed
        starting -> killed
        starting -> paused
        starting -> queued
        starting -> draft
        running -> completed
        running -> failed
        running -> dead
        running -> killed
        running -> canceled
        running -> paused
        running -> queued
        running -> draft
        paused -> running
        paused -> killed
        paused -> canceled
        paused -> failed
        paused -> queued

        -- Restart/requeue paths (from terminal states)
        completed -> queued
        failed -> running
        failed -> paused
        failed -> queued
        dead -> running
        dead -> paused
        dead -> queued
        killed -> paused
        killed -> queued
        canceled -> paused
        canceled -> queued
        canceled -> failed

        -- Authoritative overrides (R2 completion corrects race conditions)
        queued -> completed
        failed -> completed
        dead -> completed
        killed -> completed
        canceled -> completed
        -- An agent's .complete marker is ground truth about the job's
        -- outcome; orphan recovery's dead/killed is a guess made before
        -- the marker was observed, so an authoritative failed completion
        -- may override those guessed terminal states. completed -> failed
        -- remains forbidden: a stale failed marker must never overwrite a
        -- later authoritative completed.
        -- Carve-out: a completion whose kill_reason is user_kill was
        -- produced by weft's own kill signal — it confirms the user's stop
        -- rather than reporting a self-failure, so ingestion keeps the
        -- user's killed/canceled status (backfilling exit metadata) instead
        -- of taking this edge (db.RecordCloudJobCompletion).
        dead -> failed
        killed -> failed

        terminal: completed, dead, failed, killed, canceled, draft
    }
}

-- Each execution attempt for a job. A job may have multiple attempts
-- due to retry, requeue, or auto-remediation.
entity JobAttempt {
    job: Job
    attempt_number: Integer
    status: Status              -- same status enum as Job
    target: ExecutionTarget?
    host: Host?                 -- compatibility shadow of target for
                                -- estimator and research SQL consumers
    cloud_instance: CloudInstance? -- compatibility shadow of target for
                                   -- estimator and research SQL consumers
    backend: Backend
    start_time: Timestamp?
    end_time: Timestamp?
    exit_code: Integer?
    failure_reason: FailureReason?
    cloud_outcome: AttemptOutcome?      -- set on closed cloud attempts; see
                                        -- campaign-lifecycle.allium for the
                                        -- enum and what each outcome means.
    log_bytes: Integer?                 -- byte length of this attempt's log,
                                        -- when the log object/file exists.
    predecessor_attempt_id: Integer?    -- id of the prior attempt this one
                                        -- continues (set when the job is
                                        -- reattached to a fresh launch after
                                        -- a preempted/orphaned termination).

    -- Move-overlap authority. When two attempts temporarily exist during a
    -- deliberate move, the loser is marked abandoned instead of deleting the
    -- row or choosing a global winner on the job. abandoned_reason is a short
    -- durable string for forensics; abandoned_by_intent is structured
    -- provenance when a MoveIntent caused the abandonment.
    abandoned_at: Timestamp?
    abandoned_reason: String?
    abandoned_by_intent: MoveIntent?

    -- Three-way merge fields (for on-prem sync reconciliation)
    last_synced_status: String?     -- remote state at last successful sync
    pending_status: String?         -- what user wants (nil = no pending change)
    pending_at: Timestamp?          -- when user requested change

    -- Derived: a "preflight-rejected" attempt is one the runner refused
    -- to start before stamping a start_time. The DB shape is:
    --   status        = failed
    --   start_time    = null
    --   exit_code     = null
    --   end_time      = 0       (CloseAttempt was called with endTime=0)
    --   failure_reason non-empty (e.g. "source_provenance_mismatch: ...")
    -- See source-data-sync.allium § RunnerPreflightProvenanceCheck for the
    -- runner-side semantics and status-sync.allium §
    -- PreflightRejectionReconciled for the sync-side closure.
    -- Display surfaces (cmd/job.go) render this as "preflight-rejected"
    -- with Exit "-" and Duration "-". The Job itself stays queued so the
    -- autopilot or user can replan.
    is_preflight_rejected:
        status = failed
        and start_time = null
        and exit_code = null
        and failure_reason != null
}

-- A mirrored job owned by an external scheduler/control plane. The binding
-- keeps Weft's job ID as the canonical local identity while preserving the
-- external identifiers needed for status refresh, log passthrough, cancel, and
-- links to the external UI.
--
-- The ownership boundary this binding sits on — what the external executor
-- owns, what an observation may and may not conclude, the adapter's
-- availability model, staleness, and the explicit non-guarantees for these
-- jobs — is specified in external-executor.allium. Status refresh and cancel
-- passthrough are in status-sync.allium § SyncExternalExecutorJob and
-- § ExternalExecutorCancel.
entity ExternalJobBinding {
    job: Job
    attempt: JobAttempt?
    executor: ExternalExecutor
    external_job_id: String
    external_task_id: String?
    external_cluster_id: String?
    external_cluster_name: String?
    raw_status: String?
    raw_status_message: String?
    submitted_from_working_dir: String?
    submitted_from_project: String?
    dashboard_url: String?
    created_at: Timestamp
    last_observed_at: Timestamp?

    -- The latest normalized status produced by the executor adapter. This is
    -- advisory until written to Job.status by status-sync.allium.
    normalized_status: Status?
}

invariant ExternalJobIdentityIsLocal {
    -- Agent and human-facing surfaces address external jobs by wj<id>. The
    -- external job id is an implementation detail used by sync/log/cancel
    -- adapters and may be non-unique across executors or SkyPilot clusters.
    for binding in ExternalJobBindings:
        binding.job.backend = skypilot
        and binding.job.target_kind = external_executor
        and (binding.submitted_from_project = null
             or binding.job.project = binding.submitted_from_project)
}

invariant ExternalJobsUseWeftBookkeeping {
    -- The processed/unprocessed distinction is always a Weft tag on the local
    -- job row. SkyPilot state, cluster tags, and task labels must not be used
    -- as the authoritative processed marker.
    for binding in ExternalJobBindings:
        ProcessedState(binding.job) = binding.job.tags.contains(processed)
}

-- Job processes launched by the weft runner get a small set of WEFT_*
-- environment variables that let
-- them detect they are running under weft and reflect on their runtime
-- environment:
--   WEFT_JOB_ID           weft DB id of the job (always set)
--   WEFT_ARTIFACT_MANIFEST  manifest path; jobs append outputs here
--   WEFT_ARTIFACT_ROOT    artifact root, defaulting to "."
--   WEFT_TARGET_KIND      "host" (inventory) or "rental" (cloud agent)
--   WEFT_LAUNCH_ID        weft DB launch id (rental only)
--   WEFT_PROVIDER         "vastai" / "runpod" (rental only)
--   WEFT_INSTANCE_TYPE    "on-demand" / "interruptible" (rental only)
--   WEFT_RESUMED          "1" if the agent's container restarted after a
--                         docker stop on the same disk (Vast.ai
--                         interruptible pause/resume). Absent on first
--                         boot. Detected by an agent-written sentinel.
--   WEFT_RESTAGED         "1" if Weft restored this job's previous
--                         R2-streamed outputs into the workdir before
--                         starting it on a fresh rental instance.
-- The legacy RJ_* prefix is also set for backward compatibility.
-- External-executor jobs such as SkyPilot jobs do not get these variables
-- unless the external task definition explicitly injects them.

value Tag = processed | exclusive | benchmark_isolation | rental | inventory
          | compute_intensive | cpu_intensive | interruptible

-- unplaced is represented as target = null on the attempt.
value TargetKind = unplaced | inventory_host | rental_instance | external_executor

value Backend = queue_runner | slurm | vastai | skypilot

-- External executors are schedulers/control planes that own execution for a
-- mirrored job. Weft owns the durable job identity, project scoping, tags,
-- processed bookkeeping, and user/agent-facing query surfaces; the external
-- executor owns resource selection, cluster lifecycle, retry policy, and raw
-- logs unless a later integration explicitly imports those artifacts.
value ExternalExecutor = skypilot

-- Failure reasons detected by the runner from exit info and system probes.
-- Dynamic values: "signal_<name>" for other signals, "exit_<N>" for
-- unrecognized non-zero exit codes.
-- infra_prewarm_download_failed: weft-owned input staging (HF prewarm)
--   failed before the user command started — infrastructure-side, auto-
--   retried when the launch ends with a retryable termination reason.
-- infra_cuda_hardware_fault: runtime CUDA failure whose log signature
--   indicates a bad rental GPU/interconnect (peer GPU memory, NVLink,
--   uncorrectable ECC, Xid) rather than user code.
value FailureReason = oom | gpu_oom | disk_full | segfault | aborted | error
                    | killed_sigkill | killed_sigterm
                    | killed_gpu_idle | killed_stdout_silence
                    | cuda_driver_too_old
                    | setup_timeout
                    | infra_prewarm_download_failed
                    | infra_cuda_hardware_fault

-- The in-flight "this job is being placed" signal lives on
-- PlacementIntent (specs/job-move.allium § PlacementIntent), not in
-- this enum. The Go constant StatusPendingPlacement is still defined
-- so existing comparisons against it compile and harmlessly never
-- match.
value Status = draft | queued | starting | running
             | paused | completed | failed | dead | killed | canceled

-- User-visible derived status. This is NOT a stored attempt status and has
-- no transition graph; it is computed by the effective-status view
-- (internal/db/migrations/baseline_schema.sql) for display and query.
-- It is the stored Status set plus `orphaned`, which surfaces when an
-- attempt is terminal but its backing instance/launch died or was canceled
-- (the job was orphaned by infrastructure death rather than by its own
-- script outcome). `orphaned` never appears in the stored `status` field or
-- the transition graph.
value DisplayStatus = draft | queued | starting | running
                    | paused | completed | failed | dead | killed | canceled
                    | orphaned

-- Placement scoring result
value PlacementResult {
    target: ExecutionTarget?
    score: Decimal
    estimated_queue_drain: Duration?
    estimated_transfer_time: Duration?
    data_locality_score: Decimal?
}

config {
    setup_timeout: Duration = 20.minutes
    kill_grace_period: Duration = 10.seconds    -- SIGTERM → SIGKILL delay

    -- Hang-detection watchdogs. Zero disables. Actual values are selected
    -- per-job by the agent based on host cost-per-hour: aggressive thresholds
    -- (8m / 12m) on expensive cloud hosts (>= $2/hr), conservative (20m / 30m)
    -- otherwise. No per-job override in v1.
    gpu_idle_timeout: Duration = 20.minutes
    stdout_silence_timeout: Duration = 30.minutes
    watchdog_initial_grace: Duration = 5.minutes  -- arms after first activity
                                                  -- or this grace, whichever first

    -- Queue-runner concurrency. The runner schedules multiple jobs per
    -- host while keeping total local CPU allotment under a target cap.
    -- Tuning constants (adaptive step sizes, sample intervals, hysteresis
    -- window shapes) are implementation details of the runner and are
    -- not pinned by the spec.
    host_cpu_utilization_target: Integer = 80    -- percent of host CPU
    default_cpu_allotment: Integer = 20          -- percent, applied when
                                                 -- Job.cpu_allotment is null
    min_cpu_allotment: Integer = 10
    max_cpu_allotment: Integer = 100
    warmup_duration: Duration = 2.minutes        -- new-dispatch gating window
}

-- ==========================================================================
-- Submission rules
-- ==========================================================================

rule SubmitJob {
    when: SubmitJob(command, working_dir, options)

    ensures: Job.created(
        command: command,
        working_dir: working_dir,
        project: options.project,
        description: options.description,
        gpu_class: options.gpu_class,
        gpu_mem_gb: options.gpu_mem_gb,
        inputs: options.inputs,
        outputs: options.outputs,
        tags: options.tags,
        env_vars: options.env_vars,
        dep_spec: options.dep_spec,
        cli_overrides: options.cli_overrides,
        backend: options.backend,
        status: if options.draft then draft
                else if options.host != null then queued
                else pending_placement,
        host: options.host,
        created_at: now,
        retry_count: 0
    )
}

rule WarnWhenUVPythonBypassesPEP723Environment {
    when: SubmitJob(command, working_dir, options)
    requires: command invokes script as `uv run python <script.py>`
    requires: script contains a PEP 723 inline metadata block

    ensures: SubmitOutputIncludes(
        warning: "the command uses the project environment and project uv.lock, not the script dependency environment or adjacent script lock",
        remedy: "run `uv run <script.py>` to use the script environment"
    )
    ensures: SubmissionContinues

    @guidance
        -- The warning is based on the presence of the metadata block, not on
        -- whether its dependency names happen to be repeated with `--with`.
        -- Matching package names do not prove that uv selected the same lock
        -- or resolved the same dependency graph. Implementation:
        -- warnPEP723ScriptEnvironmentMismatch in cmd/run.go, called by both
        -- `weft run` and `weft queue add`.
}

rule EditJobRentalPolicy {
    when: EditJob(job, options)
    requires: options changes any of {
        max_hourly_rate_cents,
        max_spend_cents,
        max_time_seconds,
        min_survival,
        grace_period_seconds
    }

    ensures: job.cli_overrides preserves every unchanged field
    ensures: job.cli_overrides stores each changed field
    ensures: a cleared field is absent from job.cli_overrides

    @guidance
        -- `weft run --from` copies these fields before applying explicit
        -- command-line changes. `weft edit` updates the same durable JSON
        -- object, so retries and later autopilot passes retain the policy.
        -- Dollar values are stored as integer cents and durations as integer
        -- seconds. Implementation: cmd/rental_policy_flags.go,
        -- cmd/run.go, cmd/queue.go, and internal/db.CLIResourceOverrides.
}

rule SubmitDraft {
    when: SubmitDraft(job)
    requires: job.status = draft

    ensures: job.status = queued
    ensures: JobAttempt.created(
        job: job,
        attempt_number: 1,
        status: queued,
        backend: job.backend
    )
}

rule SubmitExternalExecutorJob {
    when: SubmitExternalExecutorJob(command, working_dir, options)
    requires: options.executor = skypilot

    -- Weft records the job before invoking SkyPilot so all later agent-facing
    -- commands have a stable wj<id> even if the external submission is slow,
    -- asynchronous, or fails after allocating an external request id.
    ensures: Job.created(
        command: command,
        working_dir: working_dir,
        project: options.project,
        description: options.description,
        gpu_class: options.gpu_class,
        gpu_mem_gb: options.gpu_mem_gb,
        inputs: options.inputs,
        outputs: options.outputs,
        tags: options.tags,
        env_vars: options.env_vars,
        dep_spec: options.dep_spec,
        backend: skypilot,
        target_kind: external_executor,
        status: queued,
        host: null,
        created_at: now,
        retry_count: 0
    )
    ensures: ExternalSubmissionRequested(job)

    if ExternalSubmissionAccepted(job, external_ids):
        ensures: JobAttempt.created(
            job: job,
            attempt_number: 1,
            status: queued,
            target: null,
            host: null,
            backend: skypilot
        )
        ensures: ExternalJobBinding.created(
            job: job,
            attempt: job.latest_attempt,
            executor: skypilot,
            external_job_id: external_ids.job_id,
            external_task_id: external_ids.task_id,
            external_cluster_id: external_ids.cluster_id,
            external_cluster_name: external_ids.cluster_name,
            submitted_from_working_dir: working_dir,
            submitted_from_project: options.project,
            created_at: now
        )
    else:
        ensures: job.status = dead
        ensures: job.error_message = ExternalSubmissionError(job)

    @guidance
        -- This is the Option C integration shape: Weft is the ledger/front
        -- door and SkyPilot is an external executor. The submission path may
        -- shell out to `sky` or use a SkyPilot API, but it must not bypass
        -- the local job row. Weft does not run its Go agent, does not create
        -- a CloudInstance/Launch row, and does not promise R2 output
        -- collection or Weft telemetry for this job unless a later adapter
        -- implements those imports explicitly.
}

rule ImportExternalExecutorJob {
    when: ImportExternalExecutorJob(executor, external_job, options)
    requires: executor = skypilot

    -- Import is for jobs that were submitted outside Weft but should appear
    -- in the same project-scoped and unprocessed-job surfaces. The importer
    -- must require or infer a project; otherwise it records the job under the
    -- current directory's project only when the user explicitly requests that
    -- association.
    ensures: Job.created(
        command: external_job.command,
        working_dir: options.working_dir,
        project: options.project,
        description: options.description ?? external_job.name,
        gpu_class: external_job.gpu_class,
        gpu_mem_gb: external_job.gpu_mem_gb,
        inputs: [],
        outputs: [],
        tags: options.tags,
        env_vars: [],
        dep_spec: null,
        backend: skypilot,
        target_kind: external_executor,
        status: NormalizeExternalStatus(external_job.status),
        host: null,
        created_at: external_job.created_at ?? now,
        retry_count: 0
    )
    ensures: ExternalJobBinding.created(
        job: job,
        attempt: null,
        executor: skypilot,
        external_job_id: external_job.id,
        external_task_id: external_job.task_id,
        external_cluster_id: external_job.cluster_id,
        external_cluster_name: external_job.cluster_name,
        raw_status: external_job.status,
        submitted_from_working_dir: options.working_dir,
        submitted_from_project: options.project,
        dashboard_url: external_job.dashboard_url,
        created_at: now,
        last_observed_at: now,
        normalized_status: job.status
    )

    @guidance
        -- Import is idempotent on (executor, external_job_id,
        -- external_task_id). Re-import refreshes the existing binding and
        -- job status instead of creating a duplicate local job.
}

-- ==========================================================================
-- Placement rules
-- ==========================================================================

rule PlaceJob {
    when: job: Job.status becomes pending_placement
    requires: job.dep_spec = null or job.is_blocked = false

    let candidates = evaluate_placement(job)
    let best = candidates.max_by(c => c.score)

    if best != null:
        ensures: job.host = best.host
        ensures: job.target_kind = inventory_host
        ensures: job.status = queued
        ensures: JobAttempt.created(
            job: job,
            attempt_number: 1,
            status: queued,
            host: best.host,
            backend: job.backend
        )
    else:
        ensures: job.target_kind = unplaced
        ensures: job.placement_reasons = candidates.reasons

    @guidance
        -- Placement scoring considers GPU availability, memory requirements,
        -- data locality (input assets already cached on host), queue depth,
        -- and estimated transfer time. Jobs with `rental` tag prefer cloud
        -- instances; jobs with `inventory` tag prefer on-prem hosts.
        -- Jobs tagged `interruptible` allow interruptible cloud offers.
        -- The legacy tag `preemptible` is accepted on input and canonicalized
        -- to `interruptible` (see Campaign Lifecycle § Interruptible
        -- placement).
}

rule LaunchPlacementWindow {
    when: LaunchWorkflowBegins(jobs)
    requires: for job in jobs: job.status in {queued, pending_placement}

    ensures: for job in jobs: job.status = pending_placement

    @guidance
        -- Distinguish "unplaced and waiting for a decision" from
        -- "placement already in progress while launching infrastructure":
        --   - queued + target_kind=unplaced => not assigned yet
        --   - pending_placement => selected for launch/placement work
        -- Jobs return to queued if launch/placement fails; claimed jobs become
        -- queued once assigned to a host/instance.
        -- pending_placement is an intent marker, not durable truth:
        -- reconciliation may normalize stale pending_placement back to queued
        -- after launch progress is observed. Because the marker blocks
        -- subsequent placement (AssignJobHost refuses jobs whose effective
        -- status is not queued), it must be cleared whenever the launch it
        -- was set for stops being a valid placement target — see the
        -- PendingPlacementClearedOnTerminalLaunch invariant.
}

rule ReleaseDependency {
    when: dep: Job.is_terminal becomes true
    for job in Jobs where job.dep_spec references dep:
        if job.status = queued and job.is_blocked = false:
            ensures: JobReadyToRun(job)

    @guidance
        -- For cloud-backed dependencies (stored in job metadata), readiness is
        -- evaluated from synced DB status (terminal/completed) rather than
        -- remote host status files.
}

-- ==========================================================================
-- Execution rules
-- ==========================================================================

rule JobStarts {
    when: job: Job.status transitions_to running

    ensures: job.latest_attempt.start_time = now
}

rule JobCompletes {
    when: JobFinished(job, exit_code)
    requires: job.status in {running, starting, queued}

    if exit_code = 0:
        ensures: job.status = completed
        ensures: job.exit_code = 0
    else:
        let reason = detect_failure_reason(exit_code)
        ensures: job.status = failed
        ensures: job.exit_code = exit_code
        ensures: job.failure_reason = reason
}

rule JobDied {
    when: JobUnexpectedlyGone(job)
    requires: job.status in {running, starting, queued}

    ensures: job.status = dead
}

-- The queue-runner's refreshRunningJobs treats a wrapper process in zombie
-- state (state Z) the same as one that's truly gone: it writes a synthetic
-- status file, marks the job failed via the existing orphan-recovery path,
-- and frees the runner slot. The wrapper PID is best-effort reaped with
-- wait4(WNOHANG) so its process-table entry clears.
--
-- The bug this guards against: a wrapper that was SIGKILL'd (so no .status
-- file was written) AND whose parent (the agent) has lost its Wait()
-- goroutine across a syscall.Exec re-exec leaves the wrapper as a zombie.
-- CheckPIDAlive(pid) returns true for zombies because the kernel keeps the
-- process-table entry until the parent reaps. Before this rule, the runner
-- saw kill -0 succeed and `continue`d its scan, leaving the slot occupied
-- indefinitely.
--
-- The hasWaiter guard that normally prevents the orphan path from firing on
-- a process the runner is still actively waiting for is bypassed in the
-- zombie case: Wait() will never produce a status file for a zombie whose
-- waiter is gone, so we treat the wrapper as gone regardless.
rule WrapperZombieRecovered {
    when: QueueRunnerTick(host)
    for job in host.running_jobs:
        let wrapper = WrapperProcess(job)
        requires: WrapperPIDAlive(wrapper) and WrapperInZombieState(wrapper)

        ensures: ZombieDetectedLogged(job: job, pid: wrapper.pid)
        ensures: WrapperReaped(wrapper)
        ensures: SyntheticStatusFileWritten(job)
        ensures: job.status = failed
        ensures: RunnerSlotFreed(job)

    @guidance
        -- Implementation:
        --   internal/runner/process.go CheckProcessZombie, reapZombie
        --   internal/runner/runner.go  refreshRunningJobs (zombie branch
        --                              skips the hasWaiter guard, falls
        --                              through to orphan recovery, then
        --                              calls reapZombie before writing the
        --                              synthetic status file)
        -- The oplog event emitted is `job.zombie_detected` with detail
        -- `pid=<PID> state=Z`, distinct from `job.orphan_killed`.
        -- reapZombie is best-effort: after a syscall.Exec the child may have
        -- been reparented to init, in which case wait4 returns ECHILD and
        -- we move on — the housekeeping is purely so the process-table
        -- entry doesn't linger.
}

-- Preflight rejection closes the attempt without running it. The runner's
-- per-job provenance check (source-data-sync.allium §
-- RunnerPreflightProvenanceCheck) refused to stamp start_time; the
-- batch-status reconciliation closes the attempt as failed
-- with NULL start_time / exit_code, end_time = 0, and a populated
-- failure_reason. The Job itself stays queued so the autopilot or user
-- can replan it.
rule PreflightRejectionClosesAttempt {
    when: PreflightRejectionReported(job, reason)
    requires: job.latest_attempt.start_time = null

    ensures: job.latest_attempt.status = failed
    ensures: job.latest_attempt.failure_reason = reason
    ensures: job.latest_attempt.end_time = 0
    ensures: job.latest_attempt.exit_code = null
    -- Job stays queued; no RecordJobCompletion call.
    ensures: job.status = queued

    @guidance
        -- Implementation anchors:
        --   internal/ops/queue_batch.go    — applyBatchStatuses
        --                                    (queueStatePreflightRejected
        --                                    branch)
        --   cmd/job.go                     — isAttemptPreflightRejected,
        --                                    attemptStatus (renders as
        --                                    "preflight-rejected" with
        --                                    Exit "-" Duration "-")
        -- The wire-level reconciliation contract (PREFLIGHT_REJECTED line
        -- → sync-side closure + EventQueueDispatchFailed) lives in
        -- status-sync.allium § PreflightRejectionReconciled.
}

-- ==========================================================================
-- Artifact uploads (cloud agent)
-- ==========================================================================
-- The cloud agent publishes job outputs to R2 through two logical paths:
--   1. Convention-based output directories (the job's configured output_dirs,
--      defaulting to output/ and outputs/ in the working dir) -- uploaded by
--      uploadOutputDirs. The uploader must walk exactly the dirs discovery
--      attributes: a dir that discovery attributes but the upload skips
--      leaves outputs listed in the completion record with no bytes in R2,
--      lost at instance teardown.
--   2. Declared --produces artifacts -- uploaded by uploadArtifactManifestEntries
--      using the manifest at $WEFT_ARTIFACT_MANIFEST.
-- Declared artifacts run first. A declaration beneath an effective convention
-- output directory uses the outputs/ key as its sole payload backing; the
-- following convention walk uses --update and does not transfer it again.
-- Each path runs on a 60-second ticker during the job, and once more in a final
-- flush after the script exits, then again as background post-job work
-- before the agent self-destructs.

rule ProducesPreRegisteredAtJobStart {
    when: job: Job transitions_to running
    requires: job.produces is not empty

    ensures: $WEFT_ARTIFACT_MANIFEST contains every spec in job.produces

    @guidance
        -- Pre-registration is REQUIRED so the periodic 60s output-uploader
        -- ticker can pick up large files (e.g. checkpoints written every N
        -- training steps) DURING the run, not only after the script exits.
        -- Post-exit registration alone leaves a narrow upload window for any
        -- file written close to job exit (e.g. final-epoch checkpoints written
        -- seconds before exit), and gives no chance to upload incrementally
        -- during long runs. Implementation: internal/runner/single.go calls
        -- RecordProducedArtifacts both at job start (after env merge) and
        -- post-exit (idempotent; the script may have appended additional
        -- paths to $WEFT_ARTIFACT_MANIFEST during the run).
}

rule ArtifactUploadHasNoSizeCap {
    when: cloud_agent uploads outputs

    ensures: every file in convention-based output dirs is uploaded
    ensures: every spec in $WEFT_ARTIFACT_MANIFEST is uploaded
    ensures: no size threshold short-circuits the upload

    @guidance
        -- Neither cloud agent path (uploadOutputDirs,
        -- uploadArtifactManifestEntries) consults any size threshold, and
        -- the on-prem SyncOutputsBack caller passes maxMB=0. Consumers
        -- (--needs path:<numeric-job-id>) can rely on multi-GB --produces artifacts
        -- (checkpoints, representation tensors) being available, subject to
        -- the per-invocation timeout below and to disk available on the
        -- rental.
}

rule DeclaredConventionOutputHasSingleBacking {
    when: cloud_agent uploads declared artifact
    requires: artifact root is the job working directory
    requires: artifact path is relative, lexically contained by an effective convention output directory

    ensures: artifact payload is uploaded to its per-run outputs key before convention bulk copy
    ensures: artifact payload is not uploaded under the per-run artifact-files prefix
    ensures: convention bulk copy uses update semantics and does not transfer the payload again
    ensures: artifact manifest retains every declared name and path
    ensures: artifact list, get, cat, sync, and downstream needs resolve the outputs key

    @guidance
	-- The manifest remains the logical namespace; sharing a payload object
	-- must not erase aliases. Lexically equivalent declarations and child
	-- declarations covered by an existing declared directory upload share
	-- the same transfer while retaining per-declaration outcomes.
	--
	-- A declared artifact upload is not subject to the attempt mtime
	-- cutoff. This preserves an explicit --produces contract for a file
	-- whose timestamp predates the attempt. Only the later convention walk
	-- applies the cutoff.
	--
	-- Custom artifact roots, absolute paths, escaping paths, and relative
	-- paths outside effective convention directories retain artifact-files
	-- backing. Retrieval probes both representations for compatibility
	-- with runs uploaded before this rule.
}

rule ArtifactUploadTimeoutScalesWithSize {
    when: rclone_invocation(payload_bytes)

    ensures: per_invocation_timeout >= max(5.minutes, payload_bytes / 1.MB.per_second)

    @guidance
        -- A fixed 5-minute deadline killed in-progress 500MB+ checkpoint
        -- uploads on bursty cloud rental networks (kill via context.WithTimeout
        -- abandons the in-flight S3 multipart). The timeout is now scaled by
        -- the payload size at a 1 MB/s throughput floor, with a 5-minute
        -- minimum. Implementation: cmd/agent/runinstance.go
        -- rcloneTimeoutForBytes() applied in uploadOutputDirs and
        -- rcloneUploadWithRetry. Retries (5s, 10s delays, 3 attempts) still
        -- handle transient failures; the scaling addresses the stalled-but-
        -- progressing case where a long upload would otherwise be killed.
}

rule ManifestUpdateFailureSurfaced {
    when: RecordProducedArtifacts(job) returns error

    ensures: job_log_dir / "{job_id}.manifest_error" exists with the error message
    ensures: weft artifact list <job> emits a WARNING that includes the message

    @guidance
        -- Silent manifest write failures (disk full, permission denied) used
        -- to be logged via slog.Warn only, leaving the user with a manifest
        -- that did not include their --produces entries and no signal that
        -- something went wrong. Implementation: WriteManifestErrorFile (in
        -- internal/runner/job.go) and warnOnFailedCloudOutputUpload (in
        -- cmd/artifact.go) read the manifest_error file and emit a warning
        -- alongside any output-upload status warnings.
}

rule PerArtifactUploadOutcomeRecorded {
    when: uploadArtifactManifestEntries(job, runID)
    for each artifact in manifest:
        ensures: completion_record.output_upload.dirs contains an entry for the artifact
                 with status (ok | failed), file count, byte size, duration, and any error message

    @guidance
        -- Both directory and single-file artifacts populate a per-entry
        -- result. A failure on a single large file (e.g. a 500MB checkpoint
        -- whose upload timed out) must be visible per-path so users can see
        -- which artifact failed without inspecting agent logs.
        --
        -- A declared artifact that does not exist on disk is a failed
        -- entry, not a skipped one: a job whose --produces contract went
        -- unmet must not report a clean upload. Likewise an unreadable
        -- manifest fails the whole upload — the declared set cannot be
        -- enumerated, so absence from R2 is not evidence the job declared
        -- nothing. A manifest that exists but declares nothing (the
        -- ErrManifestMissing sentinel — empty file, blank lines) is a
        -- confirmed-empty declaration and reports a clean upload; only a
        -- read or parse failure is an unknown. The 60s mid-run ticker
        -- discards its results (a pre-registered artifact legitimately
        -- does not exist yet mid-run); only the post-job call's result
        -- reaches the completion record — the post-job merge
        -- (mergeUploadResults) must carry these per-entry outcomes and the
        -- combined status into the record, not just byte/file counters.
        -- Implementation: cmd/agent/runinstance.go uploadArtifactManifestEntries
        -- appends one result.Dirs entry per artifact regardless of kind.
}

rule SharedWorkdirUploadBarrierBeforeNextJob {
    when: agent prepares to start job_next on a rental
    requires: any prior job's post-job upload is in flight for workdir = job_next.working_dir

    ensures: agent waits for those uploads to complete before job_next runs

    @guidance
        -- Convention-based output upload (uploadOutputDirs) walks the
        -- `output/` and `outputs/` subtrees of the prior job's working
        -- directory and rclone-copies them under that prior job's R2 key
        -- prefix. The walk has no per-job source-side filter: it copies
        -- whatever exists in those subtrees at scan time. If the next job
        -- shares the same working directory and starts writing into
        -- `output/...` while the prior upload is still walking, those
        -- new files get attributed to the prior job's R2 prefix.
        --
        -- This is the wj2226/wj2227 cross-attribution incident
        -- (2026-05-28): wj2226 finished at 17:17:41 on rental wi3283;
        -- its background uploadOutputDirs goroutine kept walking
        -- `~/code/research/role-encoding-injection/output/` for the
        -- next ~2 minutes; wj2227 (same workdir) started at 17:19:23 and
        -- wrote to `output/exp_079_multiseed_n2000_s7_dp/`; those files
        -- were picked up by wj2226's still-running walk and uploaded
        -- under r2:.../jobs/2226/.../output/exp_079_multiseed_n2000_s7_dp/.
        -- `weft artifact cat wj2226 results` then returned wj2227's data.
        --
        -- Cross-workdir overlap is preserved: jobs on different working
        -- directories do not share `output/` and cannot collide, so the
        -- barrier scopes per-workdir rather than draining all uploads
        -- (the benchmark barrier, which calls bgm.Barrier() globally,
        -- remains the broader gate for benchmarks).
        --
        -- Implementation: cmd/agent/bgwork.go bgWorkManager tracks an
        -- in-flight upload set keyed by resolved workdir
        -- (uploadsByWorkdir); StartPostJobWork registers a done channel
        -- on entry and closes it on exit; cmd/agent/jobloop.go
        -- runJobSequence calls bgm.WaitForUploadsInWorkdir(job.Dir)
        -- at the top of each iteration after the benchmark barrier.
}

rule PackedSlotsUseIsolatedWorkdirs {
    when: a rental manifest runs multiple jobs concurrently via per-GPU slots

    ensures: every concurrently running slot has a distinct working_dir
    ensures: each slot's source tarball is extracted into that slot's working_dir
    ensures: no concurrently running slot has a same-instance CloudAfter edge
             to another slot in the same set

    @guidance
        -- The sequential SharedWorkdirUploadBarrierBeforeNextJob rule cannot
        -- protect two jobs that run at the same time: each job can discover
        -- and upload any file another slot writes into the same `output/`
        -- tree. Packed GPU-slot launches therefore isolate source/work
        -- directories per job even when the jobs come from the same local
        -- project. The same source tarball may be extracted more than once,
        -- but convention output discovery, uv sync, source refresh, and
        -- post-job uploads stay per-slot.
        --
        -- Same-instance artifact dependencies are represented as CloudAfter
        -- refs. They require the consumer to run after the producer has
        -- written its completion marker, and they require the consumer to see
        -- the producer's output through the shared project working directory.
        -- Packed slots violate both requirements: slots run concurrently, and
        -- each slot has an isolated working_dir. A same-instance CloudAfter
        -- edge therefore disqualifies slot packing; the group must use the
        -- ordinary sequential shared-workdir launch path instead.
        --
        -- `--after` / dep_spec consumers should normally not be present in
        -- the same launch-selection group as their upstream producer because
        -- launch and reuse paths defer them until the upstream terminates.
        -- Packing still treats an intra-group dep_spec edge as ineligible so
        -- stale manifests or alternate placement paths cannot schedule a
        -- producer/consumer ordering constraint concurrently.
        --
        -- Implementation: internal/campaign/lifecycle.go
        -- remoteDirForLaunchAgentJob gives SlotGPUs jobs a
        -- `<project>-job-<id>` remote directory, and
        -- sourceMappingsForLaunch emits one source mapping per slot.
        -- internal/campaign/campaign.go groupCanUseGPUSlots rejects
        -- intra-group --needs producer IDs and dep_spec refs before setting
        -- SlotGPUs. cmd/agent/jobloop.go canRunSlottedJobsConcurrently
        -- rejects manifests whose CloudAfter refs name another job in the
        -- concurrent slot set.
}

-- A cloud agent job that fails BEFORE its user command starts — the
-- cloud_after dependency gate skips it, or artifact staging fails — still
-- owns a terminal outcome that a later sync must be able to explain. The
-- recovery data (status file, failure-reason file, completion record) and
-- the job's results directory are uploaded to R2 BEFORE the
-- jobs/<jobID>/runs/<runID>/.complete marker is written, so any sync that
-- observes the marker can also fetch the reason and log. Writing a bare
-- .complete marker without first uploading the results directory strands
-- the reason on the instance's local disk, lost when the instance is
-- destroyed (incident wb59: marker-only ingestion produced exit 1 with an
-- empty failure_reason and no log).
rule EarlyJobFailureUploadsResultsBeforeCompleteMarker {
    when: cloud agent records a job failure before the user command starts

    ensures: the attempt's status file, failure-reason file, and completion
             record are written locally
    ensures: the job's results directory is uploaded to R2
    ensures: the .complete marker is written only after the results upload,
             never before it

    @guidance
        -- Implementation: cmd/agent/jobloop.go recordEarlyJobFailure is the
        -- single helper for both early-failure sites (the cloud_after gate
        -- skip and the artifact-staging failure). It calls WriteStatusFile,
        -- WriteFailureReasonFile, WriteCompletionRecord, then
        -- uploadJobResultsForAgent over the log/results dir, and only then
        -- writes r2keys.JobAttemptComplete via r2PutForAgent. Results upload
        -- before marker is the contract; the upload is best-effort (a failure
        -- is logged to stderr) but the marker is never written first.
        --
        -- The cloud_after gate skip reason names the probed producer run:
        -- "cloud_after_incomplete: producer job <N> run <M> has not
        -- completed", so diagnosis points at the exact unfinished attempt
        -- rather than only the producer job id.
}

invariant Attribution {
    -- Bytes stored or uploaded under job J's keys (R2 per-run prefixes,
    -- local artifact cache rows, host_data job-output assets) were written
    -- by job J. Working-directory sharing between jobs must not produce
    -- cross-attribution.
    for job in Jobs:
        for artifact in StoredArtifacts(job):
            artifact.written_by = job

    @guidance
        -- Enforced by three mechanisms:
        --   (a) Attempt-window cutoff on discovery: convention-output
        --       discovery attributes only files modified inside the
        --       attempt's window — at or after start_time − 1s and, when
        --       the attempt end is known, at or before end_time + 2m (see
        --       OutputDiscoveryUsesAttemptStartCutoff below) — so neither
        --       a prior job's leftovers nor a later sibling job's files in
        --       a shared output dir are claimed.
        --   (b) The shared-workdir upload barrier
        --       (SharedWorkdirUploadBarrierBeforeNextJob), which prevents
        --       the next job in the same directory from writing into an
        --       output tree a prior job's upload walk is still reading.
        --       The barrier covers only that leading direction; the
        --       trailing direction — a later job's walk re-uploading a
        --       PRIOR job's leftovers under the later job's prefix (the
        --       workdir is deliberately not cleaned between sequential
        --       same-workdir jobs) — is covered by (d).
        --   (d) Attempt-window cutoff on the agent's upload walk:
        --       uploadOutputDirs applies runner.AttemptOutputThreshold
        --       (the attempt's start − 1s, shared with cutoff (a)) as an
        --       absolute rclone --max-age bound
        --       (cmd/agent/runinstance.go). The window is disabled for restaged-output
        --       attempts (cloud.AgentJob.RestagedOutputs), whose files
        --       legitimately carry prior-attempt mtimes and must reach
        --       the new attempt's prefix.
        --   (c) Remote corroboration for artifact sync: files found in the
        --       SUBMITTER'S local working tree are never attributable to a
        --       job — the local tree holds the user's own files and other
        --       jobs' synced outputs. `weft artifact sync` registers only
        --       files evidenced on the execution host: the runner's
        --       completion-record output_files listing, or time-windowed
        --       discovery run against the host's working directory. The
        --       single exception is a job that executed on this machine
        --       (host == local hostname), where the local tree IS the
        --       runner's working tree (cmd/artifact.go syncJobOutputs,
        --       isLocalJobHostFunc guard). Incident: 2026-07-02, jobs
        --       wj3868–wj3873 had 182 submitter-local historical files
        --       registered as their outputs by an unguarded local-discovery
        --       fallback.
        -- Design: docs/design/artifacts.md § Intended invariants (#3).
}

rule OutputDiscoveryUsesAttemptStartCutoff {
    when: output attribution runs for job's latest attempt — convention-output
          discovery, or a completion-record output_files listing re-checked
          against the synced copies' mtimes at artifact-sync time
    requires: job.working_dir may be shared with other jobs

    let cutoff = job.latest_attempt.start_time - 1.second
    let end_bound = job.latest_attempt.end_time + 2.minutes  -- when end_time is known

    ensures: files with modification time < cutoff are not attributed to job
    ensures: files written by the attempt itself are attributed even when
             the filesystem rounds timestamps down (the 1s slack)
    ensures: when the attempt's end time is known, files with modification
             time > end_bound are not attributed to job (narrows the
             cross-attribution window for sibling jobs sharing an output
             directory; the 2m slack covers post-exit flushes and clock skew)
    ensures: an attempt with no recorded start time gets NO discovery-based
             attribution at all — a zero cutoff would match every file in the
             tree. `weft artifact sync` skips discovery with a visible
             warning; the runner's recovery paths record no output_files.
             (Missing start_time on a completed attempt is itself a
             completion-sync bug; see internal/ops/sync.go
             BackfillStartTimeFromCompletionRecord.)
    ensures: an attempt whose completion record could not be READ gets no
             discovery-based attribution either. A record that is confirmed
             absent (the host answered) leaves discovery free to run; a
             record that could not be reached — SSH failure, timeout, parse
             error — is an unknown, and the two must not collapse. Treating
             unknown as absent discards the runner's authoritative
             output_files list AND drops the end bound to zero when the DB
             row has no end_time, so a VPN flap would silently widen
             attribution to unbounded and write a sibling job's outputs
             under this one. Same shape as the ErrManifestMissing sentinel
             on the upload side.

    @guidance
        -- The completion-record read distinguishes its three outcomes with a
        -- remote sentinel rather than with the SSH error. internal/ssh does
        -- capture the remote exit code (pool.go commandError) but does not
        -- export it, so outside that package a remote non-zero exit and a
        -- transport failure both surface as a bare err != nil and absence
        -- cannot be inferred from the error alone. The probe is
        -- `if [ -f <path> ]; then cat <path>; else echo <sentinel>; fi`, and
        -- only a successful run printing the sentinel is confirmed absence
        -- (cmd/artifact.go fetchCompletionRecord, errCompletionRecordMissing).
        -- Exporting that exit-code distinction from internal/ssh would let
        -- this read and artifacts.FetchManifest share one helper and drop
        -- their sentinels; until then the sentinel is the portable form.
        -- This path is inventory-host only — syncJobOutputs routes rental
        -- jobs to cloud/R2 sync first — so refusing on unreachable does not
        -- strand jobs whose cloud instance is permanently gone.
        --
        -- Implementation: cmd/artifact.go outputSyncThreshold(job) computes
        -- StartTime − 1s and outputSyncUpperBound(job, rec) computes
        -- end_time + 2m; both feed discoverRemoteJobOutputFiles (host-side
        -- find over SSH), discoverLocalJobOutputFiles (local-execution
        -- case), and runner.FilterOutputFilesSince/Until. The runner applies
        -- the same window in waitForJob's completion discovery and in
        -- refreshRunningJobs' recovered-completion discovery
        -- (discoverRecoveredOutputs, upper bound = status-file mtime + 2m).
        -- A completion-record output_files listing is attributed by the
        -- runner, but the listed paths can be overwritten by a later job in
        -- the same directory before artifact sync runs; syncJobOutputs
        -- therefore re-applies both bounds to the synced copies' mtimes
        -- (rsync -a preserves them) and warns about dropped files rather
        -- than storing a successor's bytes under the earlier job.
        -- Declared outputs are exempt from the cutoff only insofar as the
        -- user explicitly named them; the convention-directory walk always
        -- applies it.
}

rule CompletionRecordListsDiscoveredOutputs {
    when: the on-prem runner closes a successful attempt (normal wait,
          single-job run, or recovered completion after a runner restart)

    ensures: the attempt's completion record (<id>.completion.json) carries
             an output_files listing — paths, sizes — of convention-output
             files discovered within the attempt's window
    ensures: the listing records paths and sizes only, never file contents

    @guidance
        -- The completion record is the primary attribution evidence for
        -- `weft artifact sync` on inventory hosts: when output_files is
        -- present, sync fetches exactly those files and never guesses. When
        -- it is absent (records written before this contract, or failed
        -- attempts), sync falls back to remote time-window discovery on the
        -- execution host — never to the submitter's local tree (invariant
        -- Attribution).
        -- Implementation: internal/runner/runner.go waitForJob and
        -- discoverRecoveredOutputs; internal/runner/single.go RunSingleJob;
        -- all call DiscoverJobOutputsSince and pass the result to
        -- WriteCompletionRecord.
}

open question "Concurrent same-workdir cross-attribution on multi-GPU
hosts: the shared-workdir upload barrier serializes only sequential jobs
within one agent process, and the attempt-start cutoff cannot distinguish
two jobs writing the same output subtree at the same time. Two jobs running
concurrently in one working directory (e.g. on different GPUs of the same
host) can still have each other's files uploaded under their keys. Options
include per-job output subdirectories, per-GPU workdir clones, or an
advisory lock on the convention output dirs; none is designed yet
(docs/design/artifacts.md § Known divergences)."

-- ==========================================================================
-- Artifact retrieval (sync)
-- ==========================================================================
-- Retrieval commands read the local artifact cache or cloud output objects and
-- materialize files for the user. Upload behavior is specified above; this
-- section captures the user-visible download contract.

-- The single resolution authority for artifact listing and retrieval. list,
-- get, and cat all consume one materialized union of the artifact sources,
-- with one identity matcher, so a row the user saw in a listing cannot
-- resolve against a different store when they retrieve it. Historically the
-- two sides used independent listings and matchers, producing four separate
-- list/get mismatch reports (wb11, wb16, wb20, wb40).
contract ArtifactResolution {
    resolved_rows: (job: Job) -> List<ResolvedArtifact>
    matches: (row: ResolvedArtifact, token: String) -> Boolean

    @invariant OneMaterializedUnion
        -- resolved_rows(job) is the union of the local artifact cache
        -- (artifacts table), host_data job-output pointer records, and the
        -- job's live per-run R2 listing, materialized once per invocation.
        -- `artifact list` prints exactly these rows; `get`/`cat` retrieve
        -- through them. Implementation: cmd/artifact.go
        -- resolveJobArtifacts (rows), resolvedArtifact.matchesToken
        -- (matcher), deliverArtifactToken (retrieval entry point).

    @invariant RowsCarryRetrievalHandles
        -- Every resolved row carries the handle for the bytes the listing
        -- described: cache rows the stored local path, cloud rows the
        -- listed R2 object key, host pointer rows the on-demand-sync
        -- identity (job + relative path). Retrieval of a listed row never
        -- re-derives identity through a different matcher or a second
        -- independent store listing.

    @invariant ListedRowsRetrievableOrLabeled
        -- Every row `artifact list` prints is retrievable by `get`/`cat`
        -- using the printed spelling, or the retrieval error explicitly
        -- states what was checked and why the row is gone (e.g. bytes
        -- overwritten on the host). Silence or a bare "not found" for a
        -- listed row violates this contract.
}

config {
    artifact_get_parallel_default: Integer = 8
}

rule ArtifactGetAllDownloadsConcurrently {
    when: UserRuns("weft artifact get --all", job, output, parallel)
    requires: ArtifactList(job).any()

    let requested_parallel =
        if parallel is specified then parallel else config.artifact_get_parallel_default
    let worker_count =
        min(count(ArtifactList(job)),
            max(1, requested_parallel))

    ensures: StartAtMost(worker_count, ConcurrentArtifactDownloads(job))

    for artifact in ArtifactList(job):
        let destination = ArtifactGetDestination(job, artifact.path, output,
                                                multiple = count(ArtifactList(job)) > 1)
        ensures:
            if DownloadArtifact(artifact, destination) succeeds:
                WriteLine("Wrote " + destination)
            else:
                RecordArtifactDownloadError(artifact)

    ensures:
        if any RecordedArtifactDownloadError:
            CommandFailsWith(join(RecordedArtifactDownloadError, "; "))
        else:
            CommandSucceeds()

    @guidance
        -- Implementation: cmd/artifact.go downloadCloudOutputFiles.
        -- Downloads may complete and print in completion order, not manifest
        -- order. A partial failure leaves successfully downloaded files in
        -- place and returns a combined error after all workers report.
}

rule ArtifactGetAllOutputPath {
    when: UserRuns("weft artifact get --all", job, output, _)

    if output = "-":
        requires: count(ArtifactList(job)) = 1
        ensures: WriteArtifactToStdout(First(ArtifactList(job)))

    if output != "-" and output is specified:
        requires: output exists
        requires: output is directory

    for artifact in ArtifactList(job):
        if count(ArtifactList(job)) > 1:
            ensures: destination =
                OutputDirectory(output) / job.id / artifact.relative_path
        else:
            ensures: destination =
                OutputDirectory(output) / artifact.relative_path

    @guidance
        -- Multiple artifact retrieval refuses stdout and requires --output
        -- to name an existing directory. For multiple artifacts, paths are
        -- nested under the formatted job id (wj<N>) to avoid collisions.
        -- Implementation: cmd/artifact.go resolveArtifactOutputPathForAll.
}

rule ArtifactListGetConsistency {
    when: UserRuns("weft artifact get" | "weft artifact cat", job, token)
          or UserRuns("weft artifact get --all", job)
    requires: token names a row that "weft artifact list" prints for job,
              or --all targets every such row

    ensures: retrieval succeeds via one of, in order:
        local artifact cache,
        the job's R2 per-run objects (any target kind, not only rentals),
        an on-demand sync from the job's inventory host
    ensures:
        if job is terminal and local cache row.created_at <= job.end_time
           and R2 lists the same canonical artifact path:
            retrieve the R2 object, not the pre-end cached snapshot
    ensures: if every source misses, the error names each source checked

    @guidance
        -- The list output unions three sources (cached artifacts, host_data
        -- job-output pointer records, live R2 listings); get must be able to
        -- follow all of them or say why not. Inventory queue runners started
        -- with --r2-bucket upload to the same per-run prefixes as rentals,
        -- so the R2 fallback must not be gated on the job being a rental
        -- job (bug wb16: a cool-host job's declared output listed but was
        -- not retrievable). Both sides consume the shared resolver of
        -- contract ArtifactResolution: cmd/artifact.go resolveJobArtifacts
        -- materializes the union once, and deliverArtifactToken (used by
        -- fetchArtifactForJobs and runArtifactCat) retrieves through the
        -- same rows and matcher, with syncArtifactOnDemand as the final
        -- host rung for outputs no listing source has recorded.
        -- `get --all` (fetchAllArtifactsForJobs) consumes the same
        -- resolver rows, deduplicated by canonical path with the cache
        -- preferred over cloud over host-pointer handles — a row set
        -- assembled from only the cache and cloud listings would skip
        -- host-pointer rows that list prints. The dedupe keeps same-source
        -- rows whose sizes disagree: those are genuinely different objects
        -- (e.g. a literal artifacts/ directory under output/), and each is
        -- delivered to its own printed path. Host-pointer rows are
        -- materialized by at most one whole-job sync per job, not one per
        -- row. Terminal
        -- jobs prefer a same-path R2 row over a cache row written before
        -- job end, so repeated writes to an output path return the final
        -- upload rather than an incremental snapshot (wb57); the --all
        -- dedupe applies the same preference, demoting a pre-end cache row
        -- below its same-path cloud row. Design:
        -- docs/design/artifacts.md § Intended invariants.
}

rule ArtifactRetrievalErrorFidelity {
    when: artifact retrieval download fails

    ensures: the surfaced error states the transfer failure cause
    ensures: "not found" is reported only when no source has the object

    @guidance
        -- A stalled 600MB download must not be reported as "artifact not
        -- found" (bug wb20: the candidate-key loop let a later 404 from a
        -- never-populated run prefix overwrite the real stall error).
        -- Implementation: cmd/artifact.go resolves the concrete R2 key
        -- first (resolveCloudOutputKey → r2resolve.NeedR2Key), downloads
        -- once, and propagates non-NotFound errors unwrapped. Single-file
        -- downloads above 8 MiB show a progress status line on a TTY so a
        -- long transfer is distinguishable from a hang.
}

rule ArtifactRetrievalCoversAllRuns {
    when: artifact list or retrieval consults R2
    requires: the recorded latest run and run zero have no objects

    ensures: runs discovered under jobs/<id>/runs/ are probed before
             reporting nothing
    ensures: a cache row written from a probed run's objects records that
             run's id, not the current latest_run_id — provenance names the
             attempt that uploaded the bytes

    @guidance
        -- A superseded or canceled attempt's uploads outlive latest_run_id
        -- (the wb19 pattern). Consumer staging already handled this via
        -- r2resolve.NeedR2Key; retrieval must use the same policy rather
        -- than a private [latest, 0] reimplementation. Implementation:
        -- cmd/artifact.go listCloudJobOutputFiles fallback and
        -- artifactRunIDCandidates, both delegating to internal/r2resolve.
        -- Run stamping: downloadCloudPrefix and
        -- syncCloudJobArtifactsWithStore carry the probed run id into
        -- db.UpsertArtifact (artifacts.StoreLocalArtifactForRun), which
        -- normalizes a non-positive run id (the legacy run-zero prefix)
        -- to latest-run attribution.
}

rule CompletedOutputsSurviveWorkdirReuse {
    when: job: Job completes with exit_code = 0 on an inventory host
    requires: job declares outputs (--output local:, --produces, or
              [tool.weft] outputs)

    ensures: each declared filesystem output is copied to
             ~/.cache/weft/artifacts/<jobID>/<runID>/outputs/<relPath>
             on the job's own host when the terminal transition is observed
    ensures: the snapshot is taken only when no file under the declared path
             was modified after the attempt's end bound (end_time + the same
             2m slack as OutputDiscoveryUsesAttemptStartCutoff)
    ensures: the recorded host_data job-output asset points at the snapshot
             path, not into the live working directory
    ensures: a later job reusing the same working directory cannot make the
             completed job's declared outputs unretrievable, and cannot have
             its own bytes recorded as the completed job's

    @guidance
        -- Implemented (bug wb10; design: docs/design/artifacts.md
        -- § Decision). Rentals and R2-enabled inventory runners satisfy
        -- this via per-run R2 upload plus the
        -- SharedWorkdirUploadBarrierBeforeNextJob rule. Inventory hosts
        -- without R2 get a host-local snapshot: when the terminal
        -- transition is observed, internal/ops/artifacts.go
        -- RecordJobOutputs enumerates the job's declared outputs — both
        -- --output local:/asset refs (job.outputs) and --produces manifest
        -- entries (job.produces, deduplicated against the outputs) — and
        -- snapshotRemoteJobOutput cp's each into the per-run snapshot
        -- directory over SSH before recording the host_data asset.
        --
        -- Observation lags completion: the snapshot runs on the
        -- submitter's next sync tick, and a same-directory successor may
        -- start (and overwrite the declared path) inside that window.
        -- The freshness probe closes the gap by refusing to copy when the
        -- source holds post-attempt mtimes — the outputs are then reported
        -- unretrievable rather than mis-attributed. Declared outputs are
        -- exempt from the START cutoff (naming a path attributes it even
        -- when the attempt did not rewrite it); only the end bound gates
        -- the snapshot.
        --
        -- The snapshot needs no R2 credentials; on any snapshot failure
        -- (including the freshness refusal) the asset is NOT recorded
        -- with a mutable working-dir path (a pointer into the shared dir
        -- would just re-open the wb10 race). Convention outputs that are
        -- not declared remain pointer-only until a lazy sync; the size
        -- cap / GC from the design's revised baseline is not yet
        -- implemented.
}

-- ==========================================================================
-- Queue-runner dispatch and concurrency
-- ==========================================================================
-- The queue runner on each host dispatches queued jobs subject to a
-- host-wide CPU utilization cap and a per-job warm-up window. GPU jobs
-- claim a device exclusively among our own jobs; CPU-only jobs share
-- host cores, governed by the allotment rules below.

rule QueueRunnerDispatch {
    when: QueueRunnerTick(host)

    -- Evaluate the head of the host's pending queue. Preserving submitted
    -- order is the default queue-runner property; the only scan-ahead
    -- exception is a benchmark-isolation head blocked solely by the
    -- benchmark idle probe, where a later eligible non-benchmark job may
    -- start while the benchmark remains pending with its gate reason.
    let head = host.pending_queue.first
    let candidate =
        if head.has_tag(benchmark_isolation)
           and head.blocked_only_by_benchmark_idle_probe
        then host.pending_queue.first_later(j =>
            not j.has_tag(benchmark_isolation)
            and j.dep_spec_satisfied
            and j.passes_cpu_gpu_and_load_gates)
        else head

    requires: candidate != null
    requires: candidate.dep_spec = null or candidate.is_blocked = false
    requires: candidate.target_kind in {inventory_host, rental_instance}

    -- Warm-up gate: while any running job on this host is still within
    -- its warm-up window, do not start additional jobs. This lets new
    -- jobs' CPU use stabilize before the runner makes further decisions.
    requires: host.running_jobs.all(j =>
        now >= j.latest_attempt.start_time + config.warmup_duration)

    -- CPU capacity gate (CPU-only jobs): the sum of local allotments
    -- for running jobs plus the initial allotment for the candidate job
    -- must not exceed the host utilization target.
    let initial = candidate.cpu_allotment ?? config.default_cpu_allotment
    requires: candidate.gpu_class != null
              or (sum(j.local_cpu_allotment for j in host.running_jobs)
                  + initial <= config.host_cpu_utilization_target)

    -- GPU capacity gate: GPU jobs claim a device exclusively among our
    -- own jobs on this host. See GPUJobsAreExclusivePerDevice invariant.
    requires: candidate.gpu_class = null
              or host.has_device_available_for(candidate)

    ensures: candidate.status = starting
    ensures: candidate.local_cpu_allotment = initial
    ensures: candidate.warmup_until = now + config.warmup_duration

    @guidance
        -- CPU jobs and GPU jobs can run concurrently on the same host as
        -- long as they use disjoint resources (GPU device vs CPU cores).
        -- CPU-only jobs are identified by the absence of gpu_class,
        -- gpu_mem_gb, and gpu_devices; they bypass the GPU gate and are
        -- governed solely by the CPU allotment rules.
        --
        -- If total local allotment already exceeds the target (e.g. after
        -- adaptive increases on currently running jobs), the runner does
        -- NOT preempt — it simply refuses to start additional jobs until
        -- the sum drops below the target again.
        --
        -- Shared hosts: the exclusivity rule applies only to our own
        -- jobs. Other users' jobs on the same GPU are tolerated; we do
        -- not wait for a device to be fully vacant before starting.
}

rule AdaptiveCPUAllotment {
    when: CPUSampleWindowClosed(job)
    requires: job.status = running
    requires: now >= job.warmup_until

    -- The runner adjusts local_cpu_allotment based on observed CPU use.
    -- A move (up or down) only fires when the observation has held for
    -- a majority of recent windows — transient spikes do not change the
    -- allotment. Specific step sizes and window shapes are runner
    -- implementation details.
    if job.observation_persistently_above(job.local_cpu_allotment):
        ensures: job.local_cpu_allotment increases
                 bounded by config.max_cpu_allotment
    else if job.observation_persistently_below(job.local_cpu_allotment):
        ensures: job.local_cpu_allotment decreases
                 bounded by config.min_cpu_allotment

    @guidance
        -- Hysteresis: a threshold number of recent sample windows must
        -- agree before local_cpu_allotment moves. This avoids
        -- oscillation when a job's CPU use hovers near its current
        -- allotment. Decreases use a dead-band below the current
        -- allotment so jobs that land slightly under their allotment
        -- are not immediately decayed.
}

rule CPUAllotmentEditApplied {
    when: Job.cpu_allotment transitions_to new_value
    requires: Job.status in {queued, starting, running}

    -- When the user edits cpu_allotment in the TUI, the runner applies
    -- the new value as local_cpu_allotment immediately and resets any
    -- adaptive state (hysteresis counters, sample buffers) so the next
    -- adjustment decision starts from a clean observation window.
    ensures: Job.local_cpu_allotment = new_value ?? config.default_cpu_allotment
    ensures: AdaptiveStateReset(Job)
}

-- ==========================================================================
-- Failure detection
-- ==========================================================================

rule DetectFailureReason {
    when: job: Job.status transitions_to failed
    requires: job.exit_code != null

    -- Exit code 137 (SIGKILL) → OOM
    -- Exit code 139 (SIGSEGV) → segfault
    -- Exit code 124 → setup_timeout (setup-phase watchdog fired before
    --   the user command started — usually a slow rental network)
    -- Exit code 125 → killed_gpu_idle (GPU watchdog)
    -- Exit code 126 → killed_stdout_silence (log-silence watchdog)
    -- Disk exhaustion detected via system probes → disk_full
    -- GPU OOM detected via nvidia-smi → gpu_oom
    -- PyTorch/CUDA logs that report an insufficient NVIDIA driver →
    -- cuda_driver_too_old, with solution guidance to retry on known-compatible
    -- CUDA/driver capacity or choose a runtime built for the older driver.
    -- Otherwise → error or exit_N

    @guidance
        -- Failure reason detection examines dmesg for OOM killer messages,
        -- nvidia-smi for GPU memory exhaustion, and df for disk full
        -- conditions. These system probes run on the remote host.
}

-- Infrastructure-vs-user failure classification funnels through a single
-- classifier (db.ClassifyInfraFailure(phase, exit_code, log_tail)) rather
-- than ad-hoc per-call-site decisions. A failure is infrastructure-side —
-- the agent terminates the rental as TerminationReasonInfraFailure and
-- self-destructs, so Weft's reconciler requeues affected jobs and the
-- autopilot re-places them on a different rental — when any of these hold:
--   * HF prewarm download failure: weft-owned input staging failed before
--     the user command started, REGARDLESS of exit code (not just exit
--     124). Recorded as failure_reason infra_prewarm_download_failed. The
--     download itself already survived bounded retries with xet fallback
--     (source-data-sync.allium § HFAssetsPrestagedOnCloud), so an
--     exhausted prewarm signals rental network/Hub trouble, not user code.
--   * Setup-phase timeout: a prewarm RunSetupCommand exceeded
--     setup_timeout (default 1h on rentals); agent exit code 124. The 124
--     exit code is preserved through recordPrewarmFailure into the R2
--     .complete marker (never collapsed to 1) so downstream
--     classification can still see it.
--   * Runtime CUDA hardware fault: the job log tail carries a bad-GPU /
--     interconnect signature (peer GPU memory, NVLink, uncorrectable ECC,
--     Xid). Recorded as failure_reason infra_cuda_hardware_fault.
--   * GPU-count preflight shortfall: the instance physically exposes
--     fewer GPUs than the sequence's jobs request, detected before any
--     billable setup/prewarm spend.
-- Justification: these conditions indicate rental network, hardware, or
-- provider-allocation problems, not user error. Marking the job
-- permanently failed would strand the user on a bad rental instead of
-- moving on to a healthy one. All other setup and runtime failures stay
-- user-attributed. Auto-detected-only HF inputs are the exception inside
-- the prewarm-download phase: they are staged best-effort, and final staging
-- failure logs a warning but does not fail the job or terminate the rental.
-- Inputs from --input, project config, or PEP-723 [tool.weft] inputs remain
-- explicit and fatal; an input that is both explicit and auto-detected is
-- explicit.
-- Implementation: internal/db/failure_modes.go ClassifyInfraFailure is
-- the single decision point; cmd/agent/jobloop.go runHFDownloadPrewarm
-- (prewarm-download phase) and prewarmShouldTerminateAsInfra (setup
-- phase), internal/runner/job.go DetectFailureReasonFromExitInfoAndLog
-- (runtime phase), and cmd/agent/gpu_count_probe.go checkGPUCount
-- (gpu-count-preflight phase) all classify through it. runSetupPrewarm
-- preserves ExitInfo on setupPrewarmResult.exitInfo so exit 124 survives
-- recordPrewarmFailure.

-- Setup-phase subprocesses (uv sync, torch preflight, direnv resolution,
-- pre-job disk probes, and similar helpers that run user tooling before
-- the job command itself) must execute with an environment that includes
-- the agent's parent-process environment. Concretely, when such a
-- subprocess assigns cmd.Env explicitly, it must merge os.Environ() under
-- the job's constructed envVars (last-writer-wins, so job-level env still
-- overrides parent). Without this, HOME is absent, `bash -lc` cannot
-- resolve ~/.profile, the Debian snippet that adds ~/.local/bin to PATH
-- never runs, and `uv` — installed at $HOME/.local/bin/uv on the cloud
-- pytorch image by DefaultOnStartCmd — becomes unreachable. The
-- preflight then exits 127 even though uv is on disk, and every GPU job
-- on a fresh rental fails for an infrastructure reason that looks like
-- a missing tool. Job envVars carries dotenv + job.Env + artifact env;
-- it deliberately does not carry HOME/PATH because those come from the
-- agent process itself.
-- Implementation: internal/runner/torch_preflight.go preflightEnv,
-- internal/runner/process.go StartProcess, internal/runner/single.go
-- disk-probe call site (mergeEnvVars(os.Environ(), envVars)). New
-- setup-phase subprocesses that set cmd.Env must follow the same
-- pattern; relying on the exec.Command default (which is os.Environ
-- alone) is only correct when the job's envVars contribute nothing.
-- Regression: torch_preflight added in 03f93ba3b without this merge,
-- producing exit-127 storms across wj2221-wj2232 + follow-on attempts on
-- 2026-05-28.

-- On cloud pytorch images, weft takes a "system-torch shortcut" to avoid
-- a ~870 MiB torch download per job: bootstrap creates .venv with
-- `python -m venv --system-site-packages` against /opt/conda/bin/python,
-- and each job's setup runs `uv sync --no-install-package torch …` with
-- UV_PYTHON pinned to that interpreter, so torch is read from the image's
-- system site-packages instead of re-installed. The shortcut has two
-- structural invariants the runner must enforce on every setup phase:
--
--   (a) The .venv must be on uvSystemPythonPath. Specifically,
--       .venv/pyvenv.cfg must contain `include-system-site-packages =
--       true` AND `home = filepath.Dir(uvSystemPythonPath)`. Probing only
--       `dirExists(.venv)` is insufficient: a previous job's user command
--       (`uv sync && uv run …`) runs without UV_PYTHON in its env, so any
--       project pin (`.python-version`, `requires-python`) can cause uv
--       to remove the venv and rebuild it on a different Python without
--       --system-site-packages. The next setup must detect that broken
--       state structurally and rebuild the venv before `uv sync` runs.
--
--   (b) The shortcut must be declined when the project's `.python-version`
--       requests a major.minor different from the runtime version of
--       uvSystemPythonPath. With UV_PYTHON=3.11 against a .venv that
--       .python-version forces to 3.13, uv tears down and recreates the
--       venv on every cycle (project sync ↔ weft sync), and the torch
--       preflight fails inside the resulting torch-less, non-system-site-
--       packages venv. In that case weft must fall back to a plain `uv
--       sync` (no --no-install-package torch, no UV_PYTHON override, no
--       UV_NO_SYNC) and log the reason to the job log so the user sees
--       why a full sync ran. Torch is then resolved by the project's
--       normal dependency resolution.
--
-- Implementation: internal/runner/envsetup.go —
--   * venvMatchesSystemContract enforces (a).
--   * ensureSystemSitePackagesVenv calls it; on mismatch it os.RemoveAll
--     the venv and recreates with --system-site-packages before sync.
--   * shouldUseSystemTorchPackages enforces (b) via pythonVersionRequest
--     (reads .python-version, accepts `3.13`, `3.13.1`, `cpython@3.13`,
--     `pypy@3.10`) and systemPythonMajorMinor (execs the interpreter for
--     `sys.version_info`). When declined, the function returns a non-empty
--     fallback reason and the runner appends it to the setup log.
--   * prepareUVSyncEnvironment returns the fallback reason as a 4th value
--     so the caller can surface it (the predicate alone is invisible).

-- failure_reason is a single-line classification, never a multi-line
-- diagnostic dump. Writers must keep it to one line of free-form text
-- (typically a FailureReason enum value or short headline). The prewarm
-- log tail, tracebacks, and other multi-line context belong in the job
-- log file (already uploaded to R2 and surfaced by `weft log` and `weft
-- info`'s `prewarm log tail:` section). Embedded newlines in
-- failure_reason corrupt the TUI footer line, the `Reason:` line in
-- weft info / weft status, and the `Job:` line in the list TUI — these
-- are fixed-height single-line UI elements that scroll the surrounding
-- layout off-screen when fed multi-line content.
-- Implementation: setupPrewarmResult.logTail in cmd/agent/jobloop.go
-- carries the multi-line tail separately from err (which is single-line);
-- humanizeFailureReason in cmd/campaign_diagnose.go and the FailureReason
-- branch in internal/ui/terminal/list_selected_detail.go's
-- appendJobStatusParts defensively wrap with firstLine.

-- `weft job info`, `weft job status`, and `weft list --show` must
-- surface every locally derivable diagnostic signal for a failed job.
-- "Locally derivable" means: the SQLite DB plus the local log cache at
-- ~/.cache/weft/logs/<id>.log — no SSH, no R2 fetch, no provider call.
-- The required surface includes, at minimum, when each is available:
--   - structured Diagnosis (and Solution when the matched pattern
--     defines one), resolved from job_attempts.error_diagnosis OR by
--     scanning the cached log live when the column is empty;
--   - for diagnoses with pattern=gpu_oom and parsed per-process VRAM
--     attribution, a continuation block with main GPU process pid +
--     memory, optional additional process, notes, and the
--     `hint: increase --gpu-mem by ~NGB on retry` line. These signals
--     are already surfaced by `weft instance diagnose` and one-line
--     contexts via formatDiagnosisSummary; multi-line job-noun
--     surfaces MUST render them via ErrorDiagnosis.GPUOOMDetailLines()
--     so the per-process root cause is visible without an extra hop;
--   - launch termination_detail for the latest attempt's rental,
--     restricted to failed/grace launches (completed adds no signal);
--   - phase breakdown (setup / run / upload) from job_phase_timings;
--   - GPU peak memory + mean/peak utilization from job_phase_timings.
-- The motivation is symmetry with `weft instance diagnose`, which
-- agents and operators already trust to derive everything from local
-- state. Without the fallback to live log scanning, jobs that never
-- invoke the remediation pipeline — benchmark / `processed` / no-retry
-- failures — leave the DB column empty and the job-noun surfaces show
-- only "Reason: error", forcing the reader to escalate to the
-- instance-noun command. The 2026-05-28 EXP-179 wj2041 report (CUDA
-- OOM in torch.compile, exit 1) was the named instance: `instance
-- diagnose` surfaced "GPU out of memory" and "peak mem 81910 MiB" on
-- an 80 GB device; `job info` and `job status` surfaced "Reason:
-- error" and nothing else, hiding the smoking gun.
-- Implementation: cmd/diagnosis_format.go ResolveJobDiagnosis does the
-- stored-then-log-cache resolution;
-- internal/remediation/diagnosis.go (*ErrorDiagnosis).GPUOOMDetailLines()
-- returns the per-process / notes / hint fragments and is the shared
-- source used by both formatDiagnosisSummary (one-line) and
-- printDiagnosisSummary (multi-line); cmd/job_diagnostics.go
-- printJobLocalDiagnostics renders all signals; `weft job info`
-- (cmd/job.go printJobInfo loop), `weft job status` (cmd/status.go
-- printJobStatus), and `weft list --show` / `weft jobs list --show`
-- (cmd/list.go showJob) all invoke it. New diagnostic surfaces that
-- can be derived without network access SHOULD extend
-- printJobLocalDiagnostics so all three verbs grow together.

rule JobInfoQualifiesMutableRentalAccounting {
    when: UserRunsJobInfo(job)

    let attempt = job.latest_attempt
    let rental = attempt.cloud_instance

    requires: rental != null

    if JobInfoDisplaysTiming(job):
        ensures: JobInfoTimingQualifier(job) =
            provisional if not IsTerminal(EffectiveStatus(job)) else final
    if JobInfoDisplaysRentalCost(job):
        ensures: JobInfoCostQualifier(job) =
            provisional if rental.status not in {completed, failed, canceled} else final

    @guidance
        -- `Started` and `Elapsed`, when present, carry a provisional
        -- qualifier while the job's effective status is nonterminal. The
        -- completion record may reconcile the command start time, so these
        -- live values are not stable enough to record as experiment results.
        -- Once the job is terminal, its timing fields are rendered without
        -- the provisional qualifier.
        --
        -- Rental cost has a separate finality boundary: it remains
        -- provisional while the launch is nonterminal and is described as
        -- an instance-total or shared setup-plus-run estimate "to date".
        -- Teardown finalizes the rental cost. Therefore a completed job on
        -- a still-live shared rental can have final timing and provisional
        -- cost; job terminality alone must not finalize the cost label.
        --
        -- Implementation: cmd/job.go derives timing provisionality from
        -- Job.EffectiveStatus; internal/estimate/cost.go derives cost
        -- provisionality from Launch.IsTerminal.
}

-- ==========================================================================
-- User actions
-- ==========================================================================

rule UserKillsJob {
    when: UserKill(job)
    requires: job.status in {running, starting, queued, paused}

    ensures: job.status = killed
    ensures: KillProducesStatusFile(job)
    @guidance
        -- Sends SIGTERM to the wrapper's process group, waits
        -- config.kill_grace_period (0.5s in the queue-runner path), then
        -- SIGKILL. Regardless of which signal terminates the wrapper, a
        -- .status file is produced for the job — see KillProducesStatusFile.
}

-- A `weft kill` must always leave a {jobID}.status file behind so the
-- queue runner's refreshRunningJobs can free the job slot promptly and
-- record the real exit code. The implementation uses three layers:
--   1. The job wrapper installs SIGTERM/SIGINT traps (WrapCommandWithExitCapture)
--      that write the status file with code 143 (SIGTERM) or 130 (SIGINT)
--      before exiting. This handles the SIGTERM phase.
--   2. killQueueRunnerJob waits 0.2s after SIGKILL and writes a synthetic
--      `echo 137 > {jobID}.status` if the file is still missing. This handles
--      the case where SIGKILL beat the trap or the wrapper was already wedged.
--   3. If both above fail, refreshRunningJobs's zombie-detection path (see
--      rule WrapperZombieRecovered) writes a synthetic status file as a final
--      safety net.
rule KillProducesStatusFile {
    when: KillProducesStatusFile(job)

    ensures: JobStatusFileExists(job)

    @guidance
        -- Without these layers a `weft kill` on a queue-runner job could leave
        -- the wrapper as a zombie (kernel keeps a process-table entry; the
        -- agent's Wait() goroutine doesn't survive syscall.Exec re-execs), the
        -- queue slot would stay occupied indefinitely, and `weft kill` would
        -- appear to succeed at the CLI while the job remained "running" to the
        -- runner.
        --
        -- Implementation:
        --   internal/runner/process.go WrapCommandWithExitCapture
        --     — installs `trap '_weft_on_signal 143 SIGTERM' TERM` and the
        --       same for SIGINT (130). The trap writes "=== END exit=$_e ..."
        --       to the log, writes $_e to the status file, then exits $_e.
        --   internal/ops/reconcile.go killQueueRunnerJob
        --     — after SIGTERM, sleeps 0.5s, sends SIGKILL, sleeps 0.2s, then
        --       writes echo 137 to the status file if it's still missing.
}

-- ==========================================================================
-- Hang-detection watchdogs
-- ==========================================================================
-- These are automatic, not user-initiated. The runner monitors each running
-- job and kills the process group when a hang signal fires. Only the job
-- dies; the containing rental instance stays alive and its queue advances
-- to the next job.

rule GPUIdleKillsJob {
    when: GPUIdleTimeout(job)
    requires: job.status = running
              job.gpu_class != null

    ensures: job.status = failed
             job.failure_reason = killed_gpu_idle
             job.exit_code = 125
    @guidance
        -- Triggered when every GPU assigned to the job has reported 0%
        -- utilisation and the job has produced no watchdog-visible activity
        -- for longer than config.gpu_idle_timeout, after the watchdog has
        -- armed (first non-zero sample, first log/output activity, or
        -- config.watchdog_initial_grace, whichever comes first). The same
        -- log growth and output-directory writes that reset
        -- StdoutSilenceKillsJob also reset GPU idle time, because positive
        -- setup activity is not evidence of a dead GPU job. This activity
        -- watchdog is distinct from structured semantic progress. Kill path:
        -- SIGTERM to the process group, then SIGKILL after
        -- config.kill_grace_period. The rental instance remains alive and
        -- continues its queue.
}

rule StdoutSilenceKillsJob {
    when: StdoutSilenceTimeout(job)
    requires: job.status = running

    ensures: job.status = failed
             job.failure_reason = killed_stdout_silence
             job.exit_code = 126
    @guidance
        -- Triggered when neither the job log file has grown nor any file
        -- under the configured output directories (output/, outputs/, or
        -- the job's OutputDirs override) has been modified for longer than
        -- config.stdout_silence_timeout, after the watchdog has armed
        -- (first bytes written or config.watchdog_initial_grace). Either
        -- form of activity resets this silence timer. It does not prove the
        -- task advanced; structured Progress values supply that separate
        -- signal. Kill path is identical to GPUIdleKillsJob.
}

rule UserPausesJob {
    when: UserPause(job)
    requires: job.status in {starting, running, queued}

    ensures: job.status = paused
}

rule UserResumesJob {
    when: UserResume(job)
    requires: job.status = paused

    ensures: job.status = running
}

rule UserCancelsJob {
    when: UserCancel(job)
    requires: job.status in {queued, running, paused, pending_placement}

    ensures: job.status = canceled

    @guidance
        -- Cancel is typically an operator/agent-requested administrative
        -- action. It records intent to stop/retract a job, not an external
        -- failure signal from runtime infrastructure.
}

rule CancelSurvivesInstanceTermination {
    when: InstanceTerminated(instance)
    requires: job in instance.jobs and job.requested_status = canceled

    ensures: job.requested_status = canceled
             and job.status = canceled
             and not Dispatchable(job)

    @guidance
        -- A user-issued cancel is a durable intent to retract the job.
        -- Termination of the hosting rental/instance must NOT resurrect
        -- that intent into queued, or the dispatcher will provision a
        -- fresh rental to satisfy demand from a job the user cancelled.
        --
        -- Implementation: internal/db/attempts.go closeAttemptsAndRequeue
        -- preserves requested_status='canceled' when requeuing attempts
        -- after instance teardown; internal/db/cloud_instances.go
        -- ResetLaunchJobs filters canceled jobs out of the requeue set
        -- both by view status and by raw requested_status.
        --
        -- Regression reference: jobs wj1383, wj1386, wj1387 (2026-04-24)
        -- on structural-probes were individually cancelled while placed
        -- on rental wi1362; terminating wi1362 re-dispatched them to a
        -- fresh rental wi1366, costing the user a second instance.
}

-- ==========================================================================
-- Retry and requeue
-- ==========================================================================

rule UserRequeuesJob {
    when: UserRequeue(job)
    requires: job.status in {completed, failed, dead, killed, canceled}

    let new_attempt_number = job.latest_attempt.attempt_number + 1

    ensures: job.status = queued
    ensures: JobAttempt.created(
        job: job,
        attempt_number: new_attempt_number,
        status: queued,
        backend: job.backend
    )

    @guidance
        -- Applies uniformly to on-prem and cloud/rental jobs. A fresh
        -- attempt is required (not merely setting requested_status='queued')
        -- because the job_status view derives cloud-job status from the
        -- latest attempt: without a new attempt, a terminal attempt with
        -- exit_code != 0 keeps the job visible as 'failed' in listings and
        -- the autopilot never re-places it.
        --
        -- Retry resolves the fresh attempt target in this order:
        -- explicit retry command target, stored jobs.placement_host,
        -- current inventory-host target, current live rental-instance
        -- target, otherwise unplaced. A stored or explicit host is a
        -- concrete placement and wins over tags, including stale `rental`
        -- tags left from an earlier cloud attempt.
        --
        -- If no concrete target exists, the new attempt is unplaced
        -- (host='', launch_id=NULL) and the scheduler re-places it on the
        -- next sweep. Prior cloud attempts are marked
        -- cloud_outcome='superseded' so retry-budget accounting does not
        -- keep charging elapsed/spend from the failed chain. Terminal
        -- prior instances do not count as live targets and therefore do
        -- not trigger replacement launch from retry alone.
        --
        -- Both branches must clear `requested_status` so the
        -- `job.status = queued` post-condition holds uniformly. The
        -- job_status view treats user-level overrides as authoritative:
        -- a stale `requested_status='canceled'` or `'killed'` from an
        -- earlier user action will keep reporting the job as canceled/
        -- killed regardless of the latest attempt's status. The cloud
        -- branch (RequeueFreshAttemptByID) writes
        -- `requested_status='queued'`; the on-prem branch now does the
        -- same after creating its fresh queued attempt.
        --
        -- Implementation: cmd/restart.go resolveRetryTarget applies the
        -- precedence above. internal/db/db.go RequeueFreshAttemptByTarget
        -- creates a fresh queued attempt with the resolved inventory host
        -- or live launch target; RequeueFreshAttemptByID is the unplaced
        -- fallback.
        --
        -- Regression references: jobs wj1379, wj1381 (2026-04-24) —
        -- `weft edit --retry` reported success locally but listings kept
        -- showing 'failed' because the cloud branch only set
        -- requested_status='queued' without creating a fresh attempt;
        -- job wj2365 — an on-prem job that had been canceled by the user
        -- could not be requeued because the on-prem branch left
        -- requested_status='canceled' in place, so job_status kept
        -- reporting 'canceled' even after the fresh queued attempt was
        -- created. Test: TestRequeueByID_CanceledOnPremJob_ViewReportsQueued
        -- in internal/db/db_test.go.
}

rule ResetJobToUnplaced {
    when: ResetToUnplaced(job)
    requires: job.is_terminal

    ensures: job.host = null
    ensures: job.cloud_instance = null
    ensures: job.target_kind = unplaced
    ensures: job.status = queued
    ensures: JobAttempt.created(
        job: job,
        attempt_number: job.latest_attempt.attempt_number + 1,
        status: queued,
        backend: job.backend
    )

    @guidance
        -- Used when the original cloud instance is no longer available
        -- and the job needs re-placement on a different host.
}

rule UserRetriesUnplaced {
    when: UserRetryUnplaced(job)
    requires: job.is_terminal
    requires: job.target_kind != unplaced or job.cloud_instance != null

    ensures: ResetToUnplaced(job)

    @guidance
        -- `weft retry --unplaced` resets terminal jobs to unplaced+queued
        -- so the scheduler can re-place them on a different host or instance.
        -- Also clears the runaway breaker if tripped for the job's scope
        -- (see RunawayBreakerClears in campaign-lifecycle.allium).
        -- Implementation: cmd/restart.go
}

-- Infrastructure-classified failures retry WITHOUT user action. Every
-- other retry rule in this section is user-initiated (UserRequeue,
-- UserRetryUnplaced); this is the one system-initiated path, and it is
-- deliberately narrow: it fires only when the launch itself terminated
-- for a retryable, infrastructure-side reason, so user-code failures
-- never auto-loop.
rule AutoRequeueOnInfraFailure {
    when: LaunchTerminalReconciled(launch)   -- reconciler observes the
                                             -- launch reach terminal failed
    requires: IsRetryableTermination(launch)
              -- infra_failure, provider_failure, bootstrap_timeout,
              -- phase_stall, preempted, provider_timeout, upload_stall,
              -- account_credit_exhausted, unknown/empty — see
              -- internal/db/cloud_instances.go IsRetryableTermination

    -- Non-terminal jobs on the launch are reset to unplaced+queued by the
    -- ordinary orphan handling regardless of retryability (that path
    -- covers a job that was mid-run when its instance died). What this
    -- rule adds: a job that already failed TERMINALLY with
    -- failure_reason in InfraFailureReasons gets a fresh queued unplaced
    -- attempt too, while the derived infra-failure attempt count remains
    -- below db.AutoRequeueMaxInfraFailureAttempts (2). Without this, a
    -- terminal attempt that synced before reset would stay parked as failed
    -- even though the launch died for infrastructure reasons.
    ensures:
        for job in launch.jobs
            where job.status = failed
              and job.failure_reason in InfraFailureReasons
              and CountInfraFailureAttempts(job) < AutoRequeueMaxInfraFailureAttempts
              and job.requested_status not in {canceled, killed, draft}:
            JobAttempt.created(job: job, status: queued, target: unplaced)
            job.status = queued

    @guidance
        -- Implementation: internal/db/cloud_instances.go ResetLaunchJobs —
        -- retryInfraFailed := IsRetryableTermination(ci) widens the reset
        -- query to include failed jobs whose failure_reason is in
        -- db.InfraFailureReasons() and whose historical infra-failure count
        -- is below db.AutoRequeueMaxInfraFailureAttempts, then creates the
        -- fresh queued attempt (createAttemptTx) for each. This keeps the
        -- SQL WHERE clause aligned with IsInfraFailureReason, including
        -- infra_prewarm_download_failed and infra_cuda_hardware_fault.
        --
        -- Interaction with user-initiated retry: UserRequeuesJob and
        -- UserRetriesUnplaced remain available and unchanged. This rule
        -- never fires for job-level terminations (job_failure, disk_full,
        -- canceled, completed) — those jobs stay parked until the user
        -- acts. Orphaned attempts have start_time cleared so
        -- infrastructure overhead (bootstrap/setup) is not charged
        -- against the retry budget; see also
        -- RetryBudgetExcludesCanceledAttempts.
}

rule RetryReplaysSubmissionIntent {
    when: UserRequeue(job) or UserRetryUnplaced(job)
    requires: job.has_script_pep723_block

    -- On retry, resource fields (gpu, gpu_class, gpu_mem, provider-specific
    -- placement overrides such as runpod_cloud_type) are recomputed by
    -- re-reading the current PEP 723 [tool.weft] block and replaying
    -- job.cli_overrides on top, using the same CLI > script > unset
    -- precedence as the initial `weft run` submission. Fields the script
    -- no longer declares AND the user did not pin via CLI are cleared.
    -- CLI overrides explicitly re-passed to `weft retry` take precedence
    -- over both stored overrides and script metadata.

    @guidance
        -- Implementation: cmd/restart.go applyScriptGPUDefaults.
        -- Covers the case where a user edits a script to add, change, or
        -- remove a resource constraint and re-runs `weft retry <id>`.
        -- Legacy jobs with no stored cli_overrides are treated as having
        -- no CLI intent; the retry-time merge then reflects the current
        -- script verbatim.
}

rule RetryBudgetExcludesCanceledAttempts {
    when: RetryBudgetEvaluated(job)

    -- Retry budgets (time and cost) bound *retry-system activity*, not
    -- total job wall-clock. The elapsed time charged against a budget is
    -- taken from the most recent non-canceled attempt. Canceled attempts
    -- contribute zero — whether user-initiated (`weft instance terminate`,
    -- cancel on a stuck rental) or system-initiated cleanup, a cancel
    -- does not represent retry effort and its duration must not block
    -- subsequent retries. If every prior attempt was canceled, elapsed
    -- is zero and the budget is not tripped.

    @guidance
        -- Implementation: internal/campaign/relaunch.go
        -- attemptFactsForRelaunch() scans attempts newest-first and
        -- selects the latest non-canceled attempt for LastAttemptStartTime
        -- / LastAttemptEndTime, which feed retryBudgetUsage().
        --
        -- Regression reference: job wj1134 (2026-04-13) had a canceled
        -- attempt that ran 12h38m before cleanup; that duration was
        -- incorrectly charged to the 45m subsequent-retry budget,
        -- permanently blocking every re-queue.
}

-- ==========================================================================
-- Authoritative overrides
-- ==========================================================================

rule AuthoritativeCompletion {
    when: R2CompletionReceived(job, exit_code)
    requires: job.status in {failed, dead, killed, canceled, queued}

    if exit_code = 0:
        ensures: job.status = completed
        ensures: job.exit_code = 0

    @guidance
        -- R2 completion signals can arrive after the local sync has already
        -- marked a job as failed/dead due to a race condition. The R2 signal
        -- is authoritative because the agent on the remote host has direct
        -- knowledge of the actual outcome.
}

-- ==========================================================================
-- Three-way merge reconciliation (on-prem sync)
-- ==========================================================================

rule SyncReconcile {
    when: SyncCompleted(attempt, remote_status)

    if attempt.pending_status != null:
        -- User intent takes priority
        ensures: attempt.status = attempt.pending_status
        ensures: attempt.pending_status = null
        ensures: attempt.pending_at = null
    else:
        -- Remote state is authoritative
        ensures: attempt.status = remote_status
    ensures: attempt.last_synced_status = remote_status

    @guidance
        -- Three-way merge handles network partitions for on-prem jobs.
        -- If the user requested a state change (e.g. pause) while the host
        -- was unreachable, user intent is honored on reconnection.
        -- Otherwise, the remote host's observed state is authoritative.
}

-- ==========================================================================
-- Invariants
-- ==========================================================================

invariant TerminalJobsHaveEndTime {
    -- Every attempt in a terminal status has end_time set to a positive
    -- unix timestamp, OR is a cloud row pending completion backfill
    -- (last_synced_status = NULL). The pending-backfill carve-out covers
    -- the case where R2 yielded a .complete marker but no readable
    -- completion JSON: rather than fabricate a wall-clock end_time, the
    -- writer leaves end_time NULL and a later sync rewrites it from the
    -- agent's authoritative timestamps. A "terminal but open" row with
    -- last_synced_status already set to status is still an invariant
    -- violation.
    for job in Jobs:
        if job.status in {completed, failed, dead, killed, canceled}:
            (job.latest_attempt.end_time != null and
             job.latest_attempt.end_time > 0)
            or
            (job.latest_attempt.launch_id != null and
             job.latest_attempt.last_synced_status = null)

    @guidance
        -- end_time = 0 is INVALID for jobs in a terminal status. It breaks:
        --   - CloseLaunchAttempts (WHERE end_time IS NULL misses 0)
        --   - ComputeJobState (LatestJobEnd > 0 treats 0 as "no end")
        --   - Self-destruct detection (requires LatestJobEnd > 0)
        -- The startup repair repairAttemptEndTimeZero fixes historical
        -- rows that were written as 0 by previous code. Any code path
        -- that writes end_time for a terminal *job* must ensure it is
        -- either NULL (not yet ended, OR cloud terminal pending
        -- backfill) or a positive unix timestamp.
        --
        -- Carve-out for preflight-rejected attempts (see
        -- PreflightRejectionClosesAttempt): the attempt closes with
        -- end_time = 0 by design, paired with start_time = null and
        -- exit_code = null, because there is no execution boundary to
        -- record. This is consistent with the invariant because the
        -- containing Job stays in `queued` (not terminal); only the
        -- specific attempt row carries end_time = 0. is_preflight_rejected
        -- on the attempt narrows display surfaces to the "preflight-
        -- rejected" rendering without touching the job's terminal status.
        --
        -- RecordCloudJobCompletion (cloud terminal writer) prefers the
        -- agent's authoritative end_time from <jobID>.completion.json,
        -- falls back to the .complete marker's R2 LastModified when the
        -- JSON is missing, and only as a last resort leaves end_time
        -- NULL with last_synced_status cleared so a later sync can
        -- rewrite it. It does NOT silently substitute wall-clock sync
        -- time; doing so would obscure the true completion time and
        -- silence the backfill path.
        --
        -- Regression wi2317 (2026-05): the user-cancel writer
        -- (UpdateAttemptStatusAndLastSynced in status-sync) wrote
        -- status='canceled' without stamping end_time. The reconciler
        -- treated that "terminal but open" attempt as still in flight,
        -- which silenced rule IdleAfterReadyTimeout (gated on
        -- not has_started_job) on the surrounding instance.
        --
        -- ENFORCEMENT (00006, 2026-05-26): the invariant is now also
        -- enforced by DB triggers
        --   job_attempts_terminal_auto_stamp_end_time_insert
        --   job_attempts_terminal_auto_stamp_end_time_update
        -- which auto-stamp end_time = strftime('%s','now') when an
        -- attempt transitions to a terminal status with end_time NULL.
        -- The cloud-backfill carve-out (launch_id NOT NULL AND
        -- last_synced_status IS NULL) is respected so the eventual sync
        -- can rewrite from the agent's authoritative timestamps.
        -- Per-call-site "writer MUST stamp end_time" discipline remains
        -- correct (it makes the rationale visible at the call site) but
        -- is no longer load-bearing — a future regression like wi2317
        -- would be caught by the table itself. See
        -- internal/db/terminal_attempt_triggers_test.go.
}

invariant AttemptNumbersAreSequential {
    for job in Jobs:
        for i in 1..job.attempts.count:
            job.attempts.any(a => a.attempt_number = i)
}

invariant PlacedJobsHaveTarget {
    for job in Jobs:
        if job.target_kind != unplaced:
            job.latest_attempt.target != null
}

invariant RunningJobsAreNotTerminal {
    for job in Jobs:
        if job.status = running:
            job.is_terminal = false
}

invariant PendingPlacementClearedOnTerminalLaunch {
    -- A pending_placement intent only makes sense while the launch it was set
    -- for is still a placement candidate. Once the launch reaches a terminal
    -- status, any residual pending_placement on attempts referencing that
    -- launch must be cleared.
    for attempt in JobAttempts where attempt.pending_status = pending_placement:
        if attempt.cloud_instance != null
           and attempt.cloud_instance.status in {failed, canceled, completed}:
            unreachable

    @guidance
        -- Enforced by the SQLite trigger
        -- launches_clear_pending_placement_on_terminal in
        -- internal/db/db.go createIntegrityTriggers.
        --
        -- A stale pending_placement silently blocks re-placement:
        -- AssignJobHost (internal/db/cloud_instances.go) rejects any job
        -- whose effective_status (COALESCE(pending_status, status)) is not
        -- exactly 'queued', so re-placement returns (false, nil) without
        -- updating the attempt, leaving the job unplaced.
}

invariant QueueOrderPreserved {
    -- The queue runner never dispatches a job ahead of an earlier-submitted
    -- pending job on the same host when that earlier job is eligible. If
    -- the head of the queue cannot start (warm-up active, insufficient CPU
    -- capacity, dependencies unsatisfied, GPU device busy), later jobs wait —
    -- except that a benchmark-isolation head blocked only by the benchmark
    -- idle probe may be bypassed by a later eligible non-benchmark job.
    for host in Hosts:
        for job in host.pending_queue:
            if job.dispatched_at != null:
                for earlier in host.pending_queue
                    where earlier.created_at < job.created_at
                    and earlier.is_blocked = false:
                        earlier.dispatched_at != null
                        earlier.dispatched_at <= job.dispatched_at
}

invariant HostCPUAllotmentCapped {
    -- The sum of local CPU allotments for jobs the runner has just
    -- admitted on a host must not exceed the configured utilization
    -- target at admission time. Adaptive increases on already-running
    -- jobs may push the running sum over the target; the invariant
    -- describes the admission gate, not the steady-state sum.
    for host in Hosts:
        let admitted = host.running_jobs.filter(j => j.gpu_class = null)
        sum(j.local_cpu_allotment for j in admitted)
            <= config.host_cpu_utilization_target

    @guidance
        -- When the sum would be exceeded by a new dispatch, the runner
        -- holds the head of the queue until a running job finishes or
        -- decays its allotment. Running jobs are never preempted to
        -- reclaim capacity.
}

invariant GPUJobsAreExclusivePerDevice {
    -- Among our own jobs on a single host, each GPU device carries at
    -- most one running job. Other users on shared hosts are outside
    -- our control and may use the same device concurrently; this
    -- invariant scopes only to jobs weft manages.
    for host in Hosts:
        for device in host.gpu_devices:
            count(j for j in host.running_jobs
                  where j.gpu_devices contains device) <= 1

    @guidance
        -- GPU compute (SMs/warps) cannot be partitioned the way OS
        -- scheduling partitions CPU cores, so GPU jobs get the device
        -- exclusively among our jobs. Memory tracking supplements
        -- this to avoid stacking our own jobs' VRAM on a device.
}

-- ==========================================================================
-- TUI views
-- ==========================================================================
--
-- View contracts documented here specify WHAT a job-centric TUI view
-- shows, HOW its rows are ordered, and HOW each field is formatted.
-- Drill-downs invoked from job-listing TUIs (the grouped/ungrouped list,
-- the system/project/instance watches, and the launch planner) belong
-- here alongside the data they display.
--
-- Views are specified as @guidance blocks on the entity whose state they
-- render, rather than as first-class language constructs. Implementations
-- live in internal/ui/terminal/*.go and are free to evolve colors,
-- spacing, and navigation details; the guidance constrains the semantic
-- content (columns, ordering, empty states, available keys).
--
-- Display convention: all job-time columns (start, end, queued-at) render
-- a null/zero timestamp as util.EmptyCell for the surface (TUI or plain CLI),
-- never as the Unix epoch. Shared helper: internal/util FormatUnixTimeOr
-- (regression wb21).

-- AttemptsView is a read-only drill-down reachable by pressing `a` on a
-- selected job row from any TUI that lists jobs. It shows the full
-- history of attempts recorded in job_attempts for that job.
rule AttemptsViewIsReadOnly {
    when: UserPressesAttemptsKey(job)
    ensures: AttemptsViewOpened(job)

    @guidance
        -- The view displays db.JobAttempt rows for the selected job,
        -- newest first (attempt_number DESC). It does not mutate DB
        -- state — no retry, cancel, or kill actions are offered here.
        --
        -- Header line (fields joined by two spaces):
        --   - "Attempts for job #<id>"
        --   - job.description (or generated_description, or command)
        --     truncated to ~80 display cols
        --   - job.effective_status
        --   - "project: <name>" when job.project is non-empty
        --
        -- Columns (in order):
        --   #        attempt_number
        --   Status   attempt.status (raw value)
        --   Host     attempt.host, or "—" when unset
        --   Started  attempt.start_time formatted "YYYY-MM-DD HH:MM:SS"
        --            in local time, or "—" when null/zero
        --   Duration end_time - start_time, formatted as "Ns" /
        --            "Nm Ns" / "Nh Nm"; uses now() when end_time is
        --            null (attempt still in progress); "—" when
        --            start_time is null
        --   Exit     attempt.exit_code, or "—" when null
        --   Outcome/Reason — derived in this precedence:
        --            1. cloud_outcome when non-empty and not "completed":
        --               "<outcome>" or "<outcome> — <failure_reason>"
        --            2. failure_reason when non-empty
        --            3. error_message (first line) when non-empty
        --            4. "completed" when cloud_outcome = "completed"
        --            5. "—"
        --
        -- Empty state: "No attempts recorded for this job." is shown
        -- when ListAttempts returns zero rows. Error state shows the
        -- error and offers `r` to retry loading.
        --
        -- Keys:
        --   j/k or up/down — move cursor
        --   g/G or home/end — jump top/bottom
        --   r              — reload attempts from DB
        --   esc/q          — return to the calling view
        --
        -- enter is intentionally unbound; per-attempt log viewing is
        -- accessed via `weft log <job-id> --attempt N` from the shell
        -- (see docs/guides/debugging.md). `weft job info` also prints an
        -- attempts table for jobs with more than one attempt.
        --
        -- Entry from TUIs: pressing `a` on a selected job row in the
        -- jobs list, system/project/instance watches, or any future
        -- job-listing TUI pushes this view and restores the caller on
        -- return. The `A` key (shift-a) remains the global auto-pilot
        -- enable/disable toggle in watches and the grouped jobs list.
        --
        -- Implementation:
        --   internal/db/attempts.go               — ListAttempts query
        --   internal/ui/terminal/attempts_tui.go  — attemptsListModel
        --   internal/ui/terminal/watch_router.go  — switchToAttemptsMsg,
        --                                           switchBackFromAttemptsMsg
}

-- `weft log <job-id>` without --attempt reads the selected job attempt,
-- which defaults to the job's latest attempt. It must not substitute an
-- older attempt's log when the latest attempt has no log object or an empty
-- log object.
rule JobLogCommandReadsSelectedAttempt {
    when: UserRequestsJobLog(job, requested_attempt)

    let selected_attempt =
        if requested_attempt != null:
            job.attempts.find(a => a.attempt_number = requested_attempt)
        else:
            job.latest_attempt

    requires: selected_attempt != null

    ensures: JobLogOutputSource(job) = selected_attempt
    if selected_attempt.log_bytes = 0:
        ensures: JobLogOutputBytes(job) = 0

    @guidance
        -- Default command:
        --   `weft log <job-id>` reads job.latest_attempt.
        --
        -- Explicit attempt command:
        --   `weft log <job-id> --attempt N` reads the attempt whose
        --   attempt_number is N.
        --
        -- For cloud jobs, the R2 run ID is selected_attempt.id, the
        -- job_attempts primary key, and the keys are scoped under:
        --   jobs/<jobID>/runs/<selected_attempt.id>/...
        --
        -- For external-executor jobs, the command routes through
        -- ExternalJobBinding to the executor adapter (for SkyPilot, `sky logs`
        -- or the API equivalent). The local wj<id> remains the command
        -- address. If the external executor has no retained log for the
        -- selected attempt, the command reports that absence directly; it
        -- must not scan Weft R2 paths or remote SSH hosts looking for an
        -- unrelated log.
        --
        -- Missing or empty log objects for the selected attempt are
        -- authoritative. The command may return zero bytes or a not-found
        -- error for that selected attempt, but it must not scan older
        -- job_attempts rows to find output from another attempt. Legacy
        -- job-level R2 paths (jobs/<jobID>/...) may be checked as an
        -- alternate storage location for historical jobs, but only as a
        -- storage-compatibility fallback for the selected attempt. This
        -- keeps `weft log` consistent with the AttemptsView and with
        -- retry/relaunch history.
        --
        -- Implementation:
        --   cmd/log.go — runLogFromR2, fetchCloudLogFromR2,
        --                runLogForAttempt
        --   internal/db/attempts.go — ListAttempts
}

-- Plain-mode watch commands (`weft watch`, `weft job watch`,
-- `weft project watch`, `weft instance watch`, and their aliases) refresh
-- from the database when SQLite's DB/WAL/SHM files change, with a fixed
-- maximum interval fallback. Each refresh reprints the snapshot until either
-- all displayed jobs reach a terminal state or the user interrupts. This makes
-- them suitable for headless / agent monitoring of any selection of jobs
-- without external looping. Use --follow to keep printing past quiescence.
rule PlainWatchRefreshesUntilQuiescent {
    when: UserInvokesPlainWatch(scope)
    ensures: ScopeRefreshedOnDBChangeOrInterval(scope) and
             ExitsWhenAllTerminal(scope) unless FollowFlagSet

    @guidance
        -- Refresh max interval is TerminalSyncInterval (60s by default,
        -- internal/ui/terminal/deps.go). The normal wake path is the
        -- shared DB change source (internal/app/dbwatch), which watches
        -- the SQLite database, -wal, and -shm files and coalesces bursty
        -- filesystem events. Each iteration:
        --   1. Runs the same fast/full sync the TUI would (respecting
        --      --sync / --no-sync), surfacing warnings on stderr.
        --   2. Reloads the scope's job set from the DB.
        --   3. Renders a snapshot to stdout.
        --   4. Waits until the DB changes, the max interval elapses,
        --      or SIGINT arrives.
        --
        -- Quiescence (i.e. exit conditions, when --follow is unset):
        --   - `weft watch` / `weft watch system` / `weft watch instance`:
        --     no running launches and no on-prem jobs in non-terminal
        --     states.
        --   - `weft job watch <id>...`: every named job has reached a
        --     terminal status.
        --   - `weft project watch [name]`: the project has no running,
        --     queued, or unplaced jobs.
        --
        -- Empty initial state for a named project still errors as
        -- "no jobs found for project ..." on the first iteration; the
        -- error is not retried in the polling loop.
        --
        -- Streaming/event-mode flags (--transitions-only, --jsonl,
        -- --until-any-terminal) layer on top of this loop and are
        -- specified by rule WatchEmitsTransitionEvents below.
        --
        -- Implementation:
        --   cmd/watch.go            — watchAllPlain entry
        --   cmd/job_watch.go        — watchJobsPlainAll
        --   cmd/project_watch.go    — runProjectWatchPlain
        --   internal/ui/terminal/watch_plain.go — shared snapshot loop
        --   internal/app/dbwatch    — shared DB change source
}

-- Streaming flags (--transitions-only, --jsonl, --until-any-terminal) turn
-- the plain-mode watch into an event source. They are agent-oriented and
-- must produce stable, machine-parseable output across weft versions.
rule WatchEmitsTransitionEvents {
    when: UserInvokesPlainWatch(scope) and
          (TransitionsOnlyFlagSet or JSONLinesFlagSet or UntilAnyTerminalFlagSet)
    ensures: SeedIterationEmitsNoEvents and
             SubsequentIterationsEmitOnePerStatusChange and
             EventSchemaIsStable

    @guidance
        -- Trigger semantics:
        --   - --transitions-only       suppresses the snapshot block; only
        --                              event lines are written to stdout.
        --   - --jsonl                  emits JSON Lines output. With
        --                              --transitions-only, one JSON
        --                              transition per line. Without it, one
        --                              JSON snapshot object per iteration.
        --   - --until-any-terminal     exits on the first terminal
        --                              transition (mutually exclusive with
        --                              --follow).
        --
        -- Seed iteration:
        --   The first poll establishes the (job_id → effective_status)
        --   baseline. No transition events are emitted on the seed, so
        --   already-terminal jobs (e.g. project_watch's Recent bucket) do
        --   not trip --until-any-terminal. A job appearing for the first
        --   time after the seed is emitted with prev_status = "" (new
        --   arrival).
        --
        -- Transition trigger:
        --   Only EffectiveStatus() change. Other field changes (host,
        --   exit_code) ride along on the event but do not, by themselves,
        --   trigger one. Jobs disappearing from the iteration's job set
        --   (e.g. aging out of the --recent window) are forgotten without
        --   emission so a later reappearance is reported as a new arrival.
        --
        -- v1 stable JSON schema:
        --   transition: {
        --     "type":        "transition",
        --     "timestamp":   "RFC3339 UTC string",
        --     "job_id":      "wj<id>",
        --     "id":          int64,
        --     "status":      string,
        --     "prev_status": string  (empty on new arrival),
        --     "host":        string  (empty when unset),
        --     "project":     string  (empty when unset),
        --     "instance_id": int64 | null,
        --     "exit_code":   int | null,
        --   }
        --   snapshot: {"type":"snapshot","timestamp":..., "jobs":[<as above
        --     minus type/prev_status>]}
        --
        --   These v1 fields are committed-stable: never renamed or removed
        --   without a major version bump. Additional fields may be added.
        --
        -- Implementation:
        --   internal/ui/terminal/watch_transitions.go — TransitionTracker,
        --                                               TransitionEvent,
        --                                               SnapshotEvent,
        --                                               WatchPlainOptions
        --   cmd/watch.go            — addWatchEventFlags, watchPlainOptions
        --   cmd/job_watch.go        — watchJobsPlainAll uses the tracker
        --   cmd/project_watch.go    — runProjectWatchPlain uses the tracker
}

-- allium: 3
-- inventory-placement.allium
--
-- Scope: Resource inventory (host capabilities), GPU class matching,
-- on-prem placement eligibility and scoring, and data locality.
--
-- Includes:
--   - Host capability model (static YAML + discovered)
--   - GPUSpec and GPU class normalization / matching rules
--   - Placement Constraints, eligibility filters, and scoring
--   - Data asset locality tracking and scan/download rules
--   - Host discovery via SSH
--
-- Excludes:
--   - Rental / cloud offer search and bidding (see campaign-lifecycle.allium)
--   - Job status transitions (see job-lifecycle.allium)
--   - Runtime host-info sync and reachability probing display
--     (see status-sync.allium; this spec only models the data model)
--   - Predictor internals, Monte Carlo simulation, CPU perf lookup tables
--     (implementation details of scoring)
--
-- Naming: enum literals use underscores (e.g. min_generation).
-- Normalized GPU class strings use the implementation form (lowercase,
-- no punctuation, e.g. rtx3090) since the normalization itself is
-- domain-level behaviour.

-- =========================================================================
-- Host capability model
-- =========================================================================

-- A Host is an external resource. Weft persists a capability record for it
-- (sourced from discovery + operator edits) but does not control the host
-- itself. The capability record is the canonical Host definition; the
-- job-lifecycle.allium Host stub is a cross-reference to this entity.
entity Host {
    name: String                -- SSH-reachable hostname
    os: String                  -- e.g. "Linux", "Darwin"
    arch: String                -- e.g. "x86_64", "arm64"

    cpu_cores: Integer
    memory: String              -- human size, e.g. "128GB"
    network_bw: String?         -- e.g. "1Gbps", "10Gbps"; null = unknown

    gpus: List<GPUSpec>

    -- Performance factors, 1.0 = baseline. Used as a multiplier on predicted
    -- run time during scoring. Unset (0) is treated as 1.0.
    cpu_factor: Decimal
    gpu_factor: Decimal

    hf_cache_dir: String?       -- resolved HF hub cache path on the host
    setup_timeout: Duration     -- max duration for setup commands (uv sync etc.)

    -- Derived
    total_gpus: sum(g.count for g in gpus)
    network_bw_bytes_per_sec: parse_network_bw(network_bw)

    @guidance
        -- Records live under ~/.config/weft/hosts/<name>.yaml, one file
        -- per host. At load time, entries in config.toml [hosts.<name>]
        -- override non-zero fields on the YAML record.
        -- Implementation: internal/inventory/inventory.go
}

-- A group of identical GPUs on a host. Multiple GPUSpecs may appear on
-- one host when hardware is heterogeneous (e.g. cool100 has A100s +
-- 2080 Tis).
value GPUSpec {
    name: String                -- original name, e.g. "NVIDIA A100 80GB PCIe"
    class: String               -- normalized class, e.g. "a100"
    memory: String              -- per-device memory, e.g. "80GB"
    indices: List<Integer>      -- device indices (CUDA_VISIBLE_DEVICES values)

    -- Derived
    count: indices.length
    memory_gb: parse_memory_gb(memory)
}

-- A normalized execution target is the durable placement identity for a job
-- attempt. Inventory targets reference a Host; rental targets reference a
-- CloudInstance from campaign-lifecycle.allium.
value ExecutionTargetKind = inventory_host | rental_instance

value ExecutionTargetStatus = provisioning | ready | running | draining | terminated

entity ExecutionTarget {
    kind: ExecutionTargetKind
    status: ExecutionTargetStatus

    host: Host?
    instance: campaign/CloudInstance?

    gpu_class: String?
    gpu_mem_gb: Integer
    num_gpus: Integer

    cordoned: Boolean
    cordon_reason: String?
    current_job: jobs/Job?
    queue_depth: Integer

    @guidance
        -- Persistent rows live in the execution_targets table. The Go
        -- struct is internal/db.ExecutionTarget in
        -- internal/db/execution_targets.go. job_attempts.target_id is the
        -- authoritative placement pointer; job_attempts.host and
        -- job_attempts.launch_id remain compatibility shadows for
        -- estimator and lab-notebook consumers until those contracts are
        -- migrated.
}

config {
    default_setup_timeout: Duration = 20.minutes
    default_cpu_factor: Decimal = 1.0
    default_gpu_factor: Decimal = 1.0

    data_cache_eviction_policy: String = "lru"        -- "lru" | "reuse_per_gb"
    data_cache_reuse_window: Duration = 30.days
}

invariant ExecutionTargetShapeIsExclusive {
    for target in ExecutionTargets:
        if target.kind = inventory_host:
            target.host != null and target.instance = null
        if target.kind = rental_instance:
            target.host = null and target.instance != null
}

-- =========================================================================
-- GPU class normalization and matching
-- =========================================================================

-- Normalized form for fuzzy matching: lowercase, letters/digits only.
-- Bare numeric RTX model names are expanded with the "rtx" prefix.
--
-- Examples:
--   "RTX 3090"    -> "rtx3090"
--   "rtx-3090"    -> "rtx3090"
--   "3090"        -> "rtx3090"        (bare model expansion)
--   "2080ti"      -> "rtx2080ti"
--   "A100 80GB"   -> "a10080gb"
--   "ampere"      -> "ampere"
--   "H100 HBM3"   -> "h100hbm3"
rule NormalizeGPUClass {
    when: NormalizeRequested(input)
    let letters_digits = input.lowercase.filter(c => c.is_alphanumeric)
    let expanded =
        if letters_digits.starts_with_digit and looks_like_rtx_model(letters_digits):
            "rtx" + letters_digits
        else: letters_digits
    ensures: NormalizedResult(expanded)

    @guidance
        -- "Looks like an RTX model" covers the well-known GeForce RTX
        -- 20xx/30xx/40xx lines and their "ti" / "super" variants.
        -- NVIDIA data-center SKUs (A100, H100, etc.) do not get the
        -- rtx prefix. Implementation: inventory.NormalizeGPUClass.
}

-- Generations group GPU models by architecture. The `family` marks whether
-- two generations can be compared by "newer than" — NVIDIA and Apple are
-- incomparable.
value GPUFamily = nvidia | apple

value GPUGeneration {
    name: String                -- e.g. "ampere", "ada_lovelace", "m2"
    family: GPUFamily
    rank: Integer               -- monotonic within family; higher = newer
}

-- Parsed form of a --gpu / --gpu-class constraint string.
value GPUConstraint {
    mode: exact_model | exact_generation | min_generation | family
    model: String?              -- set when mode = exact_model (normalized)
    generation: GPUGeneration?  -- set when mode in {exact_generation, min_generation}
    family: GPUFamily?          -- set when mode = family
    aliases: List<String>        -- exact-model aliases such as h100hbm3 -> h100sxm
}

rule ParseGPUConstraint {
    when: ParseRequested(raw: String)

    -- Recognition precedence:
    --   1. "nvidia" / "apple" (bare family)       -> family
    --   2. "<generation>+" or "<model>+"          -> min_generation
    --   3. exact generation name                  -> exact_generation
    --   4. everything else                        -> exact_model (normalized)
    --
    -- In min_generation mode the string may name a specific model
    -- (e.g. "a100+"); the parser resolves it to that model's generation.
    -- The "+" suffix is always generation-level: it never matches
    -- "this exact model or a newer submodel".
    --
    -- Exact-model mode preserves known package / memory variant intent:
    -- "h100" matches H100 PCIe, SXM/HBM3, and NVL variants; "h100-pcie"
    -- matches only PCIe; "h100-sxm" and "h100-hbm3" match the H100
    -- SXM/HBM3 class; "h100-nvl" matches only NVL.

    ensures: GPUConstraintParsed(result)

    @guidance
        -- Implementation: internal/placement/gpugen.go
        -- ParseGPUConstraint. Cross-family comparisons under
        -- min_generation are rejected at match time, not parse time.
}

rule MatchGPU {
    when: MatchRequested(constraint: GPUConstraint, gpu: GPUSpec)

    if constraint.mode = exact_model:
        ensures: Matches = (
            gpu.class = constraint.model
            or gpu.class in constraint.aliases
            or IsKnownVariantOf(gpu.class, constraint.model)
        )

    if constraint.mode = family:
        ensures: Matches = (family_of(gpu.class) = constraint.family)

    if constraint.mode = exact_generation:
        ensures: Matches = (generation_of(gpu.class) = constraint.generation)

    if constraint.mode = min_generation:
        let gpu_gen = generation_of(gpu.class)
        ensures: Matches = (
            gpu_gen != null
            and gpu_gen.family = constraint.generation.family
            and gpu_gen.rank >= constraint.generation.rank
        )

    @guidance
        -- min_generation never matches across families: an M2 does not
        -- satisfy "ampere+" and an A100 does not satisfy "m1+".
        -- Known generations live in placement/gpugen.go; additions are
        -- implementation detail. Implementation: MatchesGPU.
}

-- When two candidate GPUs both match a constraint on the same host,
-- the selector takes the first matching device in the host's GPU list.
-- No explicit tie-breaking on model or memory.
invariant FirstMatchWinsOnHost {
    -- A caller evaluating MatchGPU against gpu_specs in order must not
    -- reorder the list for the purpose of matching. The ordering on the
    -- host YAML is authoritative.
    for host in Hosts:
        first_match_is_deterministic(host.gpus)
}

-- =========================================================================
-- Placement constraints
-- =========================================================================

-- Constraints derived from a Job's resource-related fields at placement
-- time. Job-lifecycle.allium owns the user-facing flags; this spec owns
-- how those flags resolve into a placement query.
value Constraints {
    gpu_class: String?          -- raw constraint string (pre-parse)
    num_gpus: Integer?          -- exact number of GPUs requested on one
                                -- host/rental instance; null/0/1 all mean
                                -- one device. Sources: the --gpus CLI flag
                                -- and PEP 723 [tool.weft] gpus (synonyms:
                                -- gpu-count, gpu_count). Persisted on
                                -- CLIResourceOverrides.gpu_count and read
                                -- back through Job.RequestedGPUCount().
    gpu_mem_gb: Integer?        -- min GPU memory per device. The
                                -- --gpu-mem-strict flag is NOT a placement
                                -- constraint: strictness is resolved into
                                -- this value (and the memory ceiling) at
                                -- submit time (cmd/run.go
                                -- resolveEffectiveGPUMemAndCeiling), before
                                -- Constraints are built.
    max_compute_cap: String?    -- upper bound on CUDA compute capability
                                -- (e.g. "9.0", "12.0"); inferred from the
                                -- project's torch pin or an explicit
                                -- [tool.weft] gpu-arch-max
    min_compute_cap: String?    -- lower bound on CUDA compute capability
                                -- (e.g. "7.5"); inferred from the project's
                                -- torch pin — modern torch wheels drop sm_<7
                                -- kernels entirely, so a pin like torch 2.10
                                -- on cu128 implies sm_75+. No explicit user
                                -- override exists yet.
    min_cuda_version: String?   -- host CUDA-compatibility floor. For a
                                -- pip-wheel torch pin this starts at the CUDA
                                -- FAMILY floor (cu12x -> "12.0") because
                                -- pip wheels bundle their CUDA runtime and
                                -- generally run on same-major drivers under
                                -- minor-version compatibility. A curated
                                -- operational floor may raise this for known
                                -- wheel lines that fail on older same-major
                                -- drivers (for example torch 2.9.x+cu128 ->
                                -- "12.8"). Library dependency floors (e.g.
                                -- vLLM >= 0.17 -> "12.8") are cited toolkit
                                -- requirements and stay exact, as do
                                -- image-label-derived requirements on the
                                -- cloud path. Explicit cuda-driver-min
                                -- metadata REPLACES the inferred floor (it
                                -- may lower it); the value "any" clears it.
                                -- A Python dependency floor constrains
                                -- host/provider driver compatibility, not
                                -- submit-time acceptance of a user-pinned
                                -- CUDA image: modern wheels bundle CUDA
                                -- user-space libraries, so an older image
                                -- tag is not by itself proof the job cannot
                                -- run. Image-label requirements remain exact
                                -- environment floors when labels are fetched.
    min_driver_version: Integer? -- NVIDIA driver-major floor. Backfilled
                                -- from min_cuda_version via the CUDA-toolkit
                                -- driver table unless an explicit min-driver
                                -- was given (explicit values are preserved,
                                -- not raised).
    provider: String?           -- rental provider name ("" = on-prem first)
    inputs: List<String>        -- asset refs (see Data locality below)
    tags: Set<Tag>              -- rental/inventory/benchmark_isolation/compute_intensive
    preferred_instance_ids: List<Integer>   -- soft hint for instance reuse
    self_job: jobs/Job?         -- the persisted job these constraints were
                                -- resolved from (null for submit-time
                                -- constraints). Free-capacity accounting
                                -- (clause 3b) excludes this job's own
                                -- reservation so re-scoring a host the job
                                -- is already targeted at does not count the
                                -- job against itself.
}

rule BuildConstraintsFromJob {
    when: PlacementEvaluationStarts(job)

    let tags = job.tags
    let provider = parse_provider_from_tags(tags)  -- "provider:vastai" -> "vastai"
    let requests_gpu = job.gpu_class != null or job.gpu_mem_gb != null
        or job.requested_gpu_count > 1
    -- A torch project will use CUDA whenever a CUDA-capable GPU is present on
    -- the worker, so a job placed there must respect the wheel's arch range
    -- even if it never declared a GPU. Without this, a GPU-agnostic torch job
    -- can be routed onto an arch-incompatible NVIDIA card and die with "no
    -- kernel image" (wj3229). Non-CUDA GPU hosts such as Apple/MPS-only
    -- machines follow the CPU-only path for these CUDA arch bounds.
    let uses_gpu_runtime = requests_gpu or ProjectUsesTorch(job.working_dir)

    -- Torch-derived GPU-runtime constraints (arch caps, CUDA/driver floors) are
    -- populated for jobs that request a GPU OR live in a torch project. A
    -- non-torch CPU-only job carries none of them.
    ensures: Constraints.built(
        gpu_class: job.gpu_class,
        num_gpus: job.requested_gpu_count,
        gpu_mem_gb: job.gpu_mem_gb,
        max_compute_cap: uses_gpu_runtime ? job.max_compute_cap : null,
        min_compute_cap: uses_gpu_runtime ? MinComputeCapForJob(job.working_dir) : null,
        min_cuda_version: uses_gpu_runtime ? RuntimeFloorForJob(job).min_cuda_version : null,
        min_driver_version: uses_gpu_runtime ? RuntimeFloorForJob(job).min_driver_version : null,
        provider: provider,
        inputs: job.inputs,
        tags: tags,
        self_job: job
    )

    @guidance
        -- Implementation: placement.ResolveConstraints, with
        -- placement.ConstraintsFromJob adapting persisted jobs into the
        -- shared resolver input. max_compute_cap comes from the persisted
        -- jobs.max_compute_cap ("any" disables the filter), but a fresh
        -- concrete derivation from the current source tree wins over a stale
        -- concrete persisted value. min_compute_cap is re-derived from the
        -- torch pin; the CUDA/driver floors come from
        -- placement.MinRuntimeFloorForJob plus persisted CLI
        -- --cuda-driver-min overrides at highest precedence (replace /
        -- lower / clear semantics — see the Constraints field docs).
}

-- =========================================================================
-- Placement eligibility (hard constraints)
-- =========================================================================

rule EvaluateEligibility {
    when: EligibilityEvaluated(target: TargetSpec, c: Constraints, metrics: HostMetrics)

    -- A target is eligible iff every hard constraint passes. Failing targets
    -- still return a Score with placement_reasons explaining why they
    -- were rejected; those reasons surface in the TUI and `weft run`
    -- error output.

    -- 0a. Cordoned targets take no new auto-placed work. (weft instance
    --     cordon / host-level cordon; explicit --host bypasses the scorer.)
    requires: not target.cordoned

    -- 0b. Overloaded hosts are ineligible; merely busy hosts stay eligible
    --     with a scoring penalty. Implementation: placement.AssessHostLoad —
    --     rejection reasons "host overloaded: <detail>".
    requires: target.load.state != overloaded

    -- 1. Opt-in exclusion. Hosts marked opt-in-only in config are
    --    eligible only for jobs that explicitly name them.
    requires: not target.opt_in_only or target.explicitly_named

    -- 2. GPU class match.
    if c.gpu_class != null:
        let gc = ParseGPUConstraint(c.gpu_class)
        requires: target.devices.any(g => MatchGPU(gc, g))

    -- 3. GPU memory.
    if c.gpu_mem_gb != null:
        requires: target.devices.any(g => g.memory_gb >= c.gpu_mem_gb)

    -- 3a. GPU count. The host must physically hold at least the requested
    --     number of devices that INDIVIDUALLY satisfy the per-device
    --     constraints — class (#2), per-device memory (#3), and the
    --     compute-capability range (#4/#5). The per-device checks above are
    --     existential ("some device matches"); this clause is the cardinal
    --     form ("enough devices match"). One matching device on a host is
    --     not sufficient for a num_gpus > 1 job: dispatching anyway is only
    --     caught by the runner's gpu_count_preflight AFTER setup/prewarm
    --     spend (wb31, wb41).
    if c.num_gpus != null and c.num_gpus > 1:
        requires: target.devices
            .filter(g => satisfies_per_device_constraints(g, c))
            .sum(g => g.count) >= c.num_gpus

    -- 3b. Free GPU capacity. Beyond physically holding enough matching
    --     devices (3a's capacity check), the host must have enough matching
    --     devices NOT currently reserved by active attempts already targeted
    --     at it (availability). Without this clause, auto-placement can route
    --     a GPU job to a host whose matching devices are all busy — where it
    --     queues behind, or trips, the runner's live GPU gate — instead of
    --     routing to a host with free devices. Reservations are derived from
    --     job state (see ActiveReservation below); when no reservation data
    --     exists, free capacity equals total matching capacity, so this
    --     clause is a no-op on hosts without active jobs.
    if c.gpu_class != null or c.gpu_mem_gb != null
       or (c.num_gpus != null and c.num_gpus > 1):
        let reservations = ActiveReservations(target)
            .filter(r => r.job != c.self_job)   -- never count a job against itself
        requires: FreeMatchingDeviceCount(target, c, reservations)
            >= max(c.num_gpus, 1)

    -- 4. CUDA compute-capability upper bound (torch wheel compatibility).
    --    Applies to CUDA-capable targets. Eligible only if at least one CUDA
    --    GPU on the target has a KNOWN cap at or below the bound. GPUs with
    --    unknown caps do not satisfy the bound: an all-unknown-cap target is
    --    ineligible. Non-CUDA GPU hosts do not need to satisfy this CUDA bound
    --    for jobs that did not request a GPU.
    --    The bound is inferred from the project's pinned torch version + CUDA
    --    wheel variant unless the user overrides it with [tool.weft]
    --    gpu-arch-max.
    if c.max_compute_cap != null:
        requires: target.devices.any(g =>
            ComputeCapForGPU(g.class) != null
            and ComputeCapForGPU(g.class) <= c.max_compute_cap)

    -- 5. CUDA compute-capability lower bound (torch wheel compatibility).
    --    Applies to CUDA-capable hosts. Eligible if at least one CUDA GPU on
    --    the host has a known cap at or above the bound. The bound is inferred
    --    from the project's pinned torch + CUDA wheel variant
    --    (TorchMinComputeCap). Non-CUDA GPU hosts do not need to satisfy this
    --    CUDA bound for jobs that did not request a GPU. The asymmetry with #4
    --    is deliberate: for the LOWER bound, unknown-to-weft CUDA GPUs must be
    --    REJECTED, not passed. "Unknown" means weft's catalog has no
    --    compute-cap for the model — silently treating that as "probably fine"
    --    produced the EXP-179 wj2240 regression in which
    --    Vast.ai offered GTX 1080 Tis (Pascal, sm_61) that weft did not
    --    recognize and dispatched the job onto them despite a torch-derived
    --    sm_75 floor. The cloud-offer filter
    --    (campaign.filterOffersByTorchArch) implements the same fail-closed
    --    rule. Cloud offer and rental targets encode their stricter
    --    unknown-upper-bound policy in TargetSpec and are still evaluated by
    --    the same EvaluateEligibility predicate. weft's GPU catalog must
    --    include Pascal and Maxwell so this rejection is grounded in actual
    --    cap data wherever Vast.ai can offer those cards.
    if c.min_compute_cap != null:
        requires: target.devices.any(g =>
            ComputeCapForGPU(g.class) != null
            and ComputeCapForGPU(g.class) >= c.min_compute_cap)

    -- 5a. NVIDIA driver floor. The host's recorded driver major must meet
    --     the floor; a host with NO recorded driver fails when a floor is
    --     set (fail-closed — we cannot prove compatibility). For pip-wheel
    --     torch pins the floor starts from the CUDA FAMILY floor (cu12x ->
    --     driver >=525), not the wheel's exact toolkit version: pip wheels
    --     usually run under CUDA minor-version compatibility on same-major
    --     drivers. Curated operational floors may raise specific wheel lines
    --     when runtime evidence shows the family floor is too low. Exact
    --     toolkit floors also apply to library-dependency floors and
    --     image-label requirements. These floors gate host/provider
    --     compatibility; they are not a submit-time rejection solely because a
    --     user-pinned image tag reports an older CUDA toolkit than a bundled
    --     Python wheel dependency floor.
    if c.min_driver_version != null:
        requires: target.nvidia_driver_major != null
            and target.nvidia_driver_major >= c.min_driver_version

    -- 5b. CUDA-compatibility floor. host.cuda_version is the MAX CUDA
    --     compatibility reported by the host's NVIDIA driver (nvidia-smi
    --     header), not an installed toolkit version. Fail-closed when
    --     unrecorded, same rationale as 5a.
    if c.min_cuda_version != null:
        requires: target.cuda_version != null
            and target.cuda_version >= c.min_cuda_version

    -- 6. Benchmark jobs must land on an idle host.
    if benchmark_isolation in c.tags:
        requires: metrics.is_idle

    ensures: EligibilityResult(host, eligible: true)

    @guidance
        -- Implementation target: placement.EvaluateEligibility over
        -- placement.TargetSpec. TargetSpec is the normalization boundary
        -- between source-specific inventory and the single hard-constraint
        -- predicate: inventory.HostSpec, cloud offers, and running cloud
        -- instances all become target.devices plus target-level facts
        -- (cordon, opt-in-only, load, reservations/free capacity, provider,
        -- CUDA/driver facts) before matching.
        --
        -- GPU-class authority: ParseGPUConstraint + MatchGPU is canonical.
        -- Source-specific fuzzy strings are not allowed to become separate
        -- predicates. Cloud offer names from Vast.ai / provider-neutral
        -- offers are normalized into structured TargetDevice class/name/
        -- generation/family/capability fields, with provider aliases (for
        -- example RTX 4080 -> RTX 4080S and Tesla/RTX marketing prefixes)
        -- recorded as device aliases during TargetSpecFromOffer /
        -- TargetSpecFromCloudInstance construction. After that point,
        -- EvaluateEligibility uses the same structured matcher for on-prem
        -- hosts, offers, and reusable rentals. This deliberately eliminates
        -- the historical fork in internal/campaign/gpu_class_match.go while
        -- preserving cloud behavior by moving fuzzy provider compatibility
        -- into normalization instead of retaining a second matching path.
        --
        -- Reasons for rejection are surfaced as human-readable strings
        -- collected on the Score.placement_reasons list, prefixed with the
        -- constraint kind so users can tell WHICH constraint rejected the
        -- host. Examples:
        --   "has RTX 3090 GPU"           (pass)
        --   "has 2 matching GPUs (need 2)" (pass on count, num_gpus > 1)
        --   "no GPU with >=24GB"         (fail on memory)
        --   "no GPU matching ampere+"    (fail on class)
        --   "gpu count: 1 matching GPU(s) < requested 2" (fail on count)
        --   "1 of 2 matching GPU(s) free"  (pass on free capacity, with reservations)
        --   "gpu availability: 0 of 2 matching GPU(s) free (2 reserved by
        --    active jobs), need 1" (fail on free capacity)
        --   "arch cap: no GPU with compute cap <= 9.0" (fail on torch arch ceiling)
        --   "arch floor: no GPU with compute cap >= 7.5" (fail on torch arch floor)
        --   "driver floor: NVIDIA driver 550.120 < required >=570" (fail on driver floor)
        --   "CUDA floor: host CUDA 12.0 < required 12.8" (fail on CUDA-compat floor)
        --   "not idle (2 jobs running)"  (fail on benchmark idleness)
        -- Implementation: placement.scoreHost, applyResourceHardConstraints.
        -- Defense-in-depth note: CheckHostGPUConstraints is a compatibility
        -- wrapper over EvaluateEligibility.
        -- Compute-cap inference: dataloc.ScanTorchPin reads uv.lock /
        -- pyproject.toml, placement.TorchMaxComputeCap and TorchMinComputeCap
        -- map (version, cu-variant) to caps, placement.MaxComputeCapForJob /
        -- MinComputeCapForJob apply them. Cloud-offer arch filtering calls
        -- EvaluateEligibility(TargetSpecFromOffer). All target specs fail
        -- closed on max-cap unknowns. This matters for provider catalogs and
        -- on-prem inventory alike: an unrecognized GPU model may be newer
        -- than the torch wheel supports (wj2365 / RTX PRO 4500 Blackwell on
        -- 2026-06-02), so fail-open on the upper bound can silently dispatch
        -- a torch-2.6 (sm_9.0) job onto sm_12.0 silicon.
}

-- =========================================================================
-- GPU reservations (free-capacity accounting)
-- =========================================================================

-- An ActiveReservation is DERIVED from job state — there is no lease table
-- and no explicit acquire/release protocol. Every active (non-terminal)
-- attempt targeted at an inventory host reserves GPUs on it: the concrete
-- assigned device list once the runner has reported it, or the requested
-- device count while the job is still queued/starting (or when an older
-- agent never reported devices). Deriving reservations from job rows makes
-- them crash-safe by construction: a crashed CLI or daemon cannot leak a
-- reservation, because the reservation IS the active attempt.
value ActiveReservation {
    job: jobs/Job               -- the reserving job (active, inventory-targeted)
    host: Host
    devices: List<Integer>?     -- concrete assigned CUDA device indices;
                                -- null until the runner reports them
    count: Integer              -- requested device count; consulted only
                                -- while devices is null
    gpu_class: String?          -- the reserving job's own class constraint
    gpu_mem_gb: Integer?        -- the reserving job's per-device memory floor

    @guidance
        -- Implementation: placement.GPUReservationForJob derives the
        -- reservation from a db.Job row; placement.FreeGPUCapacity folds a
        -- host's active jobs (db.ListActiveJobs: running, starting, paused,
        -- queued on the inventory target) into free/matching/reserved
        -- counts for a constraint set.
}

-- A reservation begins the moment an attempt is targeted at a host (queued),
-- initially by requested count. When the runner assigns concrete devices and
-- status sync lands them on the job row, the SAME reservation becomes
-- device-shaped — a job is never counted through both count and devices, so
-- a queued reservation converts to a running one without double-counting.
rule ReservedOnAssignment {
    when: AttemptTargetedAtHost(attempt, host)
    requires: attempt.job.constraints.requests_gpu or attempt.job.gpu_device != null

    ensures: exists(r: ActiveReservation { job = attempt.job, host = host })
    ensures: r.devices = null and r.count = attempt.job.requested_gpu_count
             while attempt.job.gpu_device = null
    ensures: r.devices = attempt.job.gpu_device
             once the runner-reported device list is synced

    @guidance
        -- Device persistence path (no new column): the runner writes
        -- "gpu_devices=<indices>" to the job's meta file
        -- (internal/runner/runner.go startJob) and records them in its
        -- state.json; status sync reads the meta file
        -- (ops.applyGPUDevicesFromMetadata in internal/ops/sync_with_host.go,
        -- batch path in internal/ops/queue_batch.go) and persists them to
        -- jobs.metadata Resource.GPUDevices, read back via
        -- db.Job.GPUDevice(). CPU-only jobs (no class, no gpu-mem floor,
        -- count <= 1, no explicit device) hold no reservation — mirroring
        -- the runner's gate, which starts them unconditionally.
}

-- Release is derived, not an action: a reservation ends exactly when its
-- attempt reaches a terminal status (completed, failed, dead, killed,
-- canceled). There is no cleanup path that can be missed — a crash that
-- kills a job releases its GPUs as soon as sync records the terminal state.
rule ReleasedOnTerminal {
    when: attempt.status becomes terminal

    ensures: not exists(r: ActiveReservation { job = attempt.job })
}

-- Placement must not over-subscribe a concurrent-execution target's
-- matching devices. This is a PLANNING invariant: the free-capacity clause
-- (EvaluateEligibility 3b) keeps the sum of reservations within the
-- matching device count at placement time. The runner's live GPU gate
-- (occupancy, VRAM headroom, compute-process utilization >= 50% on
-- inventory hosts) remains the ENFORCEMENT point at dispatch time and is
-- ground truth — it also covers foreign (non-weft) GPU load, which
-- reservations cannot see. The two compose: reservations account for
-- weft-known jobs before dispatch; AssessHostLoad's utilization signals and
-- the runner's gate cover everything else.
invariant NoOversubscription {
    for host in Hosts where host.executes_concurrently:
        for pool in MatchingDevicePools(host):
            sum(r.reserved_in(pool) for r in ActiveReservations(host)) <= pool.size

    @guidance
        -- Scope: on-prem concurrent-execution (queue-runner) targets only.
        -- Cloud/rental and sequential targets are governed by rental reuse
        -- objective scoring and agent queue ordering, and are NOT subject
        -- to this device reservation accounting.
        --
        -- Degradation ladder (behavior-safe by construction):
        --   devices known    -> subtract exactly those indices from the
        --                       pools they belong to;
        --   devices unknown  -> subtract requested count from pools the
        --                       reserving job's own request overlaps;
        --   no data at all   -> free = total matching capacity (legacy rows,
        --                       hosts without active jobs: nothing regresses).
        -- Regression tests: internal/placement/gpu_free_test.go.
}

-- =========================================================================
-- Placement scoring (soft constraints)
-- =========================================================================

-- A scored candidate. Lower completion_minutes ranks higher; score
-- is -completion_minutes so that "higher is better" semantics apply.
value Score {
    host: Host
    eligible: Boolean
    completion_minutes: Decimal
    queue_drain_minutes: Decimal
    transfer_minutes: Decimal
    run_minutes: Decimal
    data_locality_score: Decimal?   -- fraction of inputs already local
    reasons: List<String>           -- human-readable rationale fragments
}

config {
    -- Scoring defaults (fallbacks when no prediction is available).
    default_queue_drain_per_job: Duration = 30.minutes
    default_run_time: Duration = 1.hour

    -- Predictor confidence threshold below which the static default is
    -- used instead. Implementation-defined; the spec only names that the
    -- fall-through exists.
}

rule ScoreHost {
    when: ScoreRequested(host: Host, c: Constraints, metrics: HostMetrics)
    requires: EligibilityResult(host, eligible: true)

    -- Total completion = queue drain + data transfer + run time.
    -- Each component contributes a reasons fragment.

    let queue_drain = estimate_queue_drain(host, metrics)
    -- Default 30m/queued job, compounded across queue depth.

    let transfer = estimate_transfer(host, c.inputs)
    -- For each input asset, if the asset is already on host, count it
    -- local. Otherwise sum its size across the most recent remote
    -- copy's total. Divide by effective bandwidth (see transferbw
    -- below). Produces a "K/N inputs local" fragment and, when any
    -- are missing, a "~Xm transfer for K missing inputs
    -- (learned, n=<samples> | static)" fragment.

    let run = estimate_run_time(host, c, metrics)
    -- Base run time comes from the predictor when available, else the
    -- default. Scaled by contention factor (metrics-driven GPU
    -- occupancy) and then by host.cpu_factor / host.gpu_factor.
    -- The compute_intensive tag skips the contention scaling because
    -- these jobs saturate the GPU regardless of neighbours.

    ensures: Score.computed(
        host: host,
        completion_minutes: queue_drain + transfer + run,
        queue_drain_minutes: queue_drain,
        transfer_minutes: transfer,
        run_minutes: run,
        data_locality_score: transfer.local_fraction
    )

    @guidance
        -- Reasons strings are constructed in placement.scoreHost. A
        -- typical complete reason set on a healthy candidate:
        --   "has RTX 3090 GPU"
        --   "3/3 inputs local"
        --   "est. ~45m total (30m queue + 0m transfer + 15m run)"
        -- Implementation: internal/placement/placement.go scoreHost,
        -- applyDurationScoring, applyResourceSoftConstraints.
}

rule SelectBestHost {
    when: BestHostRequested(c: Constraints)

    let candidates = Hosts.map(h => ScoreHost(h, c, metrics_of(h)))
    let eligible = candidates.filter(s => s.eligible)
    let best = eligible.max_by(s => -s.completion_minutes)

    if best != null:
        ensures: PlacementResult.selected(
            target: ExecutionTarget{kind: inventory_host, host: best.host},
            score: best
        )
    else:
        ensures: PlacementResult.unplaced(reasons: candidates.flat_map(s => s.reasons))

    @guidance
        -- The unplaced path feeds job.placement_reasons (see
        -- job-lifecycle.allium rule PlaceJob). The union of per-host
        -- reasons is shown to the user so they can understand why each
        -- host was rejected. Implementation: placement.BestHost.
}

-- =========================================================================
-- On-prem vs rental fallback
-- =========================================================================

rule PlaceWithFallback {
    when: PlaceWithFallbackRequested(c: Constraints)

    -- If no rental tag, prefer on-prem. Spill to rental only when the
    -- on-prem estimate exceeds the rental estimate by a material margin.
    -- The on-prem branch yields an inventory_host ExecutionTarget; the
    -- spill branch yields a rental_instance ExecutionTarget.
    -- The threshold and rental estimation are owned by
    -- campaign-lifecycle.allium; this rule only names that the
    -- comparison happens.

    let onprem = PlaceOnPrem(c)

    if onprem = null:
        ensures: fallback_to_rental = true

    if onprem != null and should_spill_to_rental(onprem, c):
        ensures: PlacementResult.spilled_to_rental(
            onprem_estimate: onprem.completion_minutes
        )
    else:
        ensures: PlacementResult.from(onprem)

    @guidance
        -- Implementation: placement.PlaceWithFallback (placement.go:464).
        -- Jobs explicitly tagged `inventory` skip this rule and stay
        -- on-prem regardless of estimate. Jobs tagged `rental` skip
        -- on-prem entirely.
        -- For jobs tagged `cpu-intensive` (legacy alias:
        -- `compute-intensive`, canonicalized on input), should_spill_to_rental
        -- is true only when rental completion is at least 30 minutes faster
        -- than on-prem completion. Existing rental targets also need
        -- cpu_cores_effective >= WEFT_COMPUTE_CPU_CORES (default 16);
        -- unknown CPU metadata is treated as ineligible.
}

-- `weft run`'s fast-submit path scores on-prem hosts from recent DB metrics
-- (no SSH probing) so an interactive submission can print a placement
-- immediately. It is an OPTIMIZATION of PlaceOnPrem, not a second placement
-- authority: it MUST apply every guard PlaceOnPrem applies. In particular:
--   * The rental/provider skip: constraints tagged `rental` or carrying a
--     provider MUST come back unplaced without scoring any on-prem host.
--     Omitting this guard let a --tag rental job run on an on-prem host
--     (wb33).
    --   * Host eligibility: candidates are scored with the SAME scorer as
    --     PlaceOnPrem (EvaluateEligibility / scoreHost), so every hard
--     constraint — including the GPU count clause 3a — applies identically.
rule FastSubmitOnPremReuse {
    when: FastSubmitEvaluated(c: Constraints)

    if rental in c.tags or c.provider != null:
        ensures: PlacementResult.unplaced(reasons: [])

    -- Fall back to the normal (probing) placement path when recent metrics
    -- are unavailable; never place from stale host state.
    if not recent_metrics_available(Hosts):
        ensures: fast_submit_declined = true

    else:
        let scores = Hosts.map(h => ScoreHost(h, c, recent_metrics_of(h)))
        ensures: PlacementResult.from(first eligible score) or
                 PlacementResult.unplaced

    @guidance
        -- Implementation: cmd/run.go evaluateRecentOnPremPlacement, which
        -- funnels through placement.ScoreHostsWithPredictor and therefore
        -- shares scoreHost / EvaluateEligibility with PlaceOnPrem.
        -- The rental/provider short-circuit mirrors
        -- placement.placeOnPremWithMetrics (db.HasRentalTag ||
        -- constraints.Provider != ""). Regression tests:
        -- cmd/run_test.go TestEvaluateRecentOnPremPlacementSkipsRentalTaggedJobs,
        -- TestEvaluateRecentOnPremPlacementEnforcesGPUCount.
}

-- =========================================================================
-- Data locality
-- =========================================================================

value AssetKind = hf_model | hf_dataset | checkpoint | job_output | corpus

-- A data asset referenced by a job input. Assets have a kind and an ID;
-- the ID shape depends on kind (e.g. "meta-llama/Llama-3-8B" for
-- hf_model, "output/model.pt:42" for job_output).
value DataAsset {
    kind: AssetKind
    id: String
}

value AssetContentType = file | directory

rule ParseAssetRef {
    when: ParseRequested(raw: String)

    -- Prefix syntax: "<kind>:<id>". Recognized prefixes:
    --   hf:          -> hf_model
    --   hf-dataset:  -> hf_dataset
    --   checkpoint:  -> checkpoint
    --   corpus:      -> corpus
    --   <N>:         -> job_output where N is a job id
    --   local:<path> -> treated as a file path (not an asset)
    --
    -- Unprefixed strings that look like filesystem paths are file inputs;
    -- everything else is an error at parse time.

    ensures: AssetRefParsed(asset)

    @guidance
        -- Implementation: dataloc.ParseAssetRef, ParseInputRef.
        -- Spec-level view: only the prefix -> kind mapping matters.
        -- The set of prefixes is extensible in implementation; additions
        -- should be reflected here.
}

-- Per-host record of a known asset. Records are updated on scan and
-- on successful download; they are the source of truth for "is this
-- asset already here?" at placement time.
entity HostAssetRecord {
    host: Host
    asset: DataAsset
    path: String                -- filesystem path on the host
    size_bytes: Integer
    content_hash: String?       -- sha256 hex for registered checkpoints
    content_type: AssetContentType?
    last_seen: Timestamp

    -- Uniqueness: (host, asset.kind, asset.id) is unique per host.
    @guidance
        -- Implementation: dataloc/store.go, table host_data.
}

rule RecordAsset {
    when: AssetObserved(host, asset, path, size_bytes, content_hash?, content_type?)
    ensures: HostAssetRecord.upserted(
        host: host,
        asset: asset,
        path: path,
        size_bytes: size_bytes,
        content_hash: content_hash,
        content_type: content_type,
        last_seen: now
    )
}

rule DirectoryAssetDigest {
    when: DirectoryCheckpointRegistered(path)

    ensures:
        size_bytes = Sum(file.size_bytes for file in RecursiveRegularFiles(path))
        content_hash = Sha256(StableManifest(path))
        content_type = directory

    @guidance
        -- Directory checkpoint hashes are not tarball hashes. The stable
        -- manifest is sorted by slash-separated relative path; each line is
        -- "<relative-path>\t<size-bytes>\t<file-sha256>\n". This makes the
        -- logical checkpoint identity independent of filesystem traversal
        -- order and archive gzip timestamps. The R2 object used for staging
        -- is a deterministic tar.gz archive keyed by this manifest digest.
        -- Implementation: internal/dataloc/content.go DigestPath and
        -- WriteDirectoryArchive; cmd/data.go runDataAdd/runDataPublish.
}

rule ScanHFCache {
    when: HFCacheScanRequested(host)
    requires: host.hf_cache_dir != null

    -- The scan lists models--* and datasets--* directories under the
    -- host's hf_cache_dir via SSH + `du -sb`, parses each "<bytes>\t<path>"
    -- line, and maps the directory name to an asset ID by replacing
    -- "--" with "/" after the kind prefix.
    --
    --   models--meta-llama--Llama-3-8B   -> hf_model     "meta-llama/Llama-3-8B"
    --   datasets--allenai--c4            -> hf_dataset   "allenai/c4"

    ensures: for entry in scan_results:
        HostAssetRecord.upserted(
            host: host,
            asset: DataAsset(kind: entry.kind, id: entry.id),
            path: entry.path,
            size_bytes: entry.size_bytes,
            last_seen: now
        )

    @guidance
        -- Implementation: dataloc.ScanHFCache / ScanHFCacheDetailed.
        -- The scan does not remove records for assets that have
        -- disappeared — RemoveStaleEntries handles that with a cutoff.
}

rule FindAssetHosts {
    when: AssetLocationRequested(asset)

    -- Returns hosts that hold `asset`, ordered by most recent last_seen
    -- descending. Used at placement time to compute transfer estimates
    -- and locality scores.

    ensures: result = HostAssetRecords
        .filter(r => r.asset = asset)
        .sort_by(r => r.last_seen, desc)
        .map(r => r.host)
}

-- A request to stage an asset onto a host, created by placement when a
-- job's input is absent from the target. The request's lifecycle
-- (pending -> running -> completed/failed) is owned by this spec; other
-- specs may observe it but must not mutate it.
entity DataRequest {
    host: Host
    asset: DataAsset
    status: DataRequestStatus
    created_at: Timestamp
    started_at: Timestamp?
    completed_at: Timestamp?
    error: String?

    transitions status {
        pending -> running
        running -> completed
        running -> failed
        pending -> failed
        terminal: completed, failed
    }
}

value DataRequestStatus = pending | running | completed | failed

rule CreateDataRequest {
    when: AssetDownloadRequested(host, asset)
    requires: not HostAssetRecords.any(r => r.host = host and r.asset = asset)

    ensures: DataRequest.created(
        host: host,
        asset: asset,
        status: pending,
        created_at: now
    )
}

rule DownloadAssetToHost {
    when: DataRequest.status becomes running

    -- For HF assets, the download runs `huggingface-cli download` (or
    -- equivalent) over SSH on the target host into host.hf_cache_dir.
    -- On success, rescan and record the new asset. On failure, record
    -- the error and mark the request failed.

    ensures: on_success:
        HostAssetRecord.upserted(host: request.host, asset: request.asset, ...)
        request.status = completed
        request.completed_at = now
    ensures: on_failure:
        request.status = failed
        request.error = reason
        request.completed_at = now
}

rule EvictStaleRecords {
    when: EvictionRequested(cutoff: Timestamp)

    -- Records whose last_seen < cutoff are removed. This is a reaper;
    -- scans do not proactively delete records for missing assets so
    -- that a transient scan failure does not clear the inventory.

    ensures: for record in HostAssetRecords where record.last_seen < cutoff:
        HostAssetRecord.deleted(record)
}

rule SelectDataEvictionCandidates {
    when: UserRunsDataEvict(host?, last_used_cutoff)

    -- `weft data evict` selects HF cache entries whose last job usage is
    -- older than the requested cutoff, or that have never appeared in a
    -- job input. It then orders the selected entries according to the
    -- configured policy before display, dry-run output, and deletion.

    let candidates =
      HostAssetRecords.filter(record =>
        (host? = null or record.host = host?)
        and LastJobUse(record.host, record.asset) < last_used_cutoff)

    if config.data_cache_eviction_policy = "reuse_per_gb":
      for candidate in candidates:
        let recent_uses =
          CountJobInputs(candidate.host, candidate.asset,
                         since = now - config.data_cache_reuse_window)
        let size_gb = max(candidate.size_bytes / 1000000000, 1)
        let density = recent_uses / size_gb
      ensures: candidates are ordered by density ascending,
               LastJobUse ascending,
               host ascending,
               asset kind ascending,
               asset id ascending
    else:
      ensures: candidates are ordered by LastJobUse ascending,
               host ascending,
               asset kind ascending,
               asset id ascending

    @guidance
        -- Implementation: cmd/data.go runDataEvict plus
        -- internal/dataloc/evict.go. Invalid or empty policy values fall
        -- back to "lru"; invalid or empty reuse windows fall back to 30d.
        -- Unknown sizes use a 1 GB denominator so reuse_per_gb never
        -- divides by zero.
        -- Deletion still requires --yes or interactive confirmation, and
        -- dry-run never deletes remote paths or DB records.
}

-- =========================================================================
-- Host discovery
-- =========================================================================

rule DiscoverHost {
    when: UserRunsDiscover(hostname)

    -- Discovery runs a canonical probe script over SSH and turns the
    -- result into a HostSpec record. The probe collects:
    --   - OS kernel / architecture
    --   - CPU count and model string
    --   - Total memory
    --   - Disk free/total
    --   - 1-minute load average
    --   - GPU inventory (nvidia-smi table + `-L` for untruncated names;
    --     system_profiler on macOS for Apple GPUs)
    --   - NVIDIA driver version and driver-reported CUDA compatibility
    --   - Resolved HF hub cache directory

    let probe = SSHProbe(hostname)
    let cpu_factor = lookup_cpu_factor(probe.cpu_model) ?? 1.0
    let gpus = group_identical_gpus(probe.gpus)

    ensures: HostSpec.written(
        name: hostname,
        os: probe.os,
        arch: probe.arch,
        cpu_cores: probe.cpu_cores,
        memory: probe.memory,
        nvidia_driver: probe.nvidia_driver,
        cuda_version: probe.cuda_version,
        gpus: gpus.map(g => GPUSpec(
            name: g.name,
            class: NormalizeGPUClass(g.name),
            memory: g.memory,
            indices: g.indices
        )),
        cpu_factor: cpu_factor,
        gpu_factor: 1.0,
        hf_cache_dir: probe.hf_cache_dir
    )

    @guidance
        -- The generated file goes to ~/.config/weft/hosts/<hostname>.yaml
        -- and replaces any existing file. Operators may edit the file
        -- after discovery; fields set non-zero in config.toml
        -- [hosts.<name>] then override on subsequent loads.
        -- Implementation: internal/inventory/discover.go,
        --   internal/hostinfo/host.go.
        -- Network bandwidth is not probed; operators set it manually.
        -- On NVIDIA hosts, `nvidia_driver` and `cuda_version` are static
        -- compatibility gates. If a GPU job has a CUDA/driver floor and the
        -- host inventory lacks the corresponding field, on-prem placement
        -- treats the host as not proven compatible.
        -- Performance factors (cpu_factor, gpu_factor) default to 1.0
        -- when the CPU model is unknown to the lookup table.
}

-- =========================================================================
-- Invariants
-- =========================================================================

invariant GPUClassIsNormalized {
    -- GPUSpec.class on a persisted HostSpec must equal the normalized
    -- form of GPUSpec.name. Editing the YAML to a raw "RTX 3090" is a
    -- configuration error; discovery never produces one.
    for host in Hosts:
        for g in host.gpus:
            g.class = NormalizeGPUClass(g.name)
}

invariant GPUIndicesAreUnique {
    -- Across all GPUSpecs on a single host, no device index appears
    -- twice. A host with 6x 3090 is one GPUSpec with indices [0..5],
    -- not six overlapping specs.
    for host in Hosts:
        all_indices_unique(host.gpus.flat_map(g => g.indices))
}

invariant AssetRecordsHaveValidKind {
    -- HostAssetRecord.asset.kind must be one of the AssetKind enum
    -- members. Legacy free-form strings in the host_data table are
    -- a migration concern, not a design surface.
    for record in HostAssetRecords:
        record.asset.kind in AssetKind
}

invariant DataRequestsConverge {
    -- Every DataRequest eventually reaches a terminal status. A request
    -- stuck in `running` past the host's setup_timeout is a bug in the
    -- downloader, not a valid state.
    for request in DataRequests:
        eventually: request.status in {completed, failed}
}

invariant PlacementReasonsExplainUnplaced {
    -- When SelectBestHost returns unplaced, the aggregate reasons list
    -- must be non-empty. A silent "no host available" with no
    -- explanation is a UX regression.
    for result in PlacementResults where result.target = null:
        result.reasons.length > 0
}

invariant PredictorNeverBlocksPlacement {
    -- The run-time predictor (estimate_run_time, line 672) is an
    -- out-of-process `uv run job-estimator` call. It is an optimization,
    -- never a dependency: a slow, hung, or timed-out estimator is treated
    -- as unavailable and placement falls back to the heuristic estimate.
    -- Every estimator subprocess is bounded by a timeout so it can never
    -- wedge the placement-critical path; readiness checks (predictor
    -- status) fall back to the on-disk model metadata on timeout. A
    -- placement pass that blocks waiting on the estimator is a bug —
    -- history: an estimator that imported torch on `status` (a ~20s call)
    -- with no weft-side timeout wedged all cloud placement fleet-wide.
    for pass in PlacementPasses:
        pass.blocks_on_predictor = false
}

invariant TargetSatisfiesRequestedGPUCount {
    -- Any ExecutionTarget selected for a job must expose at least the
    -- job's requested GPU count. This covers BOTH target kinds:
    --   * inventory_host — EvaluateEligibility clause 3a
    --     (placement.scoreHost / CheckHostGPUConstraints wrapper), applied by every on-prem
    --     scorer including the fast-submit path (see FastSubmitOnPremReuse).
    --   * rental_instance — cloud offer selection
    --     (campaign.filterOffersByGPUCount / validateOfferGPUCount) and
    --     instance-reuse routing (campaign/reuse.go via EvaluateEligibility).
    -- Defense in depth, not placement: the agent's bootstrap GPU-shape
    -- probe (cmd/agent checkGPUCount, before setup/prewarm spend) and the
    -- runner's gpu_count_preflight (before the user command) verify the
    -- target actually delivers the devices the inventory/offer promised.
    for job in Jobs where job.constraints.num_gpus != null:
        for target in job.selected_targets:
            target.num_gpus >= max(job.constraints.num_gpus, 1)

    @guidance
        -- This invariant is about the target's PHYSICAL device count, not
        -- about co-scheduling. For on-prem hosts, co-scheduling is now
        -- covered by the derived reservation model (ActiveReservation /
        -- NoOversubscription and EvaluateEligibility clause 3b): two
        -- num_gpus=2 jobs are no longer auto-placed onto one 2-GPU host at
        -- the same time, because the first job's reservation leaves too few
        -- free devices for the second. Rental instances account for queued
        -- work through estimated wait/completion time instead (wb41 note).
}

-- =========================================================================
-- Autopilot interaction
-- =========================================================================

-- The cloud autopilot (specs/campaign-lifecycle.allium § AutoPilotPass)
-- keeps inventory-tagged jobs away from the cloud planner, but is itself
-- responsible for assigning them on-prem. Each autopilot pass:
--   1. Partitions unplaced jobs by the "inventory" tag before invoking
--      the cloud planner (BuildAutoPlacementPlan).
--   2. Assigns each inventory-tagged job to an eligible on-prem host
--      using the on-prem scorer (placeInventoryOnPrem in
--      internal/orchestration/autopilot.go). Inventory jobs never spill
--      to rental, so this is on-prem-only with no rental comparison.
--      Because the autopilot pass runs in the always-on daemon, this
--      assignment does not depend on an interactive TUI being open. The
--      interactive hostsync worker (internal/app/hostsync/worker.go
--      checkUnplacedJobs) remains a secondary assigner for when a TUI is
--      running, but is no longer the sole path.
--   3. Surfaces "inventory-tagged: waiting for on-prem host" as the
--      authoritative blocked reason ONLY on jobs no on-prem host could
--      take this pass, both in job.placement_reasons and in the pass's
--      BlockedReasons map.
--
-- Letting the cloud planner see inventory-tagged jobs would build phantom
-- launch groups (since rental_scope correctly rejects them at launch time),
-- which then inflate run-rate projections and produce spurious "run-rate
-- headroom exhausted" reasons on cloud-eligible jobs. The invariant that
-- guards this is InventoryTaggedJobsBypassCloudPlanner in
-- specs/campaign-lifecycle.allium.

-- =========================================================================
-- Cross-references
-- =========================================================================
--
-- job-lifecycle.allium/PlaceJob calls SelectBestHost here. The
-- placement_reasons it stores on the Job come from PlacementResult.reasons.
--
-- campaign-lifecycle.allium owns the rental / cloud-offer side of
-- placement: when PlaceWithFallback decides to spill, control passes
-- to the instance launch workflow.
--
-- status-sync.allium owns the runtime reachability view of hosts
-- (Online/Offline/Checking) and the TUI rendering of host metrics.
-- This spec defines only the static capability model and the
-- placement-time query interface.
